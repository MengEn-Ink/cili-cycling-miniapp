.settings-page {
  padding-bottom: 72rpx;
}
.settings-hero {
  margin: 32rpx 0 48rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-text);
}
.hero-title {
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
}
.hero-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.section-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 900;
}
.section-label > text {
  font-family: var(--font-mono);
}
.release-list {
  display: grid;
  gap: var(--card-gap);
}
.release-card {
  position: relative;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  overflow: hidden;
}
.release-card.latest {
  border-color: var(--color-card-border);
}
.release-content {
  min-width: 0;
  padding: 28rpx;
}
.release-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.release-version {
  color: var(--color-text);
  font-family: var(--font-mono);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
}
.release-latest {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.release-date {
  margin-left: auto;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 24rpx;
  line-height: 36rpx;
}
.release-title {
  margin-top: 20rpx;
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 54rpx;
  font-weight: 900;
}
.release-summary {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 42rpx;
}
.release-features {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-border-subtle);
}
.release-feature {
  display: grid;
  grid-template-columns: 28rpx minmax(0, 1fr);
  gap: 8rpx;
  color: var(--color-text);
  font-size: 25rpx;
  line-height: 42rpx;
}
.release-feature + .release-feature {
  margin-top: 8rpx;
}
.settings-footer {
  margin-top: 40rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}
