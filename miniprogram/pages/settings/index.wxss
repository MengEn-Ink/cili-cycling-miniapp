.settings-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

.pageheading {
  padding: 32rpx 0 24rpx;
  background: var(--color-bg);
  color: var(--color-text);
}

.pageheading-title {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-line {
  display: block;
}
.pageheading-sub {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--font-size-body);
  line-height: 44rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.content.tight {
  gap: 0;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 64rpx;
}
.section:first-child {
  margin-top: 0;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: var(--space-5);
}
.chapterhead-title {
  flex: none;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: var(--font-size-title);
  line-height: 48rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}
.chapterhead-rule {
  display: none;
}
.chapterhead-aside {
  flex: none;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: var(--font-size-label);
  line-height: 32rpx;
  letter-spacing: 1rpx;
}

.row.rowlink.rowbutton {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 0;
  border: 0;
  border-bottom: var(--border-width-hairline) solid var(--color-border);
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  text-align: left;
  transition: background var(--motion-duration-fast) var(--motion-easing-standard);
}
.row.rowlink.rowbutton::after {
  display: none;
}
.row.rowlink.rowbutton:active:not([disabled]) {
  background: var(--color-raised);
}
.row.rowlink.rowbutton[disabled] {
  opacity: 1;
  background: var(--color-raised) !important;
  color: var(--color-disabled-text) !important;
}

.lead {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}
.rowicon {
  flex: none;
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  position: relative;
}
.rowicon--bell::before {
  position: absolute;
  top: 10rpx;
  left: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 20rpx 20rpx 0 0;
  border-bottom-color: transparent;
  content: '';
}
.rowicon--bell::after {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 10rpx;
  height: 4rpx;
  background: var(--color-text);
  border-radius: 2rpx;
  transform: translateX(-50%);
  content: '';
}
.rowicon--lock::before {
  position: absolute;
  top: 10rpx;
  left: 14rpx;
  width: 16rpx;
  height: 12rpx;
  border: 2rpx solid var(--color-text);
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
  content: '';
}
.rowicon--lock::after {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  width: 24rpx;
  height: 16rpx;
  background: var(--color-text);
  border-radius: 4rpx;
  content: '';
}
.rowicon--broom::before {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 2rpx;
  height: 24rpx;
  background: var(--color-text);
  transform: rotate(-30deg);
  transform-origin: top right;
  content: '';
}
.rowicon--broom::after {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  width: 22rpx;
  height: 10rpx;
  background: var(--color-text);
  border-radius: 2rpx 2rpx 6rpx 6rpx;
  content: '';
}
.rowicon--route::before {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-text);
  content: '';
}
.rowicon--route::after {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 50%;
  content: '';
  box-shadow:
    -8rpx -10rpx 0 -5rpx var(--color-text),
    -2rpx -16rpx 0 -5rpx var(--color-text);
}

.rowtext {
  flex: 1;
  min-width: 0;
}
.rowtext-title {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 900;
  color: var(--color-text);
}
.rowtext-sub {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 34rpx;
}

.chev {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--color-text);
  border-right: 2rpx solid var(--color-text);
  transform: rotate(45deg);
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: 24rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  font-size: var(--font-size-body);
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: var(--space-2);
  border-radius: 50%;
  background: var(--color-text);
}
.notice--info {
  border-style: solid;
  color: var(--color-text);
}
.notice--success {
  border-color: var(--color-status-success);
  color: var(--color-status-success);
}
.notice--warning {
  border-color: var(--color-status-warning);
  color: var(--color-status-warning);
}

.detailrows {
  display: flex;
  flex-direction: column;
  border: 0;
  border-radius: 0;
  background: transparent;
  overflow: hidden;
}
.detailrow {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}
.detailrow + .detailrow {
  border-top: 0;
}
.detailrow-term {
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
  letter-spacing: 1rpx;
}
.detailrow-desc {
  color: var(--color-text);
  font-family: var(--font-mono);
  font-size: var(--font-size-body);
  line-height: 36rpx;
  word-break: break-all;
}
.section-app .detailrow:nth-child(2) .detailrow-desc {
  font-family: var(--font-family-body);
  font-weight: 800;
}

.section-strava .strava-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: var(--space-4);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}
.strava-headline {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.strava-status {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-raised);
  color: var(--color-text);
  font-size: var(--font-size-label);
  line-height: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.tag--connected {
  background: var(--color-text);
  color: var(--color-on-action);
}
.tag--disconnected,
.tag--pending,
.tag--error {
  background: var(--color-raised);
  color: var(--color-text);
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: var(--radius-full);
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: var(--font-size-body);
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn--secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.strava-cta {
  width: 100%;
}

.settings-footer {
  margin-top: 72rpx;
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 32rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

@media (max-width: 350px) {
  .row.rowlink.rowbutton {
    padding: 20rpx 0;
  }
}

/* Scheme B v6: compact paper settings ----------------------------------- */
.settings-page .pageheading {
  padding: 12rpx 0 12rpx;
}

.settings-page .pageheading-title {
  margin-top: var(--space-1);
  font-size: var(--font-size-display);
  line-height: 56rpx;
  letter-spacing: -1rpx;
}
.settings-page .pageheading-sub {
  margin-top: var(--space-1);
  font-size: var(--font-size-label);
  line-height: 34rpx;
}
.settings-page .content.tight {
  gap: 0;
}
.settings-page .section {
  gap: 10rpx;
  margin-top: var(--space-4);
}
.settings-page .section:first-child {
  margin-top: 0;
}
.settings-page .chapterhead {
  margin-bottom: var(--space-1);
}
.settings-page .chapterhead-title {
  font-family: var(--font-family-body);
  font-size: 30rpx;
  line-height: 40rpx;
}
.settings-page .row.rowlink.rowbutton {
  min-height: 88rpx;
  padding: 14rpx 0;
}
.settings-page .lead {
  gap: var(--space-3);
}
.settings-page .rowicon {
  width: 36rpx;
  height: 36rpx;
}
.settings-page .rowtext-title {
  font-size: var(--font-size-body);
  line-height: 36rpx;
}
.settings-page .rowtext-sub {
  font-size: var(--font-size-label);
  line-height: 30rpx;
}
.settings-page .notice {
  padding: 14rpx 0;
  font-size: var(--font-size-label);
  line-height: 32rpx;
}
.settings-page .detailrow {
  padding: 14rpx 0;
}
.settings-page .section-strava .strava-body {
  gap: 14rpx;
  padding: var(--space-3);
  border-radius: 10rpx;
}
.settings-page .btn {
  border-radius: 10rpx;
  font-size: var(--font-size-body);
}
.settings-page .settings-footer {
  margin-top: 44rpx;
}
