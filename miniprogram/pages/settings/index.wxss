page,
.settings-page {
  background: var(--color-bg);
  color: var(--color-text);
}

.settings-page {
  min-height: 100vh;
  padding: 0 40rpx calc(72rpx + env(safe-area-inset-bottom));
}

brand-logo {
  display: block;
  padding: 12rpx 0 18rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.settings-hero {
  padding: 48rpx 0 32rpx;
}

.hero-kicker {
  color: var(--color-brand);
  font-size: 20rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 4rpx;
  font-size: 64rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: 0;
}

.hero-copy {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 28rpx 0 14rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.section-label text {
  color: var(--color-brand);
}

.appearance-card {
  padding: 24rpx;
  border-color: var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  box-shadow: 0 16rpx 44rpx var(--color-shadow);
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.card-heading .title {
  color: var(--color-text);
}

.card-heading .muted {
  margin-top: 6rpx;
  color: var(--color-muted);
}

.strava-settings-card {
  padding: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  box-shadow: 0 16rpx 44rpx var(--color-shadow);
}

.strava-status {
  flex: none;
  padding: 7rpx 12rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  color: var(--color-muted);
  font-size: 18rpx;
  font-weight: 900;
}

.strava-status.status-ready {
  border-color: var(--color-brand);
  color: var(--color-brand);
}

.settings-inline-error {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-brand-soft);
  color: var(--color-text);
  font-size: 22rpx;
  line-height: 1.5;
}

.strava-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.strava-actions button {
  flex: 1 1 220rpx;
  min-height: 80rpx;
  margin: 0;
  font-size: 24rpx;
}

.strava-manage {
  border: 1rpx solid var(--color-border-strong);
  background: transparent;
  color: var(--color-text);
}

.strava-manage::after {
  border: 0;
}

.release-list {
  display: grid;
}

.release-card {
  display: grid;
  grid-template-columns: 30rpx minmax(0, 1fr);
  gap: 16rpx;
}

.release-rail {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
}

.release-dot {
  z-index: 1;
  width: 18rpx;
  height: 18rpx;
  margin-top: 28rpx;
  border: 4rpx solid var(--color-bg);
  border-radius: 50%;
  background: var(--color-muted);
  box-shadow: 0 0 0 1rpx var(--color-border-strong);
}

.release-line {
  position: absolute;
  top: 44rpx;
  bottom: -2rpx;
  width: 1rpx;
  background: var(--color-border);
}

.release-card:last-child .release-line {
  display: none;
}

.release-card.latest .release-dot {
  background: var(--color-brand);
  box-shadow: 0 0 0 1rpx var(--color-brand);
}

.release-content {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.release-card.latest .release-content {
  border-color: var(--color-brand);
  box-shadow: 0 16rpx 44rpx var(--color-shadow);
}

.release-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.release-version {
  color: var(--color-brand);
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.release-latest {
  padding: 3rpx 8rpx;
  border-radius: 4rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.release-date {
  margin-left: auto;
  color: var(--color-subtle);
  font-size: 19rpx;
}

.release-title {
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.release-summary {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.release-features {
  display: grid;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-border);
}

.release-feature {
  display: grid;
  grid-template-columns: 26rpx minmax(0, 1fr);
  gap: 8rpx;
  color: var(--color-text);
  font-size: 22rpx;
  line-height: 1.45;
}

.release-feature text:first-child {
  color: var(--color-brand);
  font-weight: 900;
}

.settings-footer {
  padding-top: 28rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: center;
}

@media (max-width: 350px) {
  .settings-page {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .theme-option {
    grid-template-columns: 72rpx minmax(0, 1fr) 36rpx;
    gap: 12rpx;
  }

  .theme-preview {
    width: 72rpx;
  }

  .release-date {
    width: 100%;
    margin-left: 0;
  }
}
