page,
.settings-page {
  background: var(--color-bg);
  color: var(--color-text);
}

.settings-page {
  min-height: 100vh;
  padding: 0 40rpx calc(72rpx + env(safe-area-inset-bottom));
}

brand-logo {
  display: block;
  padding: 12rpx 0 18rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.settings-hero {
  padding: 48rpx 0 32rpx;
}

.hero-kicker {
  color: var(--color-brand);
  font-size: 20rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 4rpx;
  font-size: 64rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: 0;
}

.hero-copy {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 28rpx 0 14rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.section-label text {
  color: var(--color-brand);
}

.appearance-card {
  padding: 24rpx;
  border-color: var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  box-shadow: 0 16rpx 44rpx var(--color-shadow);
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.card-heading .title {
  color: var(--color-text);
}

.card-heading .muted {
  margin-top: 6rpx;
  color: var(--color-muted);
}

.theme-status {
  flex: none;
  padding: 7rpx 12rpx;
  border: 1rpx solid var(--color-brand);
  border-radius: var(--radius-sm);
  color: var(--color-brand);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.theme-options {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.theme-option {
  display: grid;
  grid-template-columns: 84rpx minmax(0, 1fr) 40rpx;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  margin: 0;
  padding: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-input-bg);
  color: var(--color-text);
  text-align: left;
}

.theme-option::after {
  border: 0;
}

.theme-option.selected {
  border-color: var(--color-brand);
  background: var(--color-brand-soft);
  box-shadow: inset 0 0 0 1rpx var(--color-brand);
}

.theme-option:active {
  transform: scale(0.985);
}

.theme-preview {
  position: relative;
  width: 84rpx;
  height: 64rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
}

.theme-preview view:first-child {
  position: absolute;
  inset: 0 0 auto;
  height: 18rpx;
  background: #d55b1f;
}

.theme-preview view:last-child {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

/* 两个缩略图固定展示目标色板，不能继承当前主题，否则预览会变成同一种外观。 */
.theme-preview-dark {
  background: #0b0b0c;
}

.theme-preview-dark view:last-child {
  background: #2a2a2d;
}

.theme-preview-light {
  background: #ffffff;
  border: 1rpx solid #bdbdb8;
}

.theme-preview-light view:last-child {
  background: #f1f1ef;
  box-shadow: none;
}

.theme-option-copy {
  display: grid;
  min-width: 0;
  line-height: 1.35;
}

.theme-option-copy text:first-child {
  font-size: 27rpx;
  font-weight: 900;
}

.theme-option-copy text:last-child {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.theme-check {
  display: grid;
  width: 36rpx;
  height: 36rpx;
  place-items: center;
  border: 1rpx solid var(--color-border-strong);
  border-radius: 50%;
  color: var(--color-on-brand);
  font-size: 22rpx;
  font-weight: 900;
}

.theme-option.selected .theme-check {
  border-color: var(--color-brand);
  background: var(--color-brand);
}

.release-list {
  display: grid;
}

.release-card {
  display: grid;
  grid-template-columns: 30rpx minmax(0, 1fr);
  gap: 16rpx;
}

.release-rail {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
}

.release-dot {
  z-index: 1;
  width: 18rpx;
  height: 18rpx;
  margin-top: 28rpx;
  border: 4rpx solid var(--color-bg);
  border-radius: 50%;
  background: var(--color-muted);
  box-shadow: 0 0 0 1rpx var(--color-border-strong);
}

.release-line {
  position: absolute;
  top: 44rpx;
  bottom: -2rpx;
  width: 1rpx;
  background: var(--color-border);
}

.release-card:last-child .release-line {
  display: none;
}

.release-card.latest .release-dot {
  background: var(--color-brand);
  box-shadow: 0 0 0 1rpx var(--color-brand);
}

.release-content {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.release-card.latest .release-content {
  border-color: var(--color-brand);
  box-shadow: 0 16rpx 44rpx var(--color-shadow);
}

.release-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.release-version {
  color: var(--color-brand);
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.release-latest {
  padding: 3rpx 8rpx;
  border-radius: 4rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.release-date {
  margin-left: auto;
  color: var(--color-subtle);
  font-size: 19rpx;
}

.release-title {
  margin-top: 12rpx;
  color: var(--color-text);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.release-summary {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.release-features {
  display: grid;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-border);
}

.release-feature {
  display: grid;
  grid-template-columns: 26rpx minmax(0, 1fr);
  gap: 8rpx;
  color: var(--color-text);
  font-size: 22rpx;
  line-height: 1.45;
}

.release-feature text:first-child {
  color: var(--color-brand);
  font-weight: 900;
}

.settings-footer {
  padding-top: 28rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: center;
}

@media (max-width: 350px) {
  .settings-page {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .theme-option {
    grid-template-columns: 72rpx minmax(0, 1fr) 36rpx;
    gap: 12rpx;
  }

  .theme-preview {
    width: 72rpx;
  }

  .release-date {
    width: 100%;
    margin-left: 0;
  }
}
