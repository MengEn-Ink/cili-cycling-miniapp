.settings-page {
  min-height: 100vh;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}
.settings-hero {
  margin: 20rpx 0 64rpx;
  padding: 28rpx 0 0;
  background: var(--color-bg);
  color: var(--color-text);
}
.journal-heading {
  position: relative;
}
.journal-eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.journal-eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.hero-title {
  margin-top: 16rpx;
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}
.hero-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 32rpx;
  line-height: 48rpx;
}
.section-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 900;
}
.section-label > text {
  font-family: var(--font-mono);
}
.release-section-label {
  margin-top: 64rpx;
}
.management-list {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  overflow: hidden;
}
.management-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 116rpx;
  margin: 0;
  padding: 24rpx 28rpx;
  border: 0;
  border-radius: 0;
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
}
.management-row::after {
  display: none;
}
.management-row + .management-row {
  border-top: 2rpx solid var(--color-border-subtle);
}
.management-copy {
  flex: 1;
  min-width: 0;
}
.management-title {
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 900;
}
.management-description {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 34rpx;
}
.management-action {
  flex: none;
  margin-left: 20rpx;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.release-list {
  display: grid;
  gap: var(--card-gap);
}
.release-card {
  position: relative;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  overflow: hidden;
}
.release-card.latest {
  border-color: var(--color-card-border);
}
.release-content {
  min-width: 0;
  padding: 28rpx;
}
.release-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.release-version {
  color: var(--color-text);
  font-family: var(--font-mono);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
}
.release-latest {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.release-date {
  margin-left: auto;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 24rpx;
  line-height: 36rpx;
}
.release-title {
  margin-top: 20rpx;
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 54rpx;
  font-weight: 900;
}
.release-summary {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 42rpx;
}
.release-features {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-border-subtle);
}
.release-feature {
  display: grid;
  grid-template-columns: 28rpx minmax(0, 1fr);
  gap: 8rpx;
  color: var(--color-text);
  font-size: 25rpx;
  line-height: 42rpx;
}
.release-feature + .release-feature {
  margin-top: 8rpx;
}
.settings-footer {
  margin-top: 40rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.strava-section-label {
  margin-top: 0;
}
.strava-list {
  margin-bottom: 64rpx;
}
.strava-row {
  gap: 20rpx;
}
.strava-mark {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #fc4c02;
}
.strava-mark-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: var(--color-on-action);
}
.strava-row--connected .strava-mark {
  background: #fc4c02;
}
.strava-row--disconnected .strava-mark,
.strava-row--pending .strava-mark,
.strava-row--error .strava-mark {
  background: var(--color-raised);
  border: 2rpx solid var(--color-border);
}
.strava-row--disconnected .strava-mark-dot,
.strava-row--pending .strava-mark-dot,
.strava-row--error .strava-mark-dot {
  background: #fc4c02;
}
