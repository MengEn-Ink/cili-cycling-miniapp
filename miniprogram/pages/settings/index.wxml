<view class="page settings-page">
  <view class="pageheading">
    <view class="eyebrow">此里 · 安心同行</view>
    <view class="pageheading-title editorial">
      <text class="pageheading-line">小事设置好，</text>
      <text class="pageheading-line">出发更轻松。</text>
    </view>
    <view class="pageheading-sub">通知订阅、隐私与应用信息。</view>
  </view>

  <view class="content tight">
    <view class="section section-notifications">
      <view class="chapterhead">
        <view class="chapterhead-title">通知</view>
        <view class="chapterhead-rule" aria-hidden="true"></view>
      </view>
      <button
        class="row rowlink rowbutton"
        bindtap="manageNotifications"
        disabled="{{actionPending}}"
        data-notifications
        aria-label="按次向微信请求活动通知订阅"
      >
        <view class="lead">
          <view class="rowicon rowicon--bell" aria-hidden="true"></view>
          <view class="rowtext">
            <view class="rowtext-title">订阅活动通知</view>
            <view class="rowtext-sub">由微信询问本次订阅选择</view>
          </view>
        </view>
        <view class="chev" aria-hidden="true"></view>
      </button>
      <view
        wx:if="{{notificationHint}}"
        class="notice notice--{{notificationHintTone}}"
        role="status"
        aria-live="polite"
      >
        <text>{{notificationHint}}</text>
      </view>
    </view>

    <view class="section section-privacy">
      <view class="chapterhead">
        <view class="chapterhead-title">隐私</view>
        <view class="chapterhead-rule" aria-hidden="true"></view>
      </view>
      <button
        class="row rowlink rowbutton"
        bindtap="managePrivacy"
        disabled="{{actionPending}}"
        data-privacy
        aria-label="打开微信隐私管理"
      >
        <view class="lead">
          <view class="rowicon rowicon--lock" aria-hidden="true"></view>
          <view class="rowtext">
            <view class="rowtext-title">微信隐私管理</view>
            <view class="rowtext-sub">查看小程序隐私保护指引</view>
          </view>
        </view>
        <view class="chev" aria-hidden="true"></view>
      </button>
      <view class="notice notice--info" role="note">
        <view class="notice-dot" aria-hidden="true"></view>
        <text>实名与电话仅本人和审核管理员完整可见；其他骑友只见昵称与同意公开的头像。</text>
      </view>
    </view>

    <view class="section section-app">
      <view class="chapterhead">
        <view class="chapterhead-title">应用</view>
        <view class="chapterhead-rule" aria-hidden="true"></view>
      </view>
      <button
        class="row rowlink rowbutton"
        bindtap="clearSafeCache"
        disabled="{{actionPending}}"
        data-cache-clear
        aria-label="清理可安全重建的缓存"
      >
        <view class="lead">
          <view class="rowicon rowicon--broom" aria-hidden="true"></view>
          <view class="rowtext">
            <view class="rowtext-title">清理可重建缓存</view>
            <view class="rowtext-sub">活动、资料与图片会在下次访问时重新加载</view>
          </view>
        </view>
        <view class="chev" aria-hidden="true"></view>
      </button>
      <view class="detailrows" wx:if="{{currentRelease}}" aria-label="App 更新">
        <view class="detailrow">
          <view class="detailrow-term">当前版本</view>
          <view class="detailrow-desc">V{{currentRelease.version}}</view>
        </view>
        <view class="detailrow">
          <view class="detailrow-term">本次更新</view>
          <view class="detailrow-desc">{{currentRelease.title}}</view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{isAdmin}}"
      class="section section-strava"
      data-admin-only
    >
      <view class="chapterhead">
        <view class="chapterhead-title">Strava 线路同步</view>
        <view class="chapterhead-aside">平台管理员可见</view>
      </view>
      <view class="strava-body">
        <view class="strava-headline">
          <view class="rowicon rowicon--route" aria-hidden="true"></view>
          <view class="rowtext">
            <view class="rowtext-title">同步 Strava 线路信息</view>
            <view class="rowtext-sub">{{stravaDescription}}</view>
          </view>
        </view>
        <view class="strava-status">
          <view class="tag tag--{{stravaState}}">{{stravaStatusLabel}}</view>
        </view>
        <button
          class="btn btn--secondary strava-cta"
          bindtap="openStravaSync"
          disabled="{{actionPending}}"
          aria-label="同步 Strava 线路信息"
        >{{stravaAction}}</button>
      </view>
    </view>
  </view>

  <view class="settings-footer">此里 · 持续为每一次出发升级</view>
</view>
