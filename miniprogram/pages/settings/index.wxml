<view class="page settings-page">
  <brand-logo compact="{{true}}" meta="设置" />

  <view class="settings-hero">
    <view class="hero-title">设置</view>
    <view class="hero-copy">管理个人设置，查看「此里」的每一次功能升级。</view>
  </view>

  <view class="section-label"><text>01</text> 功能升级日志</view>
  <view class="release-list">
    <view
      class="release-card {{item.latest ? 'latest' : ''}}"
      wx:for="{{releaseNotes}}"
      wx:key="version"
    >
      <view class="release-rail"
        ><view class="release-dot"></view><view class="release-line"></view
      ></view>
      <view class="release-content">
        <view class="release-meta">
          <text class="release-version">V{{item.version}}</text>
          <text class="release-latest" wx:if="{{item.latest}}">最新</text>
          <text class="release-date">{{item.date}}</text>
        </view>
        <view class="release-title">{{item.title}}</view>
        <view class="release-summary">{{item.summary}}</view>
        <view class="release-features">
          <view
            class="release-feature"
            wx:for="{{item.features}}"
            wx:for-item="feature"
            wx:key="*this"
            ><text aria-hidden="true">→</text><text>{{feature}}</text></view
          >
        </view>
      </view>
    </view>
  </view>

  <view class="settings-footer">此里 · 持续为每一次出发升级</view>
</view>
