<page-meta page-style="{{appearanceStyle}}" background-text-style="{{appearanceMode === 'light' ? 'dark' : 'light'}}" />
<view class="aihero-page capability-page cinema-page cinema-page--dark" data-v1-layout="redirect">
  <view class="redirect-heading"><view class="eyebrow">此里 · 骑行名片</view><view class="pageheading-title editorial">去我的页面，<text class="pageheading-line">看看自己的名片。</text></view></view>
  <state-view
    loading="{{!error}}"
    error="{{error}}"
    loading-title="正在打开我的页面"
    loading-copy="你的头像和背景就是骑行名片"
    retryable="{{true}}"
    bind:retry="openProfile"
  />
</view>
