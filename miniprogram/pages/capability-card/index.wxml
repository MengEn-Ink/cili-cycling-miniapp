<view class="capability-page">
  <state-view
    loading="{{loading}}"
    error="{{error}}"
    loading-title="正在生成骑行名片"
    loading-copy="正在整理你的公开资料与照片"
    retryable="{{true}}"
    bind:retry="load"
  >
    <view wx:if="{{card}}" class="card-stage">
      <view class="rider-card {{card.genderClass}}">
        <swiper
          wx:if="{{card.hasBackgrounds}}"
          class="card-visual"
          autoplay="{{card.hasMultipleBackgrounds}}"
          circular="{{card.hasMultipleBackgrounds}}"
          interval="5200"
          duration="520"
          indicator-dots="{{card.hasMultipleBackgrounds}}"
          indicator-color="rgba(255,255,255,.35)"
          indicator-active-color="#ffffff"
        >
          <swiper-item wx:for="{{card.backgrounds}}" wx:key="url">
            <image
              class="card-photo"
              src="{{item.url}}"
              mode="aspectFill"
              aria-hidden="true"
              data-url="{{item.url}}"
              data-index="{{index}}"
              binderror="backgroundError"
            />
          </swiper-item>
        </swiper>
        <view wx:else class="card-visual alpine-fallback" aria-label="品牌骑行名片背景">
          <view class="route-line-art"></view>
          <view class="fallback-logo"><brand-logo compact="{{true}}" /></view>
          <view class="brand-word">CILI RIDER</view>
        </view>

        <view class="image-shade" aria-hidden="true"></view>
        <view class="card-topline">
          <view class="brand-signature"><brand-logo compact="{{true}}" /></view>
          <view class="card-label"><text class="status-dot"></text>公开骑行名片</view>
        </view>
        <view class="card-content">
          <view class="identity-block">
            <view class="rider-name">{{card.displayName}}</view>
            <view class="gender-pill {{card.genderClass}}">{{card.genderLabel}}</view>
            <view class="privacy-note">这是你在活动中展示的公开资料</view>
          </view>
        </view>
      </view>

      <view class="card-caption">
        <text>{{card.generatedAtText}}</text>
        <text>昵称、头像和照片由你维护</text>
      </view>

      <button wx:if="{{card.needsProfilePhoto}}" class="photo-button" bindtap="completeProfile">
        添加个人骑行照片
      </button>
    </view>
  </state-view>
</view>
