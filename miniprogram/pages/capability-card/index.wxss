page {
  background: #0b0b0c;
}
.capability-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(56rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 85% 7%, rgba(213, 91, 31, 0.16), transparent 32%),
    linear-gradient(180deg, #111113, #0b0b0c);
  color: #f7f7f5;
}
.card-stage {
  max-width: 750rpx;
  margin: 0 auto;
  animation: card-enter 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
.rider-card {
  position: relative;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  min-height: 936rpx;
  border: 1rpx solid #68686c;
  border-radius: 12rpx;
  background: #171719;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.48);
}
.card-visual {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.card-photo {
  width: 100%;
  height: 100%;
}
.alpine-fallback {
  overflow: hidden;
  background: linear-gradient(165deg, #303034 0%, #1d1d20 42%, #111113 100%);
}
.alpine-sun {
  position: absolute;
  top: 116rpx;
  right: 92rpx;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid rgba(247, 247, 245, 0.42);
  border-radius: 50%;
  box-shadow: 0 0 70rpx rgba(213, 91, 31, 0.12);
}
.ridge {
  position: absolute;
  right: -18%;
  bottom: 300rpx;
  left: -18%;
  height: 360rpx;
  transform: rotate(-7deg) skewX(-19deg);
  background: #252528;
}
.ridge-far {
  bottom: 390rpx;
  background: #3a3a3e;
}
.ridge-near {
  bottom: 238rpx;
  background: #151517;
}
.fallback-mark {
  position: absolute;
  top: 72rpx;
  left: 54rpx;
  color: rgba(255, 255, 255, 0.14);
  font-size: 112rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 14rpx;
}
.image-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(5, 5, 6, 0.72) 0%,
    rgba(5, 5, 6, 0.05) 35%,
    rgba(5, 5, 6, 0.48) 58%,
    rgba(5, 5, 6, 0.98) 83%,
    #0b0b0c 100%
  );
  pointer-events: none;
}
.card-topline,
.identity-block,
.core-summary,
.metric-sheet {
  position: absolute;
  z-index: 2;
  right: 38rpx;
  left: 38rpx;
}
.card-topline {
  top: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.brand-signature {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #fff;
  font-size: 29rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.brand-cn {
  font-size: 19rpx;
  font-style: normal;
}
.mini-mark {
  display: inline-block;
  width: 27rpx;
  height: 22rpx;
  border: 6rpx solid #f7f7f5;
  border-right-color: #d55b1f;
  border-radius: 8rpx 2rpx 8rpx 8rpx;
  transform: skewX(-9deg);
}
.strava-pill {
  display: inline-flex;
  align-items: center;
  padding: 9rpx 15rpx;
  border: 1rpx solid #68686c;
  border-radius: 4rpx;
  background: rgba(11, 11, 12, 0.64);
  color: #f7f7f5;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.status-dot {
  display: inline-block;
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #d55b1f;
}
.identity-block {
  bottom: 478rpx;
}
.rider-name {
  display: -webkit-box;
  overflow: hidden;
  max-height: 2.08em;
  margin-top: 12rpx;
  color: #fff;
  font-size: 68rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.04;
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.5);
}
.rider-title {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
}
.privacy-note {
  display: inline-block;
  margin-top: 18rpx;
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.status-partial,
.status-syncing {
  color: #e77a43;
}
.status-repair {
  color: #ef6961;
}
.core-summary {
  bottom: 282rpx;
  display: flex;
  align-items: flex-start;
  padding: 0 4rpx;
}
.core-metric {
  width: 33.333%;
  min-width: 0;
  border-right: 1rpx solid rgba(255, 255, 255, 0.22);
  padding-left: 12rpx;
}
.core-metric:first-child {
  padding-left: 0;
}
.core-metric:last-child {
  border-right: 0;
}
.core-value {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.core-unit {
  margin-left: 5rpx;
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 800;
}
.core-label {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
}
.metric-sheet {
  bottom: 24rpx;
  min-height: 198rpx;
  padding: 24rpx 28rpx 22rpx;
  border: 1rpx solid #69696d;
  border-radius: 6rpx;
  background: rgba(19, 19, 21, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.34);
  backdrop-filter: blur(22rpx);
}
.metric-sheet::after {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 34rpx;
  height: 34rpx;
  background: #d55b1f;
  content: '';
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}
.secondary-metrics {
  display: flex;
  gap: 22rpx;
}
.metric-item {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}
.metric-value {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.metric-unit {
  margin-left: 5rpx;
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 800;
}
.metric-label,
.metric-empty,
.data-meta {
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
}
.metric-label {
  margin-top: 8rpx;
}
.metric-empty {
  padding: 10rpx 0 24rpx;
}
.data-meta {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  line-height: 1.45;
}
.card-caption {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 8rpx 4rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;
}
.repair-button,
.photo-button,
.retry-button {
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 4rpx;
  font-size: 27rpx;
  font-weight: 850;
}
.repair-button,
.retry-button {
  background: #d55b1f !important;
  color: #0b0b0c !important;
}
.photo-button {
  border: 1rpx solid #68686c;
  background: #1b1b1d !important;
  color: #fff !important;
}
.repair-button:active,
.photo-button:active,
.retry-button:active {
  transform: scale(0.985);
  opacity: 0.86;
}
.load-state {
  padding: 170rpx 32rpx 80rpx;
}
.load-kicker {
  color: #d55b1f;
  font-size: 21rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.load-title {
  margin-top: 20rpx;
  font-size: 52rpx;
  font-weight: 900;
}
.load-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.58);
}
@keyframes card-enter {
  from {
    opacity: 0;
    transform: translateY(22rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
@media (max-width: 350px) {
  .card-topline,
  .identity-block,
  .core-summary,
  .metric-sheet {
    right: 28rpx;
    left: 28rpx;
  }
  .metric-value {
    font-size: 30rpx;
  }
  .core-value {
    font-size: 32rpx;
  }
  .rider-name {
    font-size: 56rpx;
  }
}
