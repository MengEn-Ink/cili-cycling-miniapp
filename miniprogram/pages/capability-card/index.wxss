.capability-page {
  padding: 32rpx var(--page-gutter);
  background: var(--color-bg);
}
.rider-card {
  position: relative;
  overflow: hidden;
  padding: 0;
}
.card-visual {
  height: 336rpx;
  background: var(--color-media-card-bg);
}
.card-photo {
  width: 100%;
  height: 100%;
}
.alpine-fallback {
  position: relative;
  color: var(--color-on-media);
}
.route-line-art {
  position: absolute;
  right: 32rpx;
  bottom: 88rpx;
  left: 32rpx;
  height: 80rpx;
  border-top: 4rpx solid var(--color-media-muted);
  border-radius: 50%;
  transform: rotate(-8deg);
}
.fallback-logo {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
}
.brand-word {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.image-shade {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 336rpx;
  background: var(--color-overlay);
  opacity: 0.25;
}
.card-topline {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  left: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-label {
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--color-media-muted);
  border-radius: 8rpx;
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}
.card-content {
  padding: 32rpx;
}
.rider-name {
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
}
.gender-pill {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 8rpx;
  font-size: 24rpx;
}
.privacy-note {
  margin-top: 16rpx;
}
.card-caption {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.photo-button {
  width: 100%;
  margin-top: 24rpx;
}
