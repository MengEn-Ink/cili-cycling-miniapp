.capability-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}
.mock-label {
  margin-bottom: 16rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #fff0ea;
  color: #c94616;
  text-align: center;
  font-weight: 700;
}
.hero {
  position: relative;
  overflow: hidden;
  height: 620rpx;
  border-radius: 32rpx;
  background: #123f34;
  box-shadow: 0 18rpx 48rpx rgba(8, 52, 40, 0.2);
}
.hero-swiper,
.hero-image {
  width: 100%;
  height: 100%;
}
.hero-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  height: 100%;
  color: #b9d0c8;
}
.wheel {
  color: #ff6b35;
  font-size: 92rpx;
}
.hero-shade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 100rpx 34rpx 34rpx;
  background: linear-gradient(transparent, rgba(4, 34, 27, 0.92));
  color: #fff;
  pointer-events: none;
}
.eyebrow {
  color: #ff8a5c;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.eyebrow.green {
  color: #0b6b4f;
}
.nickname {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 850;
}
.scope {
  margin-top: 8rpx;
  color: #c9d8d3;
  font-size: 22rpx;
}
.status-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 24rpx 0 38rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
}
.status-dot {
  flex: 0 0 18rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e6a23c;
}
.status-ready .status-dot {
  background: #0b9a6b;
}
.status-failed .status-dot {
  background: #d94841;
}
.status-copy {
  min-width: 0;
  flex: 1;
}
.status-title {
  font-weight: 800;
}
.status-detail {
  margin-top: 4rpx;
  color: #718078;
  font-size: 22rpx;
}
.status-action {
  min-width: 144rpx;
  margin: 0;
  padding: 0 14rpx;
  background: #fff0ea;
  color: #e45220;
  font-size: 22rpx;
  line-height: 62rpx;
}
.section-head,
.time-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 850;
}
.period-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e5f1ec;
  color: #0b6b4f;
  font-size: 22rpx;
  font-weight: 700;
}
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}
.metric {
  padding: 28rpx 24rpx;
  border-radius: 22rpx;
  background: #fff;
}
.metric.featured {
  grid-column: span 2;
  background: #0b6b4f;
  color: #fff;
}
.value {
  font-size: 42rpx;
  font-weight: 850;
}
.unit {
  margin-left: 6rpx;
  font-size: 20rpx;
}
.label {
  margin-top: 8rpx;
  color: #718078;
  font-size: 22rpx;
}
.featured .label {
  color: #c6ddd5;
}
.time-card {
  margin-top: 18rpx;
}
.time-label {
  color: #718078;
  font-size: 21rpx;
}
.time-value {
  margin-top: 6rpx;
  font-weight: 700;
}
.footnote {
  padding: 24rpx 12rpx;
  color: #829089;
  font-size: 20rpx;
  line-height: 1.6;
}
.error-card {
  margin-top: 30rpx;
}
.card-title {
  margin-bottom: 8rpx;
  font-weight: 800;
}
