page {
  background: #0b0b0c;
}

.capability-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 86% 6%, rgba(213, 91, 31, 0.16), transparent 30%),
    linear-gradient(180deg, #111113, #0b0b0c);
  color: #f7f7f5;
}

.card-stage {
  max-width: 750rpx;
  margin: 0 auto;
  animation: card-enter 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.rider-card {
  position: relative;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  min-height: 900rpx;
  border: 1rpx solid #68686c;
  border-radius: 16rpx;
  background: #171719;
  box-shadow: 0 26rpx 68rpx rgba(0, 0, 0, 0.46);
}

.card-visual,
.image-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-photo {
  width: 100%;
  height: 100%;
}

.alpine-fallback {
  overflow: hidden;
  background: linear-gradient(165deg, #303034 0%, #1d1d20 42%, #111113 100%);
}

.alpine-sun {
  position: absolute;
  top: 104rpx;
  right: 84rpx;
  width: 104rpx;
  height: 104rpx;
  border: 2rpx solid rgba(247, 247, 245, 0.42);
  border-radius: 50%;
  box-shadow: 0 0 64rpx rgba(213, 91, 31, 0.12);
}

.ridge {
  position: absolute;
  right: -18%;
  bottom: 280rpx;
  left: -18%;
  height: 340rpx;
  transform: rotate(-7deg) skewX(-19deg);
  background: #252528;
}

.ridge-far {
  bottom: 370rpx;
  background: #3a3a3e;
}

.ridge-near {
  bottom: 220rpx;
  background: #151517;
}

.fallback-mark {
  position: absolute;
  top: 68rpx;
  left: 48rpx;
  color: rgba(255, 255, 255, 0.14);
  font-size: 104rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 14rpx;
}

.image-shade {
  background: linear-gradient(
    180deg,
    rgba(5, 5, 6, 0.72) 0%,
    rgba(5, 5, 6, 0.08) 30%,
    rgba(5, 5, 6, 0.6) 49%,
    rgba(5, 5, 6, 0.96) 68%,
    #0b0b0c 100%
  );
  pointer-events: none;
}

.card-topline,
.card-content {
  position: absolute;
  z-index: 2;
  right: 32rpx;
  left: 32rpx;
}

.card-topline {
  top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-signature {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #fff;
  font-size: 28rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.mini-mark {
  display: inline-block;
  width: 27rpx;
  height: 22rpx;
  border: 6rpx solid #f7f7f5;
  border-right-color: #d55b1f;
  border-radius: 8rpx 2rpx 8rpx 8rpx;
  transform: skewX(-9deg);
}

.strava-pill {
  display: inline-flex;
  flex: 0 1 auto;
  align-items: center;
  overflow: hidden;
  max-width: 54%;
  padding: 8rpx 13rpx;
  border: 1rpx solid #68686c;
  border-radius: 6rpx;
  background: rgba(11, 11, 12, 0.68);
  color: #f7f7f5;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-dot {
  display: inline-block;
  flex: 0 0 9rpx;
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-partial,
.status-syncing {
  color: #e77a43;
}

.status-repair {
  color: #ef6961;
}

.card-content {
  bottom: 24rpx;
}

.identity-block {
  min-width: 0;
  margin-bottom: 18rpx;
}

.rider-name {
  display: -webkit-box;
  overflow: hidden;
  max-height: 2.08em;
  color: #fff;
  font-size: 58rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.04;
  text-overflow: ellipsis;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.5);
}

.rider-title {
  display: -webkit-box;
  overflow: hidden;
  max-height: 2.8em;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.privacy-note {
  display: inline-block;
  max-width: 100%;
  margin-top: 12rpx;
  padding: 5rpx 9rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 4rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.metric-sheet {
  position: relative;
  padding: 20rpx 22rpx 18rpx;
  border: 1rpx solid #69696d;
  border-radius: 8rpx;
  background: rgba(19, 19, 21, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.34);
  backdrop-filter: blur(22rpx);
}

.metric-sheet::after {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 30rpx;
  height: 30rpx;
  background: #d55b1f;
  content: '';
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}

.metric-kicker {
  margin-bottom: 15rpx;
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 18rpx;
}

.metric-item {
  box-sizing: border-box;
  flex: 0 0 33.333%;
  min-width: 0;
  padding-right: 12rpx;
}

.metric-item:nth-child(n + 4) {
  flex-basis: 50%;
}

.metric-value {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 32rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-unit {
  margin-left: 4rpx;
  color: #d55b1f;
  font-size: 16rpx;
  font-weight: 800;
}

.metric-label,
.metric-empty,
.data-meta {
  color: rgba(255, 255, 255, 0.56);
  font-size: 19rpx;
}

.metric-label {
  margin-top: 6rpx;
}

.metric-empty {
  padding: 4rpx 0 12rpx;
}

.data-meta {
  margin-top: 17rpx;
  padding-top: 13rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  line-height: 1.4;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.meta-row + .meta-row {
  margin-top: 6rpx;
}

.meta-label {
  flex: 0 0 76rpx;
  color: rgba(255, 255, 255, 0.38);
}

.meta-value {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
  text-align: right;
}

.card-caption {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 6rpx 2rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 19rpx;
  line-height: 1.4;
}

.card-caption text {
  min-width: 0;
  overflow-wrap: anywhere;
}

.card-caption text:last-child {
  text-align: right;
}

.repair-button,
.photo-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  font-size: 27rpx;
  font-weight: 850;
}

.repair-button {
  background: #d55b1f !important;
  color: #0b0b0c !important;
}

.photo-button {
  border: 1rpx solid #68686c;
  background: #1b1b1d !important;
  color: #fff !important;
}

.repair-button:active,
.photo-button:active {
  transform: scale(0.985);
  opacity: 0.86;
}

@keyframes card-enter {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(0.988);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 350px) {
  .card-topline,
  .card-content {
    right: 24rpx;
    left: 24rpx;
  }

  .rider-name {
    font-size: 48rpx;
  }

  .metric-value {
    font-size: 27rpx;
  }

  .metric-unit,
  .metric-kicker,
  .metric-label,
  .metric-empty,
  .data-meta {
    font-size: 16rpx;
  }
}

/* Design reference alignment. */
.capability-page {
  padding-right: 40rpx;
  padding-left: 40rpx;
  background: #000;
}

.rider-card {
  border-color: #3a3a3c;
  border-radius: 48rpx;
  background: #1c1c1e;
  box-shadow: none;
}

.strava-pill,
.privacy-note {
  border-radius: 16rpx;
  background: rgba(28, 28, 30, 0.86);
}

.metric-sheet {
  border-color: #3a3a3c;
  border-radius: 40rpx;
  background: rgba(44, 44, 46, 0.94);
  box-shadow: none;
}

.metric-kicker,
.metric-unit {
  color: #ff5722;
}

.metric-sheet::after {
  background: #ff5722;
}

.repair-button,
.photo-button {
  min-height: 104rpx;
  border-radius: 24rpx;
}

.repair-button {
  background: #ff5722 !important;
  color: #fff !important;
}

@media (max-width: 320px) {
  .capability-page {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }
}
