page {
  background: #07111e;
}

.capability-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(56rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 82% 8%, rgba(70, 116, 148, 0.16), transparent 34%),
    linear-gradient(180deg, #071727 0%, #08111d 100%);
  color: #f5f8f7;
}

.card-stage {
  max-width: 750rpx;
  margin: 0 auto;
  animation: card-enter 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.rider-card {
  position: relative;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  min-height: 936rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 34rpx;
  background: #0b1b2c;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.38);
}

.card-visual {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.card-photo {
  width: 100%;
  height: 100%;
}

.alpine-fallback {
  overflow: hidden;
  background: linear-gradient(165deg, #153c54 0%, #0c263b 42%, #091727 100%);
}

.alpine-sun {
  position: absolute;
  top: 116rpx;
  right: 92rpx;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid rgba(203, 225, 234, 0.52);
  border-radius: 50%;
  box-shadow: 0 0 70rpx rgba(203, 225, 234, 0.14);
}

.ridge {
  position: absolute;
  right: -18%;
  bottom: 300rpx;
  left: -18%;
  height: 360rpx;
  transform: rotate(-7deg) skewX(-19deg);
  background: #102d41;
}

.ridge-far {
  bottom: 390rpx;
  background: rgba(31, 84, 103, 0.76);
}

.ridge-near {
  bottom: 238rpx;
  background: #091c2d;
}

.fallback-mark {
  position: absolute;
  top: 72rpx;
  left: 54rpx;
  color: rgba(255, 255, 255, 0.2);
  font-size: 112rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
}

.image-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(
    180deg,
    rgba(4, 18, 31, 0.76) 0%,
    rgba(4, 18, 31, 0.08) 34%,
    rgba(4, 18, 31, 0.44) 58%,
    rgba(4, 15, 27, 0.97) 81%,
    #07111e 100%
  );
  pointer-events: none;
}

.card-topline,
.identity-block,
.core-summary,
.metric-sheet {
  position: absolute;
  z-index: 2;
  right: 38rpx;
  left: 38rpx;
}

.card-topline {
  top: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.brand-signature {
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.strava-pill {
  display: inline-flex;
  align-items: center;
  padding: 9rpx 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(5, 20, 34, 0.4);
  backdrop-filter: blur(14rpx);
  color: #55f2c5;
  font-size: 19rpx;
  font-weight: 760;
  letter-spacing: 1rpx;
}

.status-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.identity-block {
  bottom: 478rpx;
}

.rider-name {
  display: -webkit-box;
  overflow: hidden;
  max-height: 2.08em;
  margin-top: 12rpx;
  color: #fff;
  font-size: 68rpx;
  font-weight: 900;
  line-height: 1.04;
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.36);
}

.rider-title {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
}

.privacy-note {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.status-partial,
.status-syncing {
  color: #f4c66b;
}

.status-partial .status-dot,
.status-syncing .status-dot {
  background: #f4c66b;
}

.status-repair {
  color: #ff9d8f;
}

.status-repair .status-dot {
  background: #ff9d8f;
}

.core-summary {
  bottom: 282rpx;
  display: flex;
  align-items: flex-start;
  padding: 0 4rpx;
}

.core-metric {
  width: 33.333%;
  min-width: 0;
}

.core-value {
  overflow: hidden;
  color: #55f2c5;
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 850;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.core-unit {
  margin-left: 5rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 18rpx;
  font-weight: 600;
}

.core-label {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
}

.metric-sheet {
  bottom: 24rpx;
  min-height: 198rpx;
  padding: 24rpx 28rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 26rpx;
  background: rgba(6, 18, 30, 0.82);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(22rpx);
}

.secondary-metrics {
  display: flex;
  gap: 22rpx;
}

.metric-item {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.metric-value {
  overflow: hidden;
  color: #55f2c5;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 820;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-unit {
  margin-left: 5rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
  font-weight: 600;
}

.metric-label,
.metric-empty,
.data-meta {
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
}

.metric-label {
  margin-top: 8rpx;
}

.metric-empty {
  padding: 10rpx 0 24rpx;
}

.data-meta {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  line-height: 1.45;
}

.card-caption {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 8rpx 4rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;
}

.repair-button,
.photo-button,
.retry-button {
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.repair-button,
.retry-button {
  background: #f3f7f6 !important;
  color: #061721 !important;
}

.photo-button {
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.06) !important;
  color: #fff !important;
}

.repair-button:active,
.photo-button:active,
.retry-button:active {
  transform: scale(0.985);
  opacity: 0.86;
}

.load-state {
  padding: 170rpx 32rpx 80rpx;
}

.load-kicker {
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.load-title {
  margin-top: 20rpx;
  font-size: 52rpx;
  font-weight: 850;
}

.load-copy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.58);
}

@keyframes card-enter {
  from {
    opacity: 0;
    transform: translateY(22rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 350px) {
  .card-topline,
  .identity-block,
  .core-summary,
  .metric-sheet {
    right: 28rpx;
    left: 28rpx;
  }

  .metric-value {
    font-size: 30rpx;
  }

  .core-value {
    font-size: 32rpx;
  }

  .rider-name {
    font-size: 56rpx;
  }
}
