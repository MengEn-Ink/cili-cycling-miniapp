page {
  background: #0b0b0c;
}

.capability-page {
  min-height: 100vh;
  padding: 18rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #000;
  color: #f7f7f5;
}

.card-stage {
  max-width: 750rpx;
  margin: 0 auto;
  animation: card-enter 360ms ease-out both;
}

.rider-card {
  position: relative;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  min-height: 820rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: 48rpx;
  background: #1c1c1e;
}

.card-visual,
.image-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-photo {
  width: 100%;
  height: 100%;
}

.alpine-fallback {
  overflow: hidden;
  background: #1c1c1e;
}

.alpine-sun {
  position: absolute;
  top: 92rpx;
  right: 76rpx;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid rgba(247, 247, 245, 0.36);
  border-radius: 50%;
  box-shadow: 0 0 54rpx rgba(213, 91, 31, 0.12);
}

.ridge {
  position: absolute;
  right: -18%;
  bottom: 220rpx;
  left: -18%;
  height: 320rpx;
  transform: rotate(-7deg) skewX(-19deg);
  background: #252528;
}

.ridge-far {
  bottom: 340rpx;
  background: #3a3a3e;
}

.ridge-near {
  bottom: 190rpx;
  background: #111113;
}

.fallback-mark {
  position: absolute;
  top: 58rpx;
  left: 42rpx;
  color: rgba(255, 255, 255, 0.12);
  font-size: 96rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 12rpx;
}

.image-shade {
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.54) 0%,
    rgba(0, 0, 0, 0.02) 32%,
    rgba(0, 0, 0, 0.64) 57%,
    #000 100%
  );
  pointer-events: none;
}

.card-topline,
.card-content {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  left: 28rpx;
}

.card-topline {
  top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.brand-signature {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #fff;
  font-size: 28rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.mini-mark {
  display: inline-block;
  width: 26rpx;
  height: 21rpx;
  border: 6rpx solid #f7f7f5;
  border-right-color: #ff5722;
  border-radius: 8rpx 2rpx 8rpx 8rpx;
  transform: skewX(-9deg);
}

.strava-pill {
  display: inline-flex;
  flex: 0 1 auto;
  align-items: center;
  overflow: hidden;
  max-width: 58%;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #1c1c1e;
  color: #fff;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strava-pill.status-verified {
  background: #ff5722;
}

.status-dot {
  display: inline-block;
  flex: 0 0 9rpx;
  width: 9rpx;
  height: 9rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-partial,
.status-syncing {
  color: #ff8a65;
}

.status-repair {
  color: #ff8f86;
}

.card-content {
  bottom: 22rpx;
}

.identity-block {
  min-width: 0;
  margin-bottom: 14rpx;
}

.rider-name {
  display: -webkit-box;
  overflow: hidden;
  max-height: 2.08em;
  color: #fff;
  font-size: 54rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.04;
  text-overflow: ellipsis;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.56);
}

.rider-title {
  display: -webkit-box;
  overflow: hidden;
  max-height: 2.8em;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.privacy-note {
  display: inline-block;
  max-width: 100%;
  margin-top: 9rpx;
  padding: 5rpx 10rpx;
  border-radius: 12rpx;
  background: rgba(28, 28, 30, 0.88);
  color: rgba(255, 255, 255, 0.72);
  font-size: 17rpx;
  font-weight: 700;
}

.metric-sheet {
  position: relative;
  padding: 18rpx 20rpx 16rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: 32rpx;
  background: rgba(28, 28, 30, 0.94);
  backdrop-filter: blur(22rpx);
}

.metric-sheet::after {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 32rpx;
  height: 32rpx;
  background: #ff5722;
  content: '';
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}

.metric-kicker {
  margin-bottom: 12rpx;
  color: #ff5722;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 14rpx;
}

.metric-item {
  box-sizing: border-box;
  flex: 0 0 33.333%;
  min-width: 0;
  padding-right: 10rpx;
}

.metric-item:nth-child(n + 4) {
  flex-basis: 50%;
}

.metric-value {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 31rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-unit {
  margin-left: 3rpx;
  color: #ff5722;
  font-size: 15rpx;
  font-weight: 800;
}

.metric-label,
.metric-empty,
.data-meta {
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
}

.metric-label {
  margin-top: 4rpx;
}

.metric-empty {
  padding: 4rpx 0 10rpx;
  line-height: 1.45;
}

.data-meta {
  margin-top: 13rpx;
  padding-top: 11rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  line-height: 1.35;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.meta-row + .meta-row {
  margin-top: 4rpx;
}

.meta-label {
  flex: 0 0 76rpx;
  color: rgba(255, 255, 255, 0.4);
}

.meta-value {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
  text-align: right;
}

.card-caption {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 6rpx 0;
  color: rgba(255, 255, 255, 0.44);
  font-size: 18rpx;
}

.card-caption text {
  min-width: 0;
  overflow-wrap: anywhere;
}

.card-caption text:last-child {
  text-align: right;
}

.repair-button,
.photo-button {
  min-height: 96rpx;
  margin-top: 16rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.repair-button {
  background: #ff5722 !important;
  color: #fff !important;
}

.photo-button {
  border: 1rpx solid #3a3a3c;
  background: #1c1c1e !important;
  color: #fff !important;
}

.repair-button:active,
.photo-button:active {
  transform: scale(0.985);
  opacity: 0.86;
}

@keyframes card-enter {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 350px) {
  .capability-page {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }

  .card-topline,
  .card-content {
    right: 22rpx;
    left: 22rpx;
  }

  .rider-name {
    font-size: 46rpx;
  }

  .metric-value {
    font-size: 27rpx;
  }

  .metric-unit,
  .metric-kicker,
  .metric-label,
  .metric-empty,
  .data-meta {
    font-size: 16rpx;
  }
}

/* Keep the established low-saturation event accent available for legacy snapshots. */
.legacy-event-accent {
  color: #d55b1f;
}
