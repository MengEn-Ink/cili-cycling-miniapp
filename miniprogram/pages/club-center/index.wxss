.club-center-page {
  padding-bottom: 160rpx;
  background: var(--color-bg);
}
.status-card,
.intro-card,
.form-card,
.read-card {
  margin-top: var(--card-gap);
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.status-card {
  border-left: 8rpx solid var(--color-border-strong);
}
.status-pending_review {
  border-left-color: var(--color-status-warning);
}
.status-rejected {
  border-left-color: var(--color-action);
}
.status-approved {
  border-left-color: var(--color-status-success);
}
.status-kicker {
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
}
.status-title {
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.status-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  line-height: 40rpx;
}
.rejection {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.rejection text,
.rejection strong {
  display: block;
}
.rejection text {
  color: var(--color-muted);
  font-size: 24rpx;
}
.rejection strong {
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}
.card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.section-no {
  color: var(--color-action);
  font-weight: 900;
}
.form-card {
  margin-top: 28rpx;
}
.cover-picker {
  display: flex;
  width: 100%;
  height: 280rpx;
  margin-top: 28rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-text);
}
.cover-picker image {
  width: 100%;
  height: 100%;
}
.cover-picker strong,
.cover-picker text {
  display: block;
}
.cover-picker text {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.field {
  display: block;
  margin-top: 28rpx;
}
.field > text {
  display: block;
  margin-bottom: 10rpx;
  color: var(--color-text);
  font-weight: 800;
}
.field input,
.field textarea,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
}
.field textarea {
  min-height: 180rpx;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.field-error {
  margin-top: 8rpx;
  color: var(--color-action);
  font-size: 24rpx;
  font-weight: 700;
}
.cover-preview {
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-sm);
}
.detail-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-border);
}
.detail-block text,
.detail-block strong {
  display: block;
}
.detail-block text {
  color: var(--color-muted);
  font-size: 24rpx;
}
.detail-block strong {
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}
.privacy-note {
  margin-top: 28rpx;
}
.actions-space {
  height: 140rpx;
}
.actions {
  grid-template-columns: 0.82fr 1.18fr;
}
.text-retry {
  margin-top: 12rpx;
  padding: 0;
  background: transparent;
  color: var(--color-action);
  text-align: left;
}
.state-card .btn {
  margin-top: 24rpx;
}
@media (max-width: 340px) {
  .actions {
    grid-template-columns: 1fr;
  }
  .club-center-page {
    padding-bottom: 260rpx;
  }
}

.club-list {
  display: grid;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
}
.join-club-card {
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.club-avatar {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}
.club-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-raised);
  color: var(--color-action);
  font-size: 44rpx;
  font-weight: 900;
}
.club-copy {
  min-width: 0;
  flex: 1;
}
.club-name {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 900;
}
.club-city {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.club-introduction {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--color-muted);
  line-height: 36rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.join-button {
  width: 100%;
  margin-top: 20rpx;
}
.create-club-button {
  width: 100%;
  margin-top: 28rpx;
}

.manage-card,
.manage-form {
  margin-top: var(--card-gap);
}
.manage-card {
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.managed-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}
.managed-avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: var(--color-bg-soft);
}
.managed-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-action);
  font-size: 40rpx;
  font-weight: 900;
}
.managed-profile-copy {
  min-width: 0;
}
.managed-introduction {
  margin-top: 20rpx;
  -webkit-line-clamp: 3;
}
.manage-entry,
.create-club-button {
  margin-top: 28rpx;
}
.managed-cover-picker {
  margin-top: 28rpx;
}

.managed-club-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-soft);
  color: var(--color-text);
  font-weight: 800;
}
.managed-club-switch text {
  color: var(--color-action);
}
.managed-inline-error {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-danger-soft);
  color: var(--color-action);
}
