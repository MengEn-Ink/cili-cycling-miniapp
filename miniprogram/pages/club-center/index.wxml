<view class="page club-center-page">
  <brand-logo compact="{{true}}" meta="俱乐部中心" />
  <view class="a11y-live-region" role="status" aria-live="polite">{{loading ? '正在读取俱乐部信息' : (managing ? '正在保存俱乐部资料' : (joinedClubName ? '已加入俱乐部' : (discoverMode ? '可以选择公开俱乐部加入' : '俱乐部信息已更新')))}}</view>
  <view class="state-card" wx:if="{{loading}}"><view class="title">正在读取俱乐部</view><view class="muted">请稍候。</view></view>
  <view class="state-card" wx:elif="{{loadError}}" role="alert"><view class="title">暂时无法读取</view><view class="muted">{{loadError}}</view><button class="btn" bindtap="load">重新加载</button></view>

  <block wx:else>
    <view class="status-card status-approved" wx:if="{{joinedClubName && !application}}">
      <view class="status-kicker">俱乐部状态</view>
      <view class="status-title">已加入</view>
      <view class="status-copy">你已加入“{{joinedClubName}}”，现在可以参与俱乐部活动。</view>
    </view>

    <view class="state-card" wx:if="{{canManageClub && manageLoadError && !managedClub}}" role="alert"><view class="title">暂时无法读取管理资料</view><view class="muted">{{manageLoadError}}</view><button class="btn" bindtap="load">重新加载</button></view>

    <view class="manage-card" wx:if="{{canManageClub && managedClub && !manageMode}}">
      <view class="card-head"><text class="section-no">管理</text><view><view class="title">俱乐部资料</view><view class="muted">负责人和管理员可维护对外展示信息</view></view></view>
      <picker wx:if="{{managedClubs.length > 1}}" range="{{managedClubs}}" range-key="name" bindchange="selectManagedClub"><view class="managed-club-switch">当前管理：{{managedClub.name}} <text>切换 ›</text></view></picker>
      <view class="managed-inline-error" wx:if="{{manageLoadError}}" role="alert">{{manageLoadError}}</view>
      <view class="managed-profile">
        <image wx:if="{{managedClub.avatarUrl}}" class="managed-avatar" src="{{managedClub.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="managed-avatar managed-avatar-placeholder">{{managedAvatarInitial}}</view>
        <view class="managed-profile-copy"><view class="club-name">{{managedClub.name}}</view><view class="club-city">{{managedClub.city}} · {{joinModes[managedJoinModeIndex].label}}</view></view>
      </view>
      <view class="club-introduction managed-introduction">{{managedClub.introduction}}</view>
      <button class="secondary manage-entry" bindtap="showManageForm">修改俱乐部资料</button>
    </view>

    <form class="manage-form" wx:if="{{canManageClub && managedClub && manageMode}}">
      <view class="form-card">
        <view class="card-head"><text class="section-no">编辑</text><view><view class="title">修改俱乐部资料</view><view class="muted">保存后，个人资料与后续活动会使用新信息</view></view></view>
        <button class="cover-picker managed-cover-picker" bindtap="chooseCover" loading="{{uploading}}" disabled="{{uploading || managing}}">
          <image wx:if="{{managedAvatarPreviewUrl}}" src="{{managedAvatarPreviewUrl}}" mode="aspectFill" />
          <view wx:else><strong>{{uploading ? '正在上传…' : '上传俱乐部头像'}}</strong><text>支持相册或拍照，最大 5MB</text></view>
        </button>
        <view class="field-error" wx:if="{{fieldErrorKey === 'avatarFileId'}}">{{fieldError}}</view>
        <label class="field"><text>俱乐部名称</text><input value="{{managedForm.name}}" data-field="name" bindinput="managedInput" maxlength="30" placeholder="例如：山海骑行会" placeholder-class="input-placeholder" /></label>
        <view class="field-error" wx:if="{{fieldErrorKey === 'name'}}">{{fieldError}}</view>
        <label class="field"><text>所在城市</text><input value="{{managedForm.city}}" data-field="city" bindinput="managedInput" maxlength="20" placeholder="例如：深圳" placeholder-class="input-placeholder" /></label>
        <view class="field-error" wx:if="{{fieldErrorKey === 'city'}}">{{fieldError}}</view>
        <label class="field"><text>俱乐部简介</text><textarea value="{{managedForm.introduction}}" data-field="introduction" bindinput="managedInput" maxlength="500" placeholder="至少 20 字，介绍定位、骑行氛围与日常活动" placeholder-class="input-placeholder" /></label>
        <view class="field-error" wx:if="{{fieldErrorKey === 'introduction'}}">{{fieldError}}</view>
        <label class="field"><text>加入方式</text><picker range="{{joinModes}}" range-key="label" value="{{managedJoinModeIndex}}" bindchange="managedJoinModeChange"><view class="picker-value">{{joinModes[managedJoinModeIndex].label}} <text>›</text></view></picker></label>
        <view class="privacy-note"><view class="privacy-note-title">权限说明</view><view>只有俱乐部负责人和管理员可以保存修改；成员身份和审批状态不会在这里改变。</view></view>
      </view>
      <view class="card danger" wx:if="{{actionError}}" role="alert">{{actionError}}</view>
      <view class="actions-space"></view>
      <view class="fixed actions"><button class="secondary" bindtap="cancelManage" disabled="{{managing || uploading}}">取消</button><button class="btn" bindtap="saveManagedClub" disabled="{{managing || uploading}}" loading="{{managing}}">{{managing ? '正在保存' : '保存修改'}}</button></view>
    </form>

    <block wx:if="{{discoverMode}}">
      <view class="intro-card">
        <view class="section-no">01</view><view class="title">加入一个俱乐部</view>
        <view class="muted">以下俱乐部已通过平台审核并开放直接加入。</view>
      </view>
      <view class="club-list" wx:if="{{joinableClubs.length}}">
        <view class="join-club-card" wx:for="{{joinableClubs}}" wx:key="id">
          <image wx:if="{{item.avatarUrl}}" class="club-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="club-avatar club-avatar-placeholder">{{item.avatarInitial}}</view>
          <view class="club-copy">
            <view class="club-name">{{item.name}}</view><view class="club-city">{{item.city}}</view>
            <view class="club-introduction">{{item.introduction || '这个俱乐部暂未填写简介。'}}</view>
            <button class="btn join-button" data-id="{{item.id}}" bindtap="joinClub" loading="{{joiningClubId === item.id}}" disabled="{{joiningClubId === item.id}}">{{joiningClubId === item.id ? '正在加入' : '加入'}}</button>
          </view>
        </view>
      </view>
      <view class="state-card" wx:else><view class="title">暂时没有可加入的俱乐部</view><view class="muted">你可以稍后再来，或申请创建一个新俱乐部。</view></view>
      <view class="card danger" wx:if="{{joinError}}" role="alert"><view>{{joinError}}</view><view class="muted">列表已保留，请再次点击加入重试。</view></view>
      <button class="secondary create-club-button" bindtap="showCreateForm">没有合适的？创建新俱乐部</button>
    </block>

    <view class="status-card status-{{application.status}}" wx:if="{{application}}">
      <view class="status-kicker">申请进度 · 第 {{application.reviewVersion}} 版</view>
      <view class="status-title" wx:if="{{application.status === 'draft'}}">草稿待提交</view>
      <view class="status-title" wx:elif="{{application.status === 'pending_review'}}">平台审批中</view>
      <view class="status-title" wx:elif="{{application.status === 'rejected'}}">申请已驳回，可修改重提</view>
      <view class="status-title" wx:else>申请已通过</view>
      <view class="status-copy" wx:if="{{application.status === 'pending_review'}}">管理员处理后，这里会同步显示结果。请勿重复提交。</view>
      <view class="rejection" wx:if="{{application.status === 'rejected'}}"><text>驳回原因</text><strong>{{application.rejectionReason}}</strong></view>
      <view class="status-copy" wx:if="{{application.status === 'approved'}}">“{{application.clubName}}”已创建，你已成为俱乐部 OWNER。</view>
    </view>

    <view class="read-card" wx:if="{{application && (application.status === 'pending_review' || application.status === 'approved')}}">
      <image wx:if="{{application.coverUrl}}" class="cover-preview" src="{{application.coverUrl}}" mode="aspectFill" />
      <view class="detail-line"><text>俱乐部名称</text><strong>{{application.clubName}}</strong></view>
      <view class="detail-line"><text>所在城市</text><strong>{{application.city}}</strong></view>
      <view class="detail-line"><text>预计规模</text><strong>{{application.expectedSize}} 人</strong></view>
      <view class="detail-block"><text>俱乐部简介</text><strong>{{application.introduction}}</strong></view>
      <view class="detail-block"><text>主要活动</text><strong>{{application.activityTypes}}</strong></view>
    </view>

    <block wx:if="{{createMode}}">
      <view class="intro-card" wx:if="{{!application}}"><view class="section-no">02</view><view class="title">申请创建俱乐部</view><view class="muted">填写必要资料并提交。俱乐部不会立即创建，必须经平台管理员审批通过。</view></view>
      <form class="application-form">
        <view class="form-card">
          <view class="card-head"><text class="section-no">01</text><view><view class="title">基本资料</view><view class="muted">用于管理员判断俱乐部定位与真实性</view></view></view>
          <button class="cover-picker" bindtap="chooseCover" loading="{{uploading}}" disabled="{{uploading}}"><image wx:if="{{coverPreviewUrl}}" src="{{coverPreviewUrl}}" mode="aspectFill" /><view wx:else><strong>{{uploading ? '正在上传…' : '上传俱乐部封面'}}</strong><text>支持相册或拍照，最大 5MB</text></view></button>
          <view class="field-error" wx:if="{{fieldErrorKey === 'coverFileId'}}">{{fieldError}}</view>
          <label class="field"><text>俱乐部名称</text><input value="{{form.clubName}}" data-field="clubName" bindinput="input" maxlength="30" placeholder="例如：山海骑行会" placeholder-class="input-placeholder" /></label>
          <view class="field-error" wx:if="{{fieldErrorKey === 'clubName'}}">{{fieldError}}</view>
          <label class="field"><text>所在城市</text><input value="{{form.city}}" data-field="city" bindinput="input" maxlength="20" placeholder="例如：深圳" placeholder-class="input-placeholder" /></label>
          <label class="field"><text>俱乐部简介</text><textarea value="{{form.introduction}}" data-field="introduction" bindinput="input" maxlength="500" placeholder="至少 20 字，介绍定位、骑行氛围与组织经验" placeholder-class="input-placeholder" /></label>
          <view class="field-error" wx:if="{{fieldErrorKey === 'introduction'}}">{{fieldError}}</view>
        </view>
        <view class="form-card">
          <view class="card-head"><text class="section-no">02</text><view class="title">运营方式</view></view>
          <label class="field"><text>加入方式</text><picker range="{{joinModes}}" range-key="label" value="{{joinModeIndex}}" bindchange="joinModeChange"><view class="picker-value">{{joinModes[joinModeIndex].label}} <text>›</text></view></picker></label>
          <label class="field"><text>预计成员规模</text><input type="number" value="{{form.expectedSize}}" data-field="expectedSize" bindinput="input" placeholder="2-10000" placeholder-class="input-placeholder" /></label>
          <label class="field"><text>主要活动类型</text><input value="{{form.activityTypes}}" data-field="activityTypes" bindinput="input" maxlength="100" placeholder="例如：公路骑行、爬坡训练" placeholder-class="input-placeholder" /></label>
          <label class="field"><text>俱乐部规则</text><textarea value="{{form.rulesSummary}}" data-field="rulesSummary" bindinput="input" maxlength="500" placeholder="至少 10 字，说明安全要求和群规" placeholder-class="input-placeholder" /></label>
          <view class="field-error" wx:if="{{fieldErrorKey === 'rulesSummary'}}">{{fieldError}}</view>
        </view>
        <view class="form-card">
          <view class="card-head"><text class="section-no">03</text><view class="title">申请人联络</view></view>
          <label class="field"><text>微信号或手机号</text><input value="{{form.applicantContact}}" data-field="applicantContact" bindinput="input" maxlength="50" placeholder="仅用于本次审核联络" placeholder-class="input-placeholder" /></label>
          <view class="privacy-note"><view class="privacy-note-title">隐私说明</view><view>申请资料仅你本人和平台管理员可见；联系方式只用于俱乐部创建审核，不向其他骑友公开。提交即表示你确认资料真实并同意用于本次审批。</view></view>
        </view>
        <view class="card danger" wx:if="{{actionError}}" role="alert">{{actionError}}</view>
        <view class="actions-space"></view>
        <view class="fixed actions"><button class="secondary" bindtap="saveDraft" disabled="{{saving || submitting || uploading}}" loading="{{saving}}">保存草稿</button><button class="btn" bindtap="submit" disabled="{{saving || submitting || uploading}}" loading="{{submitting}}">{{submitting ? '正在提交' : (application && application.status === 'rejected' ? '修改并重新提交' : '提交审核')}}</button></view>
      </form>
    </block>
  </block>
</view>
