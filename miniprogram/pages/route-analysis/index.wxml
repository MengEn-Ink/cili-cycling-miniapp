<view class="route-analysis-page">
  <state-view loading="{{loading}}" error="{{error}}" empty="{{empty}}" retryable="{{true}}" bindretry="retry" loading-title="正在分析路线" loading-copy="正在整理路线走向与坡段" empty-title="暂无路线分析" empty-copy="活动尚未提供可展示的路线信息">
    <view class="analysis-header">
      <view class="brand-line"><image src="/assets/brand/logo-circle-144.png" mode="aspectFit" /><text>CILI · ROUTE ANALYSIS</text></view>
      <view class="analysis-title">{{routeTitle}}</view>
      <view class="analysis-route">{{activityTitle}}</view>
      <view class="analysis-summary" wx:if="{{routeSummary}}">{{routeSummary}}</view>
    </view>

    <metric-grid class="overview-grid" items="{{overviewItems}}" columns="2" narrow-columns="2" aria-label="路线核心指标" />

    <view class="conclusion-panel" wx:if="{{strategySummary.length}}">
      <view class="conclusion-label">核心结论</view>
      <view class="conclusion-copy">{{strategySummary[0]}}</view>
      <view class="conclusion-copy conclusion-copy--secondary" wx:if="{{strategySummary[1]}}">{{strategySummary[1]}}</view>
      <view class="strategy-tags"><text wx:for="{{strategySummary}}" wx:key="*this">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}} / {{item}}</text></view>
    </view>

    <view class="analysis-card map-card" wx:if="{{mapAvailable || mapFailed}}">
      <view class="section-head"><view><view class="section-eyebrow">ROUTE / MAP</view><view class="section-title">路线走向 · 关键地名</view></view><view class="section-count">{{keyPoints.length}} 点</view></view>
      <view class="map-direction"><text>沿红色箭头查看骑行顺序 · 点击地图标记查看详情</text><button wx:if="{{mapFocused}}" class="map-reset" bindtap="showFullRoute">查看全线</button></view>
      <map id="route-analysis-map" wx:if="{{mapAvailable}}" wx:key="{{mapRenderKey}}" class="route-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="{{mapScale}}" markers="{{markers}}" polyline="{{polylines}}" include-points="{{mapPoints}}" bindmarkertap="markerTap" binderror="mapError" show-location="{{false}}"></map>
      <view wx:elif="{{mapFailed}}" class="analysis-empty map-fallback">
        <view>地图暂时无法显示，路线数据仍可查看</view>
        <button class="map-retry-button" bindtap="retryMap">重试地图</button>
      </view>
      <view class="map-legend"><text><text class="legend-dot legend-start">起</text>起点</text><text><text class="legend-dot legend-end">终</text>终点</text><text><text class="legend-dot legend-highest">高</text>最高点</text><text><text class="legend-dot legend-climb">爬</text>主爬坡</text><text><text class="legend-dot legend-descent">下</text>长下坡</text><text><text class="legend-dot legend-rest">休</text>节奏点</text></view>
      <view class="map-detail" wx:if="{{selectedPoint}}">
        <view class="map-detail-head"><view><text class="point-type">{{selectedPoint.typeLabel}}</text><view class="selected-name">{{selectedPoint.name}}</view></view><text class="selected-km">{{selectedPoint.kmText}}</text></view>
        <view class="map-detail-purpose">{{selectedPoint.purpose}}</view>
        <view class="selected-grid">
          <view wx:if="{{selectedPoint.hasElevation}}"><text>海拔</text><text>{{selectedPoint.elevationText}}</text></view>
          <view wx:if="{{selectedPoint.hasGrade}}"><text>附近坡度</text><text>{{selectedPoint.gradeText}}</text></view>
          <view wx:if="{{selectedPoint.hasCoordinate}}" class="coordinate-cell"><text>坐标</text><text class="coordinate-value">{{selectedPoint.coordinateText}}</text></view>
        </view>
        <view class="point-note" wx:if="{{selectedPoint.note}}">{{selectedPoint.note}}</view>
      </view>
    </view>

    <view class="analysis-card" wx:if="{{profileAvailable}}">
      <view class="section-head"><view><view class="section-eyebrow">ELEVATION</view><view class="section-title">海拔剖面与锚点</view></view><view class="section-count">{{keyPoints.length}} 点</view></view>
      <canvas id="route-analysis-elevation" type="2d" class="elevation-chart" aria-label="路线海拔剖面与当前选择"></canvas>
      <scroll-view class="anchor-strip" scroll-x enhanced show-scrollbar="{{false}}" aria-label="海拔关键锚点">
        <view class="anchor-strip-inner">
          <button class="anchor-item {{selectedPointId === point.id ? 'is-selected' : ''}}" wx:for="{{keyPoints}}" wx:for-item="point" wx:key="id" data-id="{{point.id}}" bindtap="selectPoint"><text>{{point.typeLabel}}</text><text>{{point.kmText}}</text></button>
        </view>
      </scroll-view>
    </view>

    <view class="analysis-card" wx:if="{{segments.length}}">
      <view class="section-head"><view><view class="section-eyebrow">SEGMENTS</view><view class="section-title">路线分段</view></view><view class="section-count">{{segments.length}} 段</view></view>
      <view class="segment-list">
        <button class="segment-item {{selectedSegmentId === segment.id ? 'is-selected' : ''}}" wx:for="{{segments}}" wx:for-item="segment" wx:key="id" data-id="{{segment.id}}" bindtap="selectSegment" aria-label="选择{{segment.name}}分段">
          <view class="segment-index">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</view>
          <view class="segment-content"><view class="segment-head"><text class="segment-name">{{segment.name}}</text><text class="difficulty difficulty--{{segment.difficulty}}">{{segment.difficulty}}</text></view><view class="segment-range">{{segment.rangeText}}<text wx:if="{{segment.hasGrade}}"> · {{segment.gradeText}}</text></view><view class="segment-change" wx:if="{{segment.hasChange}}">{{segment.changeText}}</view><view class="segment-strategy">{{segment.strategy}}</view></view>
        </button>
      </view>
    </view>

    <view class="analysis-card" wx:if="{{keyPoints.length}}">
      <view class="section-head"><view><view class="section-eyebrow">KEY POINTS</view><view class="section-title">关键公里点</view></view></view>
      <view class="point-list">
        <button class="point-item {{selectedPointId === point.id ? 'is-selected' : ''}}" wx:for="{{keyPoints}}" wx:for-item="point" wx:key="id" data-id="{{point.id}}" bindtap="selectPoint" aria-label="选择{{point.name}}">
          <view class="point-symbol">{{point.shortType}}</view><view class="point-main"><text class="point-name">{{point.name}}</text><text class="point-purpose">{{point.purpose}}</text></view><view class="point-metric"><text>{{point.kmText}}</text><text wx:if="{{point.hasElevation}}">{{point.elevationText}}</text></view>
        </button>
      </view>
    </view>

    <view class="analysis-card" wx:if="{{risks.length}}">
      <view class="section-head"><view><view class="section-eyebrow">RISK</view><view class="section-title">坡段风险</view></view></view>
      <view class="risk-row" wx:for="{{risks}}" wx:key="*this"><text>!</text><text>{{item}}</text></view>
    </view>

    <view class="analysis-card" wx:if="{{strategySummary.length}}">
      <view class="section-head"><view><view class="section-eyebrow">STRATEGY</view><view class="section-title">路线策略</view></view></view>
      <view class="strategy-row" wx:for="{{strategySummary}}" wx:key="*this"><text>{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text><text>{{item}}</text></view>
    </view>

    <view class="analysis-card equipment-card" wx:if="{{equipment.length}}">
      <view class="section-head"><view><view class="section-eyebrow">EQUIPMENT</view><view class="section-title">装备建议</view></view></view>
      <view class="equipment-row" wx:for="{{equipment}}" wx:key="*this"><text>✓</text><text>{{item}}</text></view>
    </view>
  </state-view>
</view>
