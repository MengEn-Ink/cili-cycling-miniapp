/* 骑行影像志 · 完整路线分析 1:1 实现
 * 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/route-analysis.html：
 *   pageheading → ink(metrics) → conclusion-panel → map.large → content(section × N) → actionbar
 */

.route-analysis-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

/* --- pageheading --------------------------------------------------------- */
.pageheading {
  padding: 32rpx 0 24rpx;
}

.pageheading-title {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-sub {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--font-size-body);
  line-height: 44rpx;
}
.pageheading-sub--secondary {
  margin-top: var(--space-1);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}

/* --- ink + metrics ------------------------------------------------------- */
.ink {
  padding: 32rpx 0;
  border-top: 2rpx solid var(--color-border);
  border-bottom: 2rpx solid var(--color-border);
  background: transparent;
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx 32rpx;
}
.metrics > view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.metrics .em {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 56rpx;
  line-height: 64rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}
.metrics .em .unit {
  color: var(--color-muted);
  font-family: var(--font-family-body);
  font-size: var(--font-size-label);
  font-weight: 600;
  letter-spacing: 1rpx;
}
.metrics text {
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}

/* --- 核心结论 panel ------------------------------------------------------ */
.conclusion-panel {
  margin-top: var(--space-5);
  padding: var(--space-5);
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-raised);
  color: var(--color-text);
}
.conclusion-label {
  color: var(--color-brand);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 2rpx;
  opacity: 0.76;
}
.conclusion-copy {
  margin-top: var(--space-2);
  font-family: var(--font-family-editorial);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 900;
  color: var(--color-on-action);
}
.conclusion-copy--secondary {
  font-size: 32rpx;
  line-height: 44rpx;
  opacity: 0.84;
}
.strategy-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}
.strategy-tags text {
  padding: 6rpx 16rpx;
  border: 2rpx solid var(--color-on-action);
  border-radius: var(--radius-full);
  color: var(--color-on-action);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
}

/* --- map.large ----------------------------------------------------------- */
.map.large {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-5);
  padding: var(--space-4);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.map-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
}

.chapterhead-title {
  flex: 1;
  font-family: var(--font-family-editorial);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 900;
}
.map-count {
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
}
.map-direction {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}
.map-reset {
  flex: none;
  padding: 6rpx 16rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-full);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: var(--font-size-label);
}
.map-reset::after {
  display: none;
}
.route-map {
  width: 100%;
  height: 560rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.map-fallback {
  flex-direction: column;
  align-items: stretch;
  gap: var(--space-2);
}
.map-fallback-copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  color: var(--color-text);
  font-size: var(--font-size-body);
}
.map-retry {
  width: 100%;
}
.map-legend {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.map-legend text {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 6rpx 14rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  color: var(--color-text);
  font-size: var(--font-size-label);
}
.legend-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-raised);
  color: var(--color-text);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
}
.map-detail,
.map-detail--start {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.map-detail-head {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
}
.point-type {
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
}
.point-computed {
  margin-left: var(--space-1);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: var(--font-size-label);
}
.selected-name {
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 900;
}
.selected-km {
  color: var(--color-brand);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-body);
  font-weight: 800;
}
.map-detail-purpose {
  color: var(--color-text);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}
.selected-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-2);
  margin-top: var(--space-1);
}
.selected-grid view {
  display: flex;
  flex-direction: column;
  color: var(--color-text);
  font-size: var(--font-size-label);
}
.selected-grid view text:first-child {
  color: var(--color-muted);
  font-size: var(--font-size-label);
}
.point-note {
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 34rpx;
}
.start-navigation-button {
  width: 100%;
}

/* --- content & section --------------------------------------------------- */
.content {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  margin-top: var(--space-6);
}
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.chapterhead .chapterhead-title {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: var(--font-size-title);
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-rule {
  flex: 1;
  min-width: 0;
  height: 2rpx;
  background: var(--color-border);
}
.chapterhead-aside {
  flex: none;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
}

/* --- elevation ----------------------------------------------------------- */
.elevation {
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}
.elevation-chart {
  display: block;
  width: 100%;
  height: 320rpx;
}
.anchor-strip {
  width: calc(100% + var(--page-gutter) * 2);
  margin: 16rpx calc(0rpx - var(--page-gutter)) 0;
  white-space: nowrap;
}
.anchor-strip-inner {
  display: inline-flex;
  gap: 10rpx;
  padding: 0 var(--page-gutter);
}
.anchor-item {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
  min-width: 128rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
  font-size: var(--font-size-label);
}
.anchor-item.is-selected {
  background: var(--color-raised);
  color: var(--color-text);
  border-color: var(--color-brand);
}
.anchor-computed {
  margin-left: 6rpx;
  color: var(--color-muted);
  font-size: var(--font-size-label);
}

/* --- segments ------------------------------------------------------------ */
.segments-hint {
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 34rpx;
}
.segment-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.segment-item {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr);
  gap: 20rpx;
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
}
.segment-item::after {
  display: none;
}
.segment-item.is-selected {
  border-color: var(--color-text);
  background: var(--color-raised);
}
.segment-index {
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-body);
  font-weight: 900;
}
.segment-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.segment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}
.segment-name {
  color: var(--color-text);
  font-size: var(--font-size-body);
  font-weight: 800;
}
.difficulty {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-label);
  background: var(--color-raised);
  color: var(--color-text);
}
.segment-range {
  color: var(--color-muted);
  font-size: var(--font-size-label);
}
.segment-change {
  color: var(--color-muted);
  font-size: var(--font-size-label);
}
.segment-strategy {
  color: var(--color-text);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}

/* --- point（关键公里点）------------------------------------------------- */
.point-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.point {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr);
  gap: 20rpx;
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
}
.point::after {
  display: none;
}
.point.is-selected {
  border-color: var(--color-text);
  background: var(--color-raised);
}
.distance {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  border-right: 2rpx dashed var(--color-border);
  color: var(--color-brand);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-body);
  line-height: 36rpx;
  font-weight: 900;
}
.distance text {
  color: var(--color-muted);
  font-size: var(--font-size-label);
  font-weight: 600;
}
.point-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.point-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.point-name {
  color: var(--color-text);
  font-size: var(--font-size-body);
  font-weight: 800;
}
.point-purpose {
  color: var(--color-muted);
  font-size: var(--font-size-label);
}
.point-elevation {
  color: var(--color-text);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
}

/* --- paper + risk + strategy + equipment -------------------------------- */
.paper {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-4);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}
.risk-row,
.strategy-row,
.equipment-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  color: var(--color-text);
  font-size: var(--font-size-body);
  line-height: 40rpx;
}
.risk-mark {
  color: var(--color-brand);
  font-weight: 900;
}
.strategy-row text:first-child {
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-weight: 900;
}
.check {
  flex: none;
  width: 10rpx;
  height: 18rpx;
  margin: 0 6rpx 6rpx 4rpx;
  border-right: 3.5rpx solid var(--color-brand);
  border-bottom: 3.5rpx solid var(--color-brand);
  transform: rotate(45deg);
}

/* --- notice -------------------------------------------------------------- */
.notice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: var(--space-2);
  border-radius: 50%;
  background: var(--color-text);
}
.notice--warning {
  border-style: solid;
  border-color: var(--color-status-warning);
  color: var(--color-status-warning);
}

/* --- btn + actionbar ---------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: var(--radius-full);
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: var(--font-size-body);
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn.secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-border);
}
.actionbar .btn {
  flex: 1;
}

.muted {
  color: var(--color-muted);
}

@media (max-width: 350px) {
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .metrics .em {
    font-size: 44rpx;
    line-height: 52rpx;
  }
}

/* Scheme B v6: dense analysis notebook ---------------------------------- */
.route-analysis-page .pageheading {
  padding: 24rpx 0 18rpx;
}

.route-analysis-page .pageheading-title {
  margin-top: 10rpx;
  font-size: 52rpx;
  line-height: 60rpx;
  letter-spacing: -1rpx;
}
.route-analysis-page .pageheading-sub {
  margin-top: var(--space-1);
  font-size: var(--font-size-label);
  line-height: 34rpx;
}
.route-analysis-page .pageheading-meta {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
}
.route-analysis-page .ink {
  padding: 18rpx;
  border-radius: var(--radius-sm);
}
.route-analysis-page .metrics {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-1);
}
.route-analysis-page .metrics .em {
  gap: 2rpx;
  font-family: var(--font-family-body);
  font-size: 30rpx;
  line-height: 40rpx;
  letter-spacing: 0;
}
.route-analysis-page .metrics .em .unit,
.route-analysis-page .metrics text {
  font-size: var(--font-size-label);
  line-height: 28rpx;
}
.route-analysis-page .conclusion-panel {
  margin-top: var(--space-3);
  padding: 20rpx;
  border-radius: var(--radius-sm);
}
.route-analysis-page .conclusion-copy {
  margin-top: var(--space-1);
  font-family: var(--font-family-body);
  font-size: var(--font-size-body);
  line-height: 40rpx;
}
.route-analysis-page .conclusion-copy--secondary {
  font-size: var(--font-size-label);
  line-height: 34rpx;
}
.route-analysis-page .strategy-tags {
  margin-top: var(--space-2);
}
.route-analysis-page .strategy-tags text {
  padding: 4rpx 10rpx;
  font-size: var(--font-size-label);
}
.route-analysis-page .map.large {
  gap: 10rpx;
  margin-top: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-sm);
}
.route-analysis-page .map-head {
  flex-wrap: wrap;
}
.route-analysis-page .map-head .chapterhead-title {
  font-family: var(--font-family-body);
  font-size: var(--font-size-body);
  line-height: 38rpx;
}
.route-analysis-page .map-direction {
  font-size: var(--font-size-label);
  line-height: 30rpx;
}
.route-analysis-page .map-reset {
  min-height: 56rpx;
  padding: 0 14rpx;
}
.route-analysis-page .route-map {
  height: 440rpx;
  border-radius: var(--radius-xs);
}
.route-analysis-page .map-detail,
.route-analysis-page .map-detail--start {
  padding: 14rpx;
  border-radius: var(--radius-xs);
}
.route-analysis-page .content {
  gap: var(--space-5);
  margin-top: 28rpx;
}
.route-analysis-page .section {
  gap: var(--space-2);
}
.route-analysis-page .chapterhead .chapterhead-title {
  font-family: var(--font-family-body);
  font-size: 30rpx;
  line-height: 40rpx;
}
.route-analysis-page .elevation,
.route-analysis-page .paper {
  padding: var(--space-3);
  border-radius: var(--radius-sm);
}
.route-analysis-page .elevation-chart {
  height: 260rpx;
}
.route-analysis-page .anchor-item,
.route-analysis-page .segment-item,
.route-analysis-page .point {
  min-height: 88rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
}
.route-analysis-page .segment-item,
.route-analysis-page .point {
  padding: var(--space-3);
}
.route-analysis-page .actionbar .btn {
  border-radius: 10rpx;
}
