<view class="page registrations-page">
  <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{refreshing ? '正在刷新行程' : ''}}</view>
  <view class="a11y-live-region" role="alert" aria-live="assertive" aria-atomic="true">{{refreshError}}</view>
  <brand-logo compact="{{true}}" meta="我的行程" />
  <view class="page-heading"><view><view class="heading-title">我的行程</view><view class="heading-copy">报名进度、出发凭证都在这里</view></view><view class="heading-count"><text class="count-value">{{items.length}}</text><text>条</text></view></view>
  <view class="trip-stats" wx:if="{{items.length}}" aria-label="行程状态统计">
    <view class="trip-stat trip-stat--review"><text class="trip-stat__value">{{statusCounts.review}}</text><text class="trip-stat__label">审核中</text></view>
    <view class="trip-stat trip-stat--ready"><text class="trip-stat__value">{{statusCounts.ready}}</text><text class="trip-stat__label">可出发</text></view>
    <view class="trip-stat trip-stat--expired"><text class="trip-stat__value">{{statusCounts.expired}}</text><text class="trip-stat__label">已失效</text></view>
  </view>
  <view class="refresh-note" wx:if="{{refreshing}}" aria-hidden="true">正在刷新行程…</view>
  <view class="refresh-note refresh-error" wx:if="{{refreshError}}" aria-hidden="true">{{refreshError}}</view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-title="暂无行程" empty-copy="去发现一场活动，报名后可在这里查看进度" retryable="{{true}}" bind:retry="load">
    <view class="registration-list">
      <view class="registration-card status-{{item.status}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open" hover-class="registration-card--pressed" role="button" aria-label="{{item.activity.title}}，{{item.displayStatusText}}，{{item.destinationLabel}}">
        <view class="card-head"><text class="card-index">{{item.activity.displayDate}}</text><status-pill status="{{item.displayStatusText}}"/></view>
        <view class="registration-title">{{item.activity.title}}</view>
        <view class="registration-meta"><text wx:if="{{item.gatheringMode}}" class="gathering-mode">{{item.gatheringMode}}</text><text class="updated-at">更新于 {{item.updatedAt}}</text></view>
        <view class="card-footer"><view class="status-guidance"><text class="status-dot"></text><text>{{item.statusGuidance}}</text></view><text class="open-link">{{item.destinationLabel}} <text class="arrow">›</text></text></view>
      </view>
    </view>
  </state-view>
</view>
