<!--
  骑行影像志 · 我的行程（1:1 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/registrations.html）
  - 骨架：pageheading(宋体标题) → content.tight(section × 骑行票据 ticket + 空状态/刷新/骨架) → tabbar
  - 真实业务保留：状态计数 statsCounts、骨架、刷新错误、cancelled 左滑删除、open/confirmDelete、state-view loading/error/empty/retry、deletingId
-->
<view class="page registrations-page cinema-page cinema-page--dark" data-v1-layout="content" style="padding-top: {{navigationTopPx}}px">
  <view class="custom-nav-title" style="top: {{navigationTopPx - 44}}px">我的行程</view>
  <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{refreshing ? '正在刷新行程' : ''}}</view>
  <view class="a11y-live-region" role="alert" aria-live="assertive" aria-atomic="true">{{refreshError}}</view>

  <view class="pageheading">
    <view class="eyebrow">此里 · 骑行日历</view>
    <view class="pageheading-title editorial">
      <text class="pageheading-line">每次出发，</text>
      <text class="pageheading-line">都有一张记忆。</text>
    </view>
    <view class="pageheading-sub">在这里确认报名状态与集合安排。</view>
    <view class="pageheading-meta" wx:if="{{loading && !items.length}}" role="status">同步中</view>
    <view class="pageheading-meta" wx:else role="status">共 {{items.length}} 场</view>
  </view>

  <view class="content tight">
    <view class="trip-stats" wx:if="{{items.length}}" role="list" aria-label="行程票据状态统计">
      <view wx:if="{{statusCounts.review > 0}}" class="trip-stat trip-stat--review" role="listitem"><text class="trip-stat__value">{{statusCounts.review}}</text><text class="trip-stat__label">审核中</text></view>
      <view wx:else class="trip-stat" role="listitem"><text class="trip-stat__value">0</text><text class="trip-stat__label">审核中</text></view>
      <view class="trip-stat trip-stat--ready" role="listitem"><text class="trip-stat__value">{{statusCounts.ready}}</text><text class="trip-stat__label">可出发</text></view>
      <view class="trip-stat trip-stat--expired" role="listitem"><text class="trip-stat__value">{{statusCounts.expired}}</text><text class="trip-stat__label">已失效</text></view>
    </view>

    <view class="refresh-note" wx:if="{{refreshing}}" aria-hidden="true">正在刷新行程…</view>
    <view class="refresh-note refresh-error" wx:if="{{refreshError}}" aria-hidden="true">{{refreshError}}</view>

    <view class="trip-skeleton" wx:if="{{loading && !items.length}}" role="status" aria-label="正在同步行程数据">
      <view class="trip-skeleton__card"><view></view><view></view><view></view><view></view></view>
      <view class="trip-skeleton__card"><view></view><view></view><view></view></view>
    </view>

    <state-view wx:else loading="{{false}}" error="{{error}}" empty="{{!items.length}}" empty-title="暂无行程" empty-copy="去发现一场活动，报名后可在这里查看进度" retryable="{{true}}" bind:retry="load">
      <view class="section section-trips">
        <view class="chapterhead">
          <view class="chapterhead-title">我的行程</view>
          <view class="chapterhead-rule" aria-hidden="true"></view>
          <view class="chapterhead-aside">骑行票据</view>
        </view>

        <view class="trip-list" role="list" aria-label="我的报名票据">
          <view class="swipe-row" wx:for="{{items}}" wx:key="id" role="listitem">
            <view wx:if="{{item.status === 'cancelled'}}" class="swipe-delete" data-id="{{item.id}}" catchtap="confirmDelete" role="button" aria-label="删除已取消的行程：{{item.activity.title}}">
              <text class="swipe-delete__icon" aria-hidden="true">×</text>
              <text>{{deletingId === item.id ? '删除中' : '删除记录'}}</text>
            </view>
            <view class="ticket status-{{item.status}}" style="transform: translateX({{item.swipeX}}px)" data-id="{{item.id}}" bindtap="open" bindtouchstart="onRowTouchStart" bindtouchmove="onRowTouchMove" bindtouchend="onRowTouchEnd" bindtouchcancel="onRowTouchCancel" hover-class="ticket--pressed" role="button" aria-label="{{item.activity.title}}，票据状态{{item.displayStatusText}}，{{item.destinationLabel}}">
              <view class="photo ticketphoto">
                <generated-activity-cover item="{{item.activity}}" variant="card" />
                <view class="shade" aria-hidden="true"></view>
              </view>
              <view class="ticketbody">
                <view class="ticket-row-top">
                  <text class="tag ticket-tag status-{{item.status}}">{{item.displayStatusText}}</text>
                  <text class="muted ticket-index">{{item.activity.displayDate}}</text>
                </view>
                <view class="ticket-title">{{item.activity.title}}</view>
                <view class="club-identity" aria-label="活动归属：{{item.activity.clubIdentity.name}}">
                  <image wx:if="{{item.activity.clubIdentity.avatarUrl}}" class="club-avatar" src="{{item.activity.clubIdentity.avatarUrl}}" mode="aspectFill" />
                  <view wx:else class="club-avatar club-avatar--placeholder">此</view>
                  <text>{{item.activity.clubIdentity.name}}</text>
                </view>
                <view class="row ticket-row">
                  <view class="lead">
                    <view class="rowicon rowicon--pin" aria-hidden="true"></view>
                    <view>
                      <text class="em">{{item.meetingLocation}}</text>
                      <text class="sub">集合时间 · {{item.meetingTime}}</text>
                    </view>
                  </view>
                </view>
                <view class="ticket-meta" wx:if="{{item.gatheringMode}}">
                  <text class="ticket-meta__label">集合方式</text>
                  <text class="gathering-mode">{{item.gatheringMode}}</text>
                </view>
                <view class="status-guidance" role="status">
                  <text class="status-dot" aria-hidden="true"></text>
                  <text>{{item.statusGuidance}}</text>
                </view>
              </view>
              <view class="ticketfooter">
                <text class="muted" wx:if="{{item.status !== 'cancelled'}}">{{item.statusGuidance}}</text>
                <text class="muted" wx:else>可左滑或点击删除记录</text>
                <view class="ticket-actions">
                  <button wx:if="{{item.status === 'cancelled'}}" class="btn tiny secondary delete-record-button" data-id="{{item.id}}" catchtap="confirmDelete" loading="{{deletingId === item.id}}" aria-label="删除行程记录：{{item.activity.title}}"><view class="hit-pad" aria-hidden="true"></view>删除记录</button>
                  <button class="btn tiny {{item.status === 'approved' || item.status === 'checked_in' ? '' : 'secondary'}} trip-action" data-id="{{item.id}}" catchtap="open" aria-label="{{item.destinationLabel}}：{{item.activity.title}}">
                    <view class="hit-pad" aria-hidden="true"></view>
                    {{item.destinationLabel}}
                    <text class="chev" aria-hidden="true"></text>
                  </button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </state-view>
  </view>

</view>
