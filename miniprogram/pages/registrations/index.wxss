/* AI Hero trip tickets. Shared layout owns typography and borders; swipe/status mechanics stay local. */
.registrations-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.trip-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.trip-stat__value,
.trip-stat__label {
  display: block;
}
.trip-stat__label {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.trip-stat--review .trip-stat__value {
  color: var(--color-status-warning);
}
.trip-stat--expired .trip-stat__value {
  color: var(--color-muted);
}
.refresh-note {
  margin-top: 24rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}
.refresh-error {
  color: var(--color-status-warning);
}
.trip-skeleton {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.trip-skeleton__card {
  padding: 28rpx;
  border: 1px solid var(--color-border);
  border-radius: 22rpx;
  background: var(--color-surface);
}
.trip-skeleton__card view {
  height: 32rpx;
  margin-top: 20rpx;
  background: var(--color-raised);
}
.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 22rpx;
}
.swipe-delete {
  position: absolute;
  top: 28rpx;
  right: 0;
  bottom: 0;
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
  font-size: 26rpx;
}
.swipe-delete__icon {
  font-size: 44rpx;
}
.ticket {
  position: relative;
  transition: transform 0.18s ease;
  box-shadow: none;
}
.ticket--pressed {
  opacity: 0.9;
}
.ticket-row-top {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  justify-content: space-between;
}
.ticket-tag {
  padding: 8rpx 16rpx;
  border: 1px solid var(--color-border);
  border-radius: 12rpx;
  font-size: 24rpx;
  background: var(--color-raised);
  color: var(--color-text);
}
.status-pending .ticket-tag,
.status-waiting .ticket-tag {
  color: var(--color-status-warning);
  background: var(--color-status-warning-soft);
}
.status-approved .ticket-tag,
.status-checked_in .ticket-tag {
  color: var(--color-status-success);
  background: var(--color-status-success-soft);
}
.status-rejected .ticket-tag,
.status-cancelled .ticket-tag {
  color: var(--color-muted);
}
.ticket-index {
  font-family: var(--font-family-mono);
  font-size: 24rpx;
  color: var(--color-muted);
}
.ticketbody {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.ticketphoto {
  position: relative;
  overflow: hidden;
  background: var(--color-media-placeholder-bg);
}
.ticketphoto generated-activity-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.ticketphoto .shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--color-scrim-soft);
}
.club-identity {
  display: flex;
  gap: 12rpx;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-muted);
}
.club-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex: none;
  background: var(--color-raised);
}
.club-avatar--placeholder {
  color: var(--color-text);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ticket-row .em,
.ticket-row .sub {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
}
.ticket-row .sub {
  font-size: 24rpx;
  color: var(--color-muted);
}
.ticket-meta,
.status-guidance {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}
.ticketfooter .muted {
  flex: 1;
  min-width: 160rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.ticket-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ticket-actions .btn {
  margin: 0;
  padding: 12rpx 20rpx;
}
@import '../../styles/aihero-layout.wxss';
