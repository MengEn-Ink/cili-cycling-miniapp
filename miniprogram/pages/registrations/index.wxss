page {
  background: var(--color-bg);
}

.page.registrations-page {
  --page-gutter: 48rpx;
  min-height: 100%;
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
  overflow-x: hidden;
  background: var(--color-bg);
  color: var(--color-text);
}

brand-logo {
  display: block;
  padding: 8rpx 0 12rpx;
  border-bottom: 2rpx solid var(--color-text);
}

.page-heading {
  display: flex;
  padding: 26rpx 0 20rpx;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.heading-title {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 0;
}

.heading-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.heading-count {
  display: flex;
  align-items: baseline;
  flex: 0 0 auto;
  gap: 5rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.count-value {
  color: var(--color-text);
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.trip-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 16rpx;
  background: var(--color-text);
  color: var(--color-on-action);
}

.trip-stat {
  display: flex;
  min-height: 116rpx;
  padding: 16rpx 8rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.trip-stat + .trip-stat {
  border-left: 1rpx solid rgba(255, 255, 255, 0.28);
}

.trip-stat__value {
  color: var(--color-on-action);
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.trip-stat--review .trip-stat__value {
  color: var(--color-brand);
}

.trip-stat__label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  font-weight: 700;
}

.refresh-note {
  margin: 0 2rpx 12rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  overflow-wrap: anywhere;
}

.refresh-error {
  color: var(--color-text);
  font-weight: 800;
}

.registration-list {
  display: grid;
  gap: var(--card-gap);
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.registration-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  padding: 32rpx;
  border-width: 4rpx;
  border-style: solid;
  border-color: var(--color-card-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-card);
  transition:
    transform 160ms ease-out,
    opacity 160ms ease-out;
}

.registration-card.status-waiting,
.registration-card.status-pending,
.registration-card.status-approved,
.registration-card.status-checked_in,
.registration-card.status-rejected,
.registration-card.status-cancelled {
  background: var(--color-surface);
}

.registration-card.status-waiting,
.registration-card.status-pending {
  border-color: var(--color-brand);
}

.registration-card--pressed {
  opacity: 0.9;
  transform: scale(0.988);
}

.card-head,
.registration-meta,
.card-footer {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.card-index {
  color: var(--color-muted);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}

.registration-title {
  display: -webkit-box;
  margin: 18rpx 0 14rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.meeting-panel {
  position: relative;
  display: grid;
  gap: 14rpx;
  padding: 22rpx 22rpx 22rpx 28rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--color-text);
  color: var(--color-on-action);
}

.meeting-panel::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 8rpx;
  background: var(--color-brand);
  content: '';
}

.meeting-row {
  display: grid;
  min-width: 0;
  grid-template-columns: 112rpx minmax(0, 1fr);
  align-items: start;
  gap: 16rpx;
}

.meeting-label {
  color: var(--color-media-muted);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.5;
}

.meeting-value {
  min-width: 0;
  color: var(--color-on-action);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.registration-meta {
  margin-top: 14rpx;
  justify-content: flex-start;
  flex-wrap: wrap;
  color: var(--color-muted);
  font-size: 21rpx;
}

.gathering-mode {
  padding: 5rpx 12rpx;
  border: 1rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 700;
}

.card-footer {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: 21rpx;
}

.status-guidance {
  display: flex;
  min-width: 0;
  align-items: center;
  color: var(--color-muted);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--color-text);
}

.status-waiting .status-dot,
.status-pending .status-dot {
  background: var(--color-brand);
}

.open-link {
  flex: 0 0 auto;
  color: var(--color-text);
  font-weight: 900;
  white-space: nowrap;
}

.arrow {
  color: var(--color-brand);
  font-size: 30rpx;
}

.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  width: 75px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 21rpx;
  font-weight: 800;
}

.swipe-delete__icon {
  color: var(--color-brand);
  font-size: 34rpx;
  line-height: 1;
}

.delete-record-button {
  min-height: 56rpx;
  margin: 0 0 0 auto;
  padding: 0 18rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.delete-record-button::after {
  border: 0;
}

@media (max-width: 340px) {
  .heading-title {
    font-size: 42rpx;
  }

  .registration-card {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .status-guidance {
    max-width: 52%;
  }
}

@media (max-width: 320px) {
  .page.registrations-page {
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }

  .card-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  .registration-card {
    transition: none;
  }

  .registration-card--pressed {
    transform: none;
  }
}
