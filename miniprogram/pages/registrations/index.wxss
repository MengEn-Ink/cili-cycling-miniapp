page {
  background: #0b0b0c;
}
.registrations-page {
  min-height: 100vh;
  background: radial-gradient(circle at 94% 3%, rgba(213, 91, 31, 0.13), transparent 32%), #0b0b0c;
  color: #f7f7f5;
}
brand-logo {
  display: block;
  padding: 16rpx 8rpx 26rpx;
  border-bottom: 1rpx solid #343437;
}
.page-heading {
  padding: 12rpx 8rpx 20rpx;
}
.page-heading .hero-kicker {
  color: #d55b1f;
  font-style: italic;
  font-weight: 900;
}
.heading-title {
  margin: 4rpx 0 8rpx;
  font-size: 58rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: -2rpx;
}
.heading-meta {
  color: #79797c;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.registration-card {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  padding: 26rpx 26rpx 24rpx;
  border: 1rpx solid #505054;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #202023, #151517);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.3);
}
.registration-card--pressed {
  transform: scale(0.988);
  border-color: #d55b1f;
  background: #242426;
}
.card-index {
  margin-bottom: 20rpx;
  color: #7f7f83;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}
.card-head {
  align-items: flex-start;
}
.date {
  color: #f38a50;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  letter-spacing: 1rpx;
}
.registration-title {
  max-width: 92%;
  margin: 22rpx 0 28rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
}
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #3b3b3e;
  font-size: 22rpx;
}
.updated-at {
  color: #858589;
}
.open-link {
  flex: 0 0 auto;
  color: #f7f7f5;
  font-weight: 800;
}
.arrow {
  color: #d55b1f;
  font-size: 30rpx;
}
.corner-cut {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 34rpx;
  height: 34rpx;
  background: #d55b1f;
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}
