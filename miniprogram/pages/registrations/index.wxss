.registrations-page {
  background: var(--color-bg);
}
.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.heading-copy,
.heading-count {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.heading-count {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.trip-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 24rpx 0;
}
.trip-stat {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
}
.trip-stat + .trip-stat {
  border-left: 2rpx solid var(--color-subtle);
}
.trip-stat__value {
  position: relative;
  color: var(--color-on-media);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
}
.trip-stat--review .trip-stat__value:not(:empty)::after {
  position: absolute;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: 8rpx;
  border-radius: 4rpx;
  background: var(--color-brand);
  content: '';
}
.trip-stat__label {
  color: var(--color-media-muted);
  font-size: 24rpx;
}
.registration-list {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
}
.swipe-row {
  position: relative;
}
.swipe-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  border-radius: var(--radius-card);
  background: var(--color-action);
  color: var(--color-on-action);
}
.registration-card {
  position: relative;
  z-index: 1;
  margin-top: 0;
  transition: transform 0.2s ease-out;
}
.registration-card--pressed {
  background: var(--color-raised);
}
.card-head,
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.card-index {
  color: var(--color-muted);
  font-size: 24rpx;
}
.registration-title {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.meeting-panel {
  margin: 24rpx -32rpx 0;
  border-radius: 0;
}
.meeting-row {
  border-color: var(--color-subtle);
}
.meeting-label {
  color: var(--color-media-muted);
}
.meeting-value {
  color: var(--color-on-media);
  font-weight: 800;
}
.registration-meta {
  margin-top: 16rpx;
}
.gathering-mode {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
  font-size: 24rpx;
}
.card-footer {
  flex-wrap: wrap;
  min-height: 88rpx;
  margin-top: 16rpx;
}
.status-guidance {
  flex: 1 1 240rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.trip-action {
  flex: 0 0 auto;
  min-width: 192rpx;
  min-height: var(--control-height);
  margin: 0;
}
.delete-record-button {
  min-height: 72rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
}
