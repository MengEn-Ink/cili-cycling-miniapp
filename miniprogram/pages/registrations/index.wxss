page {
  background: #0b0b0c;
}

.registrations-page {
  min-height: 100vh;
  overflow-x: hidden;
  background: #0b0b0c;
  color: #f7f7f5;
}

brand-logo {
  display: block;
  padding: 10rpx 4rpx 14rpx;
  border-bottom: 1rpx solid #343437;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 4rpx 14rpx;
}

.page-heading .hero-kicker {
  color: #d55b1f;
  font-size: 19rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.heading-title {
  margin-top: 1rpx;
  font-size: 46rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: -2rpx;
}

.heading-count {
  display: flex;
  align-items: baseline;
  flex: 0 0 auto;
  gap: 6rpx;
  color: #929297;
  font-size: 20rpx;
}

.count-value {
  color: #f7f7f5;
  font-size: 32rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.refresh-note {
  margin: 0 4rpx 10rpx;
  color: #a8a8ad;
  font-size: 21rpx;
  overflow-wrap: anywhere;
}

.refresh-error {
  color: #ff8f86;
}

.registration-list {
  display: grid;
  gap: 12rpx;
}

.registration-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  padding: 18rpx 20rpx 15rpx;
  border: 1rpx solid #45454a;
  border-left: 5rpx solid #76767c;
  border-radius: 10rpx;
  background: #202023;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.24);
}

.registration-card.status-pending {
  border-left-color: #d59a3a;
}

.registration-card.status-approved {
  border-left-color: #6f9b82;
}

.registration-card.status-rejected,
.registration-card.status-cancelled {
  border-left-color: #c85049;
}

.registration-card--pressed {
  transform: scale(0.988);
  border-color: #d55b1f;
  background: #242427;
}

.card-main {
  min-width: 0;
}

.card-head,
.registration-meta,
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
}

.card-index {
  color: #9b9ba0;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.registration-title {
  display: -webkit-box;
  margin: 9rpx 0 8rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.registration-meta {
  justify-content: flex-start;
  flex-wrap: wrap;
  color: #b6b6ba;
  font-size: 21rpx;
}

.date {
  color: #f38a50;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.gathering-mode::before {
  margin-right: 14rpx;
  color: #626268;
  content: '·';
}

.card-footer {
  margin-top: 12rpx;
  padding-top: 11rpx;
  border-top: 1rpx solid #3b3b3e;
  font-size: 20rpx;
}

.updated-at {
  min-width: 0;
  overflow: hidden;
  color: #9b9ba0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.open-link {
  flex: 0 0 auto;
  color: #f7f7f5;
  font-weight: 800;
  white-space: nowrap;
}

.arrow {
  color: #d55b1f;
  font-size: 28rpx;
}

.corner-cut {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 24rpx;
  height: 24rpx;
  background: #d55b1f;
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}

@media (max-width: 340px) {
  .heading-title {
    font-size: 40rpx;
  }

  .registration-card {
    padding-right: 16rpx;
    padding-left: 16rpx;
  }

  .updated-at {
    max-width: 72%;
  }
}
