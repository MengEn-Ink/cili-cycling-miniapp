.registrations-page {
  background: var(--color-bg);
}
.page-heading,
.heading-main,
.ticket-head,
.ticket-date,
.registration-card,
.meeting-row,
.ticket-meta,
.status-guidance,
.card-actions {
  min-width: 0;
}
.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.heading-main {
  flex: 1;
}
.heading-copy,
.heading-count {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.heading-count {
  flex: 0 0 auto;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.trip-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
}
.trip-stat {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  min-height: 124rpx;
  padding: 20rpx 12rpx;
  border-radius: 32rpx;
  background: var(--color-surface);
  text-align: center;
}
.trip-stat--ready {
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.trip-stat__label {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 32rpx;
}
.trip-stat--ready .trip-stat__label {
  color: var(--color-media-muted);
}
.trip-stat__value {
  position: relative;
  color: currentColor;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.trip-stat--review .trip-stat__value:not(:empty)::after {
  position: absolute;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: 8rpx;
  border-radius: 4rpx;
  background: var(--color-brand);
  content: '';
}
.registration-list {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
}
.swipe-row {
  position: relative;
  min-width: 0;
}
.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  min-height: var(--control-height);
  border-radius: 999rpx;
  background: var(--color-action);
  color: var(--color-on-action);
}
.registration-card {
  position: relative;
  z-index: 1;
  margin-top: 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: none;
  transition: transform 0.2s ease-out;
}
.registration-card--pressed {
  opacity: 0.92;
}
.status-cancelled {
  opacity: 0.92;
}
.ticket-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 16rpx;
  min-height: 112rpx;
  padding: 24rpx 32rpx;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.status-cancelled .ticket-head {
  background: var(--color-muted);
}
.ticket-body {
  padding: 24rpx 32rpx 32rpx;
}
.ticket-label {
  color: currentColor;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.card-index {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.registration-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--color-text);
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.meeting-panel {
  margin: 24rpx 0 0;
  padding: 20rpx 28rpx;
  border: 0;
  border-radius: 28rpx;
  background: var(--color-bg);
  color: var(--color-text);
}
.meeting-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-height: var(--control-height);
  padding: 0;
  border: 0;
}
.meeting-row + .meeting-row {
  margin-top: 8rpx;
}
.meeting-label {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.meeting-value {
  min-width: 0;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}
.meeting-location {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.ticket-meta {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  min-height: 64rpx;
  margin-top: 16rpx;
}
.ticket-meta__label {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: 24rpx;
}
.gathering-mode {
  min-width: 0;
  font-size: 24rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}
.status-guidance {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.status-dot {
  flex: 0 0 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-brand-active);
}
.card-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 24rpx;
}
.card-actions > button:only-child {
  grid-column: 1 / -1;
}
.trip-action,
.delete-record-button {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: var(--control-height);
  margin: 0;
  padding: 0 16rpx;
  border: 3rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.delete-record-button {
  border-color: var(--color-brand-active);
  color: var(--color-brand-active);
}
.trip-action--primary {
  border-color: var(--color-action);
  background: var(--color-action);
  color: var(--color-on-action);
}
.trip-skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
  animation: trip-skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.trip-skeleton__stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.trip-skeleton__stats view,
.trip-skeleton__card view {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.trip-skeleton__card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.trip-skeleton__card view:first-child {
  width: 44%;
}
.trip-skeleton__card view:nth-child(2) {
  width: 72%;
  height: 48rpx;
}
.trip-skeleton__card view:last-child {
  width: 58%;
}
@keyframes trip-skeleton-pulse {
  from {
    opacity: 0.55;
  }
  to {
    opacity: 1;
  }
}
@media (max-width: 340px) {
  .heading-title {
    font-size: 40rpx;
    line-height: 56rpx;
  }
  .trip-stats {
    gap: 12rpx;
  }
  .trip-stat {
    min-height: 116rpx;
    padding: 16rpx 8rpx;
  }
  .trip-stat__value {
    font-size: 40rpx;
    line-height: 52rpx;
  }
  .ticket-head {
    gap: 10rpx;
    padding: 22rpx 24rpx;
  }
  .ticket-body {
    padding: 24rpx;
  }
  .meeting-row {
    gap: 8rpx;
  }
  .card-actions {
    gap: 12rpx;
  }
  .trip-action,
  .delete-record-button {
    padding: 0 8rpx;
    font-size: 26rpx;
  }
}
@media (prefers-reduced-motion: reduce) {
  .registration-card,
  .trip-skeleton {
    transition: none;
    animation: none;
  }
}
