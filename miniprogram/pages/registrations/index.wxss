page {
  background: var(--color-bg);
}
.page.registrations-page {
  --v31-accent: var(--color-brand);
  --v31-charcoal: var(--color-text);
  --v31-warm-gray: var(--color-bg);
  --v31-line: var(--color-border);
  --color-bg: var(--v31-warm-gray);
  --color-surface: #ffffff;
  --color-raised: #f1ede7;
  --color-text: var(--v31-charcoal);
  --color-muted: #68645e;
  --color-border: var(--v31-line);
  --color-card-border: var(--v31-line);
  --shadow-card: 0 12rpx 32rpx rgba(39, 35, 30, 0.1);
  min-height: 100%;
  overflow-x: hidden;
  background: var(--color-bg);
  color: var(--color-text);
}
brand-logo {
  display: block;
  padding: 8rpx 0 12rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0 20rpx;
}
.heading-title {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 0;
}
.heading-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}
.heading-count {
  display: flex;
  align-items: baseline;
  flex: 0 0 auto;
  gap: 5rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}
.count-value {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.trip-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(39, 35, 30, 0.08);
}
.trip-stat {
  display: flex;
  min-height: 116rpx;
  padding: 16rpx 8rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.trip-stat + .trip-stat {
  border-left: 1rpx solid var(--color-border);
}
.trip-stat__value {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.trip-stat__label {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 700;
}
.trip-stat--review .trip-stat__value {
  color: #b84b20;
}
.trip-stat--ready .trip-stat__value {
  color: #2e6747;
}
.refresh-note {
  margin: 0 2rpx 12rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  overflow-wrap: anywhere;
}
.refresh-error {
  color: var(--color-danger-text);
}
.registration-list {
  display: grid;
  gap: var(--card-gap);
}
.registration-card {
  --status-color: #827d75;
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  padding: 32rpx;
  border-width: 4rpx;
  border-style: solid;
  border-color: var(--color-card-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-card);
  transition:
    transform 160ms ease-out,
    opacity 160ms ease-out;
}
.registration-card.status-waiting,
.registration-card.status-pending {
  --status-color: #dd692f;
}
.registration-card.status-approved {
  --status-color: #2e6747;
}
.registration-card.status-checked_in {
  --status-color: var(--color-text);
}
.registration-card.status-rejected {
  --status-color: #b43b32;
}
.registration-card.status-cancelled {
  --status-color: #827d75;
}
.registration-card--pressed {
  opacity: 0.9;
  transform: scale(0.988);
}
.card-head,
.registration-meta,
.card-footer {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}
.card-index {
  color: var(--color-muted);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
  letter-spacing: 0;
}
.registration-title {
  display: -webkit-box;
  margin: 18rpx 0 14rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.meeting-panel {
  display: grid;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid var(--v31-accent);
  border-radius: 20rpx;
  background: #f8f2ec;
}
.meeting-row {
  display: grid;
  min-width: 0;
  grid-template-columns: 112rpx minmax(0, 1fr);
  align-items: start;
  gap: 16rpx;
}
.meeting-label {
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.5;
}
.meeting-value {
  min-width: 0;
  color: var(--color-text);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.registration-meta {
  margin-top: 14rpx;
  justify-content: flex-start;
  flex-wrap: wrap;
  color: var(--color-muted);
  font-size: 21rpx;
}
.gathering-mode {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-raised);
  color: var(--color-text);
  font-weight: 700;
}
.card-footer {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: 21rpx;
}
.status-guidance {
  display: flex;
  min-width: 0;
  align-items: center;
  color: var(--color-muted);
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--status-color);
}
.open-link {
  flex: 0 0 auto;
  color: var(--color-text);
  font-weight: 900;
  white-space: nowrap;
}
.arrow {
  color: var(--v31-accent);
  font-size: 30rpx;
}
.page.registrations-page {
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
}
@media (max-width: 340px) {
  .heading-title {
    font-size: 42rpx;
  }
  .registration-card {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
  .status-guidance {
    max-width: 52%;
  }
}
@media (max-width: 320px) {
  .page.registrations-page {
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }
  .card-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}
@media (prefers-reduced-motion: reduce) {
  .registration-card {
    transition: none;
  }
  .registration-card--pressed {
    transform: none;
  }
}

/* 行程状态语义：低饱和浅色背景保留正文对比度。 */
.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
}
.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  width: 75px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--color-danger);
  color: var(--color-on-action);
  font-size: 21rpx;
  font-weight: 800;
}
.swipe-delete__icon {
  font-size: 34rpx;
  line-height: 1;
}
.registration-card.status-waiting {
  background: #fff6df;
}
.registration-card.status-pending {
  background: #edf5ff;
}
.registration-card.status-approved {
  background: #eaf7ee;
}
.registration-card.status-checked_in {
  background: #e9f4f2;
}
.registration-card.status-rejected {
  background: #fff0ef;
}
.registration-card.status-cancelled {
  background: #f2f0ec;
}
.delete-record-button {
  min-height: 56rpx;
  margin: 0 0 0 auto;
  padding: 0 18rpx;
  border: 2rpx solid var(--color-danger);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-danger-text);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 52rpx;
}
.delete-record-button::after {
  border: 0;
}
