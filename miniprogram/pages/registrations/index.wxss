.registrations-page {
  background: var(--color-bg);
}
.page-heading,
.heading-main,
.ticket-head,
.ticket-date,
.registration-card,
.meeting-row,
.ticket-meta,
.status-guidance,
.card-actions {
  min-width: 0;
}
.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.heading-main {
  flex: 1;
}
.heading-copy,
.heading-count {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.heading-count {
  flex: 0 0 auto;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.trip-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  padding: 24rpx 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
}
.trip-stat {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
  padding: 0 32rpx;
  text-align: center;
}
.trip-stat + .trip-stat {
  border-left: 2rpx solid var(--color-border);
}
.trip-stat__label {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 32rpx;
}
.trip-stat__value {
  position: relative;
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.trip-stat--review .trip-stat__value:not(:empty)::after {
  position: absolute;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: 8rpx;
  border-radius: 4rpx;
  background: var(--color-brand);
  content: '';
}
.registration-list {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
}
.swipe-row {
  position: relative;
  min-width: 0;
}
.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  min-height: var(--control-height);
  border-radius: 999rpx;
  background: var(--color-action);
  color: var(--color-on-action);
}
.registration-card {
  position: relative;
  z-index: 1;
  margin-top: 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  transition: transform 0.2s ease-out;
}
.registration-card--pressed {
  background: var(--color-raised);
}
.ticket-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.ticket-date {
  display: flex;
  flex: 1;
  flex-direction: column;
}
.ticket-label {
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
}
.card-index {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.registration-title {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.meeting-panel {
  margin: 24rpx -32rpx 0;
  border-radius: 0;
}
.meeting-row {
  align-items: flex-start;
  border-color: var(--color-subtle);
}
.meeting-label {
  flex: 0 0 auto;
  color: var(--color-media-muted);
}
.meeting-value {
  min-width: 0;
  color: var(--color-on-media);
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}
.meeting-location {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.ticket-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 64rpx;
  margin-top: 16rpx;
}
.ticket-meta__label {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: 24rpx;
}
.gathering-mode {
  min-width: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
  font-size: 24rpx;
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}
.status-guidance {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.status-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--color-brand);
}
.card-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border);
}
.card-actions > button:only-child {
  grid-column: 1 / -1;
}
.trip-action,
.delete-record-button {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: var(--control-height);
  margin: 0;
  padding: 0 16rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.trip-action {
  min-height: var(--control-height);
}
.trip-action__label--primary {
  color: var(--color-text);
  font-weight: 900;
}
.trip-skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
  animation: trip-skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.trip-skeleton__stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.trip-skeleton__stats view,
.trip-skeleton__card view {
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.trip-skeleton__card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.trip-skeleton__card view:first-child {
  width: 44%;
}
.trip-skeleton__card view:nth-child(2) {
  width: 72%;
  height: 48rpx;
}
.trip-skeleton__card view:last-child {
  width: 58%;
}
@keyframes trip-skeleton-pulse {
  from {
    opacity: 0.55;
  }
  to {
    opacity: 1;
  }
}
@media (max-width: 340px) {
  .heading-title {
    font-size: 40rpx;
    line-height: 56rpx;
  }
  .trip-stat {
    padding: 0 16rpx;
  }
  .trip-stat__value {
    font-size: 40rpx;
    line-height: 56rpx;
  }
  .meeting-row {
    flex-wrap: wrap;
    gap: 4rpx;
    padding: 16rpx 0;
  }
  .meeting-value {
    flex-basis: 100%;
    text-align: left;
  }
  .card-actions {
    grid-template-columns: 1fr;
  }
  .card-actions > button:only-child {
    grid-column: auto;
  }
}
@media (prefers-reduced-motion: reduce) {
  .registration-card,
  .trip-skeleton {
    transition: none;
    animation: none;
  }
}
