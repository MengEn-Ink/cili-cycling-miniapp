<!--
  骑行影像志 · 活动列表（1:1 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/activities.html）
  - 骨架：page + pageheading + segment（含紧凑切换）+ 影像故事列表 + tabbar
  - 真实业务保留：future/history 切换、day chips 日期筛选、沉浸/紧凑布局、分页 loadMore、refresh retry、无障碍 live region
  - WeChat 原生 brand-logo/系统胶囊，不渲染伪 statusbar / systemnav
-->
<view class="page activities-page" data-v1-layout="content" style="padding-top: {{navigationTopPx}}px">
  <view class="custom-nav-title" style="top: {{navigationTopPx - 44}}px">活动</view>
  <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{refreshing ? '正在刷新活动' : loadingMore ? '正在加载更多活动' : ''}}</view>
  <view class="a11y-live-region" role="alert" aria-live="assertive" aria-atomic="true">{{refreshError}}</view>

  <view class="pageheading">
    <view class="eyebrow">此里 · 骑行</view>
    <view class="pageheading-title editorial">
      <block wx:if="{{activeView === 'future' && layoutMode === 'card'}}"><blur-text text="把周末，" animate-by="letters" direction="bottom" delay="45" step-duration="320" /><blur-text text="交给山路。" animate-by="letters" direction="bottom" delay="45" step-duration="320" /></block>
      <block wx:elif="{{activeView === 'future'}}"><text class="pageheading-line">紧凑浏览</text><text class="pageheading-line">按日期快速选择</text></block>
      <block wx:else><text class="pageheading-line">往期影像</text><text class="pageheading-line">记录每一次出发</text></block>
    </view>
    <view class="pageheading-sub" wx:if="{{activeView === 'future' && layoutMode === 'card'}}">每一次转弯，都有值得记住的风景。</view>
    <view class="pageheading-sub" wx:elif="{{activeView === 'future'}}">保留日期、路线、距离、爬升与剩余名额。</view>
    <view class="pageheading-sub" wx:else>完成的骑行活动会出现在这里。</view>
  </view>

  <view class="segment" role="tablist" aria-label="活动时间">
    <button class="segment-item {{activeView === 'future' ? 'selected' : ''}}" role="tab" data-view="future" aria-selected="{{activeView === 'future'}}" aria-controls="activity-list-panel" bindtap="switchView">近期活动</button>
    <button class="segment-item {{activeView === 'history' ? 'selected' : ''}}" role="tab" data-view="history" aria-selected="{{activeView === 'history'}}" aria-controls="activity-list-panel" bindtap="switchView">往期影像</button>
    <button class="segment-end iconbutton {{layoutMode === 'compact' ? 'selected' : ''}}" data-mode="{{layoutMode === 'compact' ? 'card' : 'compact'}}" aria-pressed="{{layoutMode === 'compact'}}" aria-label="切换紧凑浏览" bindtap="switchLayout">
      <view class="icon-stripes" aria-hidden="true"></view>
    </button>
  </view>

  <view class="day-chip-shell" wx:if="{{activeView === 'future' && dayChips.length > 1}}">
    <scroll-view class="day-chip-bar" scroll-x enhanced show-scrollbar="{{false}}" aria-label="按日期快速选择活动">
      <view class="day-chip-bar__inner" role="list">
        <button class="day-chip {{selectedDayKey === item.key ? 'is-active' : ''}}" wx:for="{{dayChips}}" wx:key="key" role="listitem" aria-pressed="{{selectedDayKey === item.key}}" aria-label="{{item.label}}，{{item.dateLabel}}" data-index="{{item.index}}" bindtap="selectDay"><text class="day-chip__relative">{{item.relativeLabel}}</text><text class="day-chip__date">{{item.dateLabel}}</text></button>
      </view>
    </scroll-view>
  </view>

  <view class="refresh-note" wx:if="{{refreshing}}" aria-hidden="true">正在刷新活动…</view>
  <view class="refresh-note refresh-error" wx:if="{{refreshError}}" aria-hidden="true">{{refreshError}}</view>

  <view class="activity-skeleton" wx:if="{{loading}}" role="status" aria-label="正在加载活动">
    <view class="activity-skeleton__media skeleton"></view>
    <view class="activity-skeleton__body">
      <view class="activity-skeleton__meta skeleton"></view>
      <view class="activity-skeleton__title skeleton"></view>
      <view class="activity-skeleton__facts skeleton"></view>
    </view>
  </view>

  <state-view wx:else loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-title="{{emptyTitle}}" empty-copy="{{emptyCopy}}" data-history-empty-copy="每一次转弯，都有值得记住的风景。" retryable="{{true}}" bind:retry="load">
    <block wx:if="{{layoutMode === 'card'}}">
      <view class="story-list" id="activity-list-panel" role="tabpanel" aria-label="摄影活动列表">
        <view class="story-shell" id="activity-index-{{index}}" wx:for="{{items}}" wx:key="id">
          <view class="story" data-id="{{item.id}}" bindtap="open" hover-class="story--pressed" role="button" aria-label="查看活动：{{item.title}}">
            <view class="photo photo--{{activeView}}">
              <image wx:if="{{item.coverImage}}" class="photo-image" src="{{item.coverImage}}" mode="aspectFill" lazy-load="{{index !== 0}}" aria-label="{{item.title}}活动封面"/>
              <generated-activity-cover wx:else item="{{item}}" variant="card" />
              <view class="shade"></view>
              <view class="corner"><text class="tag tag--{{item.status}}">{{item.displayStatus}}</text></view>
              <view class="caption">
                <view class="eyebrow">{{item.displayDateLabel}} · {{item.displayTimeLabel}}</view>
                <view class="story-title editorial">{{item.title}}</view>
                <view class="story-sub">{{item.route.start || '集合地点待公布'}}{{item.route.level ? ' · ' + item.route.level : ''}}</view>
              </view>
              <view class="cover-count" wx:if="{{!item.registrationUnlimited}}">{{item.occupied}}/{{item.capacity}}</view>
            </view>
            <view class="storyfacts" wx:if="{{activeView === 'future'}}">
              <text class="em">{{item.route.distanceKm > 0 ? item.route.distanceKm : '—'}}{{item.route.distanceKm > 0 ? ' km' : ''}} <text>距离</text></text>
              <text class="em">{{item.route.elevationM > 0 ? item.route.elevationM : '—'}}{{item.route.elevationM > 0 ? ' m' : ''}} <text>爬升</text></text>
              <text class="em">{{item.estimatedRideTime || '—'}} <text>骑行</text></text>
            </view>
            <view class="storymeta" wx:if="{{activeView === 'future'}}">
              <text class="storymeta-pin" aria-hidden="true">◉</text>
              <view class="storymeta-main"><text class="storymeta-link">{{item.clubIdentity.name}}</text><text class="storymeta-copy">{{item.route.start || '集合地点待公布'}}</text></view>
              <text class="storymeta-fee">{{item.fee || '免费'}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="compact-list" id="activity-list-panel" role="tabpanel" aria-label="紧凑活动列表">
      <button class="compact-item" id="activity-index-{{index}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open" aria-label="查看活动：{{item.title}}">
        <view class="compact-item__date"><text>{{item.displayDateLabel}}</text><text>{{item.displayTimeLabel}}</text></view>
        <view class="compact-item__body"><text class="compact-item__title">{{item.title}}</text><text class="compact-item__route">{{item.route.start || '集合地点待公布'}}</text><text class="compact-item__metrics">{{item.route.distanceKm > 0 ? item.route.distanceKm + ' km' : '里程待公布'}} · {{item.route.elevationM > 0 ? '爬升 ' + item.route.elevationM + ' m' : '爬升待公布'}}{{item.route.level ? ' · ' + item.route.level : ''}}</text></view>
        <view class="compact-item__status"><text class="tag tag--{{item.status}}">{{item.registrationUnlimited ? '不限' : item.occupied + '/' + item.capacity}}</text><text>{{item.fee || '免费'}}</text></view>
      </button>
    </view>
  </state-view>

  <button class="btn secondary load-more" wx:if="{{nextCursor && items.length}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}" aria-label="{{loadingMore ? '正在加载更多活动' : (refreshError ? '重试加载更多活动' : '加载更多活动')}}">{{loadingMore ? '加载中…' : (refreshError ? '重试加载更多' : '加载更多活动')}}</button>
</view>
