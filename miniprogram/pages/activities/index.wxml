<view class="page activities-page">
  <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{refreshing ? '正在刷新活动' : loadingMore ? '正在加载更多活动' : ''}}</view>
  <view class="a11y-live-region" role="alert" aria-live="assertive" aria-atomic="true">{{refreshError}}</view>
  <brand-logo meta="骑行活动" />
  <view class="activities-intro">
    <view class="page-title">选一场骑行，一起出发</view>
    <view class="intro-copy">路线、时间、集合点，一眼看清</view>
  </view>

  <view class="timeline-tabs" role="tablist" aria-label="活动时间筛选">
    <button class="timeline-tab {{activeView === 'future' ? 'is-active' : ''}}" role="tab" aria-selected="{{activeView === 'future'}}" aria-controls="activity-list-panel" data-view="future" bindtap="switchView">即将开始</button>
    <button class="timeline-tab {{activeView === 'history' ? 'is-active' : ''}}" role="tab" aria-selected="{{activeView === 'history'}}" aria-controls="activity-list-panel" data-view="history" bindtap="switchView">历史活动</button>
  </view>
  <view class="day-chip-shell" wx:if="{{activeView === 'future' && dayChips.length > 1}}">
    <scroll-view class="day-chip-bar" scroll-x enhanced show-scrollbar="{{false}}" aria-label="按日期快速选择活动">
      <view class="day-chip-bar__inner"><button class="day-chip {{selectedDayKey === item.key ? 'is-active' : ''}}" wx:for="{{dayChips}}" wx:key="key" aria-pressed="{{selectedDayKey === item.key}}" aria-label="{{item.label}}，{{item.dateLabel}}" data-index="{{item.index}}" bindtap="selectDay"><text class="day-chip__relative">{{item.relativeLabel}}</text><text class="day-chip__date">{{item.dateLabel}}</text></button></view>
    </scroll-view>
    <view class="day-chip-fade" aria-hidden="true"></view>
  </view>

  <view class="list-count" wx:if="{{items.length}}"><text>{{activeView === 'history' ? '历史活动' : '近期活动'}}</text><text>共 {{items.length}} 场</text></view>
  <view class="refresh-note" wx:if="{{refreshing}}" aria-hidden="true">正在刷新活动…</view>
  <view class="refresh-note refresh-error" wx:if="{{refreshError}}" aria-hidden="true">{{refreshError}}</view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-title="{{emptyTitle}}" empty-copy="{{emptyCopy}}" retryable="{{true}}" bind:retry="load">
    <swiper class="activity-carousel" id="activity-list-panel" current="{{currentCardIndex}}" duration="260" circular="{{false}}" next-margin="{{items.length > 1 ? '32rpx' : '0rpx'}}" bindchange="cardChange" role="tabpanel" aria-label="左右滑动切换活动">
      <swiper-item wx:for="{{items}}" wx:key="id">
        <view class="activity-slide"><activity-card item="{{item}}" data-id="{{item.id}}" bind:open="open" /></view>
      </swiper-item>
    </swiper>
    <view class="carousel-guide" wx:if="{{items.length > 1}}" aria-hidden="true"><text>{{currentCardIndex + 1}} / {{items.length}}</text><text>左右滑动切换</text><view class="carousel-progress"><view class="carousel-progress__value" style="width: {{(currentCardIndex + 1) / items.length * 100}}%"></view></view></view>
  </state-view>
  <button class="secondary load-more" wx:if="{{nextCursor && items.length && (items.length === 1 || refreshError)}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadingMore ? '加载中…' : (refreshError ? '重试加载更多' : '加载更多活动')}}</button>
</view>
