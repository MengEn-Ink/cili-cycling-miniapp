page {
  background: var(--color-bg);
}
.activities-page {
  --v31-accent: var(--color-brand);
  --v31-charcoal: var(--color-text);
  --v31-warm-gray: var(--color-bg);
  --v31-line: var(--color-border);
  --color-bg: var(--v31-warm-gray);
  --color-surface: #ffffff;
  --color-raised: #f1ede7;
  --color-text: var(--v31-charcoal);
  --color-muted: #68645e;
  --color-border: var(--v31-line);
  --color-card-border: var(--v31-line);
  --color-action: var(--v31-charcoal);
  --color-on-action: #ffffff;
  min-height: 100%;
  padding: 12rpx var(--page-gutter) calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
  overflow-x: hidden;
  background: var(--color-bg);
  color: var(--color-text);
}
.activities-page .muted {
  color: var(--color-muted);
}
brand-logo {
  display: block;
  margin: 0 0 8rpx;
}
.activities-intro {
  padding: 16rpx 0 22rpx;
  text-align: var(--page-heading-align);
}
.page-title {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.06;
  letter-spacing: 0;
}
.page-title view:last-child {
  color: var(--v31-accent);
}
.intro-copy {
  margin-top: 12rpx;
  font-size: 23rpx;
}
.timeline-tabs {
  display: flex;
  width: 100%;
  margin: 0 0 24rpx;
  padding: 6rpx;
  border: 1rpx solid var(--v31-line);
  border-radius: 22rpx;
  background: #ebe7e1;
}
.timeline-tab {
  display: flex;
  min-width: 0;
  min-height: var(--segment-height);
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  font-weight: 800;
}
.timeline-tab.is-active {
  background: var(--color-surface);
  color: var(--v31-accent);
  box-shadow: 0 6rpx 18rpx rgba(39, 35, 30, 0.1);
}
.timeline-tab--pressed {
  opacity: 0.72;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 2rpx 10rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 900;
}
.count {
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.day-chip-bar {
  width: calc(100% + 64rpx);
  margin: 0 -32rpx 16rpx;
  white-space: nowrap;
}
.day-chip-bar__inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 32rpx 8rpx;
}
.day-chip {
  display: inline-flex;
  min-height: 64rpx;
  padding: 0 24rpx;
  align-items: center;
  border: 1rpx solid var(--v31-line);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-text);
  font-size: 23rpx;
  font-weight: 800;
}
.day-chip:first-child {
  border-color: var(--v31-accent);
  color: var(--v31-accent);
}
.day-chip--pressed {
  background: #fce8e1;
}
.activity-results {
  display: grid;
  min-height: 360rpx;
  row-gap: var(--card-gap);
}
.activity-results activity-card {
  display: block;
}
.day-group-head {
  display: flex;
  align-items: center;
  margin: 18rpx 2rpx 0;
}
.day-group-head__label {
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 900;
}
.day-group-head__label::after {
  display: inline-block;
  width: 40rpx;
  height: 4rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: var(--v31-accent);
  vertical-align: middle;
  content: '';
}
.following-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 2rpx 0;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 900;
}
.following-head text:last-child {
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 700;
}
.refresh-note {
  margin: 8rpx 2rpx 10rpx;
  font-size: 21rpx;
}
.refresh-error {
  color: var(--color-danger-text);
}
.load-more {
  display: flex;
  width: 100%;
  min-height: var(--control-height);
  margin: 8rpx 0 4rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--v31-line);
  border-radius: 20rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
}
.load-more::after {
  border: 0;
}
.load-more[disabled] {
  background: var(--color-raised);
  color: var(--color-muted);
  opacity: 1;
}
@media (max-width: 350px) {
  .page.activities-page {
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }
  .page-title {
    font-size: 44rpx;
  }
  .day-chip-bar {
    width: calc(100% + 48rpx);
    margin-right: -24rpx;
    margin-left: -24rpx;
  }
  .day-chip-bar__inner {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
}

.activities-page {
  --page-gutter: 48rpx;
  --segment-height: 88rpx;
  padding: 32rpx var(--page-gutter) calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
  background: var(--color-bg);
}
.activities-intro {
  padding: 32rpx 0 48rpx;
  text-align: var(--page-heading-align);
}
.page-title {
  max-width: 560rpx;
  font-size: 44rpx;
  line-height: 1.14;
}
.intro-copy {
  max-width: 560rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.timeline-tabs {
  width: 100%;
  margin-bottom: 48rpx;
  padding: 0;
  border-radius: 8rpx;
  background: transparent;
}
.timeline-tab {
  min-height: var(--segment-height);
  border-radius: 0;
}
.timeline-tab.is-active {
  border: 4rpx solid var(--color-action);
  background: var(--color-surface);
  color: var(--color-action);
  box-shadow: none;
}
.section-head {
  margin: 0 0 16rpx;
}
.section-title {
  font-size: 32rpx;
}
.day-chip-bar {
  width: calc(100% + 96rpx);
  margin: 0 -48rpx 32rpx;
}
.day-chip-bar__inner {
  gap: 16rpx;
  padding: 0 48rpx 16rpx;
}
.day-chip {
  min-height: var(--segment-height);
  border-radius: 8rpx;
}
.activity-results {
  row-gap: var(--card-gap);
}
.day-group-head,
.following-head {
  margin-right: 0;
  margin-left: 0;
}
.day-group-head__label::after {
  width: 48rpx;
  margin-left: 16rpx;
  border-radius: 0;
}
.load-more {
  min-height: var(--control-height);
  margin-top: 16rpx;
  border-radius: 8rpx;
}
@media (max-width: 350px) {
  .page.activities-page {
    --page-gutter: var(--page-gutter-narrow);
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }
  .page-title {
    font-size: 44rpx;
  }
  .day-chip-bar {
    width: calc(100% + 64rpx);
    margin-right: -32rpx;
    margin-left: -32rpx;
  }
  .day-chip-bar__inner {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }
}
