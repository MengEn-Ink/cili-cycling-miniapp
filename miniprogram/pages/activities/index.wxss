page {
  background: #0b0b0c;
}

.activities-page {
  min-height: 100%;
  padding: 16rpx var(--page-gutter) calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #0b0b0c;
  color: #f7f7f5;
}

.activities-page .muted {
  color: #8e8e93;
}

brand-logo {
  display: block;
  margin: 0 4rpx 10rpx;
}

.activities-intro {
  padding: 10rpx 4rpx 14rpx;
}

.section-eyebrow {
  margin-bottom: 2rpx;
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 1rpx;
}

.intro-copy {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.timeline-tabs {
  display: flex;
  width: calc(100% - 8rpx);
  overflow: hidden;
  margin: 4rpx 4rpx 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.timeline-tab {
  display: flex;
  min-width: 0;
  min-height: var(--control-height);
  flex: 1;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.timeline-tab + .timeline-tab {
  border-left: 1rpx solid var(--color-border);
}

.timeline-tab.is-active {
  background: var(--color-brand);
  color: var(--color-on-brand);
}

.timeline-tab--pressed {
  opacity: 0.78;
}

.activity-results {
  min-height: 360rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 8rpx 4rpx 2rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.count {
  flex: none;
  min-width: 68rpx;
  padding: 4rpx 12rpx;
  border-left: 5rpx solid var(--color-brand);
  border-radius: 14rpx;
  background: #2c2c2e;
  color: #f7f7f5;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
  transform: skewX(-10deg);
}

.refresh-note {
  margin: 8rpx 4rpx 0;
  font-size: 21rpx;
}

.load-more {
  display: flex;
  width: 100%;
  min-height: var(--control-height);
  margin: 24rpx 0 4rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.load-more::after {
  border: 0;
}

.load-more[disabled] {
  background: var(--color-surface);
  color: var(--color-muted);
  opacity: 1;
}

@media (max-width: 350px) {
  .page.activities-page {
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }

  .page-title {
    font-size: 38rpx;
  }
}

@media (max-width: 320px) {
  .timeline-tabs {
    width: 100%;
    margin-right: 0;
    margin-left: 0;
  }

  .timeline-tab {
    padding-right: 8rpx;
    padding-left: 8rpx;
    white-space: normal;
  }
}

page,
.activities-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.activities-page .muted {
  color: var(--color-muted);
}
.count {
  border-radius: var(--radius-md);
  background: var(--color-raised);
  color: var(--color-text);
}

/* Scheme A: editorial lead story with quieter supporting rides. */
.activities-page {
  padding-top: 12rpx;
  overflow-x: hidden;
}

.activities-page brand-logo {
  margin-bottom: 6rpx;
}

.activities-intro {
  padding: 12rpx 4rpx 18rpx;
  text-align: var(--page-heading-align);
}

.section-eyebrow {
  margin-bottom: 8rpx;
  font-size: 18rpx;
}

.page-title {
  font-size: 50rpx;
  line-height: 1.04;
}

.intro-copy {
  margin-top: 10rpx;
  font-size: 23rpx;
}

.section-head {
  margin-top: 4rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 25rpx;
}

.count {
  min-width: auto;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-muted);
  font-size: 20rpx;
  transform: none;
}

.following-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 4rpx 4rpx;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 900;
}

.following-head text:last-child {
  color: var(--color-brand);
  font-size: 19rpx;
  font-weight: 800;
}

@media (max-width: 350px) {
  .page-title {
    font-size: 44rpx;
  }
}
