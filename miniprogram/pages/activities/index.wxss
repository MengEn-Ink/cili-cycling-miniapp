.activities-intro,
.activities-intro > view,
.list-count,
.list-count__main,
.carousel-guide {
  min-width: 0;
}
.activities-intro {
  margin-top: 16rpx;
}
.intro-copy {
  max-width: 560rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.timeline-tabs {
  grid-template-columns: 1fr 1fr;
  margin-top: 32rpx;
}
.timeline-tab {
  min-width: 0;
  min-height: var(--control-height);
}
.timeline-tab.is-active {
  border-color: var(--color-action);
  background: var(--color-action);
  color: var(--color-on-action);
}
.day-chip-shell {
  position: relative;
  margin: 24rpx calc(0rpx - var(--page-gutter)) 0;
}
.day-chip-bar {
  width: 100%;
  white-space: nowrap;
}
.day-chip-bar__inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 calc(var(--page-gutter) + 48rpx) 8rpx var(--page-gutter);
}
.day-chip {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 128rpx;
  min-height: 104rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: center;
}
.day-chip__relative {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
  white-space: nowrap;
}
.day-chip__date {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.day-chip.is-active {
  border-color: var(--color-action);
  background: var(--color-action);
  color: var(--color-on-action);
}
.day-chip.is-active .day-chip__date {
  color: var(--color-on-action);
}
.day-chip-fade {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 8rpx;
  width: 32rpx;
  pointer-events: none;
  background: var(--color-bg);
  opacity: 0.72;
}
.list-count {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 32rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.list-count__main {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
}
.list-count__current {
  color: var(--color-text);
  font-weight: 800;
}
.list-count__total {
  flex: 0 0 auto;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.activity-card-skeleton {
  height: 900rpx;
  margin-top: 48rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.activity-card-skeleton__media {
  height: 360rpx;
  border-radius: 0;
}
.activity-card-skeleton__body {
  padding: 24rpx 32rpx 32rpx;
}
.activity-card-skeleton__meta {
  width: 56%;
  height: 28rpx;
}
.activity-card-skeleton__title {
  width: 78%;
  height: 48rpx;
  margin-top: 20rpx;
}
.activity-card-skeleton__route {
  width: 66%;
  height: 36rpx;
  margin-top: 20rpx;
}
.activity-card-skeleton__metrics {
  height: 112rpx;
  margin-top: 32rpx;
}
.activity-card-skeleton__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}
.activity-card-skeleton__actions > view {
  height: var(--control-height);
  border-radius: 999rpx;
}
.activity-carousel {
  width: 100%;
  height: 900rpx;
  margin-top: 16rpx;
  overflow: hidden;
}
.activity-slide {
  box-sizing: border-box;
  min-width: 0;
  height: 100%;
  padding-bottom: 8rpx;
}
.carousel-guide {
  display: grid;
  grid-template-columns: auto minmax(80rpx, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.carousel-guide > text:first-child {
  color: var(--color-text);
  font-weight: 900;
}
.carousel-progress {
  min-width: 0;
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--color-border);
}
.carousel-progress__value {
  height: 100%;
  border-radius: inherit;
  background: var(--color-brand);
  transition: width 220ms ease;
}
.load-more {
  width: 100%;
  margin-top: 32rpx;
}
@media (max-width: 340px) {
  .page-title {
    font-size: 40rpx;
    line-height: 56rpx;
  }
  .day-chip {
    min-width: 120rpx;
    padding-right: 12rpx;
    padding-left: 12rpx;
  }
  .carousel-guide {
    grid-template-columns: auto minmax(64rpx, 1fr);
  }
  .carousel-guide > text:last-child {
    display: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .carousel-progress__value {
    transition: none;
  }
}
