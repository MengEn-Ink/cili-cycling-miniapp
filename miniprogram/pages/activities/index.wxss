.activities-page {
  background: var(--color-bg);
}
.activities-intro {
  margin-top: 16rpx;
}
.intro-copy {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.timeline-tabs {
  grid-template-columns: 1fr 1fr;
  margin-top: 32rpx;
}
.day-chip-bar {
  margin: 24rpx calc(0rpx - var(--page-gutter)) 0;
}
.day-chip-bar__inner {
  display: flex;
  gap: 16rpx;
  padding: 0 var(--page-gutter);
}
.day-chip {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 144rpx;
  height: 104rpx;
  padding: 0 24rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
}
.day-chip__relative {
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.day-chip__date {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.day-chip.is-active {
  background: var(--color-action);
  color: var(--color-on-action);
}
.day-chip.is-active .day-chip__date {
  color: var(--color-media-muted);
}
.list-count {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.list-count text:last-child {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.activity-list {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: 16rpx;
}
.load-more {
  width: 100%;
  margin-top: 32rpx;
}
