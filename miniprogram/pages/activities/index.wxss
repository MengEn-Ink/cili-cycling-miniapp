page {
  background: #0b0b0c;
}

.activities-page {
  min-height: 100vh;
  overflow: hidden;
  padding-top: 18rpx;
  background: radial-gradient(circle at 100% 5%, rgba(213, 91, 31, 0.1), transparent 26%), #0b0b0c;
  color: #f7f7f5;
}

.activities-page .muted {
  color: #a8a8ad;
}

brand-logo {
  display: block;
  margin: 0 4rpx 14rpx;
}

.activities-hero {
  min-height: 218rpx;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 18rpx;
}

.activities-hero .hero-title {
  margin: 8rpx 0 4rpx;
  font-size: 40rpx;
  line-height: 1.08;
}

.activities-hero .hero-subtitle {
  position: relative;
  z-index: 1;
  max-width: 510rpx;
  font-size: 23rpx;
}

.hero-index {
  position: absolute;
  top: 24rpx;
  right: 26rpx;
  color: #6f6f75;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-rule {
  width: 190rpx;
  height: 5rpx;
  margin-top: 18rpx;
  background: #3a3a3e;
  transform: skewX(-30deg);
}

.hero-rule view {
  width: 58%;
  height: 100%;
  background: linear-gradient(90deg, #c82018, #d55b1f);
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin: 22rpx 4rpx 4rpx;
}

.section-copy {
  min-width: 0;
}

.section-eyebrow {
  margin-bottom: 1rpx;
  color: #d55b1f;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.24;
}

.section-head .muted {
  overflow: hidden;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.count {
  flex: none;
  min-width: 68rpx;
  padding: 5rpx 12rpx;
  border-left: 5rpx solid #d55b1f;
  background: #242427;
  color: #f7f7f5;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  transform: skewX(-10deg);
}

.refresh-note {
  margin: 10rpx 4rpx 0;
  font-size: 22rpx;
}

@media (max-width: 350px) {
  .page.activities-page {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .activities-hero {
    min-height: 204rpx;
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .activities-hero .hero-title {
    font-size: 37rpx;
  }
}

/* Design reference alignment: page-local to avoid affecting admin surfaces. */
.page.activities-page {
  padding-right: 40rpx;
  padding-left: 40rpx;
  background: #000;
}

.activities-hero {
  border-color: #38383a;
  border-radius: 48rpx;
  background: #1c1c1e;
  box-shadow: none;
}

.section-eyebrow {
  color: #ff5722;
}

.hero-rule view {
  background: #ff5722;
}

.count {
  border-left-color: #ff5722;
  border-radius: 16rpx;
  background: #2c2c2e;
}

@media (max-width: 320px) {
  .page.activities-page {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }
}
