page {
  background: #0b0b0c;
}

.activities-page {
  min-height: 100%;
  padding: 16rpx 32rpx calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #0b0b0c;
  color: #f7f7f5;
}

.activities-page .muted {
  color: #8e8e93;
}

brand-logo {
  display: block;
  margin: 0 4rpx 10rpx;
}

.activities-intro {
  padding: 10rpx 4rpx 14rpx;
}

.section-eyebrow {
  margin-bottom: 2rpx;
  color: var(--color-brand);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 1rpx;
}

.intro-copy {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 8rpx 4rpx 2rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.count {
  flex: none;
  min-width: 68rpx;
  padding: 4rpx 12rpx;
  border-left: 5rpx solid var(--color-brand);
  border-radius: 14rpx;
  background: #2c2c2e;
  color: #f7f7f5;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
  transform: skewX(-10deg);
}

.refresh-note {
  margin: 8rpx 4rpx 0;
  font-size: 21rpx;
}

@media (max-width: 350px) {
  .page.activities-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .page-title {
    font-size: 38rpx;
  }
}

page,
.activities-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.activities-page .muted {
  color: var(--color-muted);
}
.count {
  border-radius: var(--radius-md);
  background: var(--color-raised);
  color: var(--color-text);
}
