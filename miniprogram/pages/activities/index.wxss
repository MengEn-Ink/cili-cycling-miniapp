/* AI Hero activity list: geometry lives in shared layout; local media/fallback mechanics remain here. */
.activities-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.story-list {
  display: flex;
  flex-direction: column;
}
.photo-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.photo generated-activity-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, var(--color-scrim-soft), var(--color-media-scrim));
}
.caption {
  position: absolute;
  bottom: 24rpx;
  left: 28rpx;
  right: 28rpx;
  color: var(--color-on-media);
}
.caption .eyebrow {
  color: var(--color-on-media);
  font-family: var(--font-family-mono);
  font-size: 24rpx;
}
.caption-when {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.corner {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
}
.corner .tag {
  color: var(--color-on-media);
  background: var(--color-media-scrim);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.iconbutton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border: 1px solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-surface);
  color: var(--color-text);
}
.icon-stripes {
  width: 32rpx;
  height: 20rpx;
  border-top: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
}
.segment-count {
  align-self: center;
  font-family: var(--font-family-mono);
  color: var(--color-muted);
  font-size: 24rpx;
}
.compact-list {
  margin-top: 24rpx;
}
.compact-item {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 28rpx 0;
  border: 0;
  border-bottom: 1px solid var(--color-border);
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  text-align: left;
}
.compact-item__date {
  width: 112rpx;
  flex: 0 0 auto;
  font-family: var(--font-family-mono);
  font-size: 24rpx;
}
.compact-item__date text {
  display: block;
}
.compact-item__body {
  flex: 1;
  min-width: 0;
}
.compact-item__title,
.compact-item__route {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.compact-item__title {
  font-size: 32rpx;
  font-weight: 700;
}
.compact-item__route {
  font-size: 26rpx;
  color: var(--color-muted);
}
.compact-item__metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  font-family: var(--font-family-mono);
  font-size: 24rpx;
  color: var(--color-muted);
}
.compact-item__status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}
.compact-item__arrow {
  font-size: 24rpx;
}
.activity-skeleton {
  margin-top: 36rpx;
  overflow: hidden;
  border: 1px solid var(--color-border);
  border-radius: 22rpx;
}
.activity-skeleton__media {
  height: 360rpx;
  background: var(--color-raised);
}
.activity-skeleton__body {
  padding: 28rpx;
}
.activity-skeleton__meta,
.activity-skeleton__title,
.activity-skeleton__facts {
  height: 32rpx;
  margin-top: 20rpx;
  background: var(--color-raised);
}
.refresh-note {
  margin-top: 24rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}
.refresh-error {
  color: var(--color-danger);
}
.story--pressed {
  opacity: 0.86;
}
.load-more {
  margin-top: 32rpx;
  width: 100%;
}
.activity-endnote {
  margin-top: 40rpx;
  text-align: center;
  font-family: var(--font-family-mono);
  font-size: 24rpx;
  color: var(--color-muted);
}
@import '../../styles/aihero-layout.wxss';
