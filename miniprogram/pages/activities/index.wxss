.activities-intro,
.activities-intro > view,
.list-count,
.list-count__main,
.carousel-guide {
  min-width: 0;
}
.activities-intro {
  margin-top: 32rpx;
}
.intro-kicker {
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.page-title {
  max-width: 560rpx;
  margin-top: 12rpx;
  font-family: 'Songti SC', STSong, serif;
  font-size: 56rpx;
  line-height: 72rpx;
  font-weight: 600;
}
.intro-copy {
  margin-top: 12rpx;
  max-width: 560rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.timeline-tabs {
  grid-template-columns: 1fr 1fr;
  margin-top: 32rpx;
}
.timeline-tab {
  min-width: 0;
  min-height: var(--control-height);
}
.timeline-tab.is-active {
  border-color: var(--color-action);
  background: var(--color-action);
  color: var(--color-on-action);
}
.day-chip-shell {
  position: relative;
  margin: 24rpx calc(0rpx - var(--page-gutter)) 0;
}
.day-chip-bar {
  width: 100%;
  white-space: nowrap;
}
.day-chip-bar__inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 calc(var(--page-gutter) + 48rpx) 8rpx var(--page-gutter);
}
.day-chip {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 128rpx;
  min-height: 104rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: center;
}
.day-chip__relative {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
  white-space: nowrap;
}
.day-chip__date {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.day-chip.is-active {
  border-color: var(--color-action);
  background: var(--color-action);
  color: var(--color-on-action);
}
.day-chip.is-active .day-chip__date {
  color: var(--color-on-action);
}
.day-chip-fade {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 8rpx;
  width: 32rpx;
  pointer-events: none;
  background: var(--color-bg);
  opacity: 0.72;
}
.list-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 32rpx;
}
.list-count {
  display: flex;
  flex: 1;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 0;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.list-count__main {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
}
.list-count__current {
  color: var(--color-text);
  font-weight: 800;
}
.list-count__total {
  flex: 0 0 auto;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.layout-switch {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  overflow: hidden;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 999rpx;
  background: var(--color-surface);
}
.layout-switch__item {
  min-height: 88rpx;
  padding: 0 20rpx;
  border-right: 2rpx solid var(--color-border-strong);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
}
.layout-switch__item:last-child {
  border-right: 0;
}
.layout-switch__item.is-active {
  background: var(--color-text);
  color: var(--color-on-media);
}
.activity-card-skeleton {
  height: 820rpx;
  margin-top: 48rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.activity-card-skeleton__media {
  height: 560rpx;
  border-radius: 0;
}
.activity-card-skeleton__body {
  padding: 24rpx 32rpx 32rpx;
}
.activity-card-skeleton__meta {
  width: 56%;
  height: 28rpx;
}
.activity-card-skeleton__title {
  width: 78%;
  height: 48rpx;
  margin-top: 20rpx;
}
.activity-card-skeleton__route {
  width: 66%;
  height: 36rpx;
  margin-top: 20rpx;
}
.activity-card-skeleton__metrics {
  height: 112rpx;
  margin-top: 32rpx;
}
.activity-story-list {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  margin-top: 16rpx;
}
.activity-story {
  scroll-margin-top: 24rpx;
}
.compact-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}
.compact-item {
  display: grid;
  grid-template-columns: 140rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 168rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
}
.compact-item__date,
.compact-item__body,
.compact-item__status {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.compact-item__date {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.compact-item__date text:first-child,
.compact-item__title {
  color: var(--color-text);
  font-weight: 900;
}
.compact-item__title,
.compact-item__route,
.compact-item__metrics {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.compact-item__title {
  font-size: 28rpx;
  line-height: 44rpx;
}
.compact-item__route,
.compact-item__metrics {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.compact-item__status {
  align-items: flex-end;
  gap: 8rpx;
  color: var(--color-action);
  font-size: 24rpx;
  font-weight: 800;
}
.load-more {
  width: 100%;
  margin-top: 32rpx;
}
@media (max-width: 340px) {
  .page-title {
    font-size: 40rpx;
    line-height: 56rpx;
  }
  .day-chip {
    min-width: 120rpx;
    padding-right: 12rpx;
    padding-left: 12rpx;
  }
}
