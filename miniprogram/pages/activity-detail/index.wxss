.detail-page {
  min-height: 100vh;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  background: #0b0b0c;
  color: #f7f7f5;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  min-height: 430rpx;
  padding: 62rpx 36rpx 112rpx;
  border-bottom: 1rpx solid #39393d;
  background:
    radial-gradient(circle at 90% 15%, #2c1a14, transparent 36%),
    linear-gradient(145deg, #242427, #0d0d0e 72%);
  color: #f7f7f5;
}

.detail-brand {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 48rpx;
  color: #d0d0d3;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.mini-symbol {
  width: 30rpx;
  height: 30rpx;
  border: 6rpx solid #f7f7f5;
  border-right-color: #d55b1f;
  border-radius: 50%;
}

.hero-sequence {
  position: absolute;
  top: 66rpx;
  right: 34rpx;
  color: #59595e;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.detail-hero .hero-title {
  max-width: 610rpx;
  font-size: 48rpx;
}

.route-arrow,
.button-arrow {
  color: #f38a50;
}

.hero-level {
  display: inline-flex;
  margin-top: 26rpx;
  padding: 7rpx 18rpx;
  border: 1rpx solid #d55b1f;
  border-radius: 3rpx;
  background: rgba(213, 91, 31, 0.1);
  color: #f38a50;
  font-size: 21rpx;
  font-weight: 800;
}

.hero-corner {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 76rpx;
  height: 76rpx;
  background: linear-gradient(135deg, transparent 49%, #d55b1f 50%);
}

.content {
  padding: 0 24rpx;
}

.metric-panel {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rpx;
  margin-top: -62rpx;
  border: 1rpx solid #414146;
  background: #414146;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.38);
}

.detail-metric {
  min-width: 0;
  padding: 24rpx 8rpx;
  background: #18181a;
  color: #a8a8ad;
  font-size: 24rpx;
  text-align: center;
}

.metric-number {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 34rpx;
  font-weight: 900;
  text-overflow: ellipsis;
}

.metric-label {
  margin-top: 2rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.card {
  position: relative;
  overflow: hidden;
}

.card-index {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  color: #414146;
  font-size: 42rpx;
  font-weight: 900;
  font-style: italic;
}

.body-text,
.list-item,
.notice-item {
  color: #b8b8bc;
  line-height: 1.75;
}

.schedule-row {
  display: grid;
  grid-template-columns: 92rpx 18rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 16rpx 0;
}

.schedule-time {
  color: #f38a50;
  font-weight: 900;
}

.schedule-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  background: #d55b1f;
  transform: rotate(45deg);
}

.schedule-copy {
  min-width: 0;
}

.list-item,
.notice-item {
  display: flex;
  gap: 14rpx;
  padding: 8rpx 0;
}

.check {
  color: #d55b1f;
  font-weight: 900;
}

.notice-item {
  color: #8b8b91;
}

.notice-mark {
  color: #c82018;
  font-weight: 900;
}

.button-arrow {
  margin-left: 16rpx;
  color: #f7f7f5;
}
