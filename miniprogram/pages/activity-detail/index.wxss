.detail-page {
  padding-bottom: calc(var(--fixed-action-reserve) + var(--card-gap) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}
.detail-unified-card {
  width: 100%;
}
.detail-refresh-retry {
  display: flex;
  align-items: center;
  min-height: var(--control-height);
  padding: 16rpx var(--card-padding);
  border: 2rpx solid var(--color-status-warning);
  border-radius: var(--radius-card);
  background: var(--color-status-warning-soft);
  color: var(--color-status-warning);
  font-weight: 800;
}
.detail-metric-panel {
  display: block;
  width: 100%;
  overflow: visible;
  border: 0;
  background: transparent;
}
.detail-hero {
  position: relative;
  height: 360rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-media-placeholder-bg);
}
.hero-gallery,
.hero-media {
  width: 100%;
  height: 100%;
}
.cover-count {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-overlay);
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}
.detail-page .info-bar .club-identity {
  color: var(--color-media-muted);
}
.detail-page .info-bar .info-tag {
  border-color: var(--color-media-muted);
  background: transparent;
  color: var(--color-on-media);
}
.info-head,
.section-heading,
.attendees-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.info-tag {
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
}
.content {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
}
.content > .card,
.content > .official-route-card,
.content > .gpx-route-card,
.content > .detail-decision,
.content > .metric-panel {
  margin-top: 0;
}
.detail-page .card,
.detail-page .official-route-card,
.detail-page .gpx-route-card {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
}
.metric-panel {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
/* 墨黑决策块：复用全局 .info-bar / .activity-context 的深底 + 品牌红边条范式 */
.detail-page .detail-decision {
  position: relative;
  overflow: hidden;
  padding: 32rpx 32rpx 32rpx 40rpx;
  border: 0;
  border-radius: var(--radius-card);
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.detail-page .detail-decision::before {
  position: absolute;
  top: 32rpx;
  bottom: 32rpx;
  left: 0;
  width: 8rpx;
  background: var(--color-brand);
  content: '';
}
.route-action-note,
.attendees-hint,
.group-qr-detail-hint {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.detail-page .decision-kicker {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.decision-title {
  display: block;
  margin-top: 8rpx;
  color: var(--color-on-media);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.decision-hint {
  margin-top: 8rpx;
  color: var(--color-media-muted);
}
.decision-capacity {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  text-align: right;
}
.decision-capacity text:first-child {
  font-size: 36rpx;
  font-weight: 900;
}
.time-card {
  margin-top: 0;
}
.time-card-primary {
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
}
.time-card-kicker,
.meeting-location__label {
  color: var(--color-muted);
  font-size: 24rpx;
}
.meeting-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}
.meeting-location__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}
.meeting-location__name {
  font-weight: 800;
}
.time-card-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 24rpx;
}
.organizer-route-card {
  padding: 24rpx 32rpx;
}
.organizer-trust {
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
}
.organizer-trust__avatar {
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 50%;
}
.organizer-trust__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-text);
  color: var(--color-on-media);
  font-weight: 900;
}
.organizer-trust__copy {
  min-width: 0;
}
.organizer-trust__label,
.organizer-trust__club,
.route-difficulty__label {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.organizer-trust__name {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 900;
}
.route-difficulty {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}
.route-difficulty__text {
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 700;
}
.section-heading .title {
  flex: 1;
}
.section-tag {
  border: 2rpx solid var(--color-border-strong);
  background: var(--color-surface);
}
.route-action {
  width: 100%;
  margin-top: 24rpx;
}
.inline-feedback {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}
.inline-feedback--success {
  border: 2rpx solid var(--color-status-success);
  background: var(--color-status-success-soft);
  color: var(--color-status-success);
}
.inline-feedback--error {
  border: 4rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
}
.route-native-metrics {
  margin-top: 24rpx;
  border-radius: var(--radius-sm);
}
.route-native-metrics > view {
  min-height: 120rpx;
  text-align: center;
}
.route-native-metrics > view > text:first-child {
  display: block;
  overflow: hidden;
  margin-bottom: 4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.route-estimate {
  display: flex;
  justify-content: space-between;
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  font-weight: 800;
}
.route-estimate text:last-child {
  min-width: 0;
  overflow: hidden;
  color: var(--color-action);
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.route-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 176rpx;
  margin-top: 16rpx;
  border: 4rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-muted);
}
.gpx-download-row {
  margin-top: 24rpx;
}
.attendee-card-strip {
  margin-top: 24rpx;
}
.attendee-card-strip__inner {
  display: flex;
  gap: 24rpx;
}
.attendee-mini-card {
  display: flex;
  flex: 0 0 112rpx;
  flex-direction: column;
  align-items: center;
  min-height: 160rpx;
  background: transparent;
  font-size: 24rpx;
}
.attendee-mini-card--authorization {
  flex-basis: 280rpx;
}
.attendee-media-action {
  min-height: 64rpx;
  margin-top: 12rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--color-action);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-action);
  font-size: 22rpx;
  line-height: 1.3;
}
.attendee-media-feedback {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.4;
}
.attendee-avatar {
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid var(--color-border-strong);
  border-radius: 50%;
}
.attendee-avatar.gender-male,
.rider-card-avatar.gender-male {
  border-color: var(--color-text);
}
.attendee-avatar.gender-female,
.rider-card-avatar.gender-female {
  border-color: var(--color-brand);
}
.attendee-avatar.gender-unknown,
.rider-card-avatar.gender-unknown {
  border-color: var(--color-border-strong);
}
.group-qr-detail-image {
  width: 320rpx;
  height: 320rpx;
  margin: 24rpx auto 0;
}
.group-qr-locked {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--color-raised);
}
.body-text {
  margin-top: 16rpx;
  white-space: pre-wrap;
}
.route-location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.route-location-copy {
  flex: 1;
}
.route-location-label,
.route-location-address {
  color: var(--color-muted);
  font-size: 24rpx;
}
.route-location-row button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  font-weight: 800;
  line-height: 1.3;
}
.schedule-row {
  display: grid;
  grid-template-columns: 112rpx 24rpx 1fr;
  gap: 16rpx;
  padding: 16rpx 0;
}
.schedule-track {
  display: flex;
  justify-content: center;
  border-left: 2rpx solid var(--color-border);
}
.schedule-dot {
  width: 16rpx;
  height: 16rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.chip-list {
  margin-top: 16rpx;
}
.gear-chip,
.notice-chip,
.fee-item {
  display: flex;
  gap: 16rpx;
  min-height: 72rpx;
  align-items: center;
  border-bottom: 2rpx solid var(--color-border);
}
.check {
  color: var(--color-status-success);
}
.rider-modal-mask {
  position: fixed;
  z-index: 200;
  inset: 0;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: calc(32rpx + env(safe-area-inset-top)) 0 calc(32rpx + env(safe-area-inset-bottom));
  background: var(--color-overlay);
}
.rider-card {
  position: relative;
  width: 100%;
  max-width: 750rpx;
  margin: 0;
  border: 0;
  background: transparent;
}
.rider-card-swiper {
  width: 100%;
  height: 72vh;
}
.rider-card-photo {
  position: relative;
  height: 100%;
  margin: 0 12rpx;
  overflow: hidden;
  border: 0;
  border-radius: 32rpx;
  background: var(--color-media-card-bg);
}
.rider-card-photo__image {
  width: 100%;
  height: 100%;
}
.rider-card-photo__scrim {
  position: absolute;
  inset: 0;
  background: var(--color-media-scrim);
}
.rider-card-close {
  position: absolute;
  z-index: 3;
  top: -104rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 0;
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 36rpx;
}
.rider-card-photo__identity {
  position: absolute;
  right: 32rpx;
  bottom: 104rpx;
  left: 32rpx;
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  color: var(--color-on-media);
}
.rider-card-avatar {
  box-sizing: border-box;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border: 8rpx solid var(--color-border-strong);
  border-radius: 50%;
}
.rider-card-copy {
  min-width: 0;
  flex: 1;
}
.rider-card-kicker {
  color: var(--color-media-muted);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.rider-name {
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rider-card-photo__badges {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}
.gender-pill,
.rider-status {
  padding: 6rpx 12rpx;
  border: 2rpx solid var(--color-on-media);
  color: var(--color-on-media);
  font-size: 22rpx;
  font-weight: 800;
}
.gender-pill.gender-female {
  border-color: var(--color-brand);
  background: var(--color-brand);
}
.gender-pill.gender-male {
  background: var(--color-text);
}
.rider-card-note {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  left: 32rpx;
  color: var(--color-media-muted);
  font-size: 22rpx;
  line-height: 1.45;
}
.rider-card-pagination {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 20rpx;
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}
.detail-action--admin {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.detail-action .btn {
  border-color: var(--color-action);
  border-radius: 999rpx !important;
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
.detail-action .btn--secondary {
  border-color: var(--color-border);
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
@media (max-width: 340px), (max-height: 560px) {
  .time-card-meta {
    flex-direction: column;
  }
  .rider-card-swiper {
    height: 64vh;
  }
}
