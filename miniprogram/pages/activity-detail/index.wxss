.detail-page {
  min-height: 100vh;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  min-height: 360rpx;
  padding: 70rpx 36rpx 100rpx;
  background: #0b6b4f;
  color: #fff;
}

.hero-level {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.content {
  padding: 0 24rpx;
}

.metric-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rpx;
  margin-top: -54rpx;
  padding: 10rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(23, 35, 30, 0.1);
}

.detail-metric {
  min-width: 0;
  padding: 22rpx 8rpx;
  color: #718078;
  font-size: 21rpx;
  text-align: center;
}

.metric-number {
  overflow: hidden;
  color: #17231e;
  font-size: 32rpx;
  font-weight: 800;
  text-overflow: ellipsis;
}

.body-text,
.list-item,
.notice-item {
  line-height: 1.75;
}

.schedule-row {
  display: grid;
  grid-template-columns: 92rpx 18rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 16rpx 0;
}

.schedule-time {
  color: #0b6b4f;
  font-weight: 800;
}

.schedule-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #ff6b35;
}

.schedule-copy {
  min-width: 0;
}

.list-item,
.notice-item {
  display: flex;
  gap: 14rpx;
  padding: 8rpx 0;
}

.check {
  color: #18a058;
  font-weight: 800;
}

.notice-item {
  color: #718078;
}
