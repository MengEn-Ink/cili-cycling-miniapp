.detail-page {
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}
.detail-unified-card {
  width: 100%;
}
.detail-hero {
  position: relative;
  height: 360rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-media-placeholder-bg);
}
.hero-gallery,
.hero-media {
  width: 100%;
  height: 100%;
}
.hero-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 100%;
  color: var(--color-media-muted);
  font-size: 24rpx;
}
.cover-count {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-overlay);
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}
.info-head,
.section-heading,
.attendees-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.info-tag {
  padding: 4rpx 16rpx;
  border: 4rpx solid var(--color-media-muted);
  border-radius: 8rpx;
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}
.content {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  margin-top: var(--card-gap);
}
.content > .card,
.content > .official-route-card,
.content > .gpx-route-card,
.content > .detail-decision,
.content > .metric-panel {
  margin-top: 0;
}
.metric-panel {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.detail-decision {
  position: relative;
}
.decision-kicker,
.route-action-note,
.attendees-hint,
.group-qr-detail-hint {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.decision-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.decision-hint {
  margin-top: 8rpx;
  color: var(--color-muted);
}
.decision-capacity {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  text-align: right;
}
.decision-capacity text:first-child {
  font-size: 36rpx;
  font-weight: 900;
}
.time-card {
  margin-top: 0;
}
.time-card-primary {
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
}
.time-card-kicker,
.meeting-location__label {
  color: var(--color-muted);
  font-size: 24rpx;
}
.meeting-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}
.meeting-location__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}
.meeting-location__name {
  font-weight: 800;
}
.time-card-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 24rpx;
}
.section-heading .title {
  flex: 1;
}
.section-tag {
  border: 2rpx solid var(--color-border-strong);
  background: var(--color-surface);
}
.route-action {
  width: 100%;
  margin-top: 24rpx;
}
.inline-feedback {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}
.inline-feedback--success {
  border: 2rpx solid var(--color-status-success);
  background: var(--color-status-success-soft);
  color: var(--color-status-success);
}
.inline-feedback--error {
  border: 4rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
}
.route-native-metrics {
  margin-top: 24rpx;
  border-radius: var(--radius-sm);
}
.route-native-metrics > view {
  min-height: 120rpx;
}
.route-native-metrics > view > text:first-child {
  display: block;
  margin-bottom: 4rpx;
}
.route-estimate {
  display: flex;
  justify-content: space-between;
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  font-weight: 800;
}
.route-estimate text:last-child {
  color: var(--color-action);
  font-variant-numeric: tabular-nums;
}
.route-visual-heading {
  margin-top: 32rpx;
  font-weight: 900;
}
.route-outline-canvas,
.route-outline-image {
  position: relative;
  z-index: 0;
  width: 100%;
  height: 440rpx;
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.elevation-canvas {
  position: relative;
  z-index: 0;
  width: 100%;
  height: 280rpx;
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.route-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 176rpx;
  margin-top: 16rpx;
  border: 4rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-muted);
}
.gpx-download-row {
  margin-top: 24rpx;
}
.attendee-card-strip {
  margin-top: 24rpx;
}
.attendee-card-strip__inner {
  display: flex;
  gap: 24rpx;
}
.attendee-mini-card {
  display: flex;
  flex: 0 0 112rpx;
  flex-direction: column;
  align-items: center;
  min-height: 160rpx;
  background: transparent;
  font-size: 24rpx;
}
.attendee-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}
.group-qr-detail-image {
  width: 320rpx;
  height: 320rpx;
  margin: 24rpx auto 0;
}
.group-qr-locked {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--color-raised);
}
.body-text {
  margin-top: 16rpx;
  white-space: pre-wrap;
}
.route-location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.route-location-copy {
  flex: 1;
}
.route-location-label,
.route-location-address {
  color: var(--color-muted);
  font-size: 24rpx;
}
.route-location-row button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  font-weight: 800;
  line-height: 1.3;
}
.schedule-row {
  display: grid;
  grid-template-columns: 112rpx 24rpx 1fr;
  gap: 16rpx;
  padding: 16rpx 0;
}
.schedule-track {
  display: flex;
  justify-content: center;
  border-left: 2rpx solid var(--color-border);
}
.schedule-dot {
  width: 16rpx;
  height: 16rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.chip-list {
  margin-top: 16rpx;
}
.gear-chip,
.notice-chip,
.fee-item {
  display: flex;
  gap: 16rpx;
  min-height: 72rpx;
  align-items: center;
  border-bottom: 2rpx solid var(--color-border);
}
.check {
  color: var(--color-status-success);
}
.rider-modal-mask {
  position: fixed;
  z-index: 200;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: var(--color-overlay);
}
.rider-card {
  width: 100%;
  margin: 0;
  border-radius: 32rpx 32rpx 0 0;
}
.rider-card-photo {
  position: relative;
  height: 400rpx;
  overflow: hidden;
  background: var(--color-media-card-bg);
}
.rider-card-photo__image {
  width: 100%;
  height: 100%;
}
.rider-card-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-surface);
  font-size: 36rpx;
}
.rider-card-photo__identity {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  left: 32rpx;
  color: var(--color-on-media);
}
.rider-name {
  font-size: 48rpx;
  font-weight: 900;
}
.rider-card-body {
  padding: 32rpx;
}
.detail-action--admin {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.detail-action .btn {
  background: var(--color-action) !important;
}
.detail-action .btn--secondary {
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
@media (max-width: 340px) {
  .time-card-meta {
    flex-direction: column;
  }
}
