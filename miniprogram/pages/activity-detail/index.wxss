.detail-page {
  min-height: 100vh;
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  background: #0b0b0c;
  color: #f7f7f5;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  min-height: 330rpx;
  padding: 30rpx 30rpx 74rpx;
  border-bottom: 1rpx solid #39393d;
  background:
    radial-gradient(circle at 90% 15%, #2c1a14, transparent 36%),
    linear-gradient(145deg, #242427, #0d0d0e 72%);
  color: #f7f7f5;
}

.hero-media,
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(11, 11, 12, 0.38), rgba(11, 11, 12, 0.94));
}

.hero-content {
  position: relative;
  z-index: 2;
}

brand-logo {
  display: block;
  margin-bottom: 26rpx;
}

.hero-sequence {
  position: absolute;
  top: 4rpx;
  right: 2rpx;
  color: #a8a8ad;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.detail-hero .hero-title {
  display: -webkit-box;
  max-width: 620rpx;
  overflow: hidden;
  margin: 8rpx 0 6rpx;
  font-size: 42rpx;
  line-height: 1.16;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.detail-hero .hero-subtitle {
  overflow: hidden;
  max-width: 620rpx;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-arrow,
.button-arrow {
  color: #f38a50;
}

.hero-level {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  margin-top: 16rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid #d55b1f;
  border-radius: 999rpx;
  background: rgba(213, 91, 31, 0.13);
  color: #f38a50;
  font-size: 21rpx;
  font-weight: 800;
}

.hero-corner {
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 0;
  width: 58rpx;
  height: 58rpx;
  background: linear-gradient(135deg, transparent 49%, #d55b1f 50%);
}

.content {
  padding: 0 24rpx;
}

.metric-panel {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rpx;
  margin-top: -46rpx;
  border: 1rpx solid #414146;
  border-radius: 16rpx;
  overflow: hidden;
  background: #414146;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.36);
}

.detail-metric {
  min-width: 0;
  padding: 18rpx 6rpx 16rpx;
  background: #18181a;
  color: #a8a8ad;
  font-size: 24rpx;
  text-align: center;
}

.metric-number {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 32rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-number--text {
  font-size: 26rpx;
}

.metric-label {
  margin-top: 2rpx;
  font-weight: 700;
}

.detail-page .card {
  position: relative;
  overflow: hidden;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #37373b;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #242427, #19191b);
  color: #f7f7f5;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.22);
}

.detail-page .title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
}

.detail-page .muted {
  color: #a8a8ad;
}

.fixed {
  border-top-color: #303034;
  background: rgba(11, 11, 12, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.4);
}

.detail-action .btn {
  min-height: 92rpx;
}

.card-index {
  position: absolute;
  top: 12rpx;
  right: 18rpx;
  color: #4d4d52;
  font-size: 36rpx;
  font-weight: 900;
  font-style: italic;
}

.body-text,
.list-item,
.notice-item {
  color: #b8b8bc;
  line-height: 1.62;
}

.schedule-row {
  display: grid;
  grid-template-columns: 86rpx 18rpx minmax(0, 1fr);
  gap: 12rpx;
  min-height: 76rpx;
  padding: 10rpx 0;
}

.schedule-time {
  color: #f38a50;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.schedule-track {
  position: relative;
  display: flex;
  justify-content: center;
}

.schedule-track::after {
  position: absolute;
  top: 24rpx;
  bottom: -20rpx;
  width: 2rpx;
  background: #3a3a3e;
  content: '';
}

.schedule-row:last-child .schedule-track::after {
  display: none;
}

.schedule-dot {
  position: relative;
  z-index: 1;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  background: #d55b1f;
  transform: rotate(45deg);
}

.schedule-copy {
  min-width: 0;
}

.schedule-copy .muted {
  overflow: hidden;
  margin-top: 2rpx;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item,
.notice-item {
  display: flex;
  gap: 12rpx;
  padding: 6rpx 0;
}

.check {
  color: #d55b1f;
  font-weight: 900;
}

.notice-item {
  color: #a8a8ad;
}

.notice-mark {
  color: #c82018;
  font-weight: 900;
}

.button-arrow {
  margin-left: 16rpx;
  color: #f7f7f5;
}

@media (max-width: 350px) {
  .detail-hero {
    min-height: 306rpx;
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .detail-hero .hero-title {
    font-size: 38rpx;
  }

  .content {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .metric-number {
    font-size: 29rpx;
  }
}

/* Design reference alignment. */
.detail-page {
  background: #000;
  color: #f7f7f5;
}

.detail-hero {
  border-bottom-color: #3a3a3c;
  background: #121212;
}

.hero-level {
  border-color: #ff5722;
  border-radius: 16rpx;
  background: rgba(255, 87, 34, 0.14);
  color: #ff8a65;
}

.hero-corner,
.schedule-dot {
  background: #ff5722;
}

.content {
  padding-right: 40rpx;
  padding-left: 40rpx;
}

.metric-panel,
.detail-page .card {
  border-color: #3a3a3c;
  border-radius: 40rpx;
  background: #1c1c1e;
  color: #f7f7f5;
  box-shadow: none;
}

.detail-metric {
  background: #2c2c2e;
  color: #a8a8ad;
  font-size: 24rpx;
}

.schedule-time,
.check,
.route-arrow {
  color: #ff5722;
}

.detail-action .btn {
  min-height: 104rpx;
  border-radius: 24rpx !important;
  background: #ff5722 !important;
}

@media (max-width: 320px) {
  .content {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }
}
