.detail-page {
  min-height: 100vh;
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  background: #000;
  color: #f7f7f5;
}

.detail-hero {
  position: relative;
  box-sizing: border-box;
  min-height: 356rpx;
  overflow: hidden;
  padding: 24rpx 32rpx 72rpx;
  border-bottom: 1rpx solid #343438;
  background: #121212;
  color: #f7f7f5;
}

.detail-hero--media {
  min-height: 420rpx;
}

.hero-gallery,
.hero-media,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-gallery {
  z-index: 1;
}

.hero-shade {
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.22) 0%,
    rgba(0, 0, 0, 0.42) 38%,
    rgba(0, 0, 0, 0.94) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 3;
}

.hero-brand-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 74rpx;
}

brand-logo {
  display: block;
}

.hero-sequence {
  padding-top: 4rpx;
  color: #b5b5ba;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-kicker {
  margin-top: 24rpx;
  color: #d2d2d6;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.detail-hero .hero-title {
  display: -webkit-box;
  max-width: 650rpx;
  margin: 8rpx 0 8rpx;
  overflow: hidden;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.14;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-route {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 650rpx;
  overflow: hidden;
  color: #d2d2d6;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-route text:not(.route-arrow) {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-arrow,
.schedule-time,
.check {
  flex: 0 0 auto;
  color: #ff5722;
}

.hero-level {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-top: 14rpx;
  padding: 2rpx 14rpx;
  border: 1rpx solid #ff5722;
  border-radius: 16rpx;
  background: rgba(255, 87, 34, 0.12);
  color: #ff9b7b;
  font-size: 21rpx;
  font-weight: 800;
}

.content {
  padding: 0 32rpx;
}

.metric-panel {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: -44rpx;
  overflow: hidden;
  border: 1rpx solid #3a3a3c;
  border-radius: 32rpx;
  background: #1c1c1e;
}

.detail-metric {
  min-width: 0;
  padding: 18rpx 8rpx 16rpx;
  background: #1c1c1e;
  color: #b5b5ba;
  font-size: 24rpx;
  text-align: center;
}

.detail-metric + .detail-metric {
  border-left: 1rpx solid #3a3a3c;
}

.metric-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-height: 42rpx;
  overflow: hidden;
  white-space: nowrap;
}

.metric-number {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
}

.metric-number--text {
  font-size: 24rpx;
}

.metric-unit {
  margin-left: 5rpx;
  color: #b5b5ba;
  font-size: 18rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 3rpx;
  font-weight: 600;
}

.detail-page .card {
  position: relative;
  margin-top: 16rpx;
  overflow: hidden;
  padding: 22rpx 24rpx;
  border: 1rpx solid #343438;
  border-radius: 32rpx;
  background: #1c1c1e;
  color: #f7f7f5;
}

.detail-page .title {
  margin-bottom: 10rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.detail-page .muted {
  color: #b5b5ba;
}

.card-index {
  position: absolute;
  top: 14rpx;
  right: 20rpx;
  color: #5d5d62;
  font-size: 30rpx;
  font-style: italic;
  font-weight: 900;
}

.body-text,
.list-item,
.notice-item {
  color: #c4c4c8;
  line-height: 1.55;
}

.schedule-row {
  display: grid;
  grid-template-columns: 82rpx 18rpx minmax(0, 1fr);
  gap: 10rpx;
  min-height: 64rpx;
  padding: 7rpx 0;
}

.schedule-time {
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.schedule-track {
  position: relative;
  display: flex;
  justify-content: center;
}

.schedule-track::after {
  position: absolute;
  top: 22rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #48484d;
  content: '';
}

.schedule-row:last-child .schedule-track::after {
  display: none;
}

.schedule-dot {
  position: relative;
  z-index: 1;
  width: 11rpx;
  height: 11rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: #ff5722;
}

.schedule-copy {
  min-width: 0;
}

.schedule-copy .muted {
  margin-top: 2rpx;
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item,
.notice-item {
  display: flex;
  gap: 12rpx;
  padding: 5rpx 0;
}

.notice-item {
  color: #b5b5ba;
}

.notice-mark {
  color: #ff8a65;
  font-weight: 900;
}

.route-location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #3a3a3c;
  color: #f7f7f5;
  overflow-wrap: anywhere;
}

.route-location-copy {
  min-width: 0;
}

.route-location-row button {
  flex: 0 0 auto;
  min-width: 112rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #ff5722;
  border-radius: 16rpx;
  background: transparent;
  color: #ff9b7b;
  font-size: 24rpx;
  line-height: 62rpx;
}

.route-location-label {
  margin-bottom: 4rpx;
  color: #b5b5ba;
  font-size: 22rpx;
}

.fixed {
  border-top-color: #2c2c2e;
  background: rgba(11, 11, 12, 0.94);
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.3);
}

.detail-action {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.detail-action .btn {
  min-height: 88rpx;
  border-radius: 24rpx !important;
  background: #ff5722 !important;
}

.detail-action .btn[disabled] {
  background: #2c2c2e !important;
  color: #8e8e93;
}

.button-arrow {
  margin-left: 14rpx;
  color: currentColor;
}

@media (max-width: 350px) {
  .detail-hero {
    min-height: 330rpx;
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .detail-hero--media {
    min-height: 390rpx;
  }

  .detail-hero .hero-title {
    font-size: 40rpx;
  }

  .content {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .metric-number {
    font-size: 30rpx;
  }
}
