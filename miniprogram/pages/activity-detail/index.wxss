.detail-page {
  min-height: 100vh;
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  background: #000;
  color: #f7f7f5;
}

.theme-light .detail-hero {
  --color-brand: #d55b1f;
  --color-brand-active: #a94416;
  --color-brand-soft: rgba(213, 91, 31, 0.14);
  --color-on-brand: #0b0b0c;
}

.detail-hero {
  position: relative;
  box-sizing: border-box;
  min-height: 356rpx;
  overflow: hidden;
  padding: 24rpx var(--page-gutter) 72rpx;
  border-bottom: 1rpx solid #343438;
  background: #121212;
  color: #f7f7f5;
}

.detail-hero--media {
  min-height: 420rpx;
}

.hero-gallery,
.hero-media,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-gallery {
  z-index: 1;
}

.hero-shade {
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.22) 0%,
    rgba(0, 0, 0, 0.42) 38%,
    rgba(0, 0, 0, 0.94) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 3;
}

.hero-brand-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 74rpx;
}

brand-logo {
  display: block;
}

.hero-sequence {
  padding-top: 4rpx;
  color: #b5b5ba;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-kicker {
  margin-top: 24rpx;
  color: #d2d2d6;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.detail-hero .hero-title {
  display: -webkit-box;
  max-width: 650rpx;
  margin: 8rpx 0 8rpx;
  overflow: hidden;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.14;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-route {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 650rpx;
  overflow: hidden;
  color: #d2d2d6;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-route text:not(.route-arrow) {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-arrow,
.schedule-time,
.check {
  flex: 0 0 auto;
  color: var(--color-brand);
}

.hero-level {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-top: 14rpx;
  padding: 2rpx 14rpx;
  border: 1rpx solid var(--color-brand);
  border-radius: 16rpx;
  background: rgba(255, 87, 34, 0.12);
  color: var(--color-brand);
  font-size: 21rpx;
  font-weight: 800;
}

.content {
  padding: 0 var(--page-gutter);
}

.metric-panel {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: -44rpx;
  overflow: hidden;
  border: 1rpx solid #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.detail-metric {
  min-width: 0;
  padding: 18rpx 8rpx 16rpx;
  background: #1c1c1e;
  color: #b5b5ba;
  font-size: 24rpx;
  text-align: center;
}

.detail-metric + .detail-metric {
  border-left: 1rpx solid #3a3a3c;
}

.metric-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-height: 42rpx;
  flex-wrap: wrap;
}

.metric-number {
  min-width: 0;
  max-width: 100%;
  color: #f7f7f5;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.metric-number--text {
  font-size: 24rpx;
}

.metric-unit {
  margin-left: 5rpx;
  color: #b5b5ba;
  font-size: 18rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 3rpx;
  font-weight: 600;
}

.detail-page .card {
  position: relative;
  margin-top: 16rpx;
  overflow: hidden;
  padding: 22rpx 24rpx;
  border: 1rpx solid #343438;
  border-radius: var(--radius-display);
  background: #1c1c1e;
  color: #f7f7f5;
}

.detail-page .title {
  margin-bottom: 10rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.detail-page .muted {
  color: #b5b5ba;
}

.card-index {
  position: absolute;
  top: 14rpx;
  right: 20rpx;
  color: #5d5d62;
  font-size: 30rpx;
  font-style: italic;
  font-weight: 900;
}

.body-text,
.list-item,
.notice-item {
  color: #c4c4c8;
  line-height: 1.55;
}

.schedule-row {
  display: grid;
  grid-template-columns: 82rpx 18rpx minmax(0, 1fr);
  gap: 10rpx;
  min-height: 64rpx;
  padding: 7rpx 0;
}

.schedule-time {
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.schedule-track {
  position: relative;
  display: flex;
  justify-content: center;
}

.schedule-track::after {
  position: absolute;
  top: 22rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #48484d;
  content: '';
}

.schedule-row:last-child .schedule-track::after {
  display: none;
}

.schedule-dot {
  position: relative;
  z-index: 1;
  width: 11rpx;
  height: 11rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: var(--color-brand);
}

.schedule-copy {
  min-width: 0;
}

.schedule-copy .muted {
  margin-top: 2rpx;
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item,
.notice-item {
  display: flex;
  gap: 12rpx;
  padding: 5rpx 0;
}

.notice-item {
  color: #b5b5ba;
}

.notice-mark {
  color: var(--color-brand);
  font-weight: 900;
}

.route-location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #3a3a3c;
  color: #f7f7f5;
  overflow-wrap: anywhere;
}

.route-location-copy {
  min-width: 0;
}

.route-location-row button {
  flex: 0 0 auto;
  min-width: 112rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-brand);
  border-radius: 16rpx;
  background: transparent;
  color: var(--color-brand);
  font-size: 24rpx;
  line-height: 62rpx;
}

.route-location-label {
  margin-bottom: 4rpx;
  color: #b5b5ba;
  font-size: 22rpx;
}

.fixed {
  border-top-color: #2c2c2e;
  background: rgba(11, 11, 12, 0.94);
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.3);
}

.detail-action {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.detail-action .btn {
  min-height: 88rpx;
  border-radius: 24rpx !important;
  background: var(--color-brand) !important;
}

.detail-action .btn[disabled] {
  background: #2c2c2e !important;
  color: #8e8e93;
}

.button-arrow {
  margin-left: 14rpx;
  color: currentColor;
}

@media (max-width: 350px) {
  .detail-hero {
    min-height: 330rpx;
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }

  .detail-hero--media {
    min-height: 390rpx;
  }

  .detail-hero .hero-title {
    font-size: 40rpx;
  }

  .content {
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }

  .metric-number {
    font-size: 30rpx;
  }
}

.time-row,
.attendees-heading,
.climb-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.time-row {
  padding: 9rpx 0;
  color: #b5b5ba;
  font-size: 23rpx;
}

.time-row text:last-child {
  color: #f7f7f5;
  font-variant-numeric: tabular-nums;
}

.elevation-canvas {
  width: 100%;
  height: 300rpx;
  margin-top: 12rpx;
}

.route-empty {
  padding: 38rpx 0;
  color: #8e8e93;
  text-align: center;
}

.climb-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #343438;
}

.climb-name {
  min-width: 0;
  overflow: hidden;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.climb-popularity {
  flex: 0 0 auto;
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 87, 34, 0.14);
  color: var(--color-brand);
  font-size: 20rpx;
}

.climb-row .muted {
  margin-top: 7rpx;
  font-size: 22rpx;
}

.avatar-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  padding: 8rpx 0 4rpx;
}

.attendees-hint {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.4;
}

.attendee-avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--control-height);
  height: var(--control-height);
  margin: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}

.attendee-avatar-button::after {
  border: 0;
}

.attendee-avatar,
.rider-card-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 70rpx;
  height: 70rpx;
  border: 4rpx solid #1c1c1e;
  border-radius: 50%;
}

.attendee-avatar--default {
  background: var(--color-brand);
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
}

.route-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.route-actions button {
  min-width: 0;
  min-height: var(--control-height);
  margin: 0;
  border: 1rpx solid var(--color-brand);
  border-radius: 16rpx;
  background: transparent;
  color: var(--color-brand);
  font-size: 23rpx;
  line-height: 1.2;
}

.rider-modal-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.76);
}

.rider-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 620rpx;
  max-height: calc(100vh - 96rpx);
  padding: 30rpx;
  overflow-y: auto;
  border: 1rpx solid #444448;
  border-radius: var(--radius-display);
  background: #1c1c1e;
  color: #f7f7f5;
  box-shadow: 0 18rpx 70rpx rgba(0, 0, 0, 0.5);
}

.rider-card-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--control-height);
  height: var(--control-height);
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 50%;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 1;
}

.rider-card-close::after {
  border: 0;
}

.rider-card-kicker {
  margin-bottom: 22rpx;
  color: var(--color-brand);
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.rider-card-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rider-card-avatar {
  flex: 0 0 auto;
  width: 92rpx;
  height: 92rpx;
  border-color: #343438;
}

.rider-name {
  font-size: 32rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.rider-identity {
  min-width: 0;
  padding-right: 120rpx;
}

.rider-status {
  display: inline-flex;
  min-height: 34rpx;
  margin-top: 10rpx;
  padding: 2rpx 12rpx;
  align-items: center;
  border: 1rpx solid rgba(255, 87, 34, 0.5);
  border-radius: 999rpx;
  background: rgba(255, 87, 34, 0.12);
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 800;
}

.rider-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.rider-stats > view {
  display: flex;
  flex-direction: column;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #29292c;
}

.rider-stat-value {
  color: var(--color-brand);
  font-size: 30rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.rider-stat-value text {
  margin-left: 4rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.rider-stats > view > text:last-child {
  margin-top: 4rpx;
  color: #aaaab0;
  font-size: 21rpx;
}

.rider-card-note {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

/* Keep hero/media overlays dark and white; adapt surrounding content chrome. */
.detail-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.detail-hero:not(.detail-hero--media) {
  border-color: var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}
.metric-panel,
.detail-metric,
.detail-page .card,
.rider-card {
  border-color: var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}
.detail-metric + .detail-metric,
.route-location-row,
.climb-row {
  border-color: var(--color-border);
}
.metric-number,
.route-location-row,
.time-row text:last-child,
.rider-name {
  color: var(--color-text);
}
.detail-metric,
.metric-unit,
.body-text,
.list-item,
.notice-item,
.time-row,
.route-empty,
.rider-stats > view > text:last-child {
  color: var(--color-muted);
}
.fixed {
  border-color: var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -6rpx 20rpx var(--color-shadow);
}
.detail-action .btn {
  border-radius: var(--radius-display) !important;
  background: var(--color-brand) !important;
}
.route-location-row button,
.route-actions button {
  min-height: 88rpx;
  border-color: var(--color-brand);
  border-radius: var(--radius-md);
  color: var(--color-brand);
}
.attendee-avatar-button {
  display: flex;
  width: var(--control-height);
  height: var(--control-height);
  align-items: center;
  justify-content: center;
  margin: 0;
}
.attendee-avatar,
.rider-card-avatar {
  border-color: var(--color-surface);
}
.rider-modal-mask {
  background: var(--color-overlay);
}
.rider-card {
  border-radius: var(--radius-display);
  box-shadow: 0 18rpx 70rpx var(--color-shadow);
}
.rider-stats > view {
  border-radius: var(--radius-md);
  background: var(--color-raised);
}
