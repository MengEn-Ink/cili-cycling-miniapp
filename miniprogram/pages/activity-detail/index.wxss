/* 骑行影像志 · 活动详情 1:1 实现
 * 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/activity-detail.html：
 *   photo.hero.detail → ink(metrics + 行) → content(section × N) → decision → actionbar
 */

.detail-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

/* --- hero：首屏画面 ------------------------------------------------------- */
.photo.hero.detail {
  position: relative;
  width: calc(100% + var(--page-gutter) * 2);
  margin: 0 calc(0rpx - var(--page-gutter));
  aspect-ratio: 16 / 9;
  background: var(--color-media-placeholder-bg);
  color: var(--color-on-media);
  overflow: hidden;
}
.hero-gallery,
.hero-media {
  width: 100%;
  height: 100%;
}
.shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--gradient-cover);
  pointer-events: none;
}
.corner {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.tag.dark {
  background: var(--color-scrim-dark);
  color: var(--color-on-media);
}
.caption {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  color: var(--color-on-media);
}
.caption .eyebrow {
  display: inline-flex;
  align-items: center;
  color: var(--color-on-media);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  line-height: 32rpx;
  text-transform: uppercase;
}
.hero-title {
  margin-top: 12rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 76rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  color: var(--color-on-media);
}
.hero-sub {
  margin-top: 8rpx;
  color: var(--color-on-media);
  font-size: 26rpx;
  line-height: 38rpx;
  opacity: 0.86;
}
.cover-count {
  position: absolute;
  bottom: 32rpx;
  right: 32rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-media-scrim);
  color: var(--color-on-media);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
}

.refresh-note {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.refresh-note.refresh-error {
  color: var(--color-brand);
}

/* --- ink：metrics + 集合行 ----------------------------------------------- */
.ink {
  margin-top: 32rpx;
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-surface);
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx 32rpx;
}
.metrics > view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.metrics .em {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 56rpx;
  line-height: 64rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}
.metrics .em .unit {
  color: var(--color-muted);
  font-family: var(--font-family-body);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.metrics text {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.ink-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}
.lead {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}
.rowicon {
  flex: none;
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 14rpx;
  background: var(--color-bg);
  position: relative;
}
.rowicon--clock::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  content: '';
}
.rowicon--clock::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 2rpx;
  height: 10rpx;
  background: var(--color-text);
  transform: translate(-50%, -100%);
  content: '';
}
.rowtext {
  flex: 1;
  min-width: 0;
}
.rowtext .em {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 900;
}
.rowtext .sub {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 34rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  margin-top: 48rpx;
}
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.chapterhead-title {
  flex: none;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-rule {
  flex: 1;
  min-width: 0;
  height: 2rpx;
  background: var(--color-border);
}
.chapterhead-aside {
  flex: none;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  line-height: 32rpx;
}
.section-prose {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
}

.paper {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}

/* --- row 通用 ------------------------------------------------------------- */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}
.row.rowlink {
  text-align: left;
}
.club-avatar {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-raised);
}
.club-avatar--placeholder {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-weight: 900;
}
.chev {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--color-text);
  border-right: 2rpx solid var(--color-text);
  transform: rotate(45deg);
}
.route-difficulty {
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--color-border-strong);
  background: var(--color-raised);
  border-radius: 12rpx;
}
.route-difficulty__label {
  color: var(--color-muted);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.route-difficulty__text {
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 38rpx;
}

/* --- detailrows ----------------------------------------------------------- */
.detailrows {
  display: flex;
  flex-direction: column;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  overflow: hidden;
}
.detailrow {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--color-surface);
}
.detailrow + .detailrow {
  border-top: 2rpx solid var(--color-border-subtle);
}
.detailrow-term {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.detailrow-desc {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
  word-break: normal;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn[disabled] {
  opacity: 0.6;
}
.btn.secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.meeting-cta,
.route-analysis-cta {
  width: 100%;
}
.route-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* --- notice --------------------------------------------------------------- */
.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.notice--success {
  border-style: solid;
  border-color: var(--color-status-success);
  color: var(--color-status-success);
}
.notice--warning {
  border-style: solid;
  border-color: var(--color-status-warning);
  color: var(--color-status-warning);
}

/* --- 一起出发的骑友 ------------------------------------------------------- */
.riderlist {
  width: calc(100% + var(--page-gutter) * 2);
  margin: 0 calc(0rpx - var(--page-gutter));
  white-space: nowrap;
}
.riderlist-inner {
  display: inline-flex;
  gap: 24rpx;
  padding: 0 var(--page-gutter);
}
.rider {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 180rpx;
  padding: 20rpx 12rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  color: var(--color-text);
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-raised);
}
.avatar.initialavatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-weight: 900;
  font-size: 36rpx;
}
.rider-name {
  width: 100%;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rider-meta {
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}
.rider-authorize {
  margin-top: 8rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 800;
}

/* --- 行前约定 chip-list --------------------------------------------------- */
.notes-paper {
  gap: 16rpx;
}
.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.chip-list-label {
  width: 100%;
  color: var(--color-muted);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.gear-chip,
.notice-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-text);
}
.check {
  color: var(--color-brand);
  font-weight: 900;
}
.notice-mark {
  color: var(--color-muted);
}

/* --- 时间安排 ------------------------------------------------------------- */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}
.schedule-item {
  display: grid;
  grid-template-columns: 120rpx 20rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: start;
}
.schedule-time {
  color: var(--color-text);
  font-family: var(--font-family-mono);
  font-size: 26rpx;
  font-weight: 800;
}
.schedule-track {
  position: relative;
  width: 2rpx;
  margin: 10rpx auto 0;
  min-height: 24rpx;
  background: var(--color-border-strong);
}
.schedule-dot {
  position: absolute;
  top: 0;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.schedule-copy {
  min-width: 0;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 38rpx;
}
.muted {
  color: var(--color-muted);
}

/* --- 费用 ---------------------------------------------------------------- */
.fee-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.fee-block-title {
  color: var(--color-muted);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.fee-item {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 38rpx;
}
.fee-mark {
  font-weight: 900;
}
.fee-included {
  color: var(--color-brand);
}
.fee-excluded {
  color: var(--color-muted);
}

.group-paper {
  align-items: stretch;
}
.group-qr-frame {
  box-sizing: border-box;
  width: 100%;
  max-width: 520rpx;
  margin: 4rpx auto 0;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-raised);
}
.group-qr-image {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  background: var(--color-surface);
}
.group-qr-hint {
  text-align: center;
  font-size: 22rpx;
}

.decision {
  margin-top: 48rpx;
  padding: 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 28rpx;
  background: var(--color-text);
  color: var(--color-on-action);
}
.decision-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.decision-kicker {
  color: var(--color-on-action);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  opacity: 0.76;
}
.decision-title {
  color: var(--color-on-action);
  font-family: var(--font-family-editorial);
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
}
.decision-hint {
  margin-top: 12rpx;
  color: var(--color-on-action);
  font-size: 26rpx;
  line-height: 40rpx;
  opacity: 0.88;
}
.decision-capacity {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 16rpx;
  color: var(--color-on-action);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* --- 固定底部 actionbar -------------------------------------------------- */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-border);
}
.actionbar .btn {
  flex: 1;
}
.actionbar--admin .btn.secondary {
  flex: 0 0 auto;
  min-width: 200rpx;
}

/* --- dialog（骑手公开名片）---------------------------------------------- */
.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: var(--color-scrim-dark);
}
.dialog {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  background: var(--color-surface);
  border-radius: 32rpx;
  overflow: hidden;
}
.dialog-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: var(--color-control-scrim);
  color: var(--color-on-media);
  font-size: 36rpx;
  line-height: 64rpx;
}
.rider-dialog-swiper {
  width: 100%;
  height: 820rpx;
}
.rider-dialog-photo {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--color-media-placeholder-bg);
}
.rider-dialog-photo__image {
  width: 100%;
  height: 100%;
}
.rider-dialog-photo__scrim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--gradient-dialog-cover);
}
.rider-dialog-photo__identity {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 96rpx;
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  color: var(--color-on-media);
}
.rider-dialog-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-raised);
  border: 3rpx solid var(--color-on-media);
}
.rider-dialog-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  color: var(--color-on-media);
  background: var(--color-on-media-surface);
}
.rider-dialog-copy {
  flex: 1;
  min-width: 0;
}
.rider-dialog-kicker {
  color: var(--color-on-media);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  opacity: 0.76;
}
.rider-dialog-name {
  margin-top: 4rpx;
  color: var(--color-on-media);
  font-family: var(--font-family-editorial);
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 900;
}
.rider-dialog-status {
  margin-top: 4rpx;
  color: var(--color-on-media);
  font-size: 24rpx;
  opacity: 0.86;
}
.rider-dialog-note {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  color: var(--color-on-media);
  font-size: 22rpx;
  opacity: 0.72;
}
.rider-dialog-pagination {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

@media (max-width: 350px) {
  .hero-title {
    font-size: 52rpx;
    line-height: 64rpx;
  }
  .metrics .em {
    font-size: 44rpx;
    line-height: 52rpx;
  }
}

/* 2026-10 layout convergence: one clear CTA and protected final content. */
.detail-page {
  padding-bottom: calc(var(--action-bar-height) + 80rpx + env(safe-area-inset-bottom));
}
.ink {
  position: relative;
  z-index: 3;
  margin-top: -32rpx;
}
.section-fee,
.section-meeting {
  scroll-margin-top: 32rpx;
}
.route-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.actionbar::before {
  position: absolute;
  right: 0;
  bottom: 100%;
  left: 0;
  height: 48rpx;
  background: linear-gradient(to top, var(--color-bg), transparent);
  pointer-events: none;
  content: '';
}

/* 单行指标与骑友名片媒体降级 */
.metrics .em,
.detailrow-desc,
.rider-name,
.rider-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rider-dialog-photo--fallback {
  background: linear-gradient(145deg, var(--color-action) 0%, var(--color-text) 100%);
}
.rider-dialog-photo--fallback::before {
  position: absolute;
  top: 18%;
  right: 18%;
  bottom: 18%;
  left: 18%;
  border: 1rpx solid var(--color-on-media);
  border-radius: 50%;
  opacity: 0.18;
  content: '';
}

/* 2026-10-28 · Direction A / 一镜到底 */
.detail-page {
  --color-bg: var(--color-cinema-bg);
  --color-surface: var(--color-cinema-panel);
  --color-raised: var(--color-cinema-panel-raised);
  --color-text: var(--color-cinema-text);
  --color-muted: var(--color-cinema-muted);
  --color-border: var(--color-cinema-line);
  --color-border-subtle: var(--color-cinema-line);
  --color-card-border: var(--color-cinema-line);
  padding-bottom: calc(var(--action-bar-height) + 96rpx + env(safe-area-inset-bottom));
  background: var(--color-cinema-bg);
  color: var(--color-cinema-text);
}
.detail-page .photo.hero.detail {
  aspect-ratio: 5 / 4;
  border-bottom: 2rpx solid var(--color-cinema-line);
}
.detail-page .shade {
  background: var(--gradient-cover-opening);
}
.detail-page .caption {
  right: 36rpx;
  bottom: 36rpx;
  left: 36rpx;
}
.detail-page .hero-title {
  color: var(--color-cinema-text);
  font-size: 68rpx;
  line-height: 78rpx;
}
.detail-page .hero-sub,
.detail-page .caption .eyebrow {
  color: var(--color-cinema-text);
}
.detail-page .ink {
  width: calc(100% + var(--page-gutter) * 2);
  margin: 0 calc(0rpx - var(--page-gutter));
  padding: 0;
  border: 0;
  border-bottom: 2rpx solid var(--color-cinema-line);
  border-radius: 0;
  background: var(--color-cinema-bg);
  box-shadow: none;
}
.detail-page .metrics {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
}
.detail-page .metrics > view {
  min-width: 0;
  padding: 24rpx 16rpx;
  border-right: 2rpx solid var(--color-cinema-line);
}
.detail-page .metrics > view:last-child {
  border-right: 0;
}
.detail-page .metrics .em {
  overflow: hidden;
  color: var(--color-cinema-text);
  font-family: var(--font-family-mono);
  font-size: 40rpx;
  line-height: 50rpx;
  text-overflow: ellipsis;
}
.detail-page .metrics .em .unit,
.detail-page .metrics text {
  color: var(--color-cinema-muted);
  font-size: 20rpx;
}
.detail-page .ink-row {
  margin: 0;
  padding: 24rpx var(--page-gutter);
  border-color: var(--color-cinema-line);
}
.detail-page .ink-capacity {
  flex: none;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  min-height: 64rpx;
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid var(--color-cinema-line);
  color: var(--color-cinema-muted);
  font-family: var(--font-family-mono);
  font-size: 20rpx;
  line-height: 28rpx;
}
.detail-page .ink-capacity text:last-child {
  color: var(--color-cinema-text);
  font-size: 26rpx;
  font-weight: 900;
}
.detail-page .rowicon,
.detail-page .rowicon--clock::before {
  border-color: var(--color-cinema-text);
}
.detail-page .rowicon {
  background: var(--color-cinema-panel);
}
.detail-page .rowicon--clock::after {
  background: var(--color-cinema-text);
}
.detail-page .rowtext .em,
.detail-page .section-prose,
.detail-page .chapterhead-title,
.detail-page .detailrow-desc,
.detail-page .schedule-time,
.detail-page .schedule-copy,
.detail-page .fee-item,
.detail-page .rider,
.detail-page .rider-name {
  color: var(--color-cinema-text);
}
.detail-page .content {
  gap: 48rpx;
  margin-top: 56rpx;
}
.detail-page .chapterhead {
  position: relative;
  align-items: baseline;
  padding-left: 20rpx;
}
.detail-page .chapterhead::before {
  position: absolute;
  top: 4rpx;
  bottom: 4rpx;
  left: 0;
  width: 6rpx;
  background: var(--color-cinema-red);
  content: '';
}
.detail-page .chapterhead-rule {
  background: var(--color-cinema-line);
}
.detail-page .chapterhead-aside {
  max-width: 48%;
  text-align: right;
  white-space: normal;
}
.detail-page .paper,
.detail-page .row,
.detail-page .detailrow,
.detail-page .schedule-list,
.detail-page .rider {
  border-color: var(--color-cinema-line);
  background: var(--color-cinema-panel);
}
.detail-page .paper,
.detail-page .row,
.detail-page .schedule-list,
.detail-page .rider {
  border-radius: 16rpx;
}
.detail-page .route-difficulty {
  border-color: var(--color-cinema-red);
  background: var(--color-cinema-panel-raised);
}
.detail-page .route-difficulty__text,
.detail-page .fee-block-title,
.detail-page .chip-list-label,
.detail-page .detailrow-term,
.detail-page .rowtext .sub,
.detail-page .rider-meta,
.detail-page .muted {
  color: var(--color-cinema-muted);
}
.detail-page .chev {
  border-color: var(--color-cinema-text);
}
.detail-page .gear-chip,
.detail-page .notice-chip {
  border-color: var(--color-cinema-line);
  color: var(--color-cinema-text);
}
.detail-page .notice {
  border-color: var(--color-cinema-line);
  background: var(--color-cinema-panel);
  color: var(--color-cinema-muted);
}
.detail-page .notice-dot,
.detail-page .schedule-dot {
  background: var(--color-cinema-red);
}
.detail-page .btn {
  border-color: var(--color-cinema-red);
  border-radius: 10rpx;
  background: var(--color-cinema-red);
  color: var(--color-on-action);
}
.detail-page .btn.secondary {
  border-color: var(--color-border-strong);
  background: var(--color-cinema-panel);
  color: var(--color-cinema-text);
}
.detail-page .group-qr-frame {
  border-color: var(--color-border-strong);
  background: var(--color-input-bg);
}
.detail-page .decision {
  position: relative;
  overflow: hidden;
  border-color: var(--color-cinema-line);
  border-radius: 16rpx;
  background: var(--color-cinema-panel);
  color: var(--color-cinema-text);
}
.detail-page .decision::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 8rpx;
  background: var(--color-cinema-red);
  content: '';
}
.detail-page .decision-title,
.detail-page .decision-kicker,
.detail-page .decision-hint,
.detail-page .decision-capacity {
  color: var(--color-cinema-text);
}
.detail-page .actionbar {
  border-color: var(--color-cinema-line);
  background: var(--color-fixed-bar);
  box-shadow: var(--shadow-actionbar);
}
.detail-page .actionbar::before {
  background: linear-gradient(to top, var(--color-cinema-bg), transparent);
}

/* React Bits 动效语言的小程序转译：一次性短时入场，不锁滚动、不循环。 */
.detail-page .photo.hero.detail {
  animation: detail-hero-enter 560ms cubic-bezier(0.2, 0, 0, 1) both;
}
.detail-page .hero-media,
.detail-page .hero-gallery,
.detail-page generated-activity-cover {
  animation: detail-media-settle 680ms 80ms cubic-bezier(0.2, 0, 0, 1) both;
}
.detail-page .caption .eyebrow,
.detail-page .hero-title,
.detail-page .hero-sub {
  animation: detail-copy-enter 420ms cubic-bezier(0.2, 0, 0, 1) both;
}
.detail-page .hero-title {
  animation-delay: 120ms;
}
.detail-page .hero-sub {
  animation-delay: 200ms;
}
.detail-page .ink {
  animation: detail-facts-enter 380ms 220ms cubic-bezier(0.2, 0, 0, 1) both;
}
.detail-page .content > .section:nth-child(-n + 4) {
  animation: detail-facts-enter 360ms cubic-bezier(0.2, 0, 0, 1) both;
}
.detail-page .content > .section:nth-child(1) {
  animation-delay: 260ms;
}
.detail-page .content > .section:nth-child(2) {
  animation-delay: 300ms;
}
.detail-page .content > .section:nth-child(3) {
  animation-delay: 340ms;
}
.detail-page .content > .section:nth-child(4) {
  animation-delay: 380ms;
}
.detail-page .btn:active,
.detail-page .rider:active,
.detail-page .club-row:active {
  opacity: 0.84;
  transform: translateY(2rpx);
}

@keyframes detail-hero-enter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes detail-media-settle {
  from {
    opacity: 0.82;
    transform: scale(1.025);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes detail-copy-enter {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes detail-facts-enter {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .detail-page .photo.hero.detail,
  .detail-page .hero-media,
  .detail-page .hero-gallery,
  .detail-page generated-activity-cover,
  .detail-page .caption .eyebrow,
  .detail-page .hero-title,
  .detail-page .hero-sub,
  .detail-page .ink,
  .detail-page .content > .section {
    animation: none;
  }
}

@media (max-width: 350px) {
  .detail-page .hero-title {
    font-size: 56rpx;
    line-height: 68rpx;
  }
  .detail-page .metrics .em {
    font-size: 34rpx;
  }
  .detail-page .ink-capacity {
    margin-left: 12rpx;
    padding-left: 12rpx;
  }
}
