<view class="async-status async-status--{{state}}" role="status" aria-live="polite"><view class="async-status__rail" aria-hidden="true"></view><view class="async-status__body"><view class="async-status__head"><view class="async-status__dot" aria-hidden="true"></view><text class="async-status__title">{{title}}</text></view><text wx:if="{{detail}}" class="async-status__detail">{{detail}}</text><button wx:if="{{actionLabel}}" class="async-status__action" bindtap="onAction">{{actionLabel}}</button></view></view>
