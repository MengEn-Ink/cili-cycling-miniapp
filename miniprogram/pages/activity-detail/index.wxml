<view class="detail-page">
  <state-view loading="{{loading}}" error="{{error}}">
    <view wx:if="{{item}}">
      <view class="detail-hero {{galleryImages.length && !coverFailed ? 'detail-hero--media' : 'detail-hero--plain'}}">
        <swiper wx:if="{{galleryImages.length > 1 && !coverFailed}}" class="hero-gallery" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.4)" indicator-active-color="#ff5722" circular="{{true}}">
          <swiper-item wx:for="{{galleryImages}}" wx:for-item="media" wx:key="*this">
            <image class="hero-media" src="{{media}}" mode="aspectFill" data-index="{{index}}" binderror="galleryImageError" aria-label="活动图片 {{index + 1}}" />
          </swiper-item>
        </swiper>
        <image wx:elif="{{galleryImages.length === 1 && !coverFailed}}" class="hero-media" src="{{galleryImages[0]}}" mode="aspectFill" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
        <view class="hero-shade" wx:if="{{galleryImages.length && !coverFailed}}"></view>
        <view class="hero-content">
          <view class="hero-brand-row"><brand-logo compact="{{true}}" meta="RIDE DETAIL" /><view class="hero-sequence">RIDE / 01</view></view>
          <view class="hero-kicker" aria-label="{{displayDate}}">{{displayDate}}</view>
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-route" wx:if="{{item.route.start || item.route.end}}">
            <text>{{item.route.start}}</text><text class="route-arrow">→</text><text>{{item.route.end}}</text>
          </view>
          <view class="hero-level" wx:if="{{item.route.level}}">{{item.route.level}}</view>
        </view>
      </view>

      <view class="content">
        <view class="metric-panel" aria-label="活动关键数据">
          <view class="detail-metric">
            <view class="metric-value"><text class="metric-number">{{item.route.distanceKm}}</text><text class="metric-unit">KM</text></view>
            <view class="metric-label">里程</view>
          </view>
          <view class="detail-metric">
            <view class="metric-value"><text class="metric-number">{{item.route.elevationM}}</text><text class="metric-unit">M</text></view>
            <view class="metric-label">爬升</view>
          </view>
          <view class="detail-metric">
            <view class="metric-value"><text class="metric-number" wx:if="{{item.capacity > 0}}">{{item.capacity}}</text><text class="metric-number metric-number--text" wx:else>待补充</text></view>
            <view class="metric-label">名额</view>
          </view>
        </view>

        <view class="card overview-card" wx:if="{{item.description}}"><view class="card-index">01</view><view class="title">路线概况</view><view class="body-text">{{item.description}}</view></view>
        <view class="card route-location-card" wx:if="{{item.route.start || item.route.end}}">
          <view class="title">路线地点</view>
          <view class="route-location-row" wx:if="{{item.route.start}}"><view class="route-location-copy"><view class="route-location-label">起点</view><view>{{item.route.startLocation && item.route.startLocation.address ? item.route.startLocation.address : item.route.start}}</view></view><button wx:if="{{item.route.startLocation}}" data-target="start" bindtap="navigate">导航</button></view>
          <view class="route-location-row" wx:if="{{item.route.end}}"><view class="route-location-copy"><view class="route-location-label">终点</view><view>{{item.route.endLocation && item.route.endLocation.address ? item.route.endLocation.address : item.route.end}}</view></view><button wx:if="{{item.route.endLocation}}" data-target="end" bindtap="navigate">导航</button></view>
        </view>
        <view class="card schedule-card" wx:if="{{item.schedule && item.schedule.length}}"><view class="card-index">02</view><view class="title">时间安排</view><view wx:for="{{item.schedule}}" wx:key="time" class="schedule-row"><view class="schedule-time">{{item.time}}</view><view class="schedule-track"><view class="schedule-dot"></view></view><view class="schedule-copy"><view>{{item.title}}</view><view class="muted">{{item.location}}</view></view></view></view>
        <view class="card" wx:if="{{(item.equipment && item.equipment.length) || (item.notices && item.notices.length)}}"><view class="card-index">03</view><view class="title">装备与注意</view><view class="list-item" wx:for="{{item.equipment}}" wx:key="*this"><text class="check">✓</text><text>{{item}}</text></view><view class="notice-item" wx:for="{{item.notices}}" wx:key="*this"><text class="notice-mark">/</text><text>{{item}}</text></view></view>
        <view class="card" wx:if="{{item.fee}}"><view class="card-index">04</view><view class="title">费用说明</view><view class="body-text">{{item.fee}}</view></view>
      </view>
    </view>
  </state-view>
</view>
<view class="fixed detail-action"><button class="btn" disabled="{{loading || !item || !activityAction.enabled}}" bindtap="go">{{activityAction.label}} <text class="button-arrow">→</text></button></view>
