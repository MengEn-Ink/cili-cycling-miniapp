<view class="detail-page {{themeClass}}">
  <state-view loading="{{loading}}" error="{{error}}">
    <view wx:if="{{item}}">
      <view class="detail-hero {{galleryImages.length && !coverFailed ? 'detail-hero--media' : 'detail-hero--plain'}}">
        <swiper wx:if="{{galleryImages.length > 1 && !coverFailed}}" class="hero-gallery" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.4)" indicator-active-color="#ff5722" circular="{{true}}">
          <swiper-item wx:for="{{galleryImages}}" wx:for-item="media" wx:key="*this"><image class="hero-media" src="{{media}}" mode="aspectFill" data-index="{{index}}" binderror="galleryImageError" aria-label="活动图片 {{index + 1}}" /></swiper-item>
        </swiper>
        <image wx:elif="{{galleryImages.length === 1 && !coverFailed}}" class="hero-media" src="{{galleryImages[0]}}" mode="aspectFill" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
        <view class="hero-shade" wx:if="{{galleryImages.length && !coverFailed}}"></view>
        <view class="hero-content">
          <view class="hero-brand-row"><brand-logo compact="{{true}}" meta="RIDE DETAIL" /><view class="hero-sequence">RIDE / 01</view></view>
          <view class="hero-kicker" aria-label="{{displayDate}}">{{displayDate}}</view>
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-route" wx:if="{{item.route.start || item.route.end}}"><text>{{item.route.start}}</text><text class="route-arrow">→</text><text>{{item.route.end}}</text></view>
          <view class="hero-level" wx:if="{{item.route.level}}">{{item.route.level}}</view>
        </view>
      </view>

      <view class="content">
        <view class="metric-panel" aria-label="活动关键数据">
          <view class="detail-metric"><view class="metric-value"><text class="metric-number">{{item.route.distanceKm}}</text><text class="metric-unit">km</text></view><view class="metric-label">里程</view></view>
          <view class="detail-metric"><view class="metric-value"><text class="metric-number">{{item.route.elevationM}}</text><text class="metric-unit">m</text></view><view class="metric-label">爬升</view></view>
          <view class="detail-metric"><view class="metric-value"><text class="metric-number" wx:if="{{item.capacity > 0}}">{{item.capacity}}</text><text class="metric-number metric-number--text" wx:else>待确认</text></view><view class="metric-label">名额</view></view>
        </view>

        <view class="detail-decision" aria-label="报名状态">
          <view>
            <view class="decision-kicker">SIGN-UP STATUS</view>
            <view class="decision-title">{{activityAction.label}}</view>
            <view class="decision-meta">报名截止 {{deadlineTime || '待公布'}}</view>
          </view>
          <view class="decision-capacity" wx:if="{{item.capacity > 0}}"><text>{{item.capacity}}</text><text>活动名额</text></view>
        </view>

        <view class="card time-card">
          <view class="title">活动时间</view>
          <view class="time-row"><text>开始</text><text>{{startTime || '待公布'}}</text></view>
          <view class="time-row"><text>结束</text><text>{{endTime || '待公布'}}</text></view>
          <view class="time-row"><text>报名截止</text><text>{{deadlineTime || '待公布'}}</text></view>
        </view>

        <view class="card route-profile-card">
          <view class="title">路线海拔</view>
          <canvas wx:if="{{hasElevationProfile}}" id="elevation-canvas" type="2d" class="elevation-canvas" aria-label="路线海拔曲线"></canvas>
          <view wx:else class="route-empty">暂无有效海拔数据</view>
        </view>

        <view class="card climbs-card" wx:if="{{item.route.popularClimbs && item.route.popularClimbs.length}}">
          <view class="title">热门爬坡</view>
          <view class="climb-row" wx:for="{{item.route.popularClimbs}}" wx:key="id">
            <view class="climb-main"><text class="climb-name">{{item.name}}</text><text class="climb-popularity">{{item.popularityLabel}}</text></view>
            <view class="muted">{{item.climbCategory}} 类 · {{item.distanceKm}} km · 均坡 {{item.averageGrade}}%</view>
          </view>
        </view>

        <view class="card attendees-card">
          <view class="attendees-heading"><view><view class="title">已报名骑友</view><view class="attendees-hint" wx:if="{{attendees.length}}">点击头像查看公开骑行名片</view></view><view class="muted">{{attendees.length}} 位</view></view>
          <view class="avatar-stack" wx:if="{{attendees.length}}">
            <button class="attendee-avatar-button" wx:for="{{attendees}}" wx:key="id" data-index="{{index}}" bindtap="openAttendeeCard" aria-label="查看 {{item.displayName}} 的公开骑行名片">
              <image wx:if="{{item.avatarUrl}}" class="attendee-avatar" src="{{item.avatarUrl}}" mode="aspectFill" data-index="{{index}}" binderror="attendeeAvatarError" />
              <view wx:else class="attendee-avatar attendee-avatar--default">骑</view>
            </button>
          </view>
          <view wx:else class="route-empty">正在等待首位骑友报名</view>
        </view>

        <view class="card route-actions-card">
          <view class="title">路线操作</view>
          <view class="route-actions">
            <button wx:if="{{item.route.stravaRouteUrl}}" bindtap="openStravaRoute">复制 Strava 路线</button>
            <button bindtap="copyActivityLink">复制活动链接</button>
            <button loading="{{generatingPoster}}" disabled="{{generatingPoster}}" bindtap="generatePoster">{{generatingPoster ? '生成中' : '保存分享海报'}}</button>
            <button wx:if="{{item.route.stravaRouteId}}" loading="{{exportingGpx}}" disabled="{{exportingGpx}}" bindtap="exportGpx">{{exportingGpx ? '导出中' : '导出 GPX'}}</button>
          </view>
        </view>

        <view class="card overview-card" wx:if="{{item.description}}"><view class="card-index">01</view><view class="title">路线概况</view><view class="body-text">{{item.description}}</view></view>
        <view class="card route-location-card" wx:if="{{item.route.start || item.route.end}}">
          <view class="title">路线地点</view>
          <view class="route-location-row" wx:if="{{item.route.start}}"><view class="route-location-copy"><view class="route-location-label">起点</view><view>{{item.route.startLocation && item.route.startLocation.address ? item.route.startLocation.address : item.route.start}}</view></view><button wx:if="{{item.route.startLocation}}" data-target="start" bindtap="navigate">导航</button></view>
          <view class="route-location-row" wx:if="{{item.route.end}}"><view class="route-location-copy"><view class="route-location-label">终点</view><view>{{item.route.endLocation && item.route.endLocation.address ? item.route.endLocation.address : item.route.end}}</view></view><button wx:if="{{item.route.endLocation}}" data-target="end" bindtap="navigate">导航</button></view>
        </view>
        <view class="card schedule-card" wx:if="{{item.schedule && item.schedule.length}}"><view class="card-index">02</view><view class="title">时间安排</view><view wx:for="{{item.schedule}}" wx:key="time" class="schedule-row"><view class="schedule-time">{{item.time}}</view><view class="schedule-track"><view class="schedule-dot"></view></view><view class="schedule-copy"><view>{{item.title}}</view><view class="muted">{{item.location}}</view></view></view></view>
        <view class="card" wx:if="{{(item.equipment && item.equipment.length) || (item.notices && item.notices.length)}}"><view class="card-index">03</view><view class="title">装备与注意</view><view class="list-item" wx:for="{{item.equipment}}" wx:key="*this"><text class="check">✓</text><text>{{item}}</text></view><view class="notice-item" wx:for="{{item.notices}}" wx:key="*this"><text class="notice-mark">/</text><text>{{item}}</text></view></view>
        <view class="card" wx:if="{{item.fee}}"><view class="card-index">04</view><view class="title">费用说明</view><view class="body-text">{{item.fee}}</view></view>
      </view>
    </view>
  </state-view>
</view>

<view wx:if="{{selectedAttendee}}" class="rider-modal-mask" bindtap="closeAttendeeCard">
  <view class="rider-card" catchtap="keepAttendeeCard" role="dialog" aria-label="{{selectedAttendee.displayName}} 的公开骑行名片">
    <button class="rider-card-close" bindtap="closeAttendeeCard" aria-label="关闭骑行名片">×</button>
    <view class="rider-card-kicker">公开骑行名片</view>
    <view class="rider-card-head">
      <image wx:if="{{selectedAttendee.avatarUrl}}" class="rider-card-avatar" src="{{selectedAttendee.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="rider-card-avatar attendee-avatar--default">骑</view>
      <view class="rider-identity"><view class="rider-name">{{selectedAttendee.displayName || '此里骑手'}}</view><view class="muted">{{selectedAttendee.title || '骑行爱好者'}}</view><view class="rider-status">{{selectedAttendee.status === 'checked_in' ? '已签到' : '已报名'}}</view></view>
    </view>
    <view class="rider-stats">
      <view><view class="rider-stat-value">{{selectedAttendee.card.rides90d === null ? '--' : selectedAttendee.card.rides90d}}<text wx:if="{{selectedAttendee.card.rides90d !== null}}">次</text></view><text>近 90 天骑行</text></view>
      <view><view class="rider-stat-value">{{selectedAttendee.card.longestKm === null ? '--' : selectedAttendee.card.longestKm}}<text wx:if="{{selectedAttendee.card.longestKm !== null}}">km</text></view><text>最长骑行</text></view>
      <view><view class="rider-stat-value">{{selectedAttendee.card.elevationM === null ? '--' : selectedAttendee.card.elevationM}}<text wx:if="{{selectedAttendee.card.elevationM !== null}}">m</text></view><text>累计爬升</text></view>
      <view><view class="rider-stat-value">{{selectedAttendee.card.speedKmh === null ? '--' : selectedAttendee.card.speedKmh}}<text wx:if="{{selectedAttendee.card.speedKmh !== null}}">km/h</text></view><text>平均速度</text></view>
    </view>
    <view class="rider-card-note">数据来自报名时的 Strava 骑行快照；头像仅在骑友主动公开后展示。</view>
  </view>
</view>

<canvas id="poster-canvas" type="2d" class="poster-canvas" aria-hidden="true"></canvas>
<view class="fixed detail-action"><button class="btn" disabled="{{loading || !item || !activityAction.enabled}}" bindtap="go">{{activityAction.label}} <text class="button-arrow">→</text></button></view>
