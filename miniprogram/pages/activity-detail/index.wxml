<view class="detail-page">
  <state-view loading="{{loading}}" error="{{error}}">
    <view wx:if="{{item}}">
      <view class="detail-hero {{galleryImages.length && !coverFailed ? 'detail-hero--media' : 'detail-hero--plain'}}">
        <swiper wx:if="{{galleryImages.length > 1 && !coverFailed}}" class="hero-gallery" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.4)" indicator-active-color="#ff5722" circular="{{true}}">
          <swiper-item wx:for="{{galleryImages}}" wx:for-item="media" wx:key="*this"><image class="hero-media" src="{{media}}" mode="aspectFill" data-index="{{index}}" binderror="galleryImageError" aria-label="活动图片 {{index + 1}}" /></swiper-item>
        </swiper>
        <image wx:elif="{{galleryImages.length === 1 && !coverFailed}}" class="hero-media" src="{{galleryImages[0]}}" mode="aspectFill" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
        <view class="hero-shade" wx:if="{{galleryImages.length && !coverFailed}}"></view>
        <view class="hero-content">
          <view class="hero-brand-row"><brand-logo compact="{{true}}" meta="活动详情" /></view>
          <view class="hero-kicker" aria-label="{{displayDate}}">{{displayDate}}</view>
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-route" wx:if="{{item.registrationUnlimited && item.route.start}}"><text>{{item.route.start}}</text></view>
          <view class="hero-route" wx:elif="{{item.route.start || item.route.end}}"><text>{{item.route.start}}</text><text class="route-arrow">→</text><text>{{item.route.end}}</text></view>
          <view class="hero-level" wx:if="{{item.route.level}}">{{item.route.level}}</view>
        </view>
      </view>

      <view class="content">
        <view class="metric-panel" aria-label="活动关键数据">
          <view wx:if="{{item.route.distanceKm > 0}}" class="detail-metric"><view class="metric-value"><text class="metric-number">{{item.route.distanceKm}}</text><text class="metric-unit">km</text></view><view class="metric-label">里程</view></view>
          <view wx:if="{{item.route.elevationM > 0}}" class="detail-metric"><view class="metric-value"><text class="metric-number">{{item.route.elevationM}}</text><text class="metric-unit">m</text></view><view class="metric-label">爬升</view></view>
          <view wx:if="{{estimatedRideTime}}" class="detail-metric"><view class="metric-value"><text class="metric-number">{{estimatedRideTime}}</text></view><view class="metric-label">预计骑行</view></view>
          <view class="detail-metric"><view class="metric-value"><text class="metric-number">{{item.approvedRegistrationCount || 0}}</text><text class="metric-unit">人</text></view><view class="metric-label">已通过</view></view>
        </view>

        <view class="detail-decision" aria-label="报名状态">
          <view>
            <view class="decision-kicker">报名状态</view>
            <view class="decision-title">{{viewerStatus.label}}</view>
            <view class="decision-hint">{{viewerStatus.hint}}</view>
          </view>
          <view class="decision-capacity" wx:if="{{!item.registrationUnlimited && item.capacity > 0}}"><text>{{item.capacity}}</text><text>活动名额</text></view>
        </view>

        <view class="card time-card time-card--featured">
          <view class="time-card-kicker">集合时间</view>
          <view class="time-card-primary">{{startTime || '待公布'}}</view>
          <view class="time-card-secondary" wx:if="{{!item.registrationUnlimited && endTime}}">预计结束 {{endTime}}</view>
          <view class="time-card-secondary" wx:if="{{!item.registrationUnlimited}}">报名截止 {{deadlineTime || '待公布'}}</view>
        </view>

        <view class="card route-profile-card" wx:if="{{!item.registrationUnlimited}}">
          <view class="title">路线海拔</view>
          <canvas wx:if="{{hasElevationProfile}}" id="elevation-canvas" type="2d" class="elevation-canvas" aria-label="路线海拔曲线"></canvas>
          <view wx:else class="route-empty">暂无有效海拔数据</view>
        </view>

        <view class="card climbs-card" wx:if="{{item.route.popularClimbs && item.route.popularClimbs.length}}">
          <view class="title">热门爬坡</view>
          <view class="climb-row" wx:for="{{item.route.popularClimbs}}" wx:key="id">
            <view class="climb-main"><text class="climb-name">{{item.name}}</text><text class="climb-popularity">{{item.popularityLabel}}</text></view>
            <view class="muted">{{item.climbCategory}} 类 · {{item.distanceKm}} km · 均坡 {{item.averageGrade}}%</view>
          </view>
        </view>

        <view class="card attendees-card" wx:if="{{attendeesVisible}}">
          <view class="attendees-heading"><view><view class="title">已通过骑友</view><view class="attendees-hint" wx:if="{{attendees.length}}">点击头像查看公开骑行名片</view></view><view class="muted">{{item.approvedRegistrationCount || 0}} 位</view></view>
          <view class="avatar-stack" wx:if="{{attendees.length}}">
            <button class="attendee-avatar-button" wx:for="{{attendees}}" wx:key="id" data-index="{{index}}" bindtap="openAttendeeCard" aria-label="查看 {{item.displayName}} 的公开骑行名片">
              <image wx:if="{{item.avatarUrl}}" class="attendee-avatar" src="{{item.avatarUrl}}" mode="aspectFill" data-index="{{index}}" binderror="attendeeAvatarError" />
              <view wx:else class="attendee-avatar attendee-avatar-placeholder" aria-label="{{item.displayName}}未设置头像">无</view>
            </button>
          </view>
          <view wx:else class="route-empty">正在等待首位骑友报名</view>
        </view>

        <view class="card route-actions-card">
          <view class="title">路线与分享</view>
          <view class="strava-route" wx:if="{{item.route.stravaRouteUrl}}">
            <view class="strava-route-heading">Strava 轨迹</view>
            <view class="strava-route-row">
              <text class="strava-route-url" bindtap="copyStravaRoute" role="button" aria-label="复制 Strava 轨迹链接">{{item.route.stravaRouteUrl}}</text>
              <button class="strava-route-action" bindtap="copyStravaRoute">复制</button>
              <button class="strava-route-action strava-route-action--primary" wx:if="{{item.route.stravaRouteId}}" loading="{{exportingGpx}}" disabled="{{exportingGpx}}" bindtap="exportGpx">{{exportingGpx ? '下载中' : '下载 GPX'}}</button>
            </view>
            <view class="route-action-note">复制后可在系统浏览器或 Strava 中打开；GPX 可分享至码表或骑行应用。</view>
          </view>
          <view class="route-actions route-share-actions">
            <button bindtap="copyActivityLink">复制活动链接</button>
            <button wx:if="{{groupQrVisible}}" loading="{{generatingPoster}}" disabled="{{generatingPoster}}" bindtap="generatePoster">{{generatingPoster ? '生成中' : '保存分享海报'}}</button>
            <view wx:else class="route-action-note">报名审核通过后可生成分享海报</view>
          </view>
        </view>

        <view class="card group-qr-detail-card" wx:if="{{item.groupQrCode || !groupQrVisible}}">
          <view class="title">活动群二维码</view>
          <block wx:if="{{groupQrVisible && item.groupQrCode}}">
            <view class="body-text">扫码加入活动群，出发前请留意群内通知。</view>
            <image class="group-qr-detail-image" src="{{item.groupQrCode}}" mode="aspectFit" />
            <view wx:if="{{groupQrCodeExpired}}" class="group-qr-warning">二维码可能已过期，请联系发布人更新。</view>
          </block>
          <view wx:else class="group-qr-locked"><view class="group-qr-lock">锁定</view><view>{{groupQrLockedMessage}}</view></view>
        </view>

        <view class="card overview-card" wx:if="{{item.description}}"><view class="card-index">01</view><view class="title">{{item.registrationUnlimited ? '备注说明' : '路线概况'}}</view><view class="body-text">{{item.description}}</view></view>
        <view class="card route-location-card" wx:if="{{item.route.start || item.route.end}}">
          <view class="title">{{item.registrationUnlimited ? '集合地点' : '路线地点'}}</view>
          <view class="route-location-row" wx:if="{{item.route.start}}"><view class="route-location-copy"><view class="route-location-label">{{item.registrationUnlimited ? '集合点' : '起点'}}</view><view class="route-location-name">{{item.route.start}}</view><view class="route-location-address" wx:if="{{item.route.startLocation && item.route.startLocation.address && item.route.startLocation.address !== item.route.start}}">{{item.route.startLocation.address}}</view></view><button wx:if="{{item.route.startLocation}}" data-target="start" bindtap="navigate">地图导航</button></view>
          <view class="route-location-row" wx:if="{{!item.registrationUnlimited && item.route.end}}"><view class="route-location-copy"><view class="route-location-label">终点</view><view class="route-location-name">{{item.route.end}}</view><view class="route-location-address" wx:if="{{item.route.endLocation && item.route.endLocation.address && item.route.endLocation.address !== item.route.end}}">{{item.route.endLocation.address}}</view></view><button wx:if="{{item.route.endLocation}}" data-target="end" bindtap="navigate">地图导航</button></view>
        </view>
        <view class="card schedule-card" wx:if="{{item.schedule && item.schedule.length}}"><view class="card-index">02</view><view class="title">时间安排</view><view wx:for="{{item.schedule}}" wx:key="time" class="schedule-row"><view class="schedule-time">{{item.time}}</view><view class="schedule-track"><view class="schedule-dot"></view></view><view class="schedule-copy"><view>{{item.title}}</view><view class="muted">{{item.location}}</view></view></view></view>
        <view class="card" wx:if="{{(item.equipment && item.equipment.length) || (item.notices && item.notices.length)}}"><view class="card-index">03</view><view class="title">装备与注意</view><view class="list-item" wx:for="{{item.equipment}}" wx:key="*this"><text class="check">✓</text><text>{{item}}</text></view><view class="notice-item" wx:for="{{item.notices}}" wx:key="*this"><text class="notice-mark">/</text><text>{{item}}</text></view></view>
        <view class="card fee-card" wx:if="{{!item.registrationUnlimited && (item.fee || (item.feeIncluded && item.feeIncluded.length) || (item.feeExcluded && item.feeExcluded.length))}}">
          <view class="card-index">04</view>
          <view class="title">费用说明</view>
          <view class="body-text" wx:if="{{item.fee}}">{{item.fee}}</view>
          <view class="fee-block" wx:if="{{item.feeIncluded && item.feeIncluded.length}}">
            <view class="fee-block-title">费用包含</view>
            <view class="fee-item" wx:for="{{item.feeIncluded}}" wx:for-item="fee" wx:key="*this"><text class="fee-mark fee-included">+</text><text>{{fee}}</text></view>
          </view>
          <view class="fee-block" wx:if="{{item.feeExcluded && item.feeExcluded.length}}">
            <view class="fee-block-title">费用不包含</view>
            <view class="fee-item" wx:for="{{item.feeExcluded}}" wx:for-item="fee" wx:key="*this"><text class="fee-mark fee-excluded">−</text><text>{{fee}}</text></view>
          </view>
        </view>
      </view>
    </view>
  </state-view>
</view>

<view wx:if="{{selectedAttendee}}" class="rider-modal-mask" bindtap="closeAttendeeCard">
  <view class="rider-card" catchtap="keepAttendeeCard" role="dialog" aria-label="{{selectedAttendee.displayName}} 的公开骑行名片">
    <button class="rider-card-close" bindtap="closeAttendeeCard" aria-label="关闭骑行名片">×</button>
    <view class="rider-card-kicker">公开骑行名片</view>
    <view class="rider-card-head">
      <image wx:if="{{selectedAttendee.avatarUrl}}" class="rider-card-avatar" src="{{selectedAttendee.avatarUrl}}" mode="aspectFill" binderror="selectedAttendeeAvatarError" />
      <view wx:else class="rider-card-avatar rider-card-avatar-placeholder" aria-label="未设置头像">无头像</view>
      <view class="rider-identity"><view class="rider-name">{{selectedAttendee.displayName || '此里骑手'}}</view><view class="gender-pill {{selectedAttendee.genderClass}}">{{selectedAttendee.genderLabel}}</view><view class="rider-status">{{selectedAttendee.status === 'checked_in' ? '已签到' : '已报名'}}</view></view>
    </view>
    <view class="rider-stats">
      <view><view class="rider-stat-value">{{selectedAttendee.card.rides90d === null ? '--' : selectedAttendee.card.rides90d}}<text wx:if="{{selectedAttendee.card.rides90d !== null}}">次</text></view><text>近 90 天骑行</text></view>
      <view><view class="rider-stat-value">{{selectedAttendee.card.longestKm === null ? '--' : selectedAttendee.card.longestKm}}<text wx:if="{{selectedAttendee.card.longestKm !== null}}">km</text></view><text>最长骑行</text></view>
      <view><view class="rider-stat-value">{{selectedAttendee.card.elevationM === null ? '--' : selectedAttendee.card.elevationM}}<text wx:if="{{selectedAttendee.card.elevationM !== null}}">m</text></view><text>累计爬升</text></view>
      <view><view class="rider-stat-value">{{selectedAttendee.card.speedKmh === null ? '--' : selectedAttendee.card.speedKmh}}<text wx:if="{{selectedAttendee.card.speedKmh !== null}}">km/h</text></view><text>平均速度</text></view>
    </view>
    <view class="rider-card-note">数据来自报名时的 Strava 骑行快照；头像按骑友公开设置展示。</view>
  </view>
</view>

<canvas id="poster-canvas" type="2d" class="poster-canvas" aria-hidden="true"></canvas>
<view class="fixed detail-action detail-action--admin" wx:if="{{isAdmin}}">
  <button class="btn btn--secondary" disabled="{{loading || !item}}" bindtap="editActivity">修改活动</button>
  <button class="btn" disabled="{{loading || !item}}" bindtap="adminRegistration">{{adminRegistrationLabel}} <text class="button-arrow">→</text></button>
</view>
<view class="fixed detail-action" wx:else><button class="btn" disabled="{{loading || !item || !activityAction.enabled}}" bindtap="go">{{activityAction.label}} <text class="button-arrow">→</text></button></view>
