<view class="page"><state-view loading="{{loading}}" error="{{error}}"><view wx:if="{{item}}"><view class="hero"><view>{{item.date}}</view><view class="hero-title">{{item.title}}</view><view>{{item.route.start}} → {{item.route.end}}</view></view><view class="card"><view class="title">路线概况</view><view class="grid"><view class="metric"><view class="big">{{item.route.distanceKm}} km</view><view>里程</view></view><view class="metric"><view class="big">{{item.route.elevationM}} m</view><view>累计爬升</view></view></view><view>{{item.route.level}} · {{item.description}}</view></view><view class="card"><view class="title">时间安排</view><view wx:for="{{item.schedule}}" wx:key="time" class="row"><b>{{item.time}}</b><view>{{item.title}} · {{item.location}}</view></view></view><view class="card"><view class="title">装备与注意</view><view wx:for="{{item.equipment}}" wx:key="*this">✓ {{item}}</view><view wx:for="{{item.notices}}" wx:key="*this">• {{item}}</view></view><view class="card"><view class="title">费用说明</view>{{item.fee}}</view></view></state-view></view><view class="fixed"><button class="btn" bindtap="go">{{registration?'查看我的报名':'立即报名'}}</button></view>