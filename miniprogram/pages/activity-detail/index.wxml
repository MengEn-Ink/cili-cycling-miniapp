<!--
  骑行影像志 · 活动详情（1:1 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/activity-detail.html）
  - 骨架：photo.hero.detail → ink(metrics + 行) → content(section × N：这次一起骑 / 集合与出发 / 山路有迹可循 / 一起出发的骑友 / 行前约定 / 活动群 / Strava 官方路线 / 费用 / 装备 / 时间安排 / 终点导航) → decision → fixed actionbar
  - 真实业务保留：画面轮播 + 失败降级 + 单图封面、权限视图(viewerStatus)、报名 CTA、GPX 下载(MD5)、Strava 复制、路线分析入口、报名骑友头像 scroll + 公开名片 modal、活动群二维码、admin 管理按钮
-->
<view class="page detail-page" data-v1-layout="content-sheet">
  <state-view loading="{{loading}}" error="{{!item ? error : ''}}" retryable="{{true}}" bind:retry="retryLoad">
    <block wx:if="{{item}}">
      <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{refreshing ? '正在刷新活动详情' : ''}}</view>
      <view class="a11y-live-region" role="alert" aria-live="assertive" aria-atomic="true">{{refreshError}}</view>

      <!-- hero：首屏画面 -->
      <view class="photo hero detail">
        <swiper wx:if="{{galleryImages.length > 1 && !coverFailed}}" class="hero-gallery" indicator-dots="{{true}}" indicator-color="{{colorMediaMuted}}" indicator-active-color="{{colorOnMedia}}" circular="{{true}}" bindchange="galleryChange">
          <swiper-item wx:for="{{galleryImages}}" wx:for-item="media" wx:key="*this"><image class="hero-media" src="{{media}}" mode="aspectFill" data-index="{{index}}" binderror="galleryImageError" aria-label="活动图片 {{index + 1}}" /></swiper-item>
        </swiper>
        <image wx:elif="{{galleryImages.length === 1 && !coverFailed}}" class="hero-media" src="{{galleryImages[0]}}" mode="aspectFill" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
        <generated-activity-cover wx:else item="{{item}}" variant="detail" />
        <view class="shade"></view>
        <view class="corner"><text class="tag dark">{{viewerStatus.label}}</text></view>
        <view class="caption">
          <view class="eyebrow">{{displayDate}}{{item.route.level ? ' · ' + item.route.level : ''}}</view>
          <view class="hero-title editorial"><blur-text text="{{item.title}}" animate-by="words" direction="bottom" delay="70" step-duration="360" /></view>
          <view class="hero-sub">{{item.clubIdentity.name}}</view>
        </view>
        <view class="cover-count" wx:if="{{galleryImages.length}}">{{currentGalleryIndex + 1}} / {{galleryImages.length}}</view>
      </view>

      <view class="refresh-note" wx:if="{{refreshing}}" aria-hidden="true">正在刷新活动详情…</view>
      <view class="refresh-note refresh-error" wx:if="{{refreshError}}" role="button" bindtap="retryLoad" aria-label="活动详情刷新失败，点击重试">{{refreshError}}，点此重试</view>

      <!-- ink：指标 + 集合概要行 -->
      <view class="ink" data-v1-sheet="true">
        <view class="metrics">
          <view><text class="em">{{item.route.distanceKm > 0 ? item.route.distanceKm : '—'}}<text class="unit">km</text></text><text>全程距离</text></view>
          <view><text class="em">{{item.route.elevationM > 0 ? item.route.elevationM : '—'}}<text class="unit">m</text></text><text>累计爬升</text></view>
          <view><text class="em">{{estimatedRideTime || '—'}}<text class="unit"></text></text><text>预计骑行</text></view>
          <view wx:if="{{!item.registrationUnlimited}}"><text class="em">{{item.approvedRegistrationCount || 0}}<text class="unit">人</text></text><text>已通过</text></view>
        </view>
        <view class="row ink-row">
          <view class="lead">
            <view class="rowicon rowicon--clock" aria-hidden="true"></view>
            <view class="rowtext">
              <text class="em">{{startTime || '集合时间待公布'}}</text>
              <text class="sub">{{displayDate}} · {{item.route.start || '集合地点待公布'}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="content">
        <!-- 这次一起骑：俱乐部与简介 -->
        <view class="section section-intro">
          <view class="chapterhead"><view class="chapterhead-title">这次一起骑</view><view class="chapterhead-rule" aria-hidden="true"></view></view>
          <view class="section-prose" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="row rowlink club-row" aria-label="活动归属：{{item.clubIdentity.name}}">
            <view class="lead">
              <image wx:if="{{item.clubIdentity.avatarUrl}}" class="club-avatar" src="{{item.clubIdentity.avatarUrl}}" mode="aspectFill" />
              <view wx:else class="club-avatar club-avatar--placeholder">此</view>
              <view class="rowtext"><text class="em">{{item.clubIdentity.name}}</text><text class="sub">活动组织俱乐部</text></view>
            </view>
            <view class="chev" aria-hidden="true"></view>
          </view>
          <view class="route-difficulty" wx:if="{{routeDifficultyHint}}"><view class="route-difficulty__label">路线强度</view><view class="route-difficulty__text">{{routeDifficultyHint}}</view></view>
        </view>

        <!-- 集合与出发 -->
        <view class="section section-meeting">
          <view class="chapterhead"><view class="chapterhead-title">集合与出发</view><view class="chapterhead-rule" aria-hidden="true"></view></view>
          <view class="paper">
            <view class="detailrows">
              <view class="detailrow"><text class="detailrow-term">集合时间</text><text class="detailrow-desc">{{startTime || '待公布'}}</text></view>
              <view class="detailrow"><text class="detailrow-term">集合地点</text><text class="detailrow-desc">{{item.route.start || '集合地点待公布'}}</text></view>
              <view class="detailrow" wx:if="{{item.route.startLocation && item.route.startLocation.address && item.route.startLocation.address !== item.route.start}}"><text class="detailrow-term">集合位置</text><text class="detailrow-desc">{{item.route.startLocation.address}}</text></view>
              <view class="detailrow" wx:if="{{endTime}}"><text class="detailrow-term">预计结束</text><text class="detailrow-desc">{{endTime}}</text></view>
              <view class="detailrow" wx:if="{{deadlineTime}}"><text class="detailrow-term">报名截止</text><text class="detailrow-desc">{{deadlineTime}}</text></view>
            </view>
            <button wx:if="{{item.route.startLocation}}" class="btn secondary meeting-cta" data-target="start" bindtap="navigate" aria-label="导航到集合地点">导航到集合点</button>
          </view>
        </view>

        <!-- 费用与名额前置，先回答用户是否能参加 -->
        <view class="section section-fee" wx:if="{{!item.registrationUnlimited && (item.fee || (item.feeIncluded && item.feeIncluded.length) || (item.feeExcluded && item.feeExcluded.length))}}">
          <view class="chapterhead"><view class="chapterhead-title">费用说明</view><view class="chapterhead-rule" aria-hidden="true"></view></view>
          <view class="paper">
            <view class="section-prose" wx:if="{{item.fee}}">{{item.fee}}</view>
            <view class="fee-block" wx:if="{{item.feeIncluded && item.feeIncluded.length}}">
              <view class="fee-block-title">费用包含</view>
              <view class="fee-item" wx:for="{{item.feeIncluded}}" wx:for-item="fee" wx:key="*this"><text class="fee-mark fee-included">+</text><text>{{fee}}</text></view>
            </view>
            <view class="fee-block" wx:if="{{item.feeExcluded && item.feeExcluded.length}}">
              <view class="fee-block-title">费用不包含</view>
              <view class="fee-item" wx:for="{{item.feeExcluded}}" wx:for-item="fee" wx:key="*this"><text class="fee-mark fee-excluded">−</text><text>{{fee}}</text></view>
            </view>
          </view>
        </view>

        <!-- 山路有迹可循：路线入口 -->
        <view class="section section-route" wx:if="{{canAnalyzeRoute || hasRouteDetails}}">
          <view class="chapterhead"><view class="chapterhead-title">山路，有迹可循</view><view class="chapterhead-aside" wx:if="{{item.route.distanceKm > 0}}">{{item.route.distanceKm}} km / {{item.route.elevationM || 0}} m</view></view>
          <view class="paper route-paper" wx:if="{{hasRouteDetails}}">
            <view class="section-prose">{{hasGpxRoute ? '路线数据来自组织者上传的 GPX 文件。' : '路线数据来自免授权公开路线解析。'}}</view>
            <view class="detailrows">
              <view class="detailrow"><text class="detailrow-term">距离</text><text class="detailrow-desc">{{item.route.distanceKm}} km</text></view>
              <view class="detailrow"><text class="detailrow-term">爬升</text><text class="detailrow-desc">{{item.route.elevationM}} m</text></view>
              <view class="detailrow"><text class="detailrow-term">下降</text><text class="detailrow-desc">{{item.route.elevationLossM}} m</text></view>
              <view class="detailrow"><text class="detailrow-term">海拔范围</text><text class="detailrow-desc">{{item.route.elevationMinM}}–{{item.route.elevationMaxM}} m</text></view>
              <view class="detailrow" wx:if="{{estimatedRideTime}}"><text class="detailrow-term">此里估算</text><text class="detailrow-desc">{{estimatedRideTime}}</text></view>
            </view>
            <view class="route-actions">
              <button wx:if="{{hasGpxRoute}}" class="btn secondary" loading="{{downloadingGpx}}" disabled="{{downloadingGpx}}" bindtap="downloadGpx" aria-label="下载 GPX 路线">{{downloadingGpx ? '下载中…' : '下载 GPX 路线'}}</button>
              <button wx:if="{{officialRouteId}}" class="btn secondary" bindtap="copyOfficialRoute" aria-label="复制 Strava 官方路线链接">复制 Strava 官方链接</button>
            </view>
            <async-status-card wx:if="{{downloadingGpx}}" title="路线文件准备中" detail="正在校验并准备 GPX 文件，请保持页面打开" state="pending" />
            <async-status-card wx:if="{{copyFeedback === 'success'}}" title="路线链接已复制" detail="可前往 Strava 或浏览器打开" state="success" />
            <async-status-card wx:elif="{{copyFeedback === 'error'}}" title="路线链接复制失败" detail="请检查系统剪贴板权限后重试" state="failed" action-label="重新复制" bind:action="copyOfficialRoute" />
          </view>
          <button wx:if="{{canAnalyzeRoute}}" class="btn secondary route-analysis-cta" bindtap="openRouteAnalysis" aria-label="查看完整路线分析">查看完整路线分析 →</button>
        </view>

        <!-- 一起出发的骑友 -->
        <view class="section section-attendees" wx:if="{{attendeesVisible}}">
          <view class="chapterhead"><view class="chapterhead-title">一起出发的骑友</view><view class="chapterhead-aside">昵称与已同意的头像</view></view>
          <scroll-view class="riderlist" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{attendees.length}}" aria-label="已报名人员头像与昵称">
            <view class="riderlist-inner">
              <view class="rider {{item.isSelf && (!item.avatarUrl || !item.backgroundUrl) ? 'rider--authorization' : ''}}" wx:for="{{attendees}}" wx:key="id" data-index="{{index}}" bindtap="openAttendeeCard" role="button" aria-label="查看 {{item.displayName}} 的公开骑行名片">
                <image wx:if="{{item.avatarUrl}}" class="avatar {{item.genderClass}}" src="{{item.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" data-url="{{item.avatarUrl}}" bindload="attendeeAvatarLoad" binderror="attendeeAvatarError" />
                <view wx:else class="avatar initialavatar" aria-label="{{item.displayName || '骑友'}}尚未公开头像">骑</view>
                <text class="rider-name">{{item.displayName || '骑友'}}</text>
                <text class="rider-meta">{{item.status === 'checked_in' ? '已签到' : '已报名'}}</text>
                <button wx:if="{{item.isSelf && (!item.avatarUrl || !item.backgroundUrl)}}" class="rider-authorize" loading="{{attendeeAuthorizationState === 'loading'}}" disabled="{{attendeeAuthorizationState === 'loading'}}" catchtap="authorizeAttendeeMedia">{{attendeeAuthorizationState === 'loading' ? '正在打开…' : attendeeAuthorizationState === 'failed' ? '加载失败，重试' : attendeeAuthorizationState === 'declined' ? '重新授权' : '授权头像与背景'}}</button>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="notice">
            <view class="notice-dot" aria-hidden="true"></view>
            <text>正在等待首位骑友报名</text>
          </view>
        </view>

        <!-- 行前约定 -->
        <view class="section section-notes" wx:if="{{(item.equipment && item.equipment.length) || (item.notices && item.notices.length)}}">
          <view class="chapterhead"><view class="chapterhead-title">行前约定</view><view class="chapterhead-rule" aria-hidden="true"></view></view>
          <view class="paper notes-paper">
            <view class="chip-list" wx:if="{{item.equipment && item.equipment.length}}">
              <text class="chip-list-label">装备</text>
              <view class="gear-chip" wx:for="{{item.equipment}}" wx:key="*this"><text class="check">✓</text><text>{{item}}</text></view>
            </view>
            <view class="chip-list" wx:if="{{item.notices && item.notices.length}}">
              <text class="chip-list-label">注意事项</text>
              <view class="notice-chip" wx:for="{{item.notices}}" wx:key="*this"><text class="notice-mark">/</text><text>{{item}}</text></view>
            </view>
          </view>
        </view>

        <!-- 时间安排 -->
        <view class="section section-schedule" wx:if="{{item.schedule && item.schedule.length}}">
          <view class="chapterhead"><view class="chapterhead-title">时间安排</view><view class="chapterhead-rule" aria-hidden="true"></view></view>
          <view class="schedule-list">
            <view wx:for="{{item.schedule}}" wx:key="time" class="schedule-item"><view class="schedule-time">{{item.time}}</view><view class="schedule-track"><view class="schedule-dot"></view></view><view class="schedule-copy"><view>{{item.title}}</view><view class="muted" wx:if="{{item.location}}">{{item.location}}</view></view></view>
          </view>
        </view>

        <!-- 终点导航 -->
        <view class="section section-end" wx:if="{{!item.registrationUnlimited && item.route.end}}">
          <view class="chapterhead"><view class="chapterhead-title">终点导航</view><view class="chapterhead-rule" aria-hidden="true"></view></view>
          <view class="paper">
            <view class="detailrows">
              <view class="detailrow"><text class="detailrow-term">终点</text><text class="detailrow-desc">{{item.route.end}}</text></view>
              <view class="detailrow" wx:if="{{item.route.endLocation && item.route.endLocation.address && item.route.endLocation.address !== item.route.end}}"><text class="detailrow-term">终点地址</text><text class="detailrow-desc">{{item.route.endLocation.address}}</text></view>
            </view>
            <button wx:if="{{item.route.endLocation}}" class="btn secondary meeting-cta" data-target="end" bindtap="navigate">地图导航到终点</button>
          </view>
        </view>

        <!-- 活动群 -->
        <view class="section section-group">
          <view class="chapterhead"><view class="chapterhead-title">活动群</view><view class="chapterhead-rule" aria-hidden="true"></view></view>
          <block wx:if="{{groupQrVisible && item.groupQrCode}}">
            <view class="paper group-paper">
              <view class="section-prose">扫码加入活动群，出发前请留意群内通知。</view>
              <view class="group-qr-frame">
                <image class="group-qr-image" src="{{item.groupQrCode}}" mode="aspectFit" bindtap="previewGroupQr" show-menu-by-longpress="{{true}}" aria-label="点击放大查看活动群二维码" />
              </view>
              <view class="group-qr-hint muted">点击图片可放大查看</view>
              <view wx:if="{{groupQrCodeExpired}}" class="notice notice--warning">二维码可能已过期，请联系发布人更新。</view>
            </view>
          </block>
          <view wx:else class="notice">
            <view class="notice-dot" aria-hidden="true"></view>
            <text>{{groupQrLockedMessage || '组织者暂未上传群二维码，请留意活动说明。'}}</text>
          </view>
        </view>
      </view>

      <!-- decision：报名状态 + 主 CTA 说明 -->
      <view class="decision" aria-label="报名状态">
        <view class="decision-head">
          <text class="decision-kicker">报名状态</text>
          <text class="decision-title editorial">{{viewerStatus.label}}</text>
        </view>
        <view class="decision-hint">{{viewerStatus.hint}}</view>
        <view class="decision-capacity" wx:if="{{!item.registrationUnlimited && item.capacity > 0}}"><text>{{item.capacity}}</text><text>名额</text></view>
      </view>
    </block>
  </state-view>

  <!-- 骑手公开名片 modal -->
  <view wx:if="{{selectedAttendee}}" class="dialog-mask" bindtap="closeAttendeeCard" catchtouchmove="keepAttendeeCard">
    <view class="dialog rider-dialog" catchtap="keepAttendeeCard" role="dialog" aria-label="活动报名骑手公开名片">
      <button class="dialog-close" bindtap="closeAttendeeCard" aria-label="关闭骑行名片">×</button>
      <swiper class="rider-dialog-swiper" current="{{selectedAttendeeIndex}}" circular="{{attendees.length > 1}}" previous-margin="{{attendees.length > 1 ? '28rpx' : '0'}}" next-margin="{{attendees.length > 1 ? '28rpx' : '0'}}" bindchange="attendeeCardChange">
        <swiper-item wx:for="{{attendees}}" wx:for-item="rider" wx:key="id">
          <view class="rider-dialog-photo {{rider.backgroundUrl ? '' : 'rider-dialog-photo--fallback'}}" aria-label="{{rider.displayName}} 的完整公开骑行名片">
            <image wx:if="{{rider.backgroundUrl}}" class="rider-dialog-photo__image" src="{{rider.backgroundUrl}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" data-url="{{rider.backgroundUrl}}" bindload="selectedAttendeeBackgroundLoad" binderror="selectedAttendeeBackgroundError" />
            <view class="rider-dialog-photo__scrim"></view>
            <view class="rider-dialog-photo__identity">
              <image wx:if="{{rider.avatarUrl}}" class="rider-dialog-avatar {{rider.genderClass}}" src="{{rider.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" data-url="{{rider.avatarUrl}}" bindload="attendeeAvatarLoad" binderror="attendeeAvatarError" />
              <view wx:else class="rider-dialog-avatar rider-dialog-avatar--placeholder" aria-label="{{rider.displayName || '骑友'}}尚未公开头像">{{rider.avatarPlaceholder}}</view>
              <view class="rider-dialog-copy"><view class="rider-dialog-kicker">公开骑行名片</view><view class="rider-dialog-name">{{rider.displayName || '骑友'}}</view><view class="rider-dialog-status">{{rider.status === 'checked_in' ? '已签到' : '已报名'}}</view></view>
            </view>
            <view class="rider-dialog-note">昵称、头像与照片由骑友本人维护，仅展示公开资料。</view>
          </view>
        </swiper-item>
      </swiper>
      <view class="rider-dialog-pagination" wx:if="{{attendees.length > 1}}"><text>{{selectedAttendeeIndex + 1}} / {{attendees.length}}</text><text>左右滑动查看其他骑友</text></view>
    </view>
  </view>

  <!-- 固定底部 actionbar：admin 两键 / 普通用户主 CTA -->
  <view class="actionbar actionbar--admin" wx:if="{{isAdmin}}">
    <button class="btn secondary" disabled="{{loading || !item}}" bindtap="editActivity">修改活动</button>
    <button class="btn" disabled="{{loading || !item}}" bindtap="adminRegistration">{{adminRegistrationLabel}} →</button>
  </view>
  <view class="actionbar" wx:else>
    <button class="btn" disabled="{{loading || !item || !activityAction.enabled}}" bindtap="go">{{activityAction.label}} →</button>
  </view>
</view>
