<view class="detail-page">
  <state-view loading="{{loading}}" error="{{error}}">
    <view wx:if="{{item}}" class="detail-unified-card">
      <brand-logo compact="{{true}}" meta="活动详情" />
      <view class="detail-hero">
        <swiper wx:if="{{galleryImages.length > 1 && !coverFailed}}" class="hero-gallery" indicator-dots="{{true}}" indicator-color="{{colorMediaMuted}}" indicator-active-color="{{colorOnMedia}}" circular="{{true}}">
          <swiper-item wx:for="{{galleryImages}}" wx:for-item="media" wx:key="*this"><image class="hero-media" src="{{media}}" mode="aspectFill" data-index="{{index}}" binderror="galleryImageError" aria-label="活动图片 {{index + 1}}" /></swiper-item>
        </swiper>
        <image wx:elif="{{galleryImages.length === 1 && !coverFailed}}" class="hero-media" src="{{galleryImages[0]}}" mode="aspectFill" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
        <generated-activity-cover wx:else item="{{item}}" variant="detail" />
        <view class="cover-count" wx:if="{{galleryImages.length}}">1 / {{galleryImages.length}}</view>
      </view>
      <view class="info-bar">
        <view class="info-head"><text class="info-kicker">{{displayDate}}{{item.route.level ? ' · ' + item.route.level : ''}}</text><text class="info-tag">{{viewerStatus.label}}</text></view>
        <view class="info-title">{{item.title}}</view>
        <view class="info-meta"><text>{{startTime || '集合时间待公布'}}</text><text>{{item.route.start || '集合地点待公布'}}</text></view>
      </view>

      <view class="content">
        <metric-grid class="detail-metric-panel" items="{{[{ value: item.route.distanceKm > 0 ? item.route.distanceKm : '--', unit: 'km', label: '里程' }, { value: item.route.elevationM > 0 ? item.route.elevationM : '--', unit: 'm', label: '爬升' }, { value: estimatedRideTime || '--', unit: '', label: '预计骑行' }, { value: item.approvedRegistrationCount || 0, unit: '人', label: '已通过' }]}}" columns="2" narrow-columns="2" aria-label="活动关键数据" />

        <view class="detail-decision" aria-label="报名状态">
          <view class="decision-status"><text class="decision-kicker">报名状态</text><text class="decision-title">{{viewerStatus.label}}</text></view>
          <view class="decision-hint">{{viewerStatus.hint}}</view>
          <view class="decision-capacity" wx:if="{{!item.registrationUnlimited && item.capacity > 0}}"><text>{{item.capacity}}</text><text>名额</text></view>
        </view>

        <view class="card time-card time-card--featured">
          <view class="time-card-main">
            <view><view class="time-card-kicker">集合时间</view><view class="time-card-primary">{{startTime || '待公布'}}</view></view>
            <view class="meeting-location" wx:if="{{item.route.start}}">
              <view class="meeting-location__copy"><text class="meeting-location__label">集合地点</text><text class="meeting-location__name">{{item.route.start}}</text><text class="meeting-location__address" wx:if="{{item.route.startLocation && item.route.startLocation.address && item.route.startLocation.address !== item.route.start}}">{{item.route.startLocation.address}}</text></view>
              <button class="meeting-location__action" wx:if="{{item.route.startLocation}}" data-target="start" bindtap="navigate">导航</button>
            </view>
          </view>
          <view class="time-card-meta" wx:if="{{!item.registrationUnlimited}}">
            <text wx:if="{{endTime}}">预计结束 {{endTime}}</text>
            <text>报名截止 {{deadlineTime || '待公布'}}</text>
          </view>
        </view>

        <view class="official-route-card" wx:if="{{officialRouteId}}">
          <view class="section-heading"><view><view class="title">Strava 官方路线</view><view class="route-action-note">复制组织者分享的规范化公开路线链接。</view></view><view class="section-tag">官方</view></view>
          <button class="route-action route-action--primary" bindtap="copyOfficialRoute">复制路线链接</button>
          <view wx:if="{{copyFeedback === 'success'}}" class="inline-feedback inline-feedback--success" role="status">✓ 路线链接已复制</view>
          <view wx:elif="{{copyFeedback === 'error'}}" class="inline-feedback inline-feedback--error" role="alert">! 复制失败，请稍后重试</view>
          <view class="route-action-note">小程序内不打开第三方页面，复制后可自行粘贴使用。</view>
        </view>

        <view class="gpx-route-card" wx:if="{{hasRouteDetails}}">
          <view class="section-heading"><view><view class="title">{{item.route.routeName || '路线详情'}}</view><view class="route-action-note">{{hasGpxRoute ? '路线数据来自组织者上传的 GPX 文件。' : '路线数据来自免授权公开路线解析。'}}</view></view><view class="section-tag">路线详情</view></view>
          <view class="route-native-metrics" aria-label="路线数据">
            <view><text>{{item.route.distanceKm}}</text><text>km 距离</text></view>
            <view><text>{{item.route.elevationM}}</text><text>m 爬升</text></view>
            <view><text>{{item.route.elevationLossM}}</text><text>m 下降</text></view>
            <view><text>{{item.route.elevationMinM}}–{{item.route.elevationMaxM}}</text><text>m 海拔</text></view>
          </view>
          <view class="route-estimate" wx:if="{{estimatedRideTime}}"><text>此里估算</text><text>{{estimatedRideTime}}</text></view>

          <view class="route-visual-heading">路线轮廓</view>
          <image wx:if="{{routeOutlineImage}}" class="route-outline-image" src="{{routeOutlineImage}}" mode="aspectFit" bindtap="previewRouteImage" aria-label="点击查看{{item.route.routeName || 'GPX 路线'}}完整路线图" />
          <image wx:elif="{{item.route.generatedPreviewUrl}}" class="route-outline-image" src="{{item.route.generatedPreviewUrl}}" mode="aspectFit" bindtap="previewRouteImage" aria-label="点击查看{{item.route.routeName || 'GPX 路线'}}完整路线图" />
          <canvas wx:elif="{{hasRouteOutline}}" id="route-outline-canvas" type="2d" class="route-outline-canvas" aria-label="{{item.route.routeName || 'GPX 路线'}}路线轮廓"></canvas>
          <view wx:else class="route-empty">暂无有效路线轮廓</view>

          <view class="route-visual-heading">海拔曲线</view>
          <image wx:if="{{elevationImage}}" class="elevation-image" src="{{elevationImage}}" mode="aspectFit" aria-label="路线海拔曲线" />
          <canvas wx:elif="{{hasElevationProfile}}" id="elevation-canvas" type="2d" class="elevation-canvas" aria-label="路线海拔曲线"></canvas>
          <view wx:else class="route-empty">暂无有效海拔数据</view>

          <view class="gpx-download-row" wx:if="{{hasGpxRoute}}">
            <view class="route-action-note">下载后可导入码表或骑行应用。</view>
            <button class="route-action route-action--primary" loading="{{downloadingGpx}}" disabled="{{downloadingGpx}}" bindtap="downloadGpx">{{downloadingGpx ? '下载中' : '下载 GPX'}}</button>
          </view>
        </view>

        <view class="card route-analysis-entry" wx:if="{{canAnalyzeRoute}}">
          <view class="section-heading"><view><view class="title">完整路线分析</view><view class="route-action-note">查看关键公里点、主要坡段、海拔联动地图与基础装备建议。</view></view><view class="section-tag">分析</view></view>
          <button class="route-action route-action--primary" bindtap="openRouteAnalysis">查看完整路线分析</button>
        </view>

        <view class="card attendees-card" wx:if="{{attendeesVisible}}">
          <view class="attendees-heading"><view><view class="title">已报名人员</view><view class="attendees-hint" wx:if="{{attendees.length}}">头像与昵称经本人授权展示</view></view></view>
          <scroll-view class="attendee-card-strip" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{attendees.length}}" aria-label="已报名人员头像与昵称">
            <view class="attendee-card-strip__inner">
              <button class="attendee-mini-card" wx:for="{{attendees}}" wx:key="id" data-index="{{index}}" bindtap="openAttendeeCard" aria-label="查看 {{item.displayName}} 的公开骑行名片">
                <image wx:if="{{item.avatarUrl}}" class="attendee-avatar {{item.genderClass}}" src="{{item.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" data-url="{{item.avatarUrl}}" bindload="attendeeAvatarLoad" binderror="attendeeAvatarError" />
                <image wx:else class="attendee-avatar attendee-avatar--placeholder {{item.genderClass}}" src="/assets/brand/logo-circle-144.png" mode="aspectFill" aria-label="{{item.displayName}}未设置公开头像" />
                <view class="attendee-mini-card__name">{{item.displayName || '此里骑手'}}</view>
                <view class="attendee-mini-card__meta">{{item.status === 'checked_in' ? '已签到' : '已报名'}}</view>
              </button>
            </view>
          </scroll-view>
          <view wx:else class="route-empty">正在等待首位骑友报名</view>
        </view>

        <view class="card group-qr-detail-card" wx:if="{{item.groupQrCode || !groupQrVisible}}">
          <view class="title">活动群二维码</view>
          <block wx:if="{{groupQrVisible && item.groupQrCode}}">
            <view class="body-text">扫码加入活动群，出发前请留意群内通知。</view>
            <image class="group-qr-detail-image" src="{{item.groupQrCode}}" mode="aspectFit" bindtap="previewGroupQr" show-menu-by-longpress="{{true}}" aria-label="点击放大查看活动群二维码" />
            <view class="group-qr-detail-hint">点击图片可放大查看</view>
            <view wx:if="{{groupQrCodeExpired}}" class="group-qr-warning">二维码可能已过期，请联系发布人更新。</view>
          </block>
          <view wx:else class="group-qr-locked"><view class="group-qr-lock">锁定</view><view>{{groupQrLockedMessage}}</view></view>
        </view>

        <view class="card overview-card" wx:if="{{item.description}}"><view class="title">{{item.registrationUnlimited ? '备注说明' : '路线概况'}}</view><view class="body-text">{{item.description}}</view></view>
        <view class="card route-location-card" wx:if="{{!item.registrationUnlimited && item.route.end}}">
          <view class="title">终点导航</view>
          <view class="route-location-row"><view class="route-location-copy"><view class="route-location-label">终点</view><view class="route-location-name">{{item.route.end}}</view><view class="route-location-address" wx:if="{{item.route.endLocation && item.route.endLocation.address && item.route.endLocation.address !== item.route.end}}">{{item.route.endLocation.address}}</view></view><button wx:if="{{item.route.endLocation}}" data-target="end" bindtap="navigate">地图导航</button></view>
        </view>
        <view class="card schedule-card" wx:if="{{item.schedule && item.schedule.length}}"><view class="title">时间安排</view><view wx:for="{{item.schedule}}" wx:key="time" class="schedule-row"><view class="schedule-time">{{item.time}}</view><view class="schedule-track"><view class="schedule-dot"></view></view><view class="schedule-copy"><view>{{item.title}}</view><view class="muted">{{item.location}}</view></view></view></view>
        <view class="card gear-card" wx:if="{{(item.equipment && item.equipment.length) || (item.notices && item.notices.length)}}"><view class="title">装备与注意</view><view class="chip-list"><view class="gear-chip" wx:for="{{item.equipment}}" wx:key="*this"><text class="check">✓</text><text>{{item}}</text></view><view class="notice-chip" wx:for="{{item.notices}}" wx:key="*this"><text class="notice-mark">/</text><text>{{item}}</text></view></view></view>
        <view class="card fee-card" wx:if="{{!item.registrationUnlimited && (item.fee || (item.feeIncluded && item.feeIncluded.length) || (item.feeExcluded && item.feeExcluded.length))}}">
          <view class="title">费用说明</view>
          <view class="body-text" wx:if="{{item.fee}}">{{item.fee}}</view>
          <view class="fee-block" wx:if="{{item.feeIncluded && item.feeIncluded.length}}">
            <view class="fee-block-title">费用包含</view>
            <view class="fee-item" wx:for="{{item.feeIncluded}}" wx:for-item="fee" wx:key="*this"><text class="fee-mark fee-included">+</text><text>{{fee}}</text></view>
          </view>
          <view class="fee-block" wx:if="{{item.feeExcluded && item.feeExcluded.length}}">
            <view class="fee-block-title">费用不包含</view>
            <view class="fee-item" wx:for="{{item.feeExcluded}}" wx:for-item="fee" wx:key="*this"><text class="fee-mark fee-excluded">−</text><text>{{fee}}</text></view>
          </view>
        </view>
      </view>
    </view>
  </state-view>
</view>

<view wx:if="{{selectedAttendee}}" class="rider-modal-mask" bindtap="closeAttendeeCard" catchtouchmove="keepAttendeeCard">
  <view class="rider-card" catchtap="keepAttendeeCard" role="dialog" aria-label="活动报名骑手公开名片">
    <button class="rider-card-close" bindtap="closeAttendeeCard" aria-label="关闭骑行名片">×</button>
    <swiper class="rider-card-swiper" current="{{selectedAttendeeIndex}}" circular="{{attendees.length > 1}}" previous-margin="{{attendees.length > 1 ? '28rpx' : '0'}}" next-margin="{{attendees.length > 1 ? '28rpx' : '0'}}" bindchange="attendeeCardChange">
      <swiper-item wx:for="{{attendees}}" wx:for-item="rider" wx:key="id">
        <view class="rider-card-photo" aria-label="{{rider.displayName}} 的完整公开骑行名片">
          <image wx:if="{{rider.backgroundUrl}}" class="rider-card-photo__image" src="{{rider.backgroundUrl}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" data-url="{{rider.backgroundUrl}}" bindload="selectedAttendeeBackgroundLoad" binderror="selectedAttendeeBackgroundError" />
          <image wx:else class="rider-card-photo__image rider-card-photo__placeholder" src="/assets/brand/logo-share-500x400.png" mode="aspectFill" aria-label="此里默认骑行名片背景" />
          <view class="rider-card-photo__scrim"></view>
          <view class="rider-card-photo__identity">
            <image wx:if="{{rider.avatarUrl}}" class="rider-card-avatar {{rider.genderClass}}" src="{{rider.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" data-url="{{rider.avatarUrl}}" bindload="attendeeAvatarLoad" binderror="attendeeAvatarError" />
            <view wx:else class="rider-card-avatar rider-card-avatar--placeholder {{rider.genderClass}}">骑</view>
            <view class="rider-card-copy"><view class="rider-card-kicker">完整公开骑行名片</view><view class="rider-name">{{rider.displayName || '此里骑手'}}</view><view class="rider-card-photo__badges"><view class="gender-pill {{rider.genderClass}}">{{rider.genderLabel}}</view><view class="rider-status">{{rider.status === 'checked_in' ? '已签到' : '已报名'}}</view></view></view>
          </view>
          <view class="rider-card-note">昵称、头像与照片由骑友本人维护，仅展示公开资料。</view>
        </view>
      </swiper-item>
    </swiper>
    <view class="rider-card-pagination" wx:if="{{attendees.length > 1}}"><text>{{selectedAttendeeIndex + 1}} / {{attendees.length}}</text><text>左右滑动查看其他骑友</text></view>
  </view>
</view>

<view class="fixed detail-action detail-action--admin" wx:if="{{isAdmin}}">
  <button class="btn btn--secondary" disabled="{{loading || !item}}" bindtap="editActivity">修改活动</button>
  <button class="btn" disabled="{{loading || !item}}" bindtap="adminRegistration">{{adminRegistrationLabel}} <text class="button-arrow">→</text></button>
</view>
<view class="fixed detail-action" wx:else><button class="btn" disabled="{{loading || !item || !activityAction.enabled}}" bindtap="go">{{activityAction.label}} <text class="button-arrow">→</text></button></view>
