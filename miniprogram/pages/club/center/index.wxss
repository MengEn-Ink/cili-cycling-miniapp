/* Club Center · 骑行影像志 1:1（对齐 docs/designs/2026-10-22-cycling-image-journal/pages/club-center.html） */
.club-center-page {
  min-height: 100vh;
  padding: 0 0 calc(96rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.a11y-live-region {
  position: absolute;
  left: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
}
.photo.hero.club {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.hero-media {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.hero-media--fallback {
  background:
    linear-gradient(
      135deg,
      var(--surface-club-fallback-shine) 0%,
      var(--surface-club-fallback-clear) 60%
    ),
    radial-gradient(circle at 30% 20%, var(--surface-club-fallback-glow), transparent 55%),
    var(--color-media-card-bg);
}
.shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(
    180deg,
    var(--scrim-club-cover-top) 0%,
    var(--scrim-club-cover-mid) 42%,
    var(--scrim-club-cover-strong) 100%
  );
}
.club-cover-location {
  position: absolute;
  top: 48rpx;
  right: 48rpx;
  padding: 10rpx 20rpx;
  border: 2rpx solid var(--border-club-location);
  border-radius: 999rpx;
  color: var(--color-on-media);
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  background: var(--surface-club-location);
}
.caption {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 56rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.club-identity {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--surface-club-identity);
  backdrop-filter: blur(6rpx);
  color: var(--color-on-media);
}
.club-avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--border-club-avatar);
  background: var(--color-raised);
  overflow: hidden;
}
.club-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 48rpx;
  font-weight: 900;
  background: var(--color-raised);
}
.club-identity-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.club-name {
  font-family: var(--font-family-editorial);
  font-size: 60rpx;
  line-height: 68rpx;
  font-weight: 900;
  letter-spacing: -1.5rpx;
  color: var(--color-on-media);
}
.club-intro {
  color: var(--color-club-intro);
  font-size: 26rpx;
  line-height: 38rpx;
}
.content {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  padding: 40rpx var(--page-gutter) 0;
}
.state-content {
  padding-top: 72rpx;
}
.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  align-self: flex-start;
}
.tag--dark {
  background: var(--color-text);
  color: var(--color-on-action);
}
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 4rpx;
}
.chapterhead-title {
  flex: none;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-rule {
  flex: 1;
  min-width: 0;
  height: 2rpx;
  background: var(--color-border);
}
.chapterhead-aside {
  flex: none;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 22rpx;
  line-height: 32rpx;
  letter-spacing: 1rpx;
}
.chapterhead-action {
  padding: 8rpx 0;
  border: 0;
  background: transparent;
  color: var(--color-text);
  min-height: 48rpx;
  margin-left: auto;
}
.chapterhead-action::after {
  display: none;
}
.club-intro-body {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 42rpx;
}
.detailrows {
  display: flex;
  flex-direction: column;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  overflow: hidden;
}
.detailrow {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 20rpx 24rpx;
}
.detailrow + .detailrow {
  border-top: 2rpx solid var(--color-border-subtle);
}
.detailrow-term {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  letter-spacing: 1rpx;
}
.detailrow-desc {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 36rpx;
  word-break: break-all;
}
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.activity-state {
  padding: 32rpx 24rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 20rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}
.activity-state--error {
  border-style: solid;
  border-color: var(--color-status-warning);
  background: var(--color-status-warning-soft);
  color: var(--color-status-warning);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
}
.activity-retry {
  min-height: 72rpx;
}
.story.activity-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  margin: 0;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
  transition: background var(--motion-duration-fast) var(--motion-easing-standard);
}
.story.activity-row::after {
  display: none;
}
.story.activity-row:active {
  background: var(--color-raised);
}
.story-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.story-date {
  flex: 1;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 24rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}
.story-status {
  flex: none;
}
.story-title {
  font-family: var(--font-family-editorial);
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}
.storyfacts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 20rpx 0 0;
  border-top: 2rpx dashed var(--color-border);
}
.storyfacts-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.storyfacts-value {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
}
.storyfacts-label {
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 30rpx;
}
.storymeta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.storymeta-pin {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
.storymeta-text {
  flex: 1;
  min-width: 0;
}
.storymeta-link {
  color: var(--color-text);
  font-weight: 800;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn--secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.club-manage-btn {
  width: 100%;
}
.club-cover-skeleton {
  min-height: 520rpx;
  background: var(--color-raised);
}
.skeleton-tag,
.skeleton-card {
  background: var(--color-raised);
  border-radius: 20rpx;
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}
.skeleton-tag {
  width: 180rpx;
  height: 48rpx;
}
.skeleton-card {
  height: 240rpx;
}
@keyframes skeleton-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 56rpx 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  text-align: center;
}
.state-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-raised);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 44rpx;
  font-weight: 900;
}
.state-title {
  font-family: var(--font-family-editorial);
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
}
.state-copy {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 38rpx;
}
.club-footer {
  margin-top: 72rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
@media (max-width: 350px) {
  .caption {
    left: 32rpx;
    right: 32rpx;
    bottom: 40rpx;
  }
  .club-cover-location {
    right: 32rpx;
    top: 32rpx;
  }
  .club-name {
    font-size: 48rpx;
    line-height: 56rpx;
  }
  .content {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .story-title {
    font-size: 36rpx;
    line-height: 48rpx;
  }
}

