.club-center-page {
  padding-bottom: calc(96rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}
.club-page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.club-skeleton-cover {
  min-height: 0;
  height: 0;
  padding-bottom: 56.25%;
}
.club-skeleton-line {
  min-height: 0;
  height: 180rpx;
}
.club-skeleton-card {
  min-height: 0;
  height: 280rpx;
}
.state-card .btn {
  width: 100%;
  margin-top: 32rpx;
}
.club-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
  text-align: center;
}
.club-empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
  font-size: 52rpx;
  font-weight: 900;
}
.club-empty .muted {
  margin-top: 12rpx;
  line-height: 44rpx;
}
.club-empty-action {
  width: 100%;
  margin-top: 32rpx;
}
.club-hero {
  margin-top: var(--card-gap);
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.club-cover {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
  background: var(--color-media-card-bg);
}
.club-cover::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 32%, rgba(33, 31, 28, 0.92) 100%);
  content: '';
}
.club-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.club-cover-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-media-card-bg);
}
.club-cover-chip {
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--color-on-media);
  border-radius: 999rpx;
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  opacity: 0.9;
}
.club-cover-location {
  position: absolute;
  z-index: 1;
  top: 24rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(33, 31, 28, 0.76);
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 36rpx;
}
.club-identity {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  margin-top: -176rpx;
  padding: 28rpx 32rpx 32rpx;
  background: transparent;
  color: var(--color-on-media);
}
.club-avatar {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid var(--color-raised);
  border-radius: 36rpx;
  background: var(--color-raised);
}
.club-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 52rpx;
  font-weight: 900;
}
.club-identity-copy {
  min-width: 0;
  flex: 1;
}
.club-name {
  overflow: hidden;
  color: var(--color-on-media);
  font-family: var(--font-family-editorial);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.club-intro-copy {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-media-muted);
  font-size: 26rpx;
  line-height: 38rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.club-viewer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid var(--color-border);
  background: var(--color-raised);
}
.club-viewer-label {
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
}
.club-viewer-value {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 900;
}
.club-card {
  margin-top: var(--card-gap);
}
.club-card-head {
  align-items: center;
  justify-content: flex-start;
}
.club-card-head .card-no {
  margin-right: 4rpx;
  color: var(--color-action);
}
.club-row,
.club-intro {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.club-row-label,
.club-intro .club-row-label {
  flex: 0 0 96rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 44rpx;
}
.club-row-value,
.club-intro-value {
  flex: 1;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
  overflow-wrap: anywhere;
}
.club-intro-value {
  white-space: pre-wrap;
}
.activity-heading {
  display: flex;
}
.activity-heading .card-title {
  flex: 1;
}
.activity-all-link,
.activity-retry {
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-action);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 40rpx;
}
.activity-all-link::after,
.activity-retry::after {
  border: 0;
}
.activity-state {
  margin-top: 24rpx;
  padding: 28rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-raised);
  text-align: center;
}
.activity-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  text-align: left;
}
.activity-list {
  margin-top: 12rpx;
}
.activity-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}
.activity-row:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}
.activity-date {
  flex: 0 0 116rpx;
  color: var(--color-action);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 34rpx;
}
.activity-main {
  min-width: 0;
  flex: 1;
}
.activity-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.activity-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.activity-status {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 30rpx;
}
.activity-place {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.activity-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}
.activity-chevron {
  flex: none;
  color: var(--color-muted);
  font-size: 40rpx;
}
.club-manage-btn {
  width: 100%;
  margin-top: var(--card-gap);
}
