.club-center-page {
  padding-bottom: calc(96rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}
.club-page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 加载骨架：保持与主页相同的纵向结构，弱网下不跳动。 */
.club-skeleton-cover {
  min-height: 0;
  height: 0;
  padding-bottom: 56.25%;
}
.club-skeleton-line {
  min-height: 0;
  height: 160rpx;
}
.club-skeleton-card {
  min-height: 0;
  height: 280rpx;
}

/* 失败与空态。 */
.state-card .btn {
  width: 100%;
  margin-top: 32rpx;
}
.club-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
  text-align: center;
}
.club-empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
  font-size: 52rpx;
  font-weight: 900;
}
.club-empty .muted {
  margin-top: 12rpx;
  line-height: 44rpx;
}
.club-empty-action {
  width: 100%;
  margin-top: 32rpx;
}

/* 顶部封面 16:9，叠放头像与名称。 */
.club-hero {
  margin-top: var(--card-gap);
}
.club-cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%;
  overflow: hidden;
  border-radius: var(--radius-card);
  background: var(--color-media-card-bg);
}
.club-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.club-cover-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-media-card-bg);
}
.club-cover-chip {
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--color-on-media);
  border-radius: 999rpx;
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  opacity: 0.9;
}
.club-cover-location {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(33, 31, 28, 0.72);
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 36rpx;
}
.club-identity {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: -56rpx 24rpx 0;
}
.club-avatar {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  border: 6rpx solid var(--color-surface);
  border-radius: 36rpx;
  background: var(--color-raised);
}
.club-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 52rpx;
  font-weight: 900;
}
.club-identity-copy {
  min-width: 0;
  flex: 1;
  padding: 12rpx 0;
}
.club-name {
  overflow: hidden;
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.club-city {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}
.club-viewer {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 24rpx;
}
.club-viewer-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-raised);
}
.club-viewer-cell--end {
  text-align: right;
}
.club-viewer-label {
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 32rpx;
}
.club-viewer-value {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 42rpx;
}

/* 资料卡与活动卡。 */
.club-card {
  margin-top: var(--card-gap);
}
.club-card-head {
  justify-content: flex-start;
  align-items: flex-start;
}
.club-card-head .card-no {
  margin-right: 4rpx;
  color: var(--color-action);
}
.club-card-head-copy {
  min-width: 0;
}
.club-card-head-copy .muted {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 36rpx;
}
.club-row {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.club-row-label,
.club-intro .club-row-label {
  flex: 0 0 96rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 44rpx;
}
.club-row-value {
  flex: 1;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
  overflow-wrap: anywhere;
}
.club-intro {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.club-intro-value {
  flex: 1;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.club-activities-btn {
  width: 100%;
  margin-top: 28rpx;
}
.club-center-page .neutral-note {
  margin-top: var(--card-gap);
}
.club-manage-btn {
  width: 100%;
  margin-top: var(--card-gap);
}
