<view class="page review-detail-page">
  <brand-logo compact="{{true}}" meta="审批详情" />
  <view class="skeleton" wx:if="{{loading}}"><view></view><view></view><view></view></view>
  <view class="state-card" wx:if="{{error && !x}}" role="alert"><view class="title">加载失败</view><view class="muted">{{error}}</view></view>
  <block wx:if="{{x && card}}">
    <view class="info-bar"><view class="info-head"><text class="info-kicker">报名编号 {{x.id}}</text><text class="info-tag {{x.status === 'pending' ? 'is-pending' : ''}}">{{statusText}}</text></view><view class="info-title">{{card.displayName}} · {{x.activity.title}}</view><view class="status-explain">{{x.status === 'pending' ? '通过后骑友会收到出发凭证；驳回需填写理由。' : '当前审批状态已更新。'}}</view></view>

    <view class="card"><view class="card-head"><text class="card-no">01</text><view class="title">报名人</view><text class="tag">管理员可见完整信息</text></view><view class="detail-line"><text>昵称</text><strong>{{card.displayName}}</strong></view><view class="detail-line"><text>真实姓名</text><strong>{{card.realName}}</strong></view><view class="detail-line"><text>性别</text><strong>{{card.genderLabel}}</strong></view><view class="detail-line"><text>手机号</text><strong>{{phone}}</strong></view><view class="detail-line"><text>验证来源</text><strong>{{phoneSource}}</strong></view></view>
    <view class="card"><view class="card-head"><text class="card-no">02</text><view class="title">报名信息</view></view><view class="detail-line"><text>骑行经验</text><strong>{{card.experience}}</strong></view><view class="detail-line" wx:if="{{x.gatheringMode}}"><text>集合方式</text><strong>{{x.gatheringMode}}</strong></view><view class="detail-line" wx:if="{{x.teamName}}"><text>队伍</text><strong>{{x.teamName}}{{x.isTeamLeader ? ' · 队长' : ''}}</strong></view><view class="detail-line"><text>报名备注</text><strong>{{card.remark || '无'}}</strong></view></view>
    <view class="card"><view class="card-head"><text class="card-no">03</text><view class="title">照片</view></view><view class="muted">资料与照片由骑友本人维护，仅用于本次活动审核。</view><view class="photo-strip"><image wx:for="{{card.images}}" wx:key="url" src="{{item.url}}" mode="aspectFill" lazy-load="{{true}}" /></view></view>
    <view wx:if="{{x.status === 'pending'}}" class="decision-panel"><view class="card-head"><text class="card-no">04</text><view class="title">审核意见</view><text class="tag">驳回时必填</text></view><textarea class="textarea {{reasonError ? 'is-error' : ''}}" value="{{reason}}" bindinput="reason" placeholder-class="input-placeholder" placeholder="驳回时必填，骑友会看到这段说明" maxlength="200" /><view wx:if="{{reasonError}}" class="field-error" role="alert">{{reasonError}}</view></view>
    <view class="card danger" wx:if="{{error}}" role="alert">{{error}}</view>
  </block>
  <view wx:if="{{x.status === 'pending'}}" class="fixed actions"><button class="secondary" data-s="rejected" bindtap="act" disabled="{{submitting}}">驳回</button><button class="btn" data-s="approved" bindtap="act" disabled="{{submitting}}" loading="{{submitting}}">通过报名</button></view>
  <view wx:elif="{{x.status === 'approved'}}" class="row actions fixed single-action"><button class="btn" bindtap="checkIn" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? '正在签到' : '确认签到'}}</button></view>
</view>
