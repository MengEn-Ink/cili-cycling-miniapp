<mock-banner/><view class="page" wx:if="{{x}}"><view class="hero"><view>RIDER IDENTITY</view><view class="hero-title">{{x.profile.nickname}}</view><view>{{x.profile.title}} · {{x.experience}}</view></view><view class="card"><view class="title">识人相册</view><view class="row"><view class="photo" wx:for="{{x.profile.photos}}" wx:key="id">{{item.category}}</view></view></view><view class="card"><view class="title">实名资料（默认脱敏）</view><view>{{x.profile.realName}} · {{phone}}</view><view>{{x.profile.idType}} {{id}}</view><view class="muted">Mock 不提供明文查看；真实版须云端鉴权并写审计</view></view><view class="card"><view class="row"><view class="title">Strava</view><text class="tag">{{x.strava.status}}</text></view><view wx:if="{{x.strava.status==='exempted'}}">豁免原因：{{x.strava.reason}}</view><view wx:else class="grid"><view class="metric"><view class="big">{{x.strava.rides90d}}</view><view>近 90 天次数</view></view><view class="metric"><view class="big">{{x.strava.speedKmh}}</view><view>加权均速</view></view><view class="metric"><view class="big">{{x.strava.longestKm}}</view><view>最长 km</view></view><view class="metric"><view class="big">{{x.strava.elevationM}}</view><view>最大爬升 m</view></view></view></view><view class="card"><view class="label">驳回理由（驳回必填）</view><textarea class="textarea" value="{{reason}}" bindinput="reason"/></view><view class="row"><button class="secondary" data-s="rejected" bindtap="act">驳回</button><button class="btn" data-s="approved" bindtap="act">通过</button></view></view>