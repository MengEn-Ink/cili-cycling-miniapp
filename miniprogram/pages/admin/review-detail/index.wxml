<view class="page review-detail-page">
  <view class="brand-bar"><view class="cili-mark"><text class="mark-cut"></text></view><view class="brand-word">CILI <text>此里</text></view><view class="desk-code">REVIEW / DETAIL</view></view>
  <view class="card danger" wx:if="{{error}}">{{error}}</view>
  <block wx:if="{{x && card}}">
    <view class="review-title"><view class="eyebrow-title">RIDER REVIEW</view><view class="title-cn">报名审核</view><view class="review-status">{{statusText}}</view></view>
    <view class="capability-card">
      <swiper wx:if="{{card.hasMultipleImages}}" class="capability-hero" circular autoplay interval="5000" duration="450" indicator-dots indicator-color="rgba(255,255,255,0.45)" indicator-active-color="#d55b1f">
        <swiper-item wx:for="{{card.images}}" wx:key="url"><view class="hero-slide"><image class="rider-photo" src="{{item.url}}" mode="aspectFill" lazy-load /><view class="hero-shade"></view><view class="hero-content"><view class="eyebrow">RIDER CAPABILITY</view><view class="rider-name">{{card.displayName}}</view><view class="identity-line"><text class="masked-name">{{card.maskedName}}</text><text class="photo-source">{{item.source}}</text></view></view></view></swiper-item>
      </swiper>
      <view wx:elif="{{card.images.length === 1}}" class="capability-hero hero-slide"><image class="rider-photo" src="{{card.images[0].url}}" mode="aspectFill" lazy-load /><view class="hero-shade"></view><view class="hero-content"><view class="eyebrow">RIDER CAPABILITY</view><view class="rider-name">{{card.displayName}}</view><view class="identity-line"><text class="masked-name">{{card.maskedName}}</text><text class="photo-source">{{card.images[0].source}}</text></view></view></view>
      <view wx:else class="capability-hero hero-slide photo-empty"><view class="empty-mark">CILI</view><view class="hero-shade"></view><view class="hero-content"><view class="eyebrow">RIDER CAPABILITY</view><view class="rider-name">{{card.displayName}}</view><view class="identity-line"><text class="masked-name">{{card.maskedName}}</text></view></view></view>
      <view class="summary-row"><view class="status {{card.statusTone}}"><text class="status-dot"></text>STRAVA {{card.stravaStatus}}</view></view>
      <view class="facts"><view class="fact"><text>骑行经验</text><strong>{{card.experience}}</strong></view><view class="fact" wx:if="{{x.gatheringMode}}"><text>集合方式</text><strong>{{x.gatheringMode}}</strong></view></view>
      <view class="metrics"><view class="metric"><strong>{{card.totalKm}}</strong><text>近 90 天里程</text></view><view class="metric"><strong>{{card.rides90d}}</strong><text>近 90 天次数</text></view><view class="metric"><strong>{{card.longestKm}}</strong><text>最长骑行</text></view><view class="metric"><strong>{{card.elevationM}}</strong><text>累计爬升</text></view><view class="metric"><strong>{{card.speedKmh}}</strong><text>加权均速</text></view></view>
      <view class="sync-meta"><view>覆盖范围：{{card.coverageRange}}</view><view>覆盖状态：{{card.coverageState}}</view><view>数据同步时间：{{card.syncedAt}}</view></view><view class="corner-cut"></view>
    </view>
    <view class="snapshot-panel"><view class="panel-code">REGISTRATION SNAPSHOT</view><view class="title">报名快照</view><view class="detail-line"><text>手机号</text><strong>{{phone}}</strong></view><view class="detail-line"><text>验证来源</text><strong>{{phoneSource}}</strong></view><view class="detail-line"><text>骑行经验</text><strong>{{card.experience}}</strong></view><view class="detail-line" wx:if="{{x.gatheringMode}}"><text>集合方式</text><strong>{{x.gatheringMode}}</strong></view><view class="detail-line"><text>报名备注</text><strong>{{card.remark || '无'}}</strong></view></view>
    <view class="decision-panel"><view class="panel-code">DECISION NOTE</view><view class="label">驳回理由（驳回必填）</view><textarea class="textarea" value="{{reason}}" bindinput="reason" /></view>
    <view class="row actions"><button class="secondary" data-s="rejected" bindtap="act">驳回</button><button class="btn" data-s="approved" bindtap="act">通过报名</button></view>
  </block>
</view>
