<view class="page"><view class="card danger" wx:if="{{error}}">{{error}}</view><block wx:if="{{x}}"><view class="hero"><view>RIDER IDENTITY</view><view class="hero-title">{{x.profile.nickname}}</view><view>{{x.experience}}</view></view><view class="card"><view class="title">实名资料（仅脱敏）</view><view>{{x.profile.realName}} · {{phone}}</view><view>{{id}}</view></view><view class="card"><view class="row"><view class="title">Strava</view><text class="tag">{{x.strava.status}}</text></view><view class="grid"><view class="metric"><view class="big">{{x.strava.rides90d}}</view><view>近 90 天次数</view></view><view class="metric"><view class="big">{{x.strava.speedKmh}}</view><view>加权均速</view></view><view class="metric"><view class="big">{{x.strava.longestKm}}</view><view>最长 km</view></view></view></view><view class="card"><view class="label">驳回理由（驳回必填）</view><textarea class="textarea" value="{{reason}}" bindinput="reason"/></view><view class="row"><button class="secondary" data-s="rejected" bindtap="act">驳回</button><button class="btn" data-s="approved" bindtap="act">通过</button></view></block></view>
