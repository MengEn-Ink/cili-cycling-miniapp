.review-detail-page {
  min-height: 100vh;
  padding-bottom: calc(var(--fixed-action-reserve) + 64rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}
.journal-heading {
  padding: 28rpx 0 56rpx;
}
.journal-eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.journal-eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.journal-title {
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}
.journal-summary {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 32rpx;
  line-height: 48rpx;
}
.review-detail-page .card,
.decision-panel {
  margin-top: 64rpx;
  padding: 40rpx 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}
.info-bar {
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}
.info-kicker {
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--color-muted);
  font-variant-numeric: tabular-nums;
}
.info-kicker--pending {
  color: var(--color-muted);
}
.info-title {
  overflow-wrap: anywhere;
  color: var(--color-text);
}
.info-head,
.card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.info-head {
  justify-content: space-between;
}
.info-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
}
.info-tag.is-pending {
  border-color: var(--color-brand);
}
.status-explain {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.card-head .tag {
  margin-left: auto;
}
.detail-line {
  min-height: var(--control-height);
}
.photo-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}
.photo-cell {
  position: relative;
}
.photo-strip image {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-sm);
}
.photo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.textarea {
  margin-top: 24rpx;
}
.textarea.is-error {
  border-color: var(--color-brand);
}
.single-action {
  grid-template-columns: 1fr;
}
.actions .secondary {
  min-height: 88rpx;
}
.actions .btn {
  min-height: 96rpx;
}
.skeleton {
  padding: 32rpx;
}
.skeleton view {
  height: 28rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
}
