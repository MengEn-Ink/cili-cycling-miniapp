.capability-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  color: #eef8f1;
  background: linear-gradient(145deg, #092f27, #0d624b);
  box-shadow: 0 18rpx 46rpx rgba(8, 65, 49, 0.22);
}

.capability-hero,
.hero-slide {
  position: relative;
  height: 440rpx;
  overflow: hidden;
  background: #173d33;
}

.rider-photo {
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(3, 18, 14, 0.16) 18%,
    rgba(3, 18, 14, 0.68) 62%,
    rgba(3, 18, 14, 0.94) 100%
  );
}

.hero-content {
  position: absolute;
  right: 28rpx;
  bottom: 42rpx;
  left: 28rpx;
  min-width: 0;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.72);
}

.eyebrow,
.sync-meta {
  color: #c4ead9;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.rider-name {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-line {
  display: flex;
  min-width: 0;
  margin-top: 10rpx;
  align-items: center;
  gap: 12rpx;
}

.masked-name {
  overflow: hidden;
  color: #eef8f1;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-source {
  flex: none;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  background: rgba(0, 0, 0, 0.48);
}

.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #31594d, #173d33);
}

.empty-mark {
  color: rgba(238, 248, 241, 0.6);
  font-size: 28rpx;
}

.summary-row {
  padding: 22rpx 28rpx 8rpx;
}

.status {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.14);
}

.status.success {
  color: #a8f0c7;
}
.status.warning {
  color: #ffe09a;
}
.status.danger {
  color: #ffb9b4;
}
.status.muted {
  color: #d4ded9;
}

.facts,
.metrics {
  display: flex;
  margin: 0 28rpx;
  flex-wrap: wrap;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.fact,
.metric {
  display: flex;
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  padding: 20rpx 4rpx;
  flex-direction: column;
}

.fact text,
.metric text {
  color: #b9d5ca;
  font-size: 22rpx;
}

.fact strong,
.metric strong {
  overflow-wrap: anywhere;
  margin-bottom: 6rpx;
  font-size: 28rpx;
  line-height: 1.25;
}

.sync-meta {
  margin: 0 28rpx;
  padding: 18rpx 0 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

.sync-meta view + view {
  margin-top: 8rpx;
}

.detail-card .title {
  margin-bottom: 14rpx;
}
.detail-line {
  margin-top: 10rpx;
  color: #526159;
  overflow-wrap: anywhere;
}
.actions {
  gap: 20rpx;
}
.actions button {
  flex: 1;
}
