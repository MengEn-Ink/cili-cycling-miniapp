.review-detail-page {
  background: var(--color-bg);
}
.info-bar {
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}
.info-kicker {
  min-width: 0;
  overflow-wrap: anywhere;
  word-break: break-all;
  color: var(--color-muted);
}
.info-title {
  overflow-wrap: anywhere;
  color: var(--color-text);
}
.info-head,
.card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.info-head {
  justify-content: space-between;
}
.info-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
}
.info-tag.is-pending {
  border-color: var(--color-brand);
}
.status-explain {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.card-head .tag {
  margin-left: auto;
}
.detail-line {
  min-height: var(--control-height);
}
.photo-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}
.photo-strip image {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-sm);
}
.textarea {
  margin-top: 24rpx;
}
.textarea.is-error {
  border-color: var(--color-brand);
}
.single-action {
  grid-template-columns: 1fr;
}
.skeleton {
  padding: 32rpx;
}
.skeleton view {
  height: 28rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
}
