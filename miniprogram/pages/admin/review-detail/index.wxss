page {
  background: #0b0b0c;
}
.review-detail-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: radial-gradient(circle at 94% 3%, rgba(213, 91, 31, 0.13), transparent 30%), #0b0b0c;
  color: #f7f7f5;
}
.brand-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 8rpx 26rpx;
  border-bottom: 1rpx solid #343437;
}
.cili-mark {
  position: relative;
  width: 48rpx;
  height: 38rpx;
  border: 9rpx solid #f7f7f5;
  border-right-width: 7rpx;
  border-radius: 13rpx 4rpx 13rpx 13rpx;
  transform: skewX(-9deg);
}
.mark-cut {
  position: absolute;
  top: -11rpx;
  right: -9rpx;
  width: 26rpx;
  height: 17rpx;
  background: #d55b1f;
  clip-path: polygon(100% 0, 70% 100%, 0 100%);
}
.brand-word {
  font-size: 28rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.brand-word text {
  margin-left: 7rpx;
  font-size: 21rpx;
  font-style: normal;
}
.desk-code {
  margin-left: auto;
  color: #77777b;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.review-title {
  position: relative;
  padding: 38rpx 8rpx 24rpx;
}
.eyebrow-title {
  color: #d55b1f;
  font-size: 20rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 3rpx;
}
.title-cn {
  margin-top: 3rpx;
  font-size: 52rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.12;
}
.review-status {
  position: absolute;
  right: 8rpx;
  bottom: 30rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid #6b6b6f;
  color: #bcbcc0;
  font-size: 19rpx;
  font-weight: 800;
  text-transform: uppercase;
}
.card.danger {
  border: 1rpx solid #85312d;
  border-radius: 6rpx;
  background: #291413;
  color: #ff8f86;
}
.capability-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #626266;
  border-radius: 8rpx;
  color: #f7f7f5;
  background: linear-gradient(145deg, #202023, #111113);
  box-shadow: 0 20rpx 52rpx rgba(0, 0, 0, 0.4);
}
.capability-hero,
.hero-slide {
  position: relative;
  overflow: hidden;
  height: 430rpx;
  background: #1d1d20;
}
.rider-photo {
  width: 100%;
  height: 100%;
}
.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.08) 18%,
    rgba(5, 5, 6, 0.56) 62%,
    rgba(5, 5, 6, 0.96) 100%
  );
}
.hero-content {
  position: absolute;
  right: 28rpx;
  bottom: 38rpx;
  left: 28rpx;
  min-width: 0;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.72);
}
.eyebrow,
.sync-meta {
  color: #d55b1f;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.rider-name {
  overflow: hidden;
  margin-top: 6rpx;
  font-size: 48rpx;
  font-style: italic;
  font-weight: 900;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.identity-line {
  display: flex;
  min-width: 0;
  margin-top: 10rpx;
  align-items: center;
  gap: 12rpx;
}
.masked-name {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.photo-source {
  flex: none;
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  color: #fff;
  font-size: 18rpx;
  background: rgba(0, 0, 0, 0.55);
}
.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: repeating-linear-gradient(
    135deg,
    #252528,
    #252528 18rpx,
    #1b1b1d 18rpx,
    #1b1b1d 36rpx
  );
}
.empty-mark {
  color: rgba(247, 247, 245, 0.18);
  font-size: 76rpx;
  font-style: italic;
  font-weight: 900;
}
.summary-row {
  padding: 22rpx 28rpx 8rpx;
}
.status {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 13rpx;
  border: 1rpx solid #68686c;
  color: #d0d0d2;
  font-size: 21rpx;
  font-weight: 800;
}
.status-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #d55b1f;
}
.status.warning {
  color: #e7804d;
}
.status.danger {
  color: #ef6961;
}
.status.muted {
  color: #9c9ca0;
}
.facts,
.metrics {
  display: flex;
  margin: 0 28rpx;
  flex-wrap: wrap;
  border-top: 1rpx solid #444448;
}
.fact,
.metric {
  display: flex;
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  padding: 20rpx 14rpx 20rpx 0;
  flex-direction: column;
}
.fact text,
.metric text {
  color: #8e8e92;
  font-size: 20rpx;
}
.fact strong,
.metric strong {
  overflow-wrap: anywhere;
  margin-bottom: 5rpx;
  color: #f7f7f5;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.25;
}
.metric strong {
  color: #d55b1f;
  font-size: 34rpx;
}
.sync-meta {
  margin: 0 28rpx;
  padding: 18rpx 0 26rpx;
  border-top: 1rpx solid #444448;
  color: #a8a8ad;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}
.sync-meta view + view {
  margin-top: 7rpx;
}
.corner-cut {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  background: #d55b1f;
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}
.snapshot-panel,
.decision-panel {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #4d4d51;
  border-radius: 6rpx;
  background: #19191b;
}
.panel-code {
  margin-bottom: 10rpx;
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}
.snapshot-panel .title {
  margin-bottom: 12rpx;
  color: #f7f7f5;
}
.detail-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #39393c;
  color: #858589;
}
.detail-line strong {
  max-width: 64%;
  color: #e8e8e7;
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}
.label {
  color: #a0a0a4;
}
.textarea {
  border: 1rpx solid #555559;
  border-radius: 4rpx;
  background: #101012;
  color: #f7f7f5;
}
.actions {
  gap: 18rpx;
}
.actions button {
  flex: 1;
  border-radius: 4rpx !important;
}
.actions .secondary {
  border: 1rpx solid #8b312d;
  background: #2a1312 !important;
  color: #ef6961 !important;
}
.actions .btn {
  background: #d55b1f !important;
  color: #0b0b0c !important;
}
