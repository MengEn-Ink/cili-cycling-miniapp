.review-page {
  background: var(--color-bg);
}
.info-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.info-tag {
  border: 4rpx solid var(--color-media-muted);
}
.info-tag.is-pending {
  border-color: var(--color-brand);
}
.switch-activity {
  min-height: var(--control-height);
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 4rpx solid var(--color-on-media);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--color-on-media);
  font-weight: 800;
}
.reminder-card .secondary {
  width: 100%;
  margin-top: 24rpx;
}
.filter-tabs {
  grid-template-columns: repeat(3, 1fr);
  margin-top: 32rpx;
}
.filter-tab:nth-child(3n) {
  border-right: 0;
}
.result-count {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.review-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  text-align: left;
}
.review-avatar {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  overflow: hidden;
  border: 4rpx solid var(--color-border-strong);
  border-radius: 50%;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 900;
}
.review-avatar image {
  width: 100%;
  height: 100%;
}
.review-card--pressed {
  background: var(--color-raised);
}
.review-main {
  flex: 1;
  min-width: 0;
}
.applicant-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.applicant-name {
  min-width: 0;
  overflow: hidden;
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.data-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}
.data-line text {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
  font-size: 24rpx;
  line-height: 36rpx;
}
.submitted-at {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.open-arrow {
  margin-left: 16rpx;
  color: var(--color-muted);
  font-size: 36rpx;
}
.state-card .btn {
  margin-top: 24rpx;
}
.skeleton {
  padding: 32rpx;
}
.skeleton view {
  height: 28rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
}
