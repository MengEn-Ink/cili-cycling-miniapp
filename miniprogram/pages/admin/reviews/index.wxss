/* 骑行影像志 · 报名审核 1:1 实现
 * 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/admin-reviews.html
 *   pageheading → content.tight(info-bar + filters + reviewitem × N + paper reminder + notice)
 */

.review-page {
  min-height: 100vh;
  padding: 0 0 calc(96rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

/* --- pageheading --------------------------------------------------------- */
.pageheading {
  padding: 32rpx var(--page-gutter) 24rpx;
}
.pageheading .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.pageheading .eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.pageheading-title {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-sub {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* --- content ------------------------------------------------------------ */
.content {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  padding: 0 var(--page-gutter);
}
.content.tight {
  gap: 32rpx;
}

/* --- info-bar (current activity) ----------------------------------------- */
.info-bar {
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}
.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.info-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-raised);
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.info-tag.is-pending {
  background: var(--color-text);
  color: var(--color-on-action);
  border-color: var(--color-text);
}
.switch-activity {
  margin: 0;
  padding: 8rpx 20rpx;
  min-height: 56rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: transparent;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
}
.switch-activity::after {
  display: none;
}

/* --- filters ------------------------------------------------------------ */
.filters {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.filter-tab {
  margin: 0;
  padding: 14rpx 10rpx;
  min-height: 72rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.filter-tab::after {
  display: none;
}
.filter-tab.is-active {
  background: var(--color-text);
  color: var(--color-on-action);
  border-color: var(--color-text);
}

/* --- status / limit lines ------------------------------------------------ */
.result-count,
.limit-notice {
  display: block;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--color-muted);
  letter-spacing: 1rpx;
}
.small {
  font-size: 22rpx;
  line-height: 32rpx;
}
.muted {
  color: var(--color-muted);
}

/* --- skeleton + empty --------------------------------------------------- */
.skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.skeleton view {
  height: 128rpx;
  border-radius: 20rpx;
  background: var(--color-raised);
  animation: review-shimmer 1.4s ease-in-out infinite;
}
@keyframes review-shimmer {
  0%,
  100% {
    opacity: 0.5;
  }
  50% {
    opacity: 1;
  }
}
.empty {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 40rpx 32rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-text);
}
.empty-copy {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 38rpx;
}
.empty .btn {
  align-self: center;
}

/* --- reviewitem list ---------------------------------------------------- */
.reviewitem-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.reviewitem {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 24rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  color: var(--color-text);
}
.reviewitem--approved {
  border-color: var(--color-text);
}
.reviewitem--rejected,
.reviewitem--cancelled {
  background: var(--color-raised);
  color: var(--color-muted);
}
.reviewitem-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.reviewitem-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-raised);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 800;
  flex: none;
}
.reviewitem-avatar image {
  width: 100%;
  height: 100%;
}
.reviewitem-copy {
  flex: 1;
  min-width: 0;
}
.reviewitem-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-text);
}
.reviewitem-sub {
  margin-top: 2rpx;
}
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  flex: none;
}
.tag--waiting,
.tag--pending {
  background: var(--color-raised);
  color: var(--color-text);
  border-color: var(--color-border);
}
.tag--approved,
.tag--checked_in {
  background: var(--color-text);
  color: var(--color-on-action);
  border-color: var(--color-text);
}
.tag--rejected,
.tag--cancelled {
  background: transparent;
  color: var(--color-muted);
  border-color: var(--color-border);
}
.reviewitem-activity {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 900;
}
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.meta .mono {
  font-family: var(--font-family-mono);
  letter-spacing: 1rpx;
  color: var(--color-text);
}
.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed var(--color-border);
}
.reviewitem-cta {
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
}

/* --- paper reminder card ------------------------------------------------- */
.paper {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  background-image: repeating-linear-gradient(
    transparent 0,
    transparent 46rpx,
    var(--color-border) 46rpx,
    var(--color-border) 48rpx
  );
  background-size: 100% 48rpx;
  background-position: 0 60rpx;
}
.chapterhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.chapterhead-title {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-aside {
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* --- notice -------------------------------------------------------------- */
.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-text);
}

/* --- btn ---------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn.secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.btn[disabled] {
  opacity: 0.6;
}

@media (max-width: 350px) {
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .filters {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .reviewitem-activity {
    font-size: 30rpx;
    line-height: 42rpx;
  }
}

/* Scheme B v6: compact approval queue ----------------------------------- */
.review-page .pageheading {
  padding-top: 24rpx;
  padding-bottom: 16rpx;
}
.review-page .pageheading-title {
  margin-top: 10rpx;
  font-size: 52rpx;
  line-height: 60rpx;
  letter-spacing: -1rpx;
}
.review-page .pageheading-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}
.review-page .content.tight {
  gap: 22rpx;
}
.review-page .info-bar {
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
}
.review-page .filters {
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--color-raised);
}
.review-page .filter-tab {
  min-height: 64rpx;
  padding: 0 10rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.review-page .reviewitem-list {
  gap: 12rpx;
}
.review-page .reviewitem {
  gap: 10rpx;
  padding: 16rpx 18rpx;
  border-radius: 10rpx;
}
.review-page .reviewitem-avatar {
  width: 68rpx;
  height: 68rpx;
  font-size: 26rpx;
}
.review-page .reviewitem-title {
  font-size: 27rpx;
}
.review-page .tag {
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}
.review-page .reviewitem-activity {
  font-family: var(--font-family-body);
  font-size: 27rpx;
  line-height: 38rpx;
}
.review-page .meta {
  font-size: 21rpx;
  line-height: 30rpx;
}
.review-page .paper,
.review-page .notice {
  padding: 16rpx 18rpx;
  border-radius: 10rpx;
}
.review-page .btn {
  border-radius: 8rpx;
  font-size: 26rpx;
}
