/* 骑行影像志 · 报名审核 1:1 实现
 * 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/admin-reviews.html
 *   pageheading → content.tight(info-bar + filters + reviewitem × N + paper reminder + notice)
 */

.review-page {
  min-height: 100vh;
  padding: 0 0 calc(96rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

/* --- pageheading --------------------------------------------------------- */
.pageheading {
  padding: 32rpx var(--page-gutter) 24rpx;
}

.pageheading-title {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-sub {
  margin-top: var(--space-3);
  color: var(--color-muted);
  font-size: var(--font-size-body);
  line-height: 44rpx;
}

/* --- content ------------------------------------------------------------ */
.content {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  padding: 0 var(--page-gutter);
}
.content.tight {
  gap: var(--space-5);
}

/* --- info-bar (current activity) ----------------------------------------- */
.info-bar {
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}
.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}
.info-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-raised);
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
}
.info-tag.is-pending {
  background: var(--color-text);
  color: var(--color-on-action);
  border-color: var(--color-text);
}
.switch-activity {
  margin: 0;
  padding: 8rpx 20rpx;
  min-height: 56rpx;
  border: 2rpx solid var(--color-text);
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--color-text);
  font-size: var(--font-size-label);
  line-height: 32rpx;
  font-weight: 800;
}
.switch-activity::after {
  display: none;
}

/* --- filters ------------------------------------------------------------ */
.filters {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-2);
}
.filter-tab {
  margin: 0;
  padding: 14rpx 10rpx;
  min-height: 72rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: var(--font-size-body);
  line-height: 36rpx;
  font-weight: 800;
}
.filter-tab::after {
  display: none;
}
.filter-tab.is-active {
  background: var(--color-text);
  color: var(--color-on-action);
  border-color: var(--color-text);
}

/* --- status / limit lines ------------------------------------------------ */
.result-count,
.limit-notice {
  display: block;
  font-size: var(--font-size-label);
  line-height: 32rpx;
  color: var(--color-muted);
  letter-spacing: 1rpx;
}
.small {
  font-size: var(--font-size-label);
  line-height: 32rpx;
}
.muted {
  color: var(--color-muted);
}

/* --- skeleton + empty --------------------------------------------------- */
.skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.skeleton view {
  height: 128rpx;
  border-radius: var(--radius-md);
  background: var(--color-raised);
  animation: review-shimmer 1.4s ease-in-out infinite;
}
@keyframes review-shimmer {
  0%,
  100% {
    opacity: 0.5;
  }
  50% {
    opacity: 1;
  }
}
.empty {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: 40rpx 32rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-text);
}
.empty-copy {
  color: var(--color-muted);
  font-size: var(--font-size-body);
  line-height: 38rpx;
}
.empty .btn {
  align-self: center;
}

/* --- reviewitem list ---------------------------------------------------- */
.reviewitem-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
.reviewitem {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: 28rpx 24rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  color: var(--color-text);
}
.reviewitem--approved {
  border-color: var(--color-text);
}
.reviewitem--rejected,
.reviewitem--cancelled {
  background: var(--color-raised);
  color: var(--color-muted);
}
.reviewitem-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.reviewitem-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-raised);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 800;
  flex: none;
}
.reviewitem-avatar image {
  width: 100%;
  height: 100%;
}
.reviewitem-copy {
  flex: 1;
  min-width: 0;
}
.reviewitem-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-text);
}
.reviewitem-sub {
  margin-top: 2rpx;
}
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--color-text);
  border-radius: var(--radius-full);
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
  flex: none;
}
.tag--waiting,
.tag--pending {
  background: var(--color-raised);
  color: var(--color-text);
  border-color: var(--color-border);
}
.tag--approved,
.tag--checked_in {
  background: var(--color-text);
  color: var(--color-on-action);
  border-color: var(--color-text);
}
.tag--rejected,
.tag--cancelled {
  background: transparent;
  color: var(--color-muted);
  border-color: var(--color-border);
}
.reviewitem-activity {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 900;
}
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}
.meta .mono {
  font-family: var(--font-family-mono);
  letter-spacing: 1rpx;
  color: var(--color-text);
}
.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding-top: var(--space-2);
  border-top: 2rpx dashed var(--color-border);
}
.reviewitem-cta {
  color: var(--color-text);
  font-size: var(--font-size-label);
  font-weight: 800;
}

/* --- paper reminder card ------------------------------------------------- */
.paper {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  background-image: repeating-linear-gradient(
    transparent 0,
    transparent 46rpx,
    var(--color-border) 46rpx,
    var(--color-border) 48rpx
  );
  background-size: 100% 48rpx;
  background-position: 0 60rpx;
}
.chapterhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}
.chapterhead-title {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-aside {
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
}

/* --- notice -------------------------------------------------------------- */
.notice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: var(--space-2);
  border-radius: 50%;
  background: var(--color-text);
}

/* --- btn ---------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: var(--radius-full);
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: var(--font-size-body);
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn.secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.btn[disabled] {
  opacity: 0.6;
}

@media (max-width: 350px) {
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .filters {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .reviewitem-activity {
    font-size: 30rpx;
    line-height: 42rpx;
  }
}

/* 2026-10-28 · Direction A / 暗场后台、炭黑审核卡 */
.review-page {
  background: var(--color-cinema-bg);
  color: var(--color-cinema-text);
}
.review-page .pageheading {
  padding-top: 40rpx;
}

.review-page .pageheading-title {
  color: var(--color-cinema-text);
}
.review-page .pageheading-sub,
.review-page > .content > .result-count,
.review-page > .content > .limit-notice {
  color: var(--color-cinema-muted);
}
.review-page .info-bar {
  border-color: var(--color-cinema-line);
  background: var(--color-cinema-panel);
}
.review-page .info-tag {
  border-color: var(--color-cinema-line);
  background: var(--color-cinema-panel-raised);
  color: var(--color-cinema-muted);
}
.review-page .info-tag.is-pending,
.review-page .filter-tab.is-active {
  border-color: var(--color-cinema-red);
  background: var(--color-cinema-red);
  color: var(--color-on-action);
}
.review-page .switch-activity,
.review-page .filter-tab {
  border-color: var(--color-cinema-line);
  border-radius: 10rpx;
  background: var(--color-cinema-panel);
  color: var(--color-cinema-text);
}
.review-page .reviewitem,
.review-page .paper,
.review-page .empty {
  border-color: var(--color-border-strong);
  background-color: var(--color-paper);
  color: var(--color-ink);
  box-shadow: var(--shadow-card);
}
.review-page .reviewitem {
  border-radius: 18rpx;
}
.review-page > .content > .notice {
  border-color: var(--color-cinema-line);
  background: var(--color-cinema-panel);
  color: var(--color-cinema-text);
}
.review-page > .content > .notice .notice-dot {
  background: var(--color-cinema-red);
}
.review-page .btn {
  border-color: var(--color-cinema-red);
  border-radius: 10rpx;
  background: var(--color-cinema-red);
}
.review-page .btn.secondary {
  border-color: var(--color-border-strong);
  background: var(--color-surface);
  color: var(--color-text);
}
