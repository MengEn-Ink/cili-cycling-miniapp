<view class="page review-page">
  <brand-logo compact="{{true}}" meta="报名审批" />
  <view class="info-bar" wx:if="{{activities.length}}">
    <view class="info-head"><text class="info-kicker">当前活动</text><text class="info-tag {{tab === 'pending' && items.length ? 'is-pending' : ''}}">{{tab === 'pending' ? items.length : '—'}} 待审核</text></view>
    <view class="info-title">{{selectedActivityTitle}}</view>
    <picker mode="selector" range="{{activities}}" range-key="title" value="0" bindchange="choose"><button class="switch-activity">切换活动 ›</button></picker>
  </view>
  <view class="card reminder-card" wx:if="{{activities.length}}"><view class="title">发送活动提醒</view><view class="muted">只发给已通过的骑友，重复点击不会重复发送；不是自动定时提醒。</view><button class="secondary" bindtap="sendReminders" loading="{{sendingReminders}}" disabled="{{sendingReminders}}">{{sendingReminders ? '发送中…' : '发送活动提醒'}}</button></view>
  <view class="filter-tabs">
    <button class="filter-tab {{tab === 'waiting' ? 'is-active' : ''}}" data-v="waiting" bindtap="tab">候补</button><button class="filter-tab {{tab === 'pending' ? 'is-active' : ''}}" data-v="pending" bindtap="tab">待审核</button><button class="filter-tab {{tab === 'approved' ? 'is-active' : ''}}" data-v="approved" bindtap="tab">已通过</button><button class="filter-tab {{tab === 'checked_in' ? 'is-active' : ''}}" data-v="checked_in" bindtap="tab">已签到</button><button class="filter-tab {{tab === 'rejected' ? 'is-active' : ''}}" data-v="rejected" bindtap="tab">已驳回</button><button class="filter-tab {{tab === 'all' ? 'is-active' : ''}}" data-v="all" bindtap="tab">全部</button>
  </view>
  <view class="result-count" wx:if="{{!loading && !error}}">共 {{items.length}} 人</view>
  <view class="skeleton" wx:if="{{loading}}"><view></view><view></view><view></view></view>
  <view wx:elif="{{!items.length && !error}}" class="state-card"><view class="title">当前筛选暂无报名</view><view class="muted">新的报名提交后会出现在这里。</view></view>
  <view class="state-card" wx:if="{{error}}" role="alert"><view class="title">加载失败</view><view class="muted">{{error}}</view><button class="btn" bindtap="load">重新加载</button></view>
  <button class="review-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open" hover-class="review-card--pressed">
    <view class="review-avatar" aria-label="{{item.profile.nickname || '骑手'}}头像">
      <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="avatarError" />
      <text wx:else>{{item.avatarInitial}}</text>
    </view>
    <view class="review-main">
      <view class="applicant-row"><view class="applicant-name">{{item.profile.nickname || '未设置昵称'}}</view><view class="status-tag status-{{item.status}}">{{item.statusText}}</view></view>
      <view class="muted">{{item.activity.title}}</view>
      <view class="data-line"><text wx:if="{{item.gatheringMode}}">{{item.gatheringMode}}</text><text>{{item.experience}}</text></view>
      <view class="submitted-at" wx:if="{{item.submittedAt}}">提交于 {{item.submittedAt}}</view>
    </view>
    <text class="open-arrow">›</text>
  </button>
</view>
