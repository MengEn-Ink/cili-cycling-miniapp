<view class="page"><view class="hero"><view>REVIEW DESK</view><view class="hero-title">报名审批</view></view><view class="card danger" wx:if="{{error}}">{{error}}</view><picker wx:if="{{activities.length}}" mode="selector" range="{{activities}}" range-key="title" value="0" bindchange="choose"><view class="card">活动：{{items[0].activity.title || activities[0].title}}</view></picker><view class="card row"><text data-v="pending" bindtap="tab">待审核</text><text data-v="approved" bindtap="tab">已通过</text><text data-v="rejected" bindtap="tab">已驳回</text><text data-v="all" bindtap="tab">全部</text></view><view wx:if="{{!items.length && !error}}" class="empty">当前筛选暂无报名</view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="row"><view><view class="title">{{item.profile.nickname}}</view><view>{{item.activity.title}}</view></view><text class="tag">{{item.status}}</text></view><view class="muted">{{item.experience}} · {{item.bikeMode}} · {{item.strava.status}}</view></view></view>
