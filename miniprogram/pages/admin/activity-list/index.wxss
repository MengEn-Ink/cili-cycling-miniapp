page {
  background: var(--color-bg);
}
.page {
  background: var(--color-bg);
  color: var(--color-text);
}

.card {
  border: 1rpx solid #2b2b2e;
  background: #1b1b1d;
}
.card.danger {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}

.hero {
  color: #a8a8ad;
}
.hero view {
  color: #a8a8ad;
}
.hero view:first-child {
  color: var(--color-brand);
  font-size: 22rpx;
}
.hero .hero-title {
  color: #f7f7f5;
  font-size: 46rpx;
  font-weight: 900;
}
.hero view:last-child {
  font-size: 26rpx;
}

.activity-row {
  display: grid;
  gap: 20rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.title {
  color: #f7f7f5;
}
.tag {
  border: 1rpx solid #4a4a4e;
  background: transparent;
  color: #a8a8ad;
}

.template-button {
  margin: 0;
}
.section-title {
  color: #f7f7f5;
}
.hint {
  color: #8a8a8e;
}

.clone-panel {
  display: grid;
  gap: 24rpx;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.field text {
  color: #f7f7f5;
  font-weight: 700;
}
.field input {
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #3b3b3f;
  border-radius: 8rpx;
  background: #0d1012;
  color: #f7f7f5;
}
.clone-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* ===== CILI 统一明亮 UI：活动管理页面 ===== */
.activity-list-page {
  min-height: 100vh;
  background: #0b0b0c;
  color: #f7f7f5;
}
.activity-list-page .card {
  border: 1rpx solid #343438;
  background: #242427;
  color: #f7f7f5;
}
.activity-list-page .card.danger {
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}
.activity-list-page .title {
  color: var(--color-text);
}
.activity-list-page .tag {
  background: #343438;
  color: var(--color-brand);
}
.activity-list-page .section-title {
  color: #f7f7f5;
}
.activity-list-page .hint {
  color: #a8a8ad;
}
/* 克隆表单使用裸 input，这里统一为暗色控件，避免出现系统默认白底输入框 */
.activity-list-page .field input {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  border: 1rpx solid #343438;
  border-radius: 10rpx;
  background: #151517;
  color: #f7f7f5;
}
.activity-list-page .btn {
  border: 0;
  background: var(--color-action);
  color: var(--color-on-action);
  font-weight: 900;
}
.activity-list-page .secondary {
  border: 2rpx solid #3a3a3e;
  background: #151517;
  color: #f7f7f5;
}

.activity-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.activity-actions button {
  margin: 0;
}

.status-button {
  min-width: 144rpx;
}

.load-more {
  width: 100%;
}

.activity-list-page .danger-action {
  border-color: var(--color-danger);
  color: var(--color-danger-text);
}

page,
.page,
.activity-list-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.activity-list-page .card {
  border-color: var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
}
.hero,
.hero view,
.activity-list-page .hint,
.activity-list-page .tag {
  color: var(--color-muted);
}
.hero .hero-title,
.title,
.section-title,
.field text {
  color: var(--color-text);
}
.activity-list-page .tag {
  border-color: var(--color-border);
  background: var(--color-raised);
}
.activity-list-page .field input {
  border-color: var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-input-bg);
  color: var(--color-text);
}
.activity-actions button,
.activity-list-page .btn,
.activity-list-page .secondary {
  min-height: 88rpx;
  border-radius: var(--radius-md);
}
.activity-list-page .btn {
  background: var(--color-action);
  color: var(--color-on-action);
}
.activity-list-page .secondary {
  border-color: var(--color-border);
  background: var(--color-input-bg);
  color: var(--color-text);
}

@media (max-width: 340px) {
  .clone-actions {
    grid-template-columns: 1fr;
    gap: 12rpx;
  }
}

.status-filters {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.activity-list-page .status-filter {
  min-height: 72rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-input-bg);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 72rpx;
}

.activity-list-page .status-filter.active {
  border-color: var(--color-brand);
  background: var(--color-action);
  color: var(--color-on-action);
  font-weight: 800;
}
