.activity-list-page {
  background: var(--color-bg);
}
.status-filters {
  grid-template-columns: repeat(4, 1fr);
  margin-top: 32rpx;
}
.list-count,
.admin-card-head,
.low-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.list-count {
  margin-top: 32rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.list-count text:last-child {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.activity-row .title {
  margin-top: 16rpx;
}
.management-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  margin-top: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-border);
  gap: 2rpx;
}
.management-metrics > view {
  min-width: 0;
  padding: 16rpx 8rpx;
  background: var(--color-surface);
  text-align: center;
}
.management-metrics text:first-child {
  display: block;
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.management-metrics text:last-child {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.activity-actions,
.page-actions,
.clone-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}
.low-actions {
  margin-top: 8rpx;
}
.load-more {
  width: 100%;
  margin-top: 32rpx;
}
.state-card .btn {
  margin-top: 24rpx;
}
.skeleton {
  padding: 32rpx;
}
.skeleton view {
  height: 28rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
}
.modal-mask {
  position: fixed;
  z-index: 200;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: var(--color-overlay);
}
.modal-sheet {
  width: 100%;
  padding: 48rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--color-surface);
}
@media (max-width: 340px) {
  .status-filters {
    grid-template-columns: 1fr 1fr;
  }
  .status-filter:nth-child(2) {
    border-right: 0;
  }
  .activity-actions,
  .page-actions,
  .clone-actions {
    grid-template-columns: 1fr;
  }
}

.swipe-delete {
  position: relative;
  overflow: hidden;
  margin-top: var(--card-gap);
  border-radius: var(--radius-card);
}
.swipe-delete-active {
  z-index: 2;
}
.swipe-delete .activity-row {
  position: relative;
  z-index: 1;
  margin-top: 0;
}
.swipe-delete .activity-row.is-animating {
  transition: transform 180ms ease-out;
}
.delete-button {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  min-height: 100%;
  border-color: var(--color-brand);
  border-radius: 0 var(--radius-card) var(--radius-card) 0;
  color: var(--color-brand-active);
}
