<view class="page"><view class="card danger" wx:if="{{error}}">{{error}}</view><block wx:if="{{allowed}}"><view class="hero"><view>CILI ACTIVITIES</view><view class="hero-title">我的活动</view><view>{{isAdmin ? '管理全部活动与发布状态' : '创建、编辑并发布你的活动草稿'}}</view></view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="row"><view class="title">{{item.title}}</view><text class="tag">{{item.status}}</text></view></view><button class="btn" bindtap="create">创建活动草稿</button><button wx:if="{{isAdmin}}" class="secondary" bindtap="reviews">报名审批</button></block></view>
