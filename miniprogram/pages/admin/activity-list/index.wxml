<view class="page"><view class="card danger" wx:if="{{error}}">{{error}}</view><block wx:if="{{allowed}}"><view class="hero"><view>ADMIN</view><view class="hero-title">活动管理</view><view>当前后端仅支持读取；编辑不会伪成功</view></view><view class="card" wx:for="{{items}}" wx:key="id" bindtap="edit"><view class="row"><view class="title">{{item.title}}</view><text class="tag">{{item.status}}</text></view></view><button class="secondary" bindtap="create">新建活动（暂未开放）</button><button class="btn" bindtap="reviews">报名审批</button></block></view>
