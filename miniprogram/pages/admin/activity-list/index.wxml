<view class="page activity-list-page">
  <view class="card danger" wx:if="{{error}}">{{error}}</view>
  <block wx:if="{{allowed}}">
    <view class="hero">
      <view class="hero-title">我的活动</view>
      <view class="hero-subtitle">{{isAdmin ? '管理全部活动与发布状态' : '创建、编辑并上下架你的活动'}}</view>
    </view>
    <view class="status-filters" role="tablist" aria-label="活动状态筛选">
      <button class="status-filter {{statusFilter === 'all' ? 'active' : ''}}" role="tab" aria-selected="{{statusFilter === 'all'}}" data-status="all" bindtap="selectStatusFilter">全部</button>
      <button class="status-filter {{statusFilter === 'draft' ? 'active' : ''}}" role="tab" aria-selected="{{statusFilter === 'draft'}}" data-status="draft" bindtap="selectStatusFilter">已下架</button>
      <button class="status-filter {{statusFilter === 'published' ? 'active' : ''}}" role="tab" aria-selected="{{statusFilter === 'published'}}" data-status="published" bindtap="selectStatusFilter">已上线</button>
      <button class="status-filter {{statusFilter === 'finished' ? 'active' : ''}}" role="tab" aria-selected="{{statusFilter === 'finished'}}" data-status="finished" bindtap="selectStatusFilter">已结束</button>
    </view>
    <view class="swipe-row" wx:for="{{items}}" wx:key="id">
      <view class="swipe-delete {{item.swipeOpen ? 'swipe-delete-active' : ''}}" data-id="{{item.id}}" catchtap="confirmDelete">删除</view>
      <view
        class="card activity-row swipe-content {{item.swipeAnim ? 'swipe-anim' : ''}}"
        style="transform: translateX({{item.swipeOffset}}px);"
        data-id="{{item.id}}"
        bindtap="edit"
        bindtouchstart="onRowTouchStart"
        bindtouchmove="onRowTouchMove"
        bindtouchend="onRowTouchEnd"
        bindtouchcancel="onRowTouchEnd"
      >
        <view class="row">
          <view class="title">{{item.title}}</view>
          <text class="tag">{{item.statusLabel}}</text>
        </view>
        <view class="activity-actions">
          <button
            wx:if="{{item.canToggleOnline}}"
            catchtap="toggleOnline"
            data-id="{{item.id}}"
            class="secondary status-button {{item.status === 'published' ? 'danger-action' : ''}}"
          >{{item.toggleLabel}}</button>
          <button wx:if="{{item.status === 'draft'}}" catchtap="confirmDelete" data-id="{{item.id}}" class="secondary delete-button">删除</button>
          <button wx:if="{{item.canClone}}" catchtap="startClone" data-id="{{item.id}}" class="secondary template-button">从此活动创建</button>
        </view>
      </view>
    </view>
    <view class="card clone-panel" wx:if="{{cloneSourceId}}">
      <view class="section-title">设置新活动时间</view>
      <view class="hint">复制前必须重新填写报名截止、开始和结束时间，格式示例：2026-10-01T09:00:00+08:00。</view>
      <view class="field"><text>报名截止时间</text><input value="{{cloneForm.deadline}}" placeholder-class="input-placeholder" placeholder="2026-10-01T09:00:00+08:00" data-name="deadline" bindinput="cloneField" disabled="{{cloning}}"/></view>
      <view class="field"><text>开始时间</text><input value="{{cloneForm.startAt}}" placeholder-class="input-placeholder" placeholder="2026-10-01T09:00:00+08:00" data-name="startAt" bindinput="cloneField" disabled="{{cloning}}"/></view>
      <view class="field"><text>结束时间</text><input value="{{cloneForm.endAt}}" placeholder-class="input-placeholder" placeholder="2026-10-01T12:00:00+08:00" data-name="endAt" bindinput="cloneField" disabled="{{cloning}}"/></view>
      <view class="clone-actions">
        <button class="secondary" bindtap="cancelClone" disabled="{{cloning}}">取消</button>
        <button class="btn" bindtap="confirmClone" loading="{{cloning}}" disabled="{{cloning}}">创建草稿</button>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="secondary load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
    <button class="btn" bindtap="create">创建活动草稿</button>
    <button wx:if="{{isAdmin}}" class="secondary" bindtap="reviews">报名审批</button>
  </block>
</view>
