<view class="page activity-list-page"><view class="card danger" wx:if="{{error}}">{{error}}</view><block wx:if="{{allowed}}"><view class="hero"><view>CILI ACTIVITIES</view><view class="hero-title">我的活动</view><view>{{isAdmin ? '管理全部活动与发布状态' : '创建、编辑并发布你的活动草稿'}}</view></view><view class="card activity-row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="row"><view class="title">{{item.title}}</view><text class="tag">{{item.status}}</text></view><button wx:if="{{item.canClone}}" catchtap="startClone" data-id="{{item.id}}" class="secondary template-button">从此活动创建</button></view><view class="card clone-panel" wx:if="{{cloneSourceId}}"><view class="section-title">设置新活动时间</view><view class="hint">复制前必须重新填写报名截止、开始和结束时间。</view><view class="field"><text>报名截止（ISO 时间）</text><input value="{{cloneForm.deadline}}" data-name="deadline" bindinput="cloneField" disabled="{{cloning}}"/></view><view class="field"><text>开始时间（ISO 时间）</text><input value="{{cloneForm.startAt}}" data-name="startAt" bindinput="cloneField" disabled="{{cloning}}"/></view><view class="field"><text>结束时间（ISO 时间）</text><input value="{{cloneForm.endAt}}" data-name="endAt" bindinput="cloneField" disabled="{{cloning}}"/></view><view class="clone-actions"><button class="secondary" bindtap="cancelClone" disabled="{{cloning}}">取消</button><button class="btn" bindtap="confirmClone" loading="{{cloning}}" disabled="{{cloning}}">创建草稿</button></view></view><button class="btn" bindtap="create">创建活动草稿</button><button wx:if="{{isAdmin}}" class="secondary" bindtap="reviews">报名审批</button></block></view>
