<view class="page"><view class="card danger" wx:if="{{error}}">{{error}}</view><block wx:if="{{allowed}}"><view class="hero"><view>ADMIN</view><view class="hero-title">活动管理</view><view>草稿、已发布和已结束活动均由独立管理云函数维护</view></view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="row"><view class="title">{{item.title}}</view><text class="tag">{{item.status}}</text></view></view><button class="secondary" bindtap="create">新建活动</button><button class="btn" bindtap="reviews">报名审批</button></block></view>
