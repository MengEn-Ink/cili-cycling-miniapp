.club-admin-page {
  background: var(--color-bg);
}
.club-admin-head {
  margin-top: 28rpx;
}
.club-admin-badge {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.page-sub {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}
.club-admin-skeleton {
  min-height: 200rpx;
}
.club-admin-skeleton--short {
  min-height: 128rpx;
}
.club-admin-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.club-admin-avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-raised);
}
.club-admin-avatar-img {
  width: 112rpx;
  height: 112rpx;
}
.club-admin-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 44rpx;
  font-weight: 900;
}
.club-admin-copy {
  flex: 1;
  min-width: 0;
}
.club-admin-name {
  overflow: hidden;
  color: var(--color-text);
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.club-admin-meta {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.club-admin-status {
  flex: none;
}
.club-admin-action {
  width: 100%;
  margin-top: var(--card-gap);
}
.club-admin-retry {
  width: 100%;
  margin-top: 24rpx;
}
.club-admin-bootstrap {
  padding-bottom: 40rpx;
}
.club-admin-bootstrap-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 56rpx;
  font-weight: 900;
}
.club-admin-bootstrap .muted {
  margin-top: 12rpx;
}
@media (max-width: 340px) {
  .club-admin-avatar,
  .club-admin-avatar-img,
  .club-admin-avatar-fallback {
    width: 96rpx;
    height: 96rpx;
  }
}
