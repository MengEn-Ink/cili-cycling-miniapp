<view class="page activity-form-page"><view class="card danger" wx:if="{{error}}">{{error}}</view><view class="card" wx:if="{{loading}}">正在加载...</view><view wx:if="{{allowed && !loading}}"><view class="form-head"><view class="hero-kicker">CILI · ACTIVITY BUILDER</view><view class="form-title">{{id ? '编辑活动' : '创建活动'}}</view><view class="muted">{{isAdmin ? '管理员可管理全部活动' : '你可以维护并发布自己的活动草稿'}} · {{status}}</view></view><view class="section-label">01 · 基本信息</view><view class="form-card"><view class="field"><text>活动标题</text><view class="hint">简洁描述本次骑行主题</view><input value="{{form.title}}" data-name="title" bindinput="field"/></view><view class="field"><text>活动说明</text><textarea value="{{form.description}}" data-name="description" bindinput="field"/></view></view><view class="section-label">02 · 名额与后援车</view><view class="form-card"><view class="field"><text>总容量</text><view class="hint">不得低于已占用 {{occupiedCount}} 人</view><input type="number" value="{{form.capacity}}" data-name="capacity" bindinput="field"/></view><view class="split"><view class="field"><text>后援车名额</text><input type="number" value="{{form.supportVehicleCapacity}}" data-name="supportVehicleCapacity" bindinput="field"/></view><view class="field"><text>自驾名额</text><input type="number" value="{{form.selfDriveCapacity}}" data-name="selfDriveCapacity" bindinput="field"/></view></view><view class="hint accent">两类名额之和必须等于总容量</view><view class="field"><text>师傅昵称</text><input value="{{form.driverNickname}}" data-name="driverNickname" bindinput="field"/></view><view class="split"><view class="field"><text>车牌号</text><input value="{{form.licensePlate}}" data-name="licensePlate" bindinput="field"/></view><view class="field"><text>联系电话</text><input type="number" value="{{form.contactPhone}}" data-name="contactPhone" bindinput="field"/></view></view></view><view class="section-label">03 · 时间与路线</view><view class="form-card"><view class="field"><text>报名截止（ISO 时间）</text><input value="{{form.deadline}}" data-name="deadline" bindinput="field"/></view><view class="field"><text>开始时间（ISO 时间）</text><input value="{{form.startAt}}" data-name="startAt" bindinput="field"/></view><view class="field"><text>结束时间（ISO 时间）</text><input value="{{form.endAt}}" data-name="endAt" bindinput="field"/></view><view class="split"><view class="field"><text>路线起点</text><input value="{{form.routeStart}}" data-name="routeStart" bindinput="field"/></view><view class="field"><text>路线终点</text><input value="{{form.routeEnd}}" data-name="routeEnd" bindinput="field"/></view></view><view class="split"><view class="field"><text>里程 km</text><input type="digit" value="{{form.distanceKm}}" data-name="distanceKm" bindinput="field"/></view><view class="field"><text>爬升 m</text><input type="digit" value="{{form.elevationM}}" data-name="elevationM" bindinput="field"/></view></view><view class="field"><text>路线难度</text><input value="{{form.level}}" data-name="level" bindinput="field"/></view></view><view class="section-label">04 · 补充说明</view><view class="form-card"><view class="field"><text>费用说明</text><input value="{{form.fee}}" data-name="fee" bindinput="field"/></view><view class="field"><text>注意事项</text><view class="hint">每行一项，方便骑手快速阅读</view><textarea value="{{form.notices}}" data-name="notices" bindinput="field"/></view><view class="field"><text>装备要求</text><textarea value="{{form.equipment}}" data-name="equipment" bindinput="field"/></view></view><view class="actions"><button class="secondary" loading="{{saving}}" disabled="{{saving}}" data-status="{{status}}" bindtap="save">保存修改</button><button wx:if="{{id && status === 'draft'}}" class="btn" loading="{{saving}}" disabled="{{saving}}" data-status="published" bindtap="save">发布活动</button><button wx:if="{{isAdmin && id && status === 'published'}}" class="danger-button" loading="{{saving}}" disabled="{{saving}}" data-status="finished" bindtap="save">结束活动</button></view></view></view>
