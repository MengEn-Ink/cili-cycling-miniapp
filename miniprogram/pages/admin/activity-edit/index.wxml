<view class="page"><view class="card danger" wx:if="{{error}}">{{error}}</view><view class="card" wx:if="{{loading}}">正在加载...</view><view wx:if="{{allowed && !loading}}"><view class="hero"><view class="hero-title">{{id ? '编辑活动' : '新建活动'}}</view><view>状态：{{status}} · 已占用 {{occupiedCount}}</view></view><view class="card form"><text>活动标题</text><input value="{{form.title}}" data-name="title" bindinput="field"/><text>活动说明</text><textarea value="{{form.description}}" data-name="description" bindinput="field"/><text>容量（不得低于已占用）</text><input type="number" value="{{form.capacity}}" data-name="capacity" bindinput="field"/><text>报名截止（ISO 时间）</text><input value="{{form.deadline}}" data-name="deadline" bindinput="field"/><text>开始时间（ISO 时间）</text><input value="{{form.startAt}}" data-name="startAt" bindinput="field"/><text>结束时间（ISO 时间）</text><input value="{{form.endAt}}" data-name="endAt" bindinput="field"/><text>路线起点 / 终点</text><input value="{{form.routeStart}}" data-name="routeStart" bindinput="field"/><input value="{{form.routeEnd}}" data-name="routeEnd" bindinput="field"/><text>里程 km / 爬升 m / 难度</text><input type="digit" value="{{form.distanceKm}}" data-name="distanceKm" bindinput="field"/><input type="digit" value="{{form.elevationM}}" data-name="elevationM" bindinput="field"/><input value="{{form.level}}" data-name="level" bindinput="field"/><text>费用说明</text><input value="{{form.fee}}" data-name="fee" bindinput="field"/><text>注意事项（每行一项）</text><textarea value="{{form.notices}}" data-name="notices" bindinput="field"/><text>装备要求（每行一项）</text><textarea value="{{form.equipment}}" data-name="equipment" bindinput="field"/></view><button loading="{{saving}}" disabled="{{saving}}" data-status="{{status}}" bindtap="save">保存</button><button wx:if="{{id && status === 'draft'}}" class="btn" loading="{{saving}}" data-status="published" bindtap="save">发布活动</button><button wx:if="{{id && status === 'published'}}" class="btn" loading="{{saving}}" data-status="finished" bindtap="save">结束活动</button><view wx:if="{{status === 'finished'}}" class="card">活动已结束，状态不可再变更。</view></view></view>
