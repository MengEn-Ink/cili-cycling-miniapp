<view class="page-shell activity-editor activity-form-page">
  <view wx:if="{{loading}}" class="state-card">正在加载活动…</view>
  <view wx:elif="{{!allowed}}" class="state-card state-card--error">{{error || '无权访问活动管理'}}</view>
  <block wx:else>
    <view class="editor-hero">
      <view class="editor-kicker">DAILY RIDE</view>
      <view class="editor-title">{{id ? '编辑日常活动' : '创建日常活动'}}</view>
      <view class="editor-summary">只填写集合时间、地点、封面和备注，几步即可发布。</view>
    </view>

    <view wx:if="{{error}}" class="card danger"><view class="error-summary">{{error}}</view></view>

    <view class="form-card card">
      <view class="section-title">集合信息</view>
      <view class="field" data-error-anchor="startAt">
        <view class="field-label">集合时间 <text class="required">必填</text></view>
        <view class="date-time-row">
          <picker mode="date" value="{{form.startAt.slice(0, 10)}}" bindchange="dateTimePicker" data-part="date">
            <view class="picker-value">{{form.startAt.slice(0, 10) || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{form.startAt.slice(11, 16)}}" bindchange="dateTimePicker" data-part="time">
            <view class="picker-value">{{form.startAt.slice(11, 16) || '选择时间'}}</view>
          </picker>
        </view>
        <view class="quick-row">
          <button class="quick-button" bindtap="quickDateTime" data-preset="tomorrow-morning">明早 07:00</button>
          <button class="quick-button" bindtap="quickDateTime" data-preset="next-saturday">下周六 08:00</button>
        </view>
        <view wx:if="{{formErrors.startAt}}" class="field-error field-error-copy">{{formErrors.startAt}}</view>
      </view>

      <view class="field" data-error-anchor="routeStart">
        <view class="field-label">集合地点 <text class="required">必填</text></view>
        <view class="location-row">
          <input class="input" value="{{form.routeStart}}" placeholder-class="input-placeholder" placeholder="填写地点或从地图选择" bindinput="field" data-name="routeStart" />
          <button class="map-button" loading="{{choosingLocation}}" bindtap="chooseRouteLocation">地图选点</button>
        </view>
        <view wx:if="{{formErrors.routeStart}}" class="field-error field-error-copy">{{formErrors.routeStart}}</view>
      </view>
    </view>

    <view class="form-card card">
      <view class="section-head">
        <view>
          <view class="section-title">封面照片</view>
          <view class="section-help">最多 3 张，第一张作为封面</view>
        </view>
        <view class="image-count">{{images.length}} / 3</view>
      </view>
      <view class="image-grid">
        <view wx:for="{{images}}" wx:key="*this" class="image-item">
          <image class="image-preview" src="{{item}}" mode="aspectFill" />
          <view wx:if="{{index === 0}}" class="cover-badge">封面</view>
          <view class="image-actions">
            <button wx:if="{{index > 0}}" class="image-action" bindtap="setCover" data-index="{{index}}">设为封面</button>
            <button class="image-action image-action--danger" bindtap="removeImage" data-index="{{index}}">删除</button>
          </view>
        </view>
        <button wx:if="{{images.length < 3}}" class="upload-tile" loading="{{uploading}}" bindtap="chooseImages">
          <text class="upload-plus">＋</text>
          <text>{{uploading ? '上传中' : '添加照片'}}</text>
        </button>
      </view>
    </view>

    <view class="form-card card">
      <view class="field" data-error-anchor="description">
        <view class="field-label">备注说明</view>
        <textarea class="textarea" value="{{form.description}}" maxlength="5000" placeholder-class="input-placeholder" placeholder="集合提醒、补给安排或其他需要说明的内容" bindinput="field" data-name="description" />
        <view class="char-count">{{form.description.length}} / 5000</view>
      </view>
      <view class="field" data-error-anchor="stravaRouteUrl">
        <view class="field-label">Strava 线路链接</view>
        <input class="input" value="{{form.stravaRouteUrl}}" placeholder-class="input-placeholder" placeholder="https://www.strava.com/routes/…" bindinput="field" data-name="stravaRouteUrl" />
        <view class="section-help">仅保存链接，不再同步里程、海拔或线路信息</view>
      </view>
    </view>

    <view class="action-bar actions">
      <button class="button button--secondary secondary" loading="{{saving}}" data-status="draft" bindtap="save">保存草稿</button>
      <button class="button button--primary" loading="{{saving}}" data-status="published" bindtap="save">{{status === 'published' ? '保存修改' : '发布活动'}}</button>
    </view>
  </block>
</view>
