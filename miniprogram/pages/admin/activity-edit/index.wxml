<view class="page activity-form-page">
  <view class="card danger" wx:if="{{error}}">{{error}}</view>
  <view class="card" wx:if="{{loading}}">正在加载...</view>
  <view wx:if="{{allowed && !loading}}">
    <view class="form-head">
      <view class="hero-kicker">CILI · ACTIVITY BUILDER</view>
      <view class="form-title">{{id ? '编辑活动' : '创建活动'}}</view>
      <view class="muted">{{isAdmin ? '管理员可管理全部活动' : '你可以维护并发布自己的活动草稿'}} · {{status}}</view>
    </view>
    <view class="template-banner" wx:if="{{fromTemplate}}">已复制内容，日期、交通名额和司机信息需重新确认</view>
    <view class="publish-checklist" wx:if="{{status === 'draft'}}">
      <view class="section-title">重新确认清单</view>
      <view class="hint">发布仅需标题、活动起止时间和路线起终点；名额、报名截止、费用和封面可后续补充，补全前活动可见但报名关闭。后援车名额大于 0 时仍须填写司机信息。当前状态：{{canPublish ? '可发布' : '待补全'}}</view>
    </view>

    <view class="section-label">01 · 基本信息</view>
    <view class="form-card">
      <view class="field">
        <text>活动标题</text>
        <view class="hint">简洁描述本次骑行主题</view>
        <input value="{{form.title}}" data-name="title" bindinput="field" />
      </view>
      <view class="field">
        <view class="field-heading"><text>活动说明</text><text class="counter">{{form.description.length}}/5000</text></view>
        <textarea maxlength="5000" value="{{form.description}}" data-name="description" bindinput="field" />
      </view>
      <view class="field">
        <view class="field-heading"><text>活动图片</text><text class="counter">{{images.length}}/9</text></view>
        <view class="hint">第一张为封面；图片上传后自动维护封面文件 ID（选填）</view>
        <view class="media-grid" wx:if="{{images.length}}">
          <view class="media-item" wx:for="{{images}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" />
            <view class="cover-badge" wx:if="{{index === 0}}">封面</view>
            <view class="media-actions">
              <button wx:if="{{index > 0}}" size="mini" data-index="{{index}}" bindtap="setCover">设为封面</button>
              <button size="mini" data-index="{{index}}" bindtap="removeImage">删除</button>
            </view>
          </view>
        </view>
        <button class="media-add" loading="{{uploading}}" disabled="{{uploading || saving || images.length >= 9}}" bindtap="chooseImages">{{uploading ? '正在上传' : '选择图片'}}</button>
      </view>
    </view>

    <view class="section-label">02 · 名额与后援车</view>
    <view class="form-card">
      <view class="field"><text>总容量</text><view class="hint">不得低于已占用 {{occupiedCount}} 人</view><input type="number" value="{{form.capacity}}" data-name="capacity" bindinput="field" /></view>
      <view class="split"><view class="field"><text>后援车名额</text><input type="number" value="{{form.supportVehicleCapacity}}" data-name="supportVehicleCapacity" bindinput="field" /></view><view class="field"><text>自驾名额</text><input type="number" value="{{form.selfDriveCapacity}}" data-name="selfDriveCapacity" bindinput="field" /></view></view>
      <view class="hint accent">两类名额之和必须等于总容量</view>
      <view class="field"><text>师傅昵称</text><input value="{{form.driverNickname}}" data-name="driverNickname" bindinput="field" /></view>
      <view class="split"><view class="field"><text>车牌号</text><input value="{{form.licensePlate}}" data-name="licensePlate" bindinput="field" /></view><view class="field"><text>联系电话</text><input type="number" value="{{form.contactPhone}}" data-name="contactPhone" bindinput="field" /></view></view>
    </view>

    <view class="section-label">03 · 时间与路线</view>
    <view class="form-card">
      <view class="field"><text>报名截止日期时间</text><input maxlength="19" placeholder="yyyy-MM-dd HH:mm:ss" value="{{form.deadline}}" data-name="deadline" bindinput="field" /></view>
      <view class="field"><text>开始日期时间</text><input maxlength="19" placeholder="yyyy-MM-dd HH:mm:ss" value="{{form.startAt}}" data-name="startAt" bindinput="field" /></view>
      <view class="field"><text>结束日期时间</text><input maxlength="19" placeholder="yyyy-MM-dd HH:mm:ss" value="{{form.endAt}}" data-name="endAt" bindinput="field" /></view>
      <view class="split">
        <view class="field location-field"><text>路线起点</text><input value="{{form.routeStart}}" data-name="routeStart" bindinput="field" /><view class="location-address" wx:if="{{routeStartLocation}}">{{routeStartLocation.address}}</view><button class="location-button" data-target="start" bindtap="chooseRouteLocation">选择起点</button></view>
        <view class="field location-field"><text>路线终点</text><input value="{{form.routeEnd}}" data-name="routeEnd" bindinput="field" /><view class="location-address" wx:if="{{routeEndLocation}}">{{routeEndLocation.address}}</view><button class="location-button" data-target="end" bindtap="chooseRouteLocation">选择终点</button></view>
      </view>
      <view class="split"><view class="field"><text>里程 km</text><input type="digit" value="{{form.distanceKm}}" data-name="distanceKm" bindinput="field" /></view><view class="field"><text>爬升 m</text><input type="digit" value="{{form.elevationM}}" data-name="elevationM" bindinput="field" /></view></view>
      <view class="field"><text>路线难度</text><input value="{{form.level}}" data-name="level" bindinput="field" /></view>
      <view class="field"><text>路线文件 ID（选填）</text><input value="{{routeGpxFileId}}" data-name="routeGpxFileId" bindinput="assetField" /></view>
    </view>

    <view class="section-label">04 · 补充说明</view>
    <view class="form-card">
      <view class="field"><text>费用说明</text><input value="{{form.fee}}" data-name="fee" bindinput="field" /></view>
      <view class="field"><text>注意事项</text><view class="hint">每行一项，方便骑手快速阅读</view><textarea value="{{form.notices}}" data-name="notices" bindinput="field" /></view>
      <view class="field"><text>装备要求</text><textarea value="{{form.equipment}}" data-name="equipment" bindinput="field" /></view>
    </view>
    <view class="actions">
      <button class="secondary" loading="{{saving}}" disabled="{{saving || uploading}}" data-status="{{status}}" bindtap="save">保存修改</button>
      <button wx:if="{{id && status === 'draft' && !uploading}}" class="btn" loading="{{saving}}" data-status="published" disabled="{{saving || !canPublish}}" bindtap="save">发布活动</button>
      <button wx:if="{{isAdmin && id && status === 'published'}}" class="danger-button" loading="{{saving}}" disabled="{{saving || uploading}}" data-status="finished" bindtap="save">结束活动</button>
    </view>
  </view>
</view>
