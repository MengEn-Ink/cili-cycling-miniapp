<mock-banner/><view class="page" wx:if="{{a}}"><view class="card"><view class="title">基础信息</view><view class="field"><view class="label">活动标题</view><input class="input" value="{{a.title}}" data-k="title" bindinput="set"/></view><view class="field"><view class="label">活动说明</view><textarea class="textarea" value="{{a.description}}" data-k="description" bindinput="set"/></view><view class="field"><view class="label">名额</view><input class="input" type="number" value="{{a.capacity}}" data-k="capacity" bindinput="set"/></view></view><view class="card"><view class="title">发布状态</view><radio-group data-k="status" bindchange="set"><label><radio value="draft" checked="{{a.status==='draft'}}"/>草稿</label>　<label><radio value="published" checked="{{a.status==='published'}}"/>发布</label>　<label><radio value="finished" checked="{{a.status==='finished'}}"/>结束</label></radio-group></view></view><view class="fixed"><button class="btn" bindtap="save">保存活动</button></view>