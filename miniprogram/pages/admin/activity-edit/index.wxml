<view class="page-shell activity-editor activity-form-page">
  <view wx:if="{{loading}}" class="state-card">正在加载活动…</view>
  <view wx:elif="{{!allowed}}" class="state-card state-card--error">
    <view>{{error || '无权访问活动管理'}}</view>
    <button wx:if="{{error}}" class="button button--secondary" bindtap="retryLoad">重试</button>
  </view>
  <block wx:else>
    <view class="editor-hero">
      <view class="editor-title">{{id ? '编辑活动' : '创建活动'}}</view>
      <view class="editor-summary">填写活动信息，保存草稿后可继续完善。</view>
    </view>

    <view wx:if="{{error}}" class="card danger"><view class="error-summary">{{error}}</view></view>

    <view class="form-card card">
      <view class="card-head"><text class="card-no">01</text><view class="card-title">基本信息</view></view>
      <view class="field" data-error-anchor="title">
        <view class="field-label">活动标题 <text class="required">必填</text></view>
        <input class="input" value="{{form.title}}" maxlength="100" placeholder-class="input-placeholder" placeholder="请输入活动标题" bindinput="field" data-name="title" />
        <view wx:if="{{formErrors.title}}" class="form-error">{{formErrors.title}}</view>
      </view>
      <view class="field club-picker-field">
        <view class="field-label">活动归属</view>
        <picker range="{{clubOptions}}" range-key="name" value="{{clubOptionIndex}}" bindchange="clubOptionChange">
          <view class="picker-value club-picker-value">{{clubOptions[clubOptionIndex].name || '此里公开活动'}}</view>
        </picker>
        <view wx:if="{{clubOptions[clubOptionIndex].isReadOnly}}" class="section-help">当前活动归属已不在你的有效俱乐部列表中；将保留原归属，保存时由服务端校验权限。</view>
        <view wx:elif="{{clubOptionsLoadFailed}}" class="section-help">俱乐部列表暂时不可用，仍可继续编辑公开活动。</view>
        <view wx:else class="section-help">可选择此里公开活动，或你当前有效加入的俱乐部。</view>
      </view>
      <view class="section-title">集合信息</view>
      <view class="field" data-error-anchor="startAt">
        <view class="field-label">集合时间 <text class="required">必填</text></view>
        <view class="date-time-row">
          <picker mode="date" value="{{form.startDate}}" bindchange="dateTimePicker" data-part="date">
            <view class="picker-value">{{form.startDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{form.startTime}}" bindchange="dateTimePicker" data-part="time">
            <view class="picker-value">{{form.startTime || '选择时间'}}</view>
          </picker>
        </view>
        <view wx:if="{{formErrors.startAt}}" class="field-error field-error-copy">{{formErrors.startAt}}</view>
      </view>

      <view class="field" data-error-anchor="routeStart">
        <view class="field-label">集合地点 <text class="required">必填</text></view>
        <view class="location-row">
          <input class="input" value="{{form.routeStart}}" placeholder-class="input-placeholder" placeholder="填写地点或从地图选择" bindinput="field" data-name="routeStart" />
          <button class="map-button map-button--secondary" loading="{{choosingLocation}}" bindtap="chooseRouteLocation">地图选点</button>
        </view>
        <view wx:if="{{formErrors.routeStart}}" class="field-error field-error-copy">{{formErrors.routeStart}}</view>
      </view>
    </view>

    <view class="form-card card">
      <view class="card-head"><text class="card-no">02</text><view class="card-title">活动封面</view></view>
      <view class="section-head">
        <view>
          <view class="section-title">封面照片</view>
          <view class="section-help">最多 3 张，第一张作为封面</view>
        </view>
        <view class="image-count">{{images.length + pendingImages.length}} / 3</view>
      </view>
      <view class="image-grid">
        <view wx:for="{{images}}" wx:key="*this" class="image-item">
          <image wx:if="{{imagePreviewUrls[index]}}" class="image-preview" src="{{imagePreviewUrls[index]}}" mode="aspectFill" data-file-id="{{item}}" bindload="storedMediaPreviewLoad" binderror="storedMediaPreviewError" />
          <button wx:else class="stored-media-placeholder" data-file-id="{{item}}" bindtap="retryStoredMediaPreview">{{mediaPreviewLoading ? '图片加载中…' : '图片加载失败，点击重试'}}</button>
          <view wx:if="{{index === 0}}" class="cover-badge">封面</view>
          <view class="image-actions">
            <button wx:if="{{index > 0}}" class="image-action" bindtap="setCover" data-index="{{index}}">设为封面</button>
            <button class="image-action image-action--danger" bindtap="removeImage" data-index="{{index}}">删除</button>
          </view>
        </view>
        <view wx:for="{{pendingImages}}" wx:for-item="pendingImage" wx:key="id" class="image-item image-item--pending">
          <image class="image-preview" src="{{pendingImage.previewPath}}" mode="aspectFill" />
          <view class="upload-status upload-status--{{pendingImage.status}}">{{pendingImage.status === 'uploading' ? '上传中…' : pendingImage.status === 'uploaded' ? '已上传' : '上传失败'}}</view>
          <view wx:if="{{pendingImage.status === 'failed'}}" class="image-actions">
            <button class="image-action" bindtap="retryImage" data-id="{{pendingImage.id}}">重试</button>
            <button class="image-action image-action--danger" bindtap="removePendingImage" data-id="{{pendingImage.id}}">删除</button>
          </view>
        </view>
        <button wx:if="{{images.length + pendingImages.length < 3}}" class="upload-tile" loading="{{uploading}}" bindtap="chooseImages">
          <text class="upload-plus">＋</text>
          <text>{{uploading ? '上传中' : '添加照片'}}</text>
        </button>
      </view>
    </view>

    <view class="form-card card">
      <view class="card-head"><text class="card-no">03</text><view class="card-title">备注、路线与群二维码</view></view>
      <view class="field" data-error-anchor="description">
        <view class="field-label">备注说明</view>
        <textarea class="textarea" value="{{form.description}}" maxlength="5000" placeholder-class="input-placeholder" placeholder="集合提醒、补给安排或其他需要说明的内容" bindinput="field" data-name="description" />
        <view class="char-count">{{form.description.length}} / 5000</view>
      </view>
      <view class="section-title">活动路线</view>
      <view class="field" data-error-anchor="stravaRouteUrl">
        <view class="field-label">Strava 官方路线（可选）</view>
        <input class="input" value="{{form.stravaRouteUrl}}" maxlength="256" placeholder-class="input-placeholder" placeholder="粘贴公开路线链接" bindinput="field" data-name="stravaRouteUrl" />
        <view class="route-command-row">
          <button class="map-button map-button--secondary" loading="{{syncingRoute}}" disabled="{{saving || syncingRoute || !form.stravaRouteUrl}}" bindtap="addOfficialRoute">{{syncingRoute ? '正在解析' : '添加并解析路线'}}</button>
        </view>
        <view class="section-help">无需 Strava 授权；解析公开路线后会保存可信的路线详情。</view>
        <view wx:if="{{publicRoutePreview && !routePreview}}" class="route-preview-card">
          <view class="route-preview-heading">
            <view><view class="route-preview-name">{{publicRoutePreview.routeName}}</view><view class="section-help">此里估算 {{routeTimeLabel}}</view></view>
            <view class="route-ready-mark">公开路线已解析</view>
          </view>
          <view class="route-metric-grid">
            <view><text>{{publicRoutePreview.distanceKm}}</text><text>km 里程</text></view>
            <view><text>{{publicRoutePreview.elevationM}}</text><text>m 爬升</text></view>
            <view><text>{{publicRoutePreview.elevationLossM}}</text><text>m 下降</text></view>
            <view><text>{{publicRoutePreview.elevationMinM}}–{{publicRoutePreview.elevationMaxM}}</text><text>m 海拔</text></view>
          </view>
          <canvas id="route-outline-canvas" type="2d" class="route-outline-canvas" aria-label="{{publicRoutePreview.routeName}}路线轮廓"></canvas>
          <canvas id="route-elevation-canvas" type="2d" class="route-elevation-canvas" aria-label="{{publicRoutePreview.routeName}}海拔曲线"></canvas>
        </view>
      </view>

      <view class="field route-detail-field">
        <view class="field-label">GPX 路线详情（推荐）</view>
        <view class="section-help">上传后可展示里程、爬升、海拔曲线和路线图，参与者也可下载原文件。</view>
        <button wx:if="{{!routePreview}}" class="upload-tile upload-tile--wide route-upload-button" loading="{{uploadingRoute}}" disabled="{{saving || uploadingRoute}}" bindtap="chooseRouteGpx">{{uploadingRoute ? '正在读取路线' : '上传 GPX'}}</button>
        <view wx:if="{{routeStatusMessage}}" class="route-status">{{routeStatusMessage}}</view>
        <view wx:if="{{pendingRouteUpload && !uploadingRoute}}" class="route-command-row">
          <button class="map-button" bindtap="retryRouteGpx">重试读取</button>
          <button class="map-button map-button--secondary" bindtap="removeRouteDetails">移除路线详情</button>
        </view>
        <view wx:if="{{routePreview}}" class="route-preview-card">
          <view class="route-preview-heading">
            <view><view class="route-preview-name">{{routePreview.routeName}}</view><view class="section-help">此里估算 {{routeTimeLabel}}</view></view>
            <view class="route-ready-mark">路线详情已准备好</view>
          </view>
          <view class="route-metric-grid">
            <view><text>{{routePreview.distanceKm}}</text><text>km 里程</text></view>
            <view><text>{{routePreview.elevationM}}</text><text>m 爬升</text></view>
            <view><text>{{routePreview.elevationLossM}}</text><text>m 下降</text></view>
            <view><text>{{routePreview.elevationMinM}}–{{routePreview.elevationMaxM}}</text><text>m 海拔</text></view>
          </view>
          <canvas id="route-outline-canvas" type="2d" class="route-outline-canvas" aria-label="{{routePreview.routeName}}路线轮廓"></canvas>
          <canvas id="route-elevation-canvas" type="2d" class="route-elevation-canvas" aria-label="{{routePreview.routeName}}海拔曲线"></canvas>
          <view class="route-command-row">
            <button class="map-button" loading="{{uploadingRoute}}" disabled="{{saving || uploadingRoute}}" bindtap="chooseRouteGpx">更换 GPX</button>
            <button class="map-button map-button--secondary" disabled="{{saving || uploadingRoute}}" bindtap="removeRouteDetails">移除路线详情</button>
            <button wx:if="{{routePreview.generatedPreviewFileId}}" class="map-button map-button--secondary" bindtap="useRouteAsCover">{{routeCoverSelected ? '已设为活动背景' : '设为活动背景'}}</button>
          </view>
        </view>
      </view>
      <view class="field group-qr-field">
        <view class="field-label">活动群二维码</view>
        <view class="section-help">可选上传 1 张微信群二维码，便于已报名成员进群；上传超过 7 天会提示可能过期。</view>
        <view wx:if="{{groupQrCode}}" class="group-qr-card">
          <image wx:if="{{groupQrPreviewUrl}}" class="group-qr-preview" src="{{groupQrPreviewUrl}}" mode="aspectFit" data-file-id="{{groupQrCode}}" bindload="storedMediaPreviewLoad" binderror="storedMediaPreviewError" />
          <button wx:else class="stored-media-placeholder group-qr-preview" data-file-id="{{groupQrCode}}" bindtap="retryStoredMediaPreview">{{mediaPreviewLoading ? '二维码加载中…' : '二维码加载失败，点击重试'}}</button>
          <view wx:if="{{groupQrCodeExpired}}" class="group-qr-warning">二维码可能已过期，请替换为最新图片。</view>
          <button class="image-action image-action--danger" bindtap="removeGroupQrCode">删除二维码</button>
        </view>
        <view wx:elif="{{pendingGroupQrCode}}" class="group-qr-card group-qr-card--pending">
          <image class="group-qr-preview" src="{{pendingGroupQrCode.previewPath}}" mode="aspectFit" />
          <view class="upload-status upload-status--{{pendingGroupQrCode.status}}">{{pendingGroupQrCode.status === 'uploading' ? '上传中…' : '上传失败'}}</view>
          <button wx:if="{{pendingGroupQrCode.status === 'failed'}}" class="image-action" bindtap="chooseGroupQrCode">重新选择</button>
          <button wx:if="{{pendingGroupQrCode.status === 'failed'}}" class="image-action image-action--danger" bindtap="removeGroupQrCode">删除</button>
        </view>
        <button wx:else class="upload-tile upload-tile--wide" loading="{{uploading}}" bindtap="chooseGroupQrCode">上传活动群二维码</button>
      </view>
    </view>

    <view class="action-bar actions">
      <button class="button button--secondary secondary" loading="{{saving}}" data-status="draft" bindtap="save">保存草稿</button>
      <button class="button button--primary" loading="{{saving}}" data-status="published" bindtap="save">{{status === 'published' ? '保存修改' : (!isAdmin && clubOptions[clubOptionIndex].clubId && clubOptions[clubOptionIndex].role !== 'OWNER' && clubOptions[clubOptionIndex].role !== 'ADMIN' ? '提交俱乐部审核' : '发布活动')}}</button>
    </view>
  </block>
</view>
