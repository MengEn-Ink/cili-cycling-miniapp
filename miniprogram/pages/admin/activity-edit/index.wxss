.activity-form-page {
  min-height: 100vh;
  background: #090b0f;
  color: #f4f7f2;
}
.form-head {
  padding: 32rpx 8rpx 18rpx;
}
.hero-kicker,
.section-label {
  color: #d8ff36;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}
.form-title {
  margin: 10rpx 0;
  font-size: 46rpx;
  font-weight: 900;
}
.muted,
.hint {
  color: #89918b;
}
.section-label {
  margin: 30rpx 0 12rpx;
}
.form-card {
  padding: 28rpx;
  border: 1rpx solid #2b3130;
  border-radius: 10rpx;
  background: linear-gradient(145deg, #171b1d, #101315);
}
.field {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.field text {
  font-weight: 800;
}
.hint {
  font-size: 23rpx;
}
.accent {
  margin: -8rpx 0 24rpx;
  color: #d8ff36;
}
.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.field input,
.field textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #343b39;
  border-radius: 10rpx;
  background: #0d1012;
  color: #f4f7f2;
}
.field textarea {
  min-height: 150rpx;
}
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}
.actions button {
  margin: 0;
}
.activity-form-page .btn {
  background: #d8ff36;
  color: #090b0f;
  font-weight: 900;
}
.danger-button {
  border: 1rpx solid #ff5c61;
  background: transparent;
  color: #ff8589;
}
@media (max-width: 340px) {
  .split {
    grid-template-columns: 1fr;
  }
}
