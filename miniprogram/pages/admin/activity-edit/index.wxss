page {
  background: var(--color-bg);
  color: var(--color-text);
}

.page-shell.activity-editor {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0;
  padding-bottom: calc(var(--fixed-action-reserve) + var(--card-gap) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

.editor-hero.pageheading {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 40rpx var(--page-gutter) 36rpx;
}
.editor-hero .eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 24rpx;
  line-height: 36rpx;
  letter-spacing: 2rpx;
}
.editor-hero .eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.pageheading-title.editorial {
  display: flex;
  flex-direction: column;
  color: var(--color-text);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}
.pageheading-line {
  display: block;
}
.pageheading-sub {
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.content {
  padding: 0 var(--page-gutter);
}
.content.tight {
  padding: 0 var(--page-gutter) 120rpx;
}
.content form {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
}
.section.form-card.card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.section.form-card.card + .section.form-card.card {
  margin-top: 64rpx;
}
.chapterhead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--color-border);
}
.chapterhead-title {
  min-width: 0;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
}
.chapterhead-aside {
  flex: none;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.field,
.fieldset.registration-mode-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.field-label,
.fieldlegend {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.field-label .required,
.field-label .optional {
  margin-left: 10rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 600;
}
.field-label .required {
  color: var(--color-action);
}
.input,
.picker-value,
.textarea {
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 600;
}
.textarea {
  min-height: 200rpx;
}
.input-placeholder {
  color: var(--color-placeholder);
  font-weight: 400;
}
.field-meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.field-count {
  margin-left: auto;
  font-variant-numeric: tabular-nums;
}
.field-error {
  color: var(--color-action-active);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
}
.small,
.small.muted {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 38rpx;
}
.fieldgrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.choicegrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.choice {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  min-height: 124rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  text-align: left;
}
.choice.is-active {
  border-color: var(--color-action);
  background: var(--color-brand-soft);
}
.choice-title {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.choice-sub,
.choice.is-active .choice-sub,
.choice.is-active .choice-title {
  color: var(--color-text);
}
.detailrows {
  border-top: 2rpx solid var(--color-border);
}
.detailrow {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-border);
  font-size: 26rpx;
  line-height: 40rpx;
}
.detailrow .dt {
  color: var(--color-muted);
}
.detailrow .dd {
  color: var(--color-text);
  text-align: right;
}

.upload.cover-upload,
.upload-copy {
  display: flex;
  flex-direction: column;
}
.upload.cover-upload {
  gap: 20rpx;
}
.upload-copy {
  gap: 6rpx;
}
.upload-title {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 0;
}
.image-item,
.upload-tile {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-sm);
}
.image-item {
  border: 2rpx solid var(--color-border);
  background: var(--color-raised);
}
.image-preview,
.stored-media-placeholder {
  width: 100%;
  height: 100%;
}
.stored-media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  border: 0;
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.cover-badge,
.upload-status {
  position: absolute;
  top: 10rpx;
  z-index: 2;
  min-height: 44rpx;
  padding: 4rpx 12rpx;
  border: 0;
  border-radius: var(--radius-xs);
  background: var(--surface-media-action);
  color: var(--color-on-media);
  font-size: 22rpx;
  line-height: 36rpx;
}
.cover-badge {
  left: 10rpx;
}
.upload-status {
  right: 10rpx;
}
.upload-status--failed {
  background: var(--color-action-active);
}
.image-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 2rpx;
}
.image-action {
  flex: 1;
  min-height: 88rpx;
  padding: 8rpx;
  border: 0;
  border-radius: 0 !important;
  background: var(--surface-media-action) !important;
  color: var(--color-on-media) !important;
  font-size: 24rpx;
  line-height: 36rpx;
  text-decoration: none;
}
.image-action--danger {
  background: var(--surface-media-danger) !important;
}
.upload-tile,
.upload-tile--wide {
  border: 2rpx dashed var(--color-border-strong);
  background: var(--color-surface);
  color: var(--color-text);
}
.upload-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 24rpx;
}
.upload-plus {
  font-size: 44rpx;
  line-height: 48rpx;
}
.upload-tile--wide {
  width: 100%;
  min-height: var(--control-height);
}
.image-item--pending {
  border-color: var(--color-action);
}

.location-row,
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.location-row .input,
.input-row .input {
  flex: 1;
  min-width: 0;
}
.route-link-plus {
  flex: none;
  width: var(--control-height);
  padding: 0;
}
.paper.route-preview-card,
.group-qr-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  background: var(--color-border);
}
.metric {
  min-width: 0;
  padding: 16rpx 20rpx;
  background: var(--color-surface);
}
.metric .em {
  color: var(--color-text);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.metric .unit,
.metric .meta {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.metric .unit {
  margin-left: 6rpx;
  font-weight: 600;
}
.metric .meta {
  display: block;
}
.route-outline-canvas,
.route-elevation-canvas {
  width: 100%;
  height: 240rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.route-elevation-canvas {
  height: 160rpx;
}
.route-status {
  text-align: left;
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0 16rpx 20rpx;
  border: 0;
  border-left: 6rpx solid var(--color-border-strong);
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 38rpx;
}
.notice-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: currentColor;
}
.notice--warn {
  border-left-color: var(--color-action);
  color: var(--color-text);
}
.notice.tone-success {
  border-left-color: var(--color-status-success);
}
.route-source-conn {
  justify-content: space-between;
  flex-wrap: wrap;
}
.route-source-conn-copy {
  flex: 1;
}
.route-source-conn-link {
  flex: none;
  min-height: 72rpx;
  padding: 0 20rpx;
}

.route-boost-mask {
  position: fixed;
  z-index: 90;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--color-overlay);
}
.route-boost-sheet {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx var(--page-gutter) calc(48rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-display) var(--radius-display) 0 0;
  background: var(--color-surface);
}
.route-boost-handle {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: var(--color-border-strong);
}
.route-boost-title {
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
}

.group-qr-field {
  gap: 16rpx;
}
.group-qr-card {
  position: relative;
  align-items: center;
  padding: 32rpx;
  border-color: var(--color-border-strong);
  background: var(--color-raised);
}
.group-qr-media {
  box-sizing: border-box;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
}
.group-qr-preview {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.group-qr-warning {
  width: 100%;
  max-width: 480rpx;
}
.group-qr-card .image-action--danger {
  width: 100%;
  max-width: 360rpx;
  border-radius: var(--radius-sm) !important;
  background: var(--color-danger-soft) !important;
  color: var(--color-danger-text) !important;
  border: 2rpx solid var(--color-border-strong);
}

.action-bar.actions.buttonpair {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: 16rpx;
  padding: 16rpx var(--page-gutter) calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 24rpx var(--color-shadow);
}
.action-bar .disabled-hint {
  grid-column: 1 / -1;
  text-align: center;
}
.buttonpair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.btn,
.map-button--secondary {
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 2rpx solid var(--color-action);
  border-radius: var(--radius-sm) !important;
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
  letter-spacing: 0;
}
.btn.secondary,
.map-button--secondary {
  border-color: var(--color-border-strong);
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
.btn[disabled],
.map-button--secondary[disabled] {
  border-color: var(--color-border) !important;
  background: var(--color-raised) !important;
  color: var(--color-disabled-text) !important;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin: 80rpx var(--page-gutter);
  padding: 40rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-muted);
  text-align: center;
}
.empty-title {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
}
.empty-copy {
  font-size: 26rpx;
  line-height: 40rpx;
}

@media (max-width: 340px) {
  .pageheading-title.editorial {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .fieldgrid,
  .choicegrid,
  .image-grid,
  .buttonpair,
  .action-bar.actions.buttonpair {
    grid-template-columns: 1fr;
  }
  .location-row {
    align-items: stretch;
    flex-direction: column;
  }
  .map-button--secondary {
    width: 100%;
  }
  .group-qr-preview {
    width: 280rpx;
    height: 280rpx;
  }
}
