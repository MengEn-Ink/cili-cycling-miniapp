/* 骑行影像志 · 活动编辑（admin-activity-edit）
   视觉：米色纸感 + 宋体大标题 + 虚线分隔 + section 卡片。
   复用全局 token：--color-bg / --color-ink / --color-ink-muted / --color-paper / --color-rule / --color-accent。
   注意：发布/保存草稿按钮在底部，依赖 .buttonpair 双列。
*/

page {
  background: var(--color-bg, #f6f1e6);
  color: var(--color-ink, #1a1a1a);
  font-family: 'PingFang SC', 'Noto Sans SC', sans-serif;
}

.page-shell.activity-editor {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0;
  padding-bottom: calc(var(--fixed-action-reserve) + var(--card-gap) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

/* ---------- Page heading ---------- */
.editor-hero.pageheading {
  padding: 44rpx var(--page-gutter) 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.editor-hero .eyebrow {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-ink-muted, #5a5a52);
  text-transform: uppercase;
}
.pageheading-title.editorial {
  font-family: var(--font-family-editorial);
  font-weight: 600;
  font-size: 64rpx;
  line-height: 80rpx;
  color: var(--color-ink, #1a1a1a);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.pageheading-line {
  display: block;
}
.pageheading-sub {
  font-size: 26rpx;
  color: var(--color-ink-muted, #5a5a52);
}

/* ---------- Content container ---------- */
.content {
  padding: 0 var(--page-gutter);
}
.content.tight {
  padding: 0 var(--page-gutter) 120rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ---------- Section cards ---------- */
.section.form-card.card {
  background: var(--color-paper, #faf6ec);
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.18));
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.chapterhead {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.18));
}
.chapterhead-title {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--color-ink, #1a1a1a);
}
.chapterhead-aside {
  font-size: 22rpx;
  color: var(--color-ink-muted, #5a5a52);
  letter-spacing: 2rpx;
}

/* ---------- Fields ---------- */
.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.field-label {
  font-size: 26rpx;
  color: var(--color-ink, #1a1a1a);
  letter-spacing: 1rpx;
}
.field-label .required {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--color-accent, #c7362f);
}
.field-label .optional {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--color-ink-muted, #5a5a52);
}
.input,
.picker-value,
.textarea {
  width: 100%;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid var(--color-rule, rgba(26, 26, 26, 0.3));
  padding: 18rpx 4rpx;
  font-size: 30rpx;
  color: var(--color-ink, #1a1a1a);
  box-sizing: border-box;
}
.input-placeholder {
  color: var(--color-ink-muted, #9a9a90);
}
.textarea {
  min-height: 180rpx;
  line-height: 1.6;
}
.picker-value {
  display: block;
}
.field-meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.field-count {
  font-variant-numeric: tabular-nums;
}
.field-error {
  font-size: 24rpx;
  color: var(--color-accent, #c7362f);
}
.small.muted,
.small {
  font-size: 24rpx;
  color: var(--color-ink-muted, #5a5a52);
  line-height: 1.6;
}

/* ---------- Field grid (date + time) ---------- */
.fieldgrid,
.date-time-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.date-time-row {
  /* 兜底：窄屏下 fieldgrid 拆成单列堆叠，与上面并列共同生效，保证最窄情况下仍可读。 */
  grid-template-columns: 1fr;
}

/* ---------- Fieldset (registration mode) ---------- */
.fieldset.registration-mode-field {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.fieldlegend {
  font-size: 26rpx;
  color: var(--color-ink, #1a1a1a);
}
.choicegrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.choice {
  background: var(--color-bg, #f6f1e6);
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: flex-start;
  text-align: left;
  line-height: 1.4;
}
.choice.is-active {
  background: var(--color-ink, #1a1a1a);
  border-color: var(--color-ink, #1a1a1a);
}
.choice.is-active .choice-title,
.choice.is-active .choice-sub {
  color: var(--color-paper, #faf6ec);
}
.choice-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-ink, #1a1a1a);
}
.choice-sub {
  font-size: 22rpx;
  color: var(--color-ink-muted, #5a5a52);
}

/* ---------- Detail rows ---------- */
.detailrows {
  display: flex;
  flex-direction: column;
}
.detailrow {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.18));
  font-size: 26rpx;
}
.detailrow:first-child {
  border-top: 0;
}
.detailrow .dt {
  color: var(--color-ink-muted, #5a5a52);
}
.detailrow .dd {
  color: var(--color-ink, #1a1a1a);
}

/* ---------- Upload / image grid ---------- */
.upload.cover-upload {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.upload-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.upload-title {
  font-size: 28rpx;
  color: var(--color-ink, #1a1a1a);
}
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.image-item {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--color-bg, #f6f1e6);
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.18));
}
.image-preview {
  width: 100%;
  height: 100%;
  display: block;
}
.stored-media-placeholder {
  width: 100%;
  height: 100%;
  background: transparent;
  border: 0;
  font-size: 22rpx;
  color: var(--color-ink-muted, #5a5a52);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  line-height: 1.4;
}
.stored-media-placeholder::after {
  display: none;
}
.cover-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: var(--color-ink, #1a1a1a);
  color: var(--color-paper, #faf6ec);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  letter-spacing: 2rpx;
}
.image-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 2rpx;
}
.image-action {
  flex: 1;
  background: rgba(26, 26, 26, 0.78);
  color: var(--color-paper, #faf6ec);
  border: 0;
  font-size: 20rpx;
  padding: 10rpx 0;
  line-height: 1.4;
  min-height: 88rpx;
  border-radius: 0;
}
.image-action::after {
  display: none;
}
.image-action--danger {
  background: rgba(199, 54, 47, 0.9);
}
.group-qr-card .image-action--danger {
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
  min-height: 88rpx;
  border-radius: 999rpx;
}
.upload-tile {
  aspect-ratio: 1 / 1;
  border-radius: 20rpx;
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
  background: var(--color-bg, #f6f1e6);
  color: var(--color-ink-muted, #5a5a52);
  font-size: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  line-height: 1.4;
}
.upload-tile::after {
  display: none;
}
.upload-plus {
  font-size: 48rpx;
  color: var(--color-ink-muted, #5a5a52);
}
.upload-tile--wide {
  width: 100%;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--color-bg, #f6f1e6);
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
  color: var(--color-ink, #1a1a1a);
  font-size: 26rpx;
}
.image-item--pending {
  outline: 1rpx dashed var(--color-accent, #c7362f);
}
.upload-status {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(26, 26, 26, 0.78);
  color: var(--color-paper, #faf6ec);
}
.upload-status--failed {
  background: rgba(199, 54, 47, 0.9);
}

/* ---------- Location row ---------- */
.location-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}
.location-row .input {
  flex: 1;
}

/* ---------- Route card ---------- */
.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.input-row .input {
  flex: 1;
}
.route-link-plus {
  flex: 0 0 auto;
  width: 72rpx;
  padding: 0;
  font-size: 32rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
}
.route-link-plus::after {
  display: none;
}

.paper.route-preview-card {
  background: var(--color-paper, #faf6ec);
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx 32rpx;
}
.metric {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.metric .em {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 44rpx;
  color: var(--color-ink, #1a1a1a);
  font-weight: 500;
  line-height: 1;
}
.metric .unit {
  font-size: 22rpx;
  margin-left: 6rpx;
  color: var(--color-ink-muted, #5a5a52);
  font-family: inherit;
}
.metric .meta {
  font-size: 22rpx;
  color: var(--color-ink-muted, #5a5a52);
  letter-spacing: 2rpx;
}
.route-outline-canvas,
.route-elevation-canvas {
  width: 100%;
  height: 240rpx;
  background: var(--color-bg, #f6f1e6);
  border-radius: 16rpx;
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.18));
}
.route-elevation-canvas {
  height: 160rpx;
}
.route-status {
  text-align: left;
}

/* ---------- Notice ---------- */
.notice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: var(--color-paper, #faf6ec);
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
  font-size: 24rpx;
  color: var(--color-ink, #1a1a1a);
  line-height: 1.6;
}
.notice-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-ink, #1a1a1a);
  margin-top: 14rpx;
  flex: 0 0 auto;
}
.notice--warn {
  border-color: var(--color-accent, #c7362f);
  color: var(--color-accent, #c7362f);
}
.notice--warn .notice-dot {
  background: var(--color-accent, #c7362f);
}
.notice.tone-success {
  border-style: solid;
  border-color: var(--color-ink, #1a1a1a);
}
.route-source-conn {
  justify-content: space-between;
  flex-wrap: wrap;
}
.route-source-conn-copy {
  flex: 1;
}
.route-source-conn-link {
  flex: 0 0 auto;
  padding: 0 20rpx;
  min-height: 56rpx;
  line-height: 56rpx;
}

/* ---------- Route boost sheet ---------- */
.route-boost-mask {
  position: fixed;
  inset: 0;
  background: rgba(26, 26, 26, 0.5);
  z-index: 90;
}
.route-boost-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--color-paper, #faf6ec);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 24rpx 36rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.route-boost-handle {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(26, 26, 26, 0.2);
  margin: 0 auto;
}
.route-boost-title {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 36rpx;
  color: var(--color-ink, #1a1a1a);
}

/* ---------- Group QR ---------- */
.group-qr-field {
  gap: 18rpx;
}
.group-qr-card {
  position: relative;
  background: var(--color-paper, #faf6ec);
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: center;
}
.group-qr-preview {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
  background: var(--color-bg, #f6f1e6);
}
.group-qr-warning {
  width: 100%;
}
.group-qr-card--pending .group-qr-preview {
  opacity: 0.75;
}

/* ---------- Action bar ---------- */
.action-bar.actions.buttonpair {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: var(--color-bg, #f6f1e6);
  padding: 20rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  border-top: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
}
.action-bar .disabled-hint {
  grid-column: 1 / -1;
  text-align: center;
}

.buttonpair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* ---------- Buttons ---------- */
.btn {
  background: var(--color-ink, #1a1a1a);
  color: var(--color-paper, #faf6ec);
  border: 0;
  border-radius: 999rpx;
  padding: 22rpx 32rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  line-height: 1.2;
  text-align: center;
}
.btn::after {
  display: none;
}
.btn[disabled] {
  background: rgba(26, 26, 26, 0.3);
  color: var(--color-paper, #faf6ec);
}
.btn.secondary {
  background: var(--color-paper, #faf6ec);
  color: var(--color-ink, #1a1a1a);
  border: 1rpx solid var(--color-ink, #1a1a1a);
}
.btn.secondary[disabled] {
  color: rgba(26, 26, 26, 0.4);
  border-color: rgba(26, 26, 26, 0.3);
  background: var(--color-paper, #faf6ec);
}
.map-button--secondary {
  flex: 0 0 auto;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  background: var(--color-paper, #faf6ec);
  color: var(--color-ink, #1a1a1a);
  border: 1rpx solid var(--color-ink, #1a1a1a);
  border-radius: 999rpx;
  min-height: 72rpx;
}
.map-button--secondary::after {
  display: none;
}
.map-button--secondary[disabled] {
  color: rgba(26, 26, 26, 0.4);
  border-color: rgba(26, 26, 26, 0.3);
}

/* ---------- Empty ---------- */
.empty {
  margin: 120rpx 48rpx;
  padding: 56rpx 32rpx;
  border: 1rpx dashed var(--color-rule, rgba(26, 26, 26, 0.3));
  border-radius: 24rpx;
  text-align: center;
  color: var(--color-ink-muted, #5a5a52);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}
.empty-title {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 36rpx;
  color: var(--color-ink, #1a1a1a);
}
.empty-copy {
  font-size: 26rpx;
  line-height: 1.6;
}
