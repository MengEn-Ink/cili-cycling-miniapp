.activity-editor {
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.editor-summary {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.form-card {
  margin-top: var(--card-gap);
}
.card-head {
  justify-content: flex-start;
  margin-bottom: 24rpx;
}
.section-title {
  margin-top: 24rpx;
}
.section-help {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-muted);
}
.field-label .required {
  margin-left: auto;
}
.date-time-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.location-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
}
.map-button {
  align-self: stretch;
}
.image-count {
  margin-left: auto;
}
.image-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: flex-end;
  background: var(--color-overlay);
}
.image-action {
  min-height: 72rpx;
  padding: 0 12rpx;
  color: var(--color-on-media);
  font-size: 24rpx;
}
.cover-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
}
.char-count {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: right;
}
.route-command-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.route-command-row .map-button {
  flex: 1 1 200rpx;
}
.route-preview-card {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}
.route-preview-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.route-preview-name {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.route-metric-grid {
  margin-top: 24rpx;
}
.route-outline-canvas,
.route-elevation-canvas {
  position: relative;
  z-index: 0;
  width: 100%;
  height: 280rpx;
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
.route-status {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.group-qr-card {
  margin-top: 24rpx;
}
.group-qr-preview {
  width: 280rpx;
  height: 280rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
}
.action-bar {
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
}
.button--primary {
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
@media (max-width: 340px) {
  .date-time-row,
  .location-row {
    grid-template-columns: 1fr;
  }
  .action-bar {
    grid-template-columns: 1fr;
  }
}
