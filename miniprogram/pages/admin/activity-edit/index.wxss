.activity-editor {
  padding-bottom: calc(var(--fixed-action-reserve) + var(--card-gap) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.journal-heading {
  padding: 28rpx 0 56rpx;
}
.journal-eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.journal-eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.editor-title {
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}
.activity-editor .card {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}
.activity-editor .field .input,
.activity-editor .field .textarea,
.activity-editor .picker-value {
  border-width: 2rpx;
}
.activity-editor .required {
  border-width: 2rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
  color: var(--color-action-active);
}
.editor-summary {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 32rpx;
  line-height: 48rpx;
}
.form-card {
  margin-top: 64rpx;
  padding: 40rpx 32rpx;
}
.journal-heading + .form-card {
  margin-top: 0;
}
.card-head {
  justify-content: flex-start;
  margin-bottom: 24rpx;
}
.section-title {
  margin-top: 24rpx;
}
.section-help {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-muted);
}
.field-label .required {
  margin-left: auto;
}
.club-picker-field {
  margin-top: 24rpx;
}
.club-picker-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.date-time-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.registration-mode-field {
  margin-top: 24rpx;
}
.registration-mode-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.registration-mode-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 144rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  text-align: left;
}
.registration-mode-option.is-active {
  border-color: var(--color-action-active);
  background: var(--color-brand-soft);
}
.registration-mode-title {
  margin-bottom: 8rpx;
  font-weight: 900;
}
.location-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
}
.map-button {
  align-self: stretch;
}
.stored-media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 24rpx;
  border: 0;
  border-radius: 0;
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}
.image-count {
  margin-left: auto;
}
.image-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: flex-end;
  background: var(--color-overlay);
}
.image-action {
  min-height: 88rpx;
  padding: 0 12rpx;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
  font-size: 24rpx;
}
.cover-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
}
.char-count {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: right;
}
.route-command-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.route-command-row .map-button {
  flex: 1 1 200rpx;
}
.route-preview-card {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}
.route-preview-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.route-preview-name {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.route-metric-grid {
  margin-top: 24rpx;
}
.route-outline-canvas,
.route-elevation-canvas {
  position: relative;
  z-index: 0;
  width: 100%;
  height: var(--route-preview-canvas-height);
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
.route-state {
  margin-top: 8rpx;
  padding: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.route-state--ready {
  color: var(--color-action-active);
}
.route-state--warning {
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}
.route-status {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.group-qr-card {
  margin-top: 24rpx;
}
.group-qr-preview {
  width: var(--group-qr-code-size);
  height: var(--group-qr-code-size);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
.group-qr-card .image-action--danger {
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
  text-decoration: none;
}
.action-bar {
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
}
.action-bar .secondary {
  min-height: 88rpx;
}
.action-bar .button--primary {
  min-height: 96rpx;
}
.button--primary {
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
@media (max-width: 340px) {
  .date-time-row,
  .location-row {
    grid-template-columns: 1fr;
  }
  .action-bar {
    grid-template-columns: 1fr;
  }
}

.route-source-conn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 25rpx;
  line-height: 36rpx;
}
.route-source-conn-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--color-muted);
}
.route-source-conn.tone-success .route-source-conn-dot {
  background: var(--color-status-success);
}
.route-source-conn.tone-warning .route-source-conn-dot {
  background: var(--color-status-warning);
}
.route-source-conn-copy {
  flex: 1;
  min-width: 0;
}
.route-source-conn-link {
  flex: none;
  margin: 0;
  padding: 4rpx 16rpx;
  border: 0;
  background: transparent;
  color: var(--color-action-active);
  font-size: 25rpx;
  font-weight: 900;
}
.route-source-conn-link::after {
  display: none;
}
.route-link-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
}
.route-link-input {
  min-width: 0;
}
.route-link-plus {
  flex: none;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  padding: 0;
  border: 2rpx dashed var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 88rpx;
}
.route-link-plus::after {
  display: none;
}
.route-boost-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: var(--color-overlay);
}
.route-boost-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 11;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top-left-radius: var(--radius-display);
  border-top-right-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
}
.route-boost-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: var(--color-border);
}
.route-boost-title {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.route-boost-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 42rpx;
}
.route-boost-status {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  font-size: 25rpx;
  line-height: 36rpx;
}
.route-boost-status--warning {
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}
.route-boost-status--ready {
  background: var(--color-brand-soft);
  color: var(--color-action-active);
}
.route-boost-sheet .upload-tile {
  margin-top: 24rpx;
}
.route-boost-close {
  margin-top: 24rpx;
  width: 100%;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 900;
}
.route-boost-close::after {
  display: none;
}
@media (max-width: 340px) {
  .activity-editor {
    padding-bottom: calc(
      var(--fixed-action-reserve-narrow) + 2 * var(--line-height-body) + var(--card-gap) +
        env(safe-area-inset-bottom)
    );
  }
}
