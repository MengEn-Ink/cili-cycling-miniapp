.activity-editor {
  padding: 24rpx 24rpx 180rpx;
}

.activity-form-page {
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
}

.state-card,
.editor-hero,
.form-card {
  border: var(--border-width) solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-hard);
}

.state-card {
  padding: 48rpx 32rpx;
  color: var(--color-text);
  text-align: center;
}

.state-card--error,
.error-banner,
.field-error {
  color: var(--color-danger);
}

.editor-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
}

.editor-hero::after {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 12rpx;
  content: '';
  background: var(--color-brand);
}

.editor-kicker {
  margin-bottom: 8rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.editor-title {
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 900;
}

.editor-summary,
.section-help,
.char-count {
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.editor-summary {
  margin-top: 12rpx;
}

.error-banner {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: var(--border-width) solid var(--color-danger);
  background: var(--color-surface);
  font-size: 24rpx;
  font-weight: 700;
}

.form-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-width: 4rpx;
  border-radius: var(--radius-card);
}

.section-head,
.location-row,
.date-time-row,
.quick-row,
.action-bar {
  display: flex;
  align-items: center;
}

.section-head {
  justify-content: space-between;
}

.section-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 900;
}

.field {
  margin-top: 28rpx;
}

.field:first-child,
.section-head + .field {
  margin-top: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 800;
}

.required {
  margin-left: 8rpx;
  color: var(--color-danger);
  font-size: 20rpx;
}

.input,
.textarea,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  border: var(--border-width) solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 26rpx;
}

.input,
.picker-value {
  min-height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
}

.textarea {
  min-height: 220rpx;
  padding: 20rpx 22rpx;
  line-height: 1.6;
}

.date-time-row,
.quick-row,
.action-bar {
  gap: 16rpx;
}

.date-time-row picker {
  flex: 1;
}

.quick-row {
  margin-top: 14rpx;
}

.quick-button,
.map-button,
.image-action {
  margin: 0;
  border: var(--border-width) solid var(--color-border);
  border-radius: 0;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 800;
}

.quick-button {
  flex: 1;
}

.location-row {
  align-items: stretch;
  gap: 12rpx;
}

.location-row .input {
  flex: 1;
  width: auto;
}

.map-button {
  width: 180rpx;
}

.field-error,
.char-count,
.section-help {
  margin-top: 10rpx;
}

.char-count {
  text-align: right;
}

.image-count {
  padding: 6rpx 14rpx;
  border: var(--border-width) solid var(--color-border);
  background: var(--color-brand-soft);
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 900;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.image-item,
.upload-tile {
  position: relative;
  height: 210rpx;
  border: var(--border-width) solid var(--color-border);
  border-radius: 0;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.cover-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 10rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-brand);
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 900;
}

.image-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
}

.image-action {
  flex: 1;
  min-width: 0;
  padding: 8rpx 4rpx;
  border-width: 2rpx 0 0 2rpx;
  line-height: 1.4;
}

.image-action:first-child {
  border-left: 0;
}

.image-action--danger {
  color: var(--color-danger);
}

.upload-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 800;
}

.upload-plus {
  margin-bottom: 6rpx;
  font-size: 48rpx;
  line-height: 1;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: var(--border-width) solid var(--color-border);
  background: var(--color-surface);
}

.button {
  flex: 1;
  min-height: 92rpx;
  margin: 0;
  border: var(--border-width) solid var(--color-border);
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 88rpx;
}

.button--secondary {
  background: var(--color-surface);
  color: var(--color-text);
}

.button--primary {
  background: var(--color-action);
  color: var(--color-on-action);
  box-shadow: var(--shadow-hard);
}

.activity-form-page .card {
  background: var(--color-surface);
}

.activity-form-page .card.danger,
.error-summary {
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}

.activity-form-page .card.danger {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: var(--border-width) solid var(--color-danger-text);
}

.activity-form-page .secondary {
  background: var(--color-input-bg);
}

.field input,
.field textarea {
  min-height: var(--control-height);
}

.actions button {
  min-height: var(--control-height);
}

.field-error-copy,
.required {
  color: var(--color-danger-text);
}

.input-placeholder {
  color: var(--color-placeholder);
}

.mode-grid,
.split {
  display: grid;
  grid-template-columns: 1fr;
}

@media (max-width: 430px) {
  .split {
    grid-template-columns: 1fr;
  }
}
