.activity-form-page {
  min-height: 100vh;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  background: #0b0b0c;
  color: #f4f7f2;
}
.form-head {
  padding: 32rpx 8rpx 18rpx;
}
.hero-kicker,
.section-label {
  color: #d55b1f;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}
.form-title {
  margin: 10rpx 0;
  font-size: 46rpx;
  font-weight: 900;
}
.muted,
.hint {
  color: #89918b;
}
.section-label {
  margin: 30rpx 0 12rpx;
}
.form-card {
  padding: 28rpx;
  border: 1rpx solid #2b3130;
  border-radius: 10rpx;
  background: linear-gradient(145deg, #171b1d, #101315);
}
.activity-form-page .card {
  border: 1rpx solid #343438;
  background: #242427;
  color: #f7f7f5;
}
.activity-form-page .card.danger {
  border-color: rgba(200, 32, 24, 0.5);
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
}
.activity-form-page .secondary {
  border: 2rpx solid #3a3a3e;
  background: #151517 !important;
  color: #f7f7f5 !important;
}
.section-title {
  color: #f7f7f5;
  font-size: 28rpx;
  font-weight: 900;
}
.field {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.field text {
  font-weight: 800;
}
.hint {
  font-size: 23rpx;
}
.accent {
  margin: -8rpx 0 24rpx;
  color: #d55b1f;
}
.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.field input,
.field textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #343b39;
  border-radius: 10rpx;
  background: #0d1012;
  color: #f4f7f2;
}
.field textarea {
  min-height: 240rpx;
}
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}
.actions button {
  margin: 0;
}
.activity-form-page .btn {
  background: #d55b1f;
  color: #0b0b0c;
  font-weight: 900;
}
.danger-button {
  border: 1rpx solid #ff5c61;
  background: transparent;
  color: #ff8589;
}
@media (max-width: 480px) {
  .split {
    grid-template-columns: 1fr;
  }
}
.template-banner,
.publish-checklist {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(213, 91, 31, 0.45);
  background: rgba(213, 91, 31, 0.08);
}

.template-banner {
  color: var(--cili-orange);
  font-weight: 700;
}

/* Activity media and map controls follow the current dark design system. */
.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.counter,
.location-address {
  color: #a8a8ad;
  font-size: 22rpx;
}
.media-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}
.media-item {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #3a3a3c;
  border-radius: 24rpx;
  background: #1c1c1e;
}
.media-item image {
  display: block;
  width: 100%;
  height: 190rpx;
}
.cover-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ff5722;
  color: #000;
  font-size: 20rpx;
  font-weight: 800;
}
.media-actions {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 10rpx;
}
.media-actions button,
.media-add,
.location-button {
  margin: 0;
  border: 1rpx solid #3a3a3c;
  border-radius: 24rpx;
  background: #1c1c1e;
  color: #f7f7f5;
}
.media-actions button {
  width: 100%;
  font-size: 20rpx;
}
.media-add,
.location-button {
  margin-top: 12rpx;
}
.location-button {
  border-color: #ff5722;
  color: #ff8a65;
}
.location-address {
  overflow-wrap: anywhere;
}

.strava-route {
  padding: 20rpx;
  border: 1rpx solid rgba(252, 76, 2, 0.5);
  border-radius: 16rpx;
  background: rgba(252, 76, 2, 0.07);
}
.strava-sync {
  margin: 4rpx 0 0;
  border: 1rpx solid #fc4c02;
  background: #fc4c02;
  color: #fff;
  font-weight: 800;
}
.route-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 12rpx;
  color: #d5ddd7;
  font-size: 23rpx;
}
.climb-row {
  color: #ff9a70;
}
