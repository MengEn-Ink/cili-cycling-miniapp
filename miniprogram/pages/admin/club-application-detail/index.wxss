/* 骑行影像志 · 俱乐部资料编辑 1:1 实现
 * 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/admin-club-profile.html
 *   pageheading → content.tight(form) →
 *     section 头像与背景(upload × 2)
 *     section 基本资料(field × 3)
 *     btn 保存
 */

.club-profile-page {
  min-height: 100vh;
  padding: 0;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

/* --- pageheading --------------------------------------------------------- */
.pageheading {
  padding: 32rpx 32rpx 24rpx;
}
.pageheading .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.pageheading .eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.pageheading-title {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 72rpx;
  line-height: 88rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-sub {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}
.club-profile-badge {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 6rpx 18rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  letter-spacing: 1rpx;
}

/* --- content ------------------------------------------------------------ */
.content {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
}
.content > form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* --- section + chapterhead -------------------------------------------- */
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
}
.chapterhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.chapterhead-title {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 900;
}
.chapterhead-aside {
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* --- upload ------------------------------------------------------------- */
.upload {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 20rpx;
  background: var(--color-bg);
}
.upload-preview {
  flex: none;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--color-raised);
}
.club-cover-preview {
  width: 272rpx;
  aspect-ratio: 16 / 9;
}
.club-avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
}
.upload-image {
  width: 100%;
  height: 100%;
  display: block;
}
.upload-empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx;
  color: var(--color-muted);
  text-align: center;
  font-size: 24rpx;
}
.club-avatar-empty {
  color: var(--color-text);
  font-size: 56rpx;
  font-weight: 300;
}
.club-cover-empty-title {
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
}
.upload-progress {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: rgba(12, 10, 7, 0.56);
  color: #fff;
  font-size: 24rpx;
}
.club-cover-progress-text {
  font-weight: 800;
}
.club-cover-progress-bar {
  width: 70%;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
  overflow: hidden;
}
.club-cover-progress-inner {
  height: 100%;
  background: #fff;
}
.club-avatar-progress {
  font-weight: 800;
}
.upload-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.upload-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.upload-sub {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.upload-actions {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.upload-status {
  color: var(--color-muted);
  font-size: 22rpx;
}

/* --- field ------------------------------------------------------------- */
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.field-label {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 800;
}
.field-label .required {
  margin-left: 8rpx;
  color: var(--color-muted);
  font-weight: 500;
  font-size: 22rpx;
}
.input {
  min-height: 88rpx;
  padding: 18rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
}
.input-placeholder {
  color: var(--color-muted);
}
.textarea {
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
}
.field-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.field-count {
  color: var(--color-muted);
  font-size: 22rpx;
}
.field-error {
  color: var(--color-status-warning, #c0321f);
  font-size: 24rpx;
  line-height: 36rpx;
}
.field-msg.is-error {
  color: var(--color-status-warning, #c0321f);
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--color-status-warning, #c0321f);
  border-radius: 16rpx;
  background: var(--color-status-warning-soft, rgba(192, 50, 31, 0.08));
}

/* --- notice ----------------------------------------------------------- */
.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-text);
}

/* --- empty state ------------------------------------------------------- */
.empty {
  margin: 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  text-align: center;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-text);
}
.empty-copy {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 38rpx;
}
.empty .btn {
  align-self: center;
}

/* --- btn ------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn.secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.btn[disabled] {
  opacity: 0.6;
}
.club-profile-submit {
  align-self: stretch;
}

.small {
  font-size: 22rpx;
  line-height: 32rpx;
}
.muted {
  color: var(--color-muted);
}

/* --- offscreen canvas used by club-media utility --------------------- */
.club-media-canvas {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 1280rpx;
  height: 720rpx;
  pointer-events: none;
  opacity: 0;
}

@media (max-width: 350px) {
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .upload {
    flex-direction: column;
  }
  .club-cover-preview {
    width: 100%;
  }
}
