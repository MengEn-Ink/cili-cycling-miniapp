.club-profile-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}
.journal-heading {
  padding: 28rpx 0 56rpx;
}
.journal-eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.journal-eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.journal-heading .page-title {
  margin-top: 16rpx;
  font-size: 64rpx;
  line-height: 80rpx;
  letter-spacing: -2rpx;
}
.club-media-canvas {
  position: fixed;
  top: 0;
  left: -2000px;
  width: 1280px;
  height: 720px;
  pointer-events: none;
}
.club-profile-head {
  margin-top: 28rpx;
}
.club-profile-badge {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.page-sub {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 32rpx;
  line-height: 48rpx;
}
.club-profile-card {
  margin-top: 64rpx;
  padding: 40rpx 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}
.journal-heading + .club-profile-card {
  margin-top: 0;
}
.club-profile-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.club-profile-section-hint {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.club-avatar-editor {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}
.club-avatar-preview {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  overflow: hidden;
  border: 2rpx dashed var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.club-avatar-img {
  width: 180rpx;
  height: 180rpx;
}
.club-avatar-empty {
  color: var(--color-text);
  font-size: 64rpx;
  font-weight: 900;
}
.club-avatar-progress {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-overlay);
  color: var(--color-on-media);
  font-size: 28rpx;
  font-weight: 900;
}
.club-avatar-panel {
  flex: 1;
  min-width: 0;
}
.club-avatar-tip {
  margin-bottom: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.club-media-btn {
  width: 100%;
  min-height: var(--control-height);
}
.club-media-status {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.club-cover-preview {
  position: relative;
  margin-top: 24rpx;
  overflow: hidden;
  border: 2rpx dashed var(--color-border-strong);
  border-radius: var(--radius-md);
  background: var(--color-raised);
}
.club-cover-img {
  display: block;
  width: 100%;
  height: 320rpx;
}
.club-cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 320rpx;
  padding: 0 var(--space-4);
  text-align: center;
}
.club-cover-empty-title {
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 900;
}
.club-cover-empty-sub {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.club-cover-progress {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--color-overlay);
}
.club-cover-progress-text {
  color: var(--color-on-media);
  font-size: 26rpx;
  font-weight: 800;
}
.club-cover-progress-bar {
  width: 60%;
  height: 8rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: var(--color-media-muted);
}
.club-cover-progress-inner {
  height: 100%;
  background: var(--color-brand);
}
.club-cover-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}
.club-cover-remove {
  color: var(--color-text);
}
.club-field-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
  min-height: 36rpx;
}
.club-field-count {
  margin-left: auto;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.club-profile-action-error {
  margin-top: var(--card-gap);
}
.club-profile-submit {
  width: 100%;
  min-height: 96rpx;
  margin-top: 48rpx;
}
.club-profile-retry {
  width: 100%;
  margin-top: 24rpx;
}
@media (max-width: 340px) {
  .club-cover-actions {
    grid-template-columns: 1fr;
  }
}
