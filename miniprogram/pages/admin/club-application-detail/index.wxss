.club-review-detail-page {
  padding-bottom: 32rpx;
  background: var(--color-bg);
}
.club-review-detail-page--pending {
  padding-bottom: 160rpx;
}
.info-bar {
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}
.info-kicker {
  color: var(--color-muted);
  font-size: 24rpx;
}
.info-title {
  color: var(--color-text);
}
.cover {
  width: 100%;
  height: 360rpx;
  margin-top: var(--card-gap);
  border-radius: var(--radius-display);
  background: var(--color-raised);
}
.cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.detail-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-border);
}
