.club-profile-page {
  min-height: 100vh;
  padding: 0 0 calc(64rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.pageheading {
  padding: 32rpx var(--page-gutter) 24rpx;
}
.pageheading .eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 24rpx;
  line-height: 36rpx;
  letter-spacing: 2rpx;
}
.pageheading .eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.pageheading-title {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}
.pageheading-sub {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}
.club-profile-badge {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xs);
  background: var(--color-raised);
  color: var(--color-text);
}
.content {
  padding: 0 var(--page-gutter);
}
.content > form {
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}
.section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.section + .section {
  margin-top: 56rpx;
}
.chapterhead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--color-border);
}
.chapterhead-title {
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
}
.chapterhead-aside {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.upload {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}
.upload-preview {
  position: relative;
  flex: none;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.club-cover-preview {
  width: 256rpx;
  aspect-ratio: 16 / 9;
}
.club-avatar-preview {
  width: 144rpx;
  height: 144rpx;
}
.upload-image {
  display: block;
  width: 100%;
  height: 100%;
}
.upload-empty,
.upload-progress {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx;
  text-align: center;
}
.upload-empty {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.club-avatar-empty {
  color: var(--color-text);
  font-size: 48rpx;
}
.club-cover-empty-title {
  color: var(--color-text);
  font-weight: 800;
}
.upload-progress {
  background: var(--color-media-scrim);
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}
.club-cover-progress-bar {
  width: 70%;
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
}
.club-cover-progress-inner {
  height: 100%;
  background: var(--color-on-media);
}
.upload-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}
.upload-title {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.upload-sub,
.upload-status,
.small {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.upload-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.field-label {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.field-label .required {
  margin-left: 8rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-action);
  font-size: 24rpx;
  line-height: 36rpx;
}
.input,
.textarea {
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
}
.textarea {
  min-height: 200rpx;
}
.input-placeholder {
  color: var(--color-placeholder);
}
.field-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.field-count {
  margin-left: auto;
  font-variant-numeric: tabular-nums;
}
.field-error,
.field-msg.is-error {
  color: var(--color-action-active);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
}
.field-msg.is-error {
  padding: 16rpx 20rpx;
  border-left: 6rpx solid var(--color-action);
  background: var(--color-brand-soft);
}
.notice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0 16rpx 20rpx;
  border-left: 6rpx solid var(--color-border-strong);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 38rpx;
}
.notice-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: currentColor;
}
.btn {
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 2rpx solid var(--color-action);
  border-radius: var(--radius-sm) !important;
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.btn.secondary {
  border-color: var(--color-border-strong);
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
.btn[disabled] {
  border-color: var(--color-border) !important;
  background: var(--color-raised) !important;
  color: var(--color-disabled-text) !important;
}
.club-profile-submit {
  width: 100%;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin: 32rpx var(--page-gutter);
  padding: 40rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  text-align: center;
}
.empty-title {
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 900;
}
.empty-copy {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}
.club-media-canvas {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 1280rpx;
  height: 720rpx;
  opacity: 0;
  pointer-events: none;
}

@media (max-width: 340px) {
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .upload {
    align-items: stretch;
    flex-direction: column;
  }
  .club-cover-preview {
    width: 100%;
  }
  .club-avatar-preview {
    width: 144rpx;
  }
}
