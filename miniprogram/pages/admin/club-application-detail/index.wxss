.club-review-detail-page {
  padding-bottom: 160rpx;
  background: var(--color-bg);
}
.info-bar {
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}
.info-kicker {
  color: var(--color-muted);
  font-size: 24rpx;
}
.cover {
  width: 100%;
  height: 360rpx;
  margin-top: var(--card-gap);
  border-radius: var(--radius-display);
  background: var(--color-raised);
}
.detail-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-border);
}
.detail-block text,
.detail-block strong {
  display: block;
}
.detail-block text {
  color: var(--color-muted);
  font-size: 24rpx;
}
.detail-block strong {
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}
.privacy-card {
  background: var(--color-raised);
}
.contact {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}
.decision-panel textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
}
.field-error {
  margin-top: 8rpx;
  color: var(--color-action);
  font-size: 24rpx;
  font-weight: 800;
}
.actions-space {
  height: 140rpx;
}
.actions {
  grid-template-columns: 0.82fr 1.18fr;
}
.state-card .btn {
  margin-top: 24rpx;
}
@media (max-width: 340px) {
  .actions {
    grid-template-columns: 1fr;
  }
  .club-review-detail-page {
    padding-bottom: 260rpx;
  }
}
