  padding-right: 40rpx;
  padding-left: 40rpx;
  background: #0b0b0c;
}

.profile-hero {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #121212;
}

.avatar,
.hero-capability-card,
.profile-page .card,
.menu-list {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
  box-shadow: none;
}

.avatar {
  border-radius: 50%;
}

.hero-capability-status,
.menu-icon {
  border-radius: 16rpx;
}

.menu-card,
.menu-card:active {
  min-height: 104rpx;
  background: #2c2c2e;
}

.profile-copy .hero-kicker,
.hero-capability-label,
.hero-capability-unit,
.panel-index,
.section-label text,
.chevron {
  color: var(--color-brand);
}

.edit-button,
.profile-refresh-error button,
.profile-page .btn,
.profile-page .secondary {
  min-height: 104rpx;
  border-radius: 24rpx !important;
}

.profile-page .btn {
  background: var(--color-action) !important;
}

@media (max-width: 320px) {
  .page.profile-page {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }
}

/* Compact profile composition aligned with the rider-card visual system. */
.page.profile-page {
  padding-right: 40rpx;
  padding-left: 40rpx;
  background: #0b0b0c;
}

.profile-page brand-logo {
  padding: 4rpx 0 10rpx;
  border-bottom: 0;
}

.profile-hero {
  box-sizing: border-box;
  display: flex;
  min-height: 600rpx;
  padding: 236rpx 20rpx 18rpx;
  flex-direction: column;
  justify-content: flex-end;
  border: 1rpx solid #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.profile-hero.has-bg {
  min-height: 600rpx;
}

.hero-shade {
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.06),
    rgba(0, 0, 0, 0.28) 56%,
    rgba(0, 0, 0, 0.84) 100%
  );
  transition: opacity 160ms ease-out;
}

.hero-identity {
  gap: 16rpx;
}

.avatar {
  flex-basis: 80rpx;
  width: 80rpx;
  height: 80rpx;
  border-color: #fff;
  border-radius: 50%;
  background: #1c1c1e;
}

.profile-copy .hero-kicker,
.hero-capability-label,
.hero-capability-unit,
.panel-index,
.section-label text,
.chevron {
  color: var(--color-brand);
}

.profile-name {
  font-size: 34rpx;
}

.hero-capability-card {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: rgba(28, 28, 30, 0.92);
  box-shadow: none;
}

.hero-capability-card::after,
.corner-cut {
  background: var(--color-brand);
}

.hero-capability-metrics {
  gap: 10rpx;
  margin-top: 10rpx;
}

.hero-capability-value {
  font-size: 27rpx;
}

.hero-profile-progress {
  margin-top: 10rpx;
}

.hero-progress-value {
  background: var(--color-brand);
}

.profile-page .card {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
  box-shadow: none;
}

.auth-card,
.guidance-card {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
}

.guidance-actions {
  gap: 10rpx;
  margin-top: 14rpx;
}

.section-label {
  margin: 18rpx 4rpx 7rpx;
}

.profile-card,
.profile-loading,
.profile-error,
.empty-profile {
  margin-top: 6rpx;
}

.profile-card {
  padding-top: 17rpx;
  padding-bottom: 17rpx;
}

.profile-refresh-error {
  min-height: 56rpx;
  margin: 6rpx 0 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  background: #1c1c1e;
}

.menu-list {
  overflow: hidden;
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.menu-card,
.menu-card:active {
  min-height: 88rpx;
  padding: 11rpx 18rpx;
  background: #1c1c1e;
}

.menu-card:active {
  background: #2c2c2e;
}

.menu-icon {
  flex-basis: 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-color: #3a3a3c;
  border-radius: 16rpx;
  background: #2c2c2e;
  color: var(--color-brand);
}

.capability-entry {
  background: #1c1c1e;
}

.capability-entry .menu-icon {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: #000;
}

.edit-button,
.profile-refresh-error button,
.profile-page .btn,
.profile-page .secondary {
  min-height: 88rpx;
  border-radius: 24rpx !important;
}

.profile-page .btn {
  background: var(--color-action) !important;
}

@media (max-width: 350px) {
  .page.profile-page {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }

  .profile-hero {
    padding-right: 14rpx;
    padding-left: 14rpx;
  }
}

.hero-card-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-card-logo {
  padding: 5rpx 9rpx;
  border-radius: 8rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 18rpx;
  font-weight: 950;
  letter-spacing: 2rpx;
}

.hero-capability-secondary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 10rpx;
}

.hero-capability-secondary .hero-capability-metric {
  min-width: 0;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.035);
}

.hero-capability-details {
  display: grid;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.hero-capability-details > view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-capability-details text:first-child {
  color: #8f8f94;
  font-size: 19rpx;
}

.hero-capability-details text:last-child {
  color: #f7f7f5;
  font-size: 19rpx;
  text-align: right;
}

page,
.page.profile-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.profile-page brand-logo {
  border-color: var(--color-border);
}
.profile-page .card,
.menu-list {
  border-color: var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: none;
}
.menu-card {
  border-color: var(--color-border);
  background: var(--color-surface);
  color: var(--color-muted);
}
.menu-card:active,
.menu-icon {
  background: var(--color-raised);
}
.menu-title {
  color: var(--color-text);
}
.profile-hero,
.profile-hero .profile-name,
.profile-hero .hero-capability-value,
.profile-hero .hero-capability-details text:last-child {
  color: #f7f7f5;
}
.card .muted,
.menu-card .muted,
.hero-capability-details text:first-child {
  color: var(--color-muted);
}
.edit-button,
.profile-refresh-error button,
.profile-page .btn,
.profile-page .secondary {
  min-height: 88rpx;
  border-radius: var(--radius-display) !important;
}
.profile-page .btn {
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
.profile-page .secondary {
  border-color: var(--color-border-strong);
  background: var(--color-input-bg) !important;
  color: var(--color-text) !important;
}
/* Hero identity remains white on a persistent dark photographic overlay. */

.profile-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  overflow: hidden;
  border-bottom: 1rpx solid var(--color-border);
}

.profile-topbar brand-logo {
  min-width: 0;
  overflow: hidden;
  flex: 1;
  border-bottom: 0;
}

.settings-entry {
  display: inline-flex;
  min-width: 124rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
}

.settings-entry::after {
  border: 0;
}

.settings-entry:active {
  border-color: var(--color-brand);
  background: var(--color-brand-soft);
  transform: scale(0.98);
}

@media (prefers-reduced-motion: reduce) {
  .settings-entry:active {
    transform: none;
  }
}

.settings-entry-icon {
  color: var(--color-brand);
  font-size: 30rpx;
}

/* Scheme A: photographic rider identity with data bands below the image. */
.page.profile-page {
  overflow-x: hidden;
}

.profile-topbar {
  padding-bottom: 8rpx;
  border-bottom: 0;
}

.profile-hero,
.profile-hero.has-bg {
  min-height: 640rpx;
  padding: 370rpx 24rpx 28rpx;
  border-radius: var(--radius-sm);
}

.hero-shade {
  background: linear-gradient(
    180deg,
    rgba(11, 11, 12, 0.03),
    rgba(11, 11, 12, 0.18) 42%,
    rgba(11, 11, 12, 0.94) 100%
  );
}

.hero-identity {
  align-items: flex-end;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  flex-basis: 92rpx;
}

.profile-copy .hero-kicker {
  font-size: 17rpx;
}

.profile-name {
  margin-top: 6rpx;
  font-size: 50rpx;
  line-height: 1.02;
}

.profile-title {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.auth-line {
  margin-top: 8rpx;
  font-size: 19rpx;
}

.profile-capability-section {
  margin-top: 0;
}

.profile-capability-section .hero-capability-card {
  margin-top: 0;
  padding: 24rpx 4rpx 22rpx;
  border-width: 0 0 1rpx;
  border-color: var(--color-border);
  border-radius: 0;
  background: transparent;
}

.profile-capability-section .hero-capability-card::after {
  display: none;
}

.profile-capability-section .hero-capability-head {
  padding: 0 4rpx;
}

.profile-capability-section .hero-capability-metrics {
  display: grid;
  margin-top: 18rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
}

.profile-capability-section .hero-capability-metric {
  padding: 4rpx 10rpx 2rpx;
}

.profile-capability-section .hero-capability-metric + .hero-capability-metric {
  border-left: 1rpx solid var(--color-border);
}

.profile-capability-section .hero-capability-value {
  color: var(--color-text);
  font-size: 34rpx;
}

.profile-capability-section .hero-capability-name,
.profile-capability-section .hero-capability-empty {
  color: var(--color-muted);
}

.profile-capability-section .hero-capability-status {
  border-color: var(--color-border);
  background: var(--color-raised);
  color: var(--color-muted);
}

.profile-capability-section .hero-capability-status.status-verified {
  border-color: var(--color-success);
  background: var(--color-success-soft);
  color: var(--color-success-text);
}

.profile-capability-section .hero-capability-status.status-partial,
.profile-capability-section .hero-capability-status.status-syncing {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning-text);
}

.profile-capability-section .hero-capability-status.status-repair {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}

.hero-capability-group {
  margin-top: 20rpx;
}

.hero-capability-group-label {
  color: var(--color-muted);
  font-size: 18rpx;
  font-weight: 800;
}

.hero-capability-strava-tenure {
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.hero-capability-lifetime {
  display: grid;
  margin-top: 10rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
  border-top: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
}

.hero-capability-lifetime .hero-capability-metric {
  padding: 16rpx 10rpx 14rpx;
}

.hero-capability-lifetime .hero-capability-metric:nth-child(even) {
  border-left: 1rpx solid var(--color-border);
}

.hero-capability-lifetime .hero-capability-metric:nth-child(n + 3) {
  border-top: 1rpx solid var(--color-border);
}

.hero-capability-recent-label {
  margin-top: 20rpx;
}

.profile-capability-section .hero-capability-secondary {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.profile-capability-section .hero-capability-secondary .hero-capability-metric {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.profile-capability-section
  .hero-capability-secondary
  .hero-capability-metric
  + .hero-capability-metric {
  border-left: 1rpx solid var(--color-border);
}

.profile-capability-section .hero-capability-details {
  border-color: var(--color-border);
}

.profile-capability-section .hero-capability-details text:last-child {
  color: var(--color-text);
}

.hero-profile-progress {
  margin: 18rpx 0 0;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid var(--color-brand);
  background: var(--color-surface);
}

.hero-progress-head {
  color: var(--color-text);
  font-size: 23rpx;
}

.hero-progress-head text:last-child {
  color: var(--color-brand);
  font-size: 34rpx;
}

.hero-progress-track {
  height: 6rpx;
  margin-top: 12rpx;
  background: var(--color-border);
}

.hero-progress-value {
  background: var(--color-brand);
}

.profile-page .profile-card,
.profile-page .profile-loading,
.profile-page .profile-error,
.profile-page .empty-profile {
  padding-right: 4rpx;
  padding-left: 4rpx;
  border-right: 0;
  border-bottom: 1rpx solid var(--color-border);
  border-left: 0;
  border-radius: 0;
  background: transparent;
}

.menu-list {
  border-right: 0;
  border-left: 0;
  border-radius: 0;
  background: transparent;
}

.menu-card,
.menu-card:active {
  min-height: 104rpx;
  padding-right: 4rpx;
  padding-left: 4rpx;
  background: transparent;
}

.menu-icon {
  border-color: var(--color-border);
  background: transparent;
}

.profile-refresh-feedback {
  display: flex;
  min-height: 88rpx;
  margin-bottom: 12rpx;
  padding: 14rpx 18rpx;
  align-items: center;
  gap: 16rpx;
  border-left: 5rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
  pointer-events: none;
  animation: refresh-feedback-enter 220ms cubic-bezier(0.25, 1, 0.5, 1) both;
  contain: layout paint;
}

.refresh-feedback-icon {
  display: flex;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 54rpx;
  height: 54rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 50%;
  color: var(--color-brand);
  font-size: 27rpx;
  font-weight: 900;
}

.refresh-feedback-arrow {
  opacity: calc(0.35 + var(--refresh-progress) * 0.0065);
  transform: rotate(0deg);
  transition:
    opacity 120ms linear,
    transform 180ms cubic-bezier(0.25, 1, 0.5, 1);
}

.refresh-ready .refresh-feedback-arrow {
  opacity: 1;
  transform: rotate(180deg);
}

.refresh-feedback-spinner {
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--color-border-strong);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: refresh-feedback-spin 720ms linear infinite;
}

.refresh-success {
  border-left-color: var(--color-success);
}

.refresh-success .refresh-feedback-icon {
  border-color: var(--color-success);
  color: var(--color-success);
}

.refresh-error {
  border-left-color: var(--color-danger);
}

.refresh-error .refresh-feedback-icon {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

.refresh-feedback-copy {
  min-width: 0;
  flex: 1;
}

.refresh-feedback-title {
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
}

.refresh-feedback-detail {
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes refresh-feedback-enter {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes refresh-feedback-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .profile-refresh-feedback,
  .refresh-feedback-spinner {
    animation-duration: 0.01ms;
    animation-iteration-count: 1;
  }

  .refresh-feedback-arrow {
    transition-duration: 0.01ms;
  }
}

@media (max-width: 350px) {
  .profile-hero,
  .profile-hero.has-bg {
    min-height: 600rpx;
    padding-top: 340rpx;
  }

  .profile-name {
    font-size: 44rpx;
  }
}

/* Photographic identity with explicit black actions. */
.edit-button,
.profile-refresh-error button {
  border-color: var(--color-text);
  background: var(--color-text) !important;
  color: var(--color-bg) !important;
}

.hero-capability-metric {
  text-align: center;
}

/* Unified bright profile shell; the photo hero remains a dark media surface. */
.page.profile-page {
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
}

.profile-topbar {
  min-height: var(--control-height);
}

.settings-entry {
  width: var(--control-height);
  min-width: var(--control-height);
  min-height: var(--control-height);
  padding: 0;
  border-width: 4rpx;
  border-radius: var(--radius-sm);
  box-shadow: 4rpx 4rpx 0 var(--color-border);
}

.settings-entry-icon {
  color: var(--color-text);
}

.profile-hero,
.profile-hero.has-bg {
  min-height: 640rpx;
  border-radius: var(--radius-card);
}

.profile-page .profile-card,
.profile-page .profile-loading,
.profile-page .profile-error,
.profile-page .empty-profile {
  padding: 32rpx;
  border-width: 4rpx;
  border-style: solid;
  border-color: var(--color-card-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.menu-list {
  border-width: 4rpx;
  border-style: solid;
  border-color: var(--color-card-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.menu-card,
.menu-card:active {
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  background: var(--color-surface);
}

.menu-card + .menu-card {
  border-top: 4rpx solid var(--color-border);
}

.profile-capability-section .hero-capability-label,
.profile-capability-section .hero-capability-unit,
.panel-index,
.section-label text,
.chevron,
.hero-progress-head text:last-child {
  color: var(--color-text);
}

.section-label text {
  display: inline-flex;
  min-width: 40rpx;
  min-height: 40rpx;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
}
