.profile-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 34rpx 12rpx 28rpx;
}

.avatar {
  display: flex;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #0b6b4f;
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
}

.profile-copy {
  min-width: 0;
}

.profile-copy .hero-kicker {
  color: #0b6b4f;
}

.profile-name {
  overflow: hidden;
  margin: 6rpx 0;
  font-size: 38rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-line {
  color: #718078;
  font-size: 23rpx;
}

.auth-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #e6a23c;
}

.auth-dot.verified {
  background: #18a058;
}

.auth-card {
  border-color: #f0d9ac;
}

.profile-card {
  margin-top: 10rpx;
}

.edit-button {
  min-width: 96rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 16rpx;
  background: #eef5f1;
  color: #0b6b4f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
  color: #718078;
  font-size: 23rpx;
}

.progress {
  overflow: hidden;
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #e7ede9;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: #0b6b4f;
}

.menu-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(23, 35, 30, 0.05);
}

.menu-icon {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #fff0ea;
  color: #ff6b35;
  font-weight: 800;
}

.admin-icon {
  background: #eef5f1;
  color: #0b6b4f;
}

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-title {
  font-weight: 750;
}

.chevron {
  color: #9aa69f;
  font-size: 40rpx;
}
