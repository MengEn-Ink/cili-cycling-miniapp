.profile-page {
  background: var(--color-bg);
}
.profile-refresh-feedback {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.rider-card {
  overflow: hidden;
  padding: 0;
}
.profile-hero {
  position: relative;
  min-height: 360rpx;
  overflow: hidden;
  background: var(--color-media-card-bg);
}
.hero-swiper,
.hero-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hero-alpine {
  position: absolute;
  inset: 0;
  background: var(--color-media-card-bg);
}
.hero-shade {
  position: absolute;
  inset: 0;
  background: var(--color-overlay);
  opacity: 0.45;
}
.hero-identity {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: var(--color-on-media);
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  overflow: hidden;
  border: 6rpx solid var(--color-on-media);
  border-radius: 50%;
  background: var(--color-action);
}
.avatar-image {
  width: 100%;
  height: 100%;
}
.profile-name {
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
}
.profile-title,
.auth-line {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.auth-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--color-media-muted);
}
.auth-dot.verified {
  background: var(--color-status-success);
}
.hero-profile-progress {
  margin-top: var(--card-gap);
  padding: 32rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.hero-progress-head {
  display: flex;
  justify-content: space-between;
  font-weight: 800;
}
.hero-progress-track {
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: var(--color-raised);
}
.hero-progress-value {
  height: 100%;
  border-radius: 6rpx;
  background: var(--color-action);
}
.hero-progress-missing {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.identity-guide,
.profile-refresh-error {
  margin-top: var(--card-gap);
  padding: 32rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.identity-guide-title {
  font-size: 36rpx;
  font-weight: 900;
}
.identity-guide-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
}
.identity-guide-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}
.menu-list {
  overflow: hidden;
  padding: 0 32rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.menu-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 120rpx;
  border-bottom: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
}
.menu-card:last-child {
  border-bottom: 0;
}
.menu-icon {
  position: relative;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.menu-icon::before,
.menu-icon::after,
.menu-icon view {
  position: absolute;
  border: 3rpx solid var(--color-border-strong);
  content: '';
}
.i-profile::before {
  top: 10rpx;
  left: 20rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}
.i-profile::after {
  right: 10rpx;
  bottom: 8rpx;
  left: 10rpx;
  height: 20rpx;
  border-radius: 20rpx 20rpx 0 0;
}
.i-card::before {
  inset: 12rpx 10rpx;
}
.i-card::after {
  top: 20rpx;
  left: 18rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}
.i-admin::before {
  inset: 14rpx 10rpx 10rpx;
}
.i-admin::after {
  top: 8rpx;
  left: 22rpx;
  width: 14rpx;
  height: 12rpx;
}
.i-settings::before {
  inset: 14rpx;
  border-radius: 50%;
}
.i-settings::after {
  inset: 24rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.menu-copy {
  flex: 1;
  min-width: 0;
}
.menu-title {
  font-size: 28rpx;
  line-height: 44rpx;
}
.chevron {
  color: var(--color-muted);
  font-size: 36rpx;
}
.privacy-note {
  margin: 16rpx 0;
}
.privacy-note-title {
  font-weight: 800;
}
.profile-loading,
.profile-error,
.empty-profile {
  text-align: left;
}
.profile-error .secondary,
.empty-profile .btn {
  width: 100%;
  margin-top: 24rpx;
}
@media (prefers-reduced-motion: reduce) {
  .refresh-feedback-spinner {
    animation-duration: 0.01ms;
    animation-iteration-count: 1;
  }
}
@media (max-width: 340px) {
  .identity-guide-actions {
    grid-template-columns: 1fr;
  }
}
