page {
  background: #0b0b0c;
}
.profile-page {
  min-height: 100vh;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  background: radial-gradient(circle at 95% 4%, rgba(213, 91, 31, 0.14), transparent 30%), #0b0b0c;
  color: #f7f7f5;
}
.brand-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 10rpx 28rpx;
  border-bottom: 1rpx solid #343437;
}
.cili-mark {
  position: relative;
  width: 48rpx;
  height: 38rpx;
  border: 9rpx solid #f7f7f5;
  border-right-width: 7rpx;
  border-radius: 13rpx 4rpx 13rpx 13rpx;
  transform: skewX(-9deg);
}
.mark-cut {
  position: absolute;
  top: -11rpx;
  right: -9rpx;
  width: 26rpx;
  height: 17rpx;
  background: #d55b1f;
  clip-path: polygon(100% 0, 70% 100%, 0 100%);
}
.brand-word {
  font-size: 28rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.brand-word text {
  margin-left: 7rpx;
  font-size: 21rpx;
  font-style: normal;
}
.profile-code {
  margin-left: auto;
  color: #6f6f73;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.profile-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 190rpx;
  margin-top: 24rpx;
  padding: 34rpx 28rpx;
  border: 1rpx solid #3c3c40;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #202023, #111113);
}
.profile-hero.with-card-bg {
  border-color: rgba(213, 91, 31, 0.42);
  box-shadow: 0 20rpx 54rpx rgba(0, 0, 0, 0.34);
}
.hero-bg,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hero-bg {
  opacity: 0.68;
}
.hero-shade {
  background:
    linear-gradient(
      90deg,
      rgba(11, 11, 12, 0.9),
      rgba(11, 11, 12, 0.55) 56%,
      rgba(11, 11, 12, 0.9)
    ),
    linear-gradient(180deg, rgba(213, 91, 31, 0.15), rgba(11, 11, 12, 0.72));
  pointer-events: none;
}
.avatar {
  position: relative;
  z-index: 1;
  overflow: hidden;
  display: flex;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid rgba(247, 247, 245, 0.72);
  border-radius: 12rpx;
  background: #1b1b1d;
  color: #f7f7f5;
  font-size: 48rpx;
  font-style: italic;
  font-weight: 900;
  transform: skewX(-7deg);
}
.avatar image {
  width: 130%;
  height: 112%;
  transform: skewX(7deg) scale(1.08);
}
.avatar text {
  transform: skewX(7deg);
}
.profile-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
}
.profile-copy .hero-kicker {
  color: #d55b1f;
  font-weight: 900;
}
.profile-name {
  overflow: hidden;
  margin: 4rpx 0 6rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.auth-line,
.card-sync-line {
  color: #d5d5d7;
  font-size: 22rpx;
}
.card-sync-line {
  margin-top: 6rpx;
  color: #d55b1f;
  font-weight: 800;
}
.auth-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #d55b1f;
  box-shadow: 0 0 14rpx rgba(213, 91, 31, 0.5);
}
.auth-dot.verified {
  background: #c7c7c9;
  box-shadow: none;
}
.card {
  position: relative;
  border: 1rpx solid #4b4b4f;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #202023, #151517);
  color: #f7f7f5;
  box-shadow: 0 16rpx 38rpx rgba(0, 0, 0, 0.28);
}
.card .muted {
  color: #929296;
}
.auth-card {
  border-color: #7a4329;
}
.panel-index {
  margin-bottom: 14rpx;
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}
.section-label {
  margin: 38rpx 4rpx 12rpx;
  color: #96969a;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.section-label text {
  margin-right: 14rpx;
  color: #d55b1f;
}
.profile-card {
  margin-top: 10rpx;
}
.profile-loading,
.profile-error,
.empty-profile {
  margin-top: 10rpx;
}
.profile-refreshing,
.profile-refresh-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  margin: 10rpx 0 12rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid #5a5a5e;
  border-radius: 6rpx;
  background: #18181a;
  color: #bdbdc0;
  font-size: 22rpx;
}
.profile-refresh-error {
  border-color: #8d4930;
  color: #f0b59e;
}
.profile-refresh-error button {
  min-width: 96rpx;
  min-height: 88rpx;
  margin: 0 0 0 20rpx;
  padding: 0 18rpx;
  border: 1rpx solid #a85a39;
  border-radius: 4rpx;
  background: transparent;
  color: #f7f7f5;
  font-size: 22rpx;
  line-height: 88rpx;
}
.edit-button {
  min-width: 96rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #737377;
  border-radius: 4rpx;
  background: transparent;
  color: #f7f7f5;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 88rpx;
}
.progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 28rpx;
  color: #96969a;
  font-size: 22rpx;
}
.progress-number {
  color: #f7f7f5;
  font-size: 34rpx;
  font-weight: 900;
}
.progress {
  overflow: hidden;
  height: 10rpx;
  margin-top: 10rpx;
  background: #414145;
}
.progress-value {
  height: 100%;
  background: linear-gradient(90deg, #c82018, #d55b1f);
}
.corner-cut {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 32rpx;
  height: 32rpx;
  background: #d55b1f;
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}
.menu-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 116rpx;
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #46464a;
  border-radius: 6rpx;
  background: #18181a;
}
.menu-card:active {
  border-color: #d55b1f;
  background: #222224;
}
.menu-icon {
  display: flex;
  flex: 0 0 70rpx;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border: 1rpx solid #77777b;
  border-radius: 4rpx;
  background: #29292c;
  color: #d55b1f;
  font-size: 29rpx;
  font-style: italic;
  font-weight: 900;
}
.capability-entry {
  border-color: #6c6c70;
  background: linear-gradient(110deg, #29292c, #171719);
}
.capability-entry .menu-icon {
  border-color: #d55b1f;
  background: #d55b1f;
  color: #0b0b0c;
}
.menu-copy {
  min-width: 0;
  flex: 1;
}
.menu-title {
  color: #f7f7f5;
  font-weight: 850;
}
.menu-card .muted {
  color: #858589;
  font-size: 22rpx;
}
.chevron {
  color: #d55b1f;
  font-size: 42rpx;
}
.btn,
.secondary {
  border-radius: 4rpx !important;
}
.btn {
  background: #a94416 !important;
}
.secondary {
  border-color: #6b6b6f;
  background: transparent !important;
  color: #f7f7f5 !important;
}
.avatar-source-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #3c3c40;
  border-radius: 8rpx;
  background: #18181a;
}
.avatar-source-label {
  flex: 0 0 auto;
  color: #96969a;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.avatar-source-options {
  display: flex;
  gap: 10rpx;
}
.avatar-source-option {
  min-width: 150rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #555559;
  border-radius: 4rpx;
  color: #c7c7c9;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}
.avatar-source-option.active {
  border-color: #d55b1f;
  background: rgba(213, 91, 31, 0.16);
  color: #f38a50;
}
.avatar-source-option.is-disabled {
  opacity: 0.35;
}
