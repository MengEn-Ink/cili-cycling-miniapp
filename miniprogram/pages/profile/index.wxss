page {
  background: var(--color-bg);
}

.page.profile-page {
  min-height: 100%;
  padding: 24rpx 32rpx 56rpx;
  background: var(--color-bg);
  color: var(--color-text);
}

brand-logo {
  display: block;
  margin-bottom: 28rpx;
}

.rider-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--color-text);
  box-shadow: 0 18rpx 42rpx rgba(32, 33, 36, 0.18);
}

.profile-hero,
.profile-hero.has-bg {
  position: relative;
  display: flex;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 600rpx;
  padding: 360rpx 28rpx 28rpx;
  flex-direction: column;
  justify-content: flex-end;
  background: #292a2d;
  color: var(--color-on-media);
}

.profile-hero {
  color: var(--color-on-media);
}

.hero-swiper,
.hero-fallback-image,
.hero-alpine {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.hero-bg-image {
  width: 100%;
  height: 100%;
}

.hero-alpine {
  overflow: hidden;
  background: linear-gradient(150deg, #57534f, #262626 66%, #171717);
}

.hero-ridge {
  position: absolute;
  right: -15%;
  bottom: -60rpx;
  left: -15%;
  height: 260rpx;
  background: #18181a;
  transform: rotate(-8deg) skewX(-18deg);
}

.hero-ridge-far {
  bottom: 68rpx;
  background: #484542;
}

.hero-shade {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(10, 10, 10, 0.05),
    rgba(10, 10, 10, 0.2) 42%,
    rgba(10, 10, 10, 0.92)
  );
}

.hero-identity {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
}

.avatar {
  display: flex;
  overflow: hidden;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  border-radius: 50%;
  background: var(--color-brand);
  color: var(--color-on-media);
  font-size: 38rpx;
  font-weight: 900;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.profile-copy {
  min-width: 0;
  flex: 1;
}

.profile-name {
  overflow: hidden;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-title,
.auth-line {
  overflow: hidden;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-dot,
.status-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--color-brand);
}

.auth-dot.verified,
.status-verified .status-dot {
  background: var(--color-text);
}

.profile-capability-section {
  padding: 28rpx 24rpx 24rpx;
  background: var(--color-text);
  color: var(--color-on-media);
}

.hero-capability-head,
.hero-progress-head,
.hero-capability-details {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-capability-label {
  font-size: 26rpx;
  font-weight: 900;
}

.hero-capability-strava-tenure {
  margin-top: 6rpx;
  color: #aaa6a0;
  font-size: 18rpx;
}

.hero-capability-status {
  padding: 8rpx 14rpx;
  border: 1rpx solid #5b5c60;
  border-radius: 999rpx;
  color: #e7e4df;
  font-size: 18rpx;
  font-weight: 800;
}
.profile-capability-section .hero-capability-status.status-verified {
  border-color: var(--color-success);
  background: var(--color-success-soft);
  color: var(--color-success-text);
}
.profile-capability-section .hero-capability-status.status-partial,
.profile-capability-section .hero-capability-status.status-syncing {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning-text);
}
.profile-capability-section .hero-capability-status.status-repair {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}

.hero-capability-metrics {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.hero-capability-metric {
  min-width: 0;
  padding: 2rpx 12rpx;
  text-align: center;
}

.hero-capability-metric + .hero-capability-metric {
  border-left: 1rpx solid #46474a;
}

.hero-capability-value {
  overflow: hidden;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-capability-unit {
  margin-left: 4rpx;
  color: var(--color-brand);
  font-size: 17rpx;
}

.hero-capability-name,
.hero-capability-empty {
  margin-top: 6rpx;
  color: #aaa6a0;
  font-size: 18rpx;
}

.hero-capability-secondary {
  display: grid;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #46474a;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.hero-capability-details {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #46474a;
  color: #aaa6a0;
  font-size: 18rpx;
}

.hero-capability-details text:last-child {
  color: var(--color-on-media);
  text-align: right;
}

.hero-strava-copy {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-text);
}

.hero-strava-copy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  font-weight: 900;
}

.hero-strava-copy-head text:last-child {
  color: var(--color-muted);
  font-size: 18rpx;
  font-weight: 700;
}

.hero-strava-url {
  display: block;
  margin-top: 16rpx;
  overflow-wrap: anywhere;
  color: var(--color-brand);
  font-size: 20rpx;
  line-height: 1.55;
}

.hero-strava-copy-hint {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.55;
}

.hero-strava-link {
  display: flex;
  min-height: var(--control-height);
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-radius: 8rpx;
  background: var(--color-text);
  color: var(--color-bg);
  font-size: 22rpx;
  font-weight: 900;
  line-height: var(--control-height);
}

.hero-strava-link:active {
  background: var(--color-raised);
}

.hero-profile-progress,
.identity-guide,
.card,
.menu-list {
  margin-top: 20rpx;
  border: 1rpx solid #d3cec6;
  border-radius: 20rpx;
  background: #fff;
}

.hero-profile-progress,
.identity-guide,
.card {
  padding: 26rpx;
}

.hero-progress-head {
  font-size: 23rpx;
  font-weight: 800;
}

.hero-progress-head text:last-child {
  color: var(--color-brand);
  font-size: 30rpx;
}

.hero-progress-track {
  overflow: hidden;
  height: 8rpx;
  margin-top: 14rpx;
  border-radius: 8rpx;
  background: #dedad4;
}

.hero-progress-value {
  max-width: 100%;
  height: 100%;
  background: var(--color-brand);
}

.identity-guide {
  border-left: 8rpx solid var(--color-brand);
}

.identity-guide-title {
  font-size: 28rpx;
  font-weight: 900;
}

.identity-guide-copy,
.muted {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.identity-guide-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.identity-guide-actions button {
  min-width: 0;
  flex: 1;
  margin: 0;
}

.section-label {
  margin: 34rpx 4rpx 12rpx;
  color: #4f4b47;
  font-size: 24rpx;
  font-weight: 900;
}

.menu-list {
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
}

.menu-card {
  display: flex;
  min-height: var(--control-height);
  padding: 18rpx 22rpx;
  align-items: center;
  gap: 18rpx;
  background: var(--color-surface);
}

.menu-card + .menu-card,
.privacy-note + .menu-card {
  border-top: 1rpx solid #e1ddd7;
}

.menu-card:active {
  background: #f7f4ef;
}

.menu-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #292a2d;
  color: var(--color-on-media);
  font-size: 22rpx;
  font-weight: 900;
}

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-title {
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 900;
}

.menu-card .muted {
  overflow: hidden;
  margin-top: 3rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  color: var(--color-brand);
  font-size: 40rpx;
}

.privacy-note {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #e1ddd7;
  background: #f7f4ef;
  color: #6f6b66;
  font-size: 20rpx;
  line-height: 1.55;
}

.privacy-note-title {
  margin-bottom: 4rpx;
  color: #343230;
  font-weight: 900;
}

.btn,
.secondary,
.profile-refresh-error button {
  min-height: 80rpx;
  border-radius: 14rpx !important;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 80rpx;
}

.btn {
  background: var(--color-brand) !important;
  color: #fff !important;
}

.secondary {
  border: 1rpx solid #343538;
  background: #fff !important;
  color: var(--color-text) !important;
}

.profile-refresh-error {
  display: flex;
  min-height: 70rpx;
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  border-left: 6rpx solid var(--color-brand);
  background: #fff;
  color: var(--color-brand-active);
}

.profile-refresh-feedback {
  display: flex;
  min-height: 76rpx;
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  align-items: center;
  gap: 14rpx;
  border-left: 6rpx solid var(--color-brand);
  background: #fff;
}

.refresh-feedback-icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-brand);
  border-radius: 50%;
  color: var(--color-brand);
  font-weight: 900;
}

.refresh-feedback-copy {
  min-width: 0;
  flex: 1;
}

.refresh-feedback-title {
  font-size: 23rpx;
  font-weight: 900;
}

.refresh-feedback-detail {
  overflow: hidden;
  margin-top: 3rpx;
  color: #6f6b66;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-feedback-arrow {
  opacity: calc(0.35 + var(--refresh-progress) * 0.0065);
}

.refresh-ready .refresh-feedback-arrow {
  opacity: 1;
  transform: rotate(180deg);
}

.refresh-feedback-spinner {
  box-sizing: border-box;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #d3cec6;
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: refresh-feedback-spin 720ms linear infinite;
}

@keyframes refresh-feedback-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 350px) {
  .profile-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
  .profile-hero,
  .profile-hero.has-bg {
    min-height: 560rpx;
    padding-top: 320rpx;
  }
  .profile-name {
    font-size: 42rpx;
  }
  .hero-capability-value {
    font-size: 29rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .refresh-feedback-spinner {
    animation-duration: 0.01ms;
    animation-iteration-count: 1;
  }
}

.page.profile-page {
  --page-gutter: 48rpx;
  --radius-card: 16rpx;
  padding: 32rpx var(--page-gutter) 64rpx;
  background: var(--color-bg);
}
.rider-card {
  border: 4rpx solid var(--color-card-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}
.profile-hero,
.profile-hero.has-bg {
  padding-right: 32rpx;
  padding-bottom: 32rpx;
  padding-left: 32rpx;
}
.hero-identity {
  gap: 16rpx;
}
.profile-name {
  font-size: 48rpx;
  line-height: 1.16;
}
.profile-capability-section {
  padding: 32rpx;
  border-top: 8rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
}
.hero-capability-head,
.hero-progress-head,
.hero-capability-details {
  gap: 16rpx;
}
.hero-capability-status {
  padding: 8rpx 16rpx;
  border-color: var(--color-border);
  border-radius: 8rpx;
  color: var(--color-text);
}
.hero-capability-metrics,
.hero-capability-secondary {
  margin-top: 32rpx;
}
.hero-capability-metric {
  text-align: center;
}
.hero-capability-name,
.hero-capability-strava-tenure,
.hero-capability-details {
  color: var(--color-muted);
}
.section-label {
  margin-top: 48rpx;
  margin-bottom: 16rpx;
}
.menu-list {
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: none;
}
.menu-card {
  min-height: var(--control-height);
  padding: 24rpx 32rpx;
  background: var(--color-surface);
}
.identity-guide-actions button,
.profile-page .btn,
.profile-page .secondary {
  min-height: var(--control-height);
  border-radius: 8rpx;
}
@media (max-width: 350px) {
  .page.profile-page {
    --page-gutter: var(--page-gutter-narrow);
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }
}
