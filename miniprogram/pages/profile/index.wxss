page {
  background: #0b0b0c;
}

.profile-page {
  min-height: 100vh;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  background: radial-gradient(circle at 95% 4%, rgba(213, 91, 31, 0.14), transparent 30%), #0b0b0c;
  color: #f7f7f5;
}

brand-logo {
  display: block;
  padding: 10rpx 8rpx 16rpx;
  border-bottom: 1rpx solid #343437;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 64rpx 18rpx 22rpx;
  border-bottom: 1rpx solid #343437;
}

.profile-hero.has-bg {
  min-height: 438rpx;
}

.hero-swiper,
.hero-fallback-image,
.hero-alpine {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.hero-bg-image {
  width: 100%;
  height: 100%;
}

.packaged-alpine-image {
  background: #171719;
}

.hero-alpine {
  overflow: hidden;
  background: linear-gradient(165deg, #303034 0%, #1d1d20 42%, #111113 100%);
}

.hero-alpine-sun {
  position: absolute;
  top: 38rpx;
  right: 64rpx;
  width: 74rpx;
  height: 74rpx;
  border: 2rpx solid rgba(247, 247, 245, 0.42);
  border-radius: 50%;
  box-shadow: 0 0 58rpx rgba(213, 91, 31, 0.16);
}

.hero-ridge {
  position: absolute;
  right: -16%;
  bottom: -24rpx;
  left: -16%;
  height: 190rpx;
  transform: rotate(-7deg) skewX(-19deg);
  background: #161618;
}

.hero-ridge-far {
  bottom: 44rpx;
  background: #3a3a3e;
}

.hero-ridge-near {
  bottom: -64rpx;
}

.hero-alpine-mark {
  position: absolute;
  top: 34rpx;
  left: 24rpx;
  color: rgba(255, 255, 255, 0.14);
  font-size: 68rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 10rpx;
}

.hero-shade {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to bottom,
    rgba(11, 11, 12, 0.08),
    rgba(11, 11, 12, 0.62) 48%,
    #0b0b0c 100%
  );
}

.hero-identity {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  position: relative;
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid #77777b;
  border-radius: 10rpx;
  background: #1b1b1d;
  color: #f7f7f5;
  font-size: 40rpx;
  font-style: italic;
  font-weight: 900;
  transform: skewX(-7deg);
}

.avatar-image {
  width: 100%;
  height: 100%;
  transform: skewX(7deg) scale(1.1);
}

.avatar text {
  transform: skewX(7deg);
}

.profile-copy {
  min-width: 0;
  flex: 1;
}

.profile-copy .hero-kicker {
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.profile-name {
  overflow: hidden;
  margin: 2rpx 0 3rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-title {
  overflow: hidden;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-line {
  overflow: hidden;
  color: #aaaabe;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-dot {
  display: inline-block;
  width: 9rpx;
  height: 9rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #d55b1f;
  box-shadow: 0 0 14rpx rgba(213, 91, 31, 0.5);
}

.auth-dot.verified {
  background: #6f9b82;
  box-shadow: 0 0 12rpx rgba(111, 155, 130, 0.28);
}

.hero-capability-card {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  padding: 17rpx 20rpx 15rpx;
  border: 1rpx solid rgba(247, 247, 245, 0.2);
  border-radius: 8rpx;
  background: rgba(13, 13, 16, 0.78);
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(18rpx);
}

.hero-capability-card::after,
.corner-cut {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 28rpx;
  height: 28rpx;
  background: #d55b1f;
  content: '';
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
}

.hero-capability-head,
.hero-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.hero-capability-label {
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.hero-capability-status {
  display: inline-flex;
  flex: 0 1 auto;
  align-items: center;
  overflow: hidden;
  max-width: 52%;
  padding: 6rpx 11rpx;
  border: 1rpx solid rgba(247, 247, 245, 0.22);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #f7f7f5;
  font-size: 16rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-capability-status .status-dot {
  display: inline-block;
  flex: 0 0 9rpx;
  width: 9rpx;
  height: 9rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.hero-capability-status.status-verified {
  color: #a9cbb6;
}

.hero-capability-status.status-partial,
.hero-capability-status.status-syncing {
  color: #f38a50;
}

.hero-capability-status.status-repair {
  color: #ff8f86;
}

.hero-capability-metrics {
  display: flex;
  gap: 12rpx;
  margin-top: 13rpx;
}

.hero-capability-metric {
  min-width: 0;
  flex: 1;
}

.hero-capability-value {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 29rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-capability-unit {
  margin-left: 4rpx;
  color: #d55b1f;
  font-size: 15rpx;
  font-weight: 800;
}

.hero-capability-name,
.hero-capability-empty,
.hero-capability-meta {
  color: rgba(255, 255, 255, 0.6);
  font-size: 18rpx;
}

.hero-capability-name {
  margin-top: 5rpx;
}

.hero-capability-empty {
  margin-top: 12rpx;
}

.hero-capability-meta {
  overflow: hidden;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-profile-progress {
  position: relative;
  z-index: 2;
  margin-top: 13rpx;
}

.hero-progress-head {
  color: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
  font-weight: 700;
}

.hero-progress-head text:last-child {
  color: #f7f7f5;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.hero-progress-track {
  overflow: hidden;
  height: 7rpx;
  margin-top: 6rpx;
  background: #414145;
}

.hero-progress-value {
  max-width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #c82018, #d55b1f);
}

.card {
  position: relative;
  border: 1rpx solid #4b4b4f;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #202023, #151517);
  color: #f7f7f5;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.26);
}

.card .muted {
  color: #929296;
}

.auth-card {
  border-color: #7a4329;
}

.panel-index {
  margin-bottom: 10rpx;
  color: #d55b1f;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.guidance-card {
  margin-top: 18rpx;
  border-color: #d55b1f;
}

.guidance-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.guidance-actions button {
  flex: 1;
  margin: 0;
}

.section-label {
  margin: 24rpx 4rpx 9rpx;
  color: #96969a;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.section-label text {
  margin-right: 12rpx;
  color: #d55b1f;
}

.profile-card,
.profile-loading,
.profile-error,
.empty-profile {
  margin-top: 8rpx;
}

.profile-card {
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.profile-card-copy {
  min-width: 0;
  flex: 1;
}

.profile-card .title {
  margin-bottom: 5rpx;
}

.profile-refreshing,
.profile-refresh-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin: 8rpx 0 10rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #5a5a5e;
  border-radius: 6rpx;
  background: #18181a;
  color: #bdbdc0;
  font-size: 21rpx;
}

.profile-refresh-error {
  border-color: #8d4930;
  color: #f0b59e;
}

.profile-refresh-error button,
.edit-button {
  min-width: 104rpx;
  min-height: 88rpx;
  margin: 0 0 0 18rpx;
  padding: 0 16rpx;
  border: 1rpx solid #737377;
  border-radius: 4rpx;
  background: transparent;
  color: #f7f7f5;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.profile-refresh-error button {
  border-color: #a85a39;
}

.menu-list {
  overflow: hidden;
  border: 1rpx solid #46464a;
  border-radius: 8rpx;
  background: #18181a;
}

.menu-card {
  display: flex;
  align-items: center;
  gap: 17rpx;
  min-height: 96rpx;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #3a3a3e;
  background: #18181a;
}

.menu-card:last-child {
  border-bottom: 0;
}

.menu-card:active {
  background: #242427;
}

.menu-icon {
  display: flex;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid #77777b;
  border-radius: 5rpx;
  background: #29292c;
  color: #d55b1f;
  font-size: 25rpx;
  font-style: italic;
  font-weight: 900;
}

.capability-entry {
  background: linear-gradient(110deg, #242427, #18181a);
}

.capability-entry .menu-icon {
  border-color: #d55b1f;
  background: #d55b1f;
  color: #0b0b0c;
}

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-title,
.menu-card .muted {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-title {
  color: #f7f7f5;
  font-weight: 850;
}

.menu-card .muted {
  color: #858589;
  font-size: 20rpx;
}

.chevron {
  color: #d55b1f;
  font-size: 38rpx;
}

.btn,
.secondary {
  border-radius: 4rpx !important;
}

.btn {
  background: #a94416 !important;
}

.secondary {
  border-color: #6b6b6f;
  background: transparent !important;
  color: #f7f7f5 !important;
}

@media (max-width: 350px) {
  .profile-hero {
    padding-right: 12rpx;
    padding-left: 12rpx;
  }

  .profile-name {
    font-size: 32rpx;
  }

  .hero-capability-value {
    font-size: 25rpx;
  }

  .hero-capability-status {
    max-width: 48%;
  }
}
