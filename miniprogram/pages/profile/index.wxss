.profile-page {
  background: var(--color-bg);
}
.rider-card {
  overflow: hidden;
  padding: 0;
  border: 0;
  border-radius: var(--radius-sm);
}
.profile-hero {
  position: relative;
  min-height: 680rpx;
  overflow: hidden;
  background: var(--color-media-card-bg);
}
.hero-swiper,
.hero-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hero-alpine {
  position: absolute;
  inset: 0;
  background: var(--color-media-card-bg);
}
.hero-ridge {
  position: absolute;
  right: -12%;
  bottom: -28%;
  width: 90%;
  height: 64%;
  border-radius: 50% 50% 0 0;
  background: var(--color-muted);
  opacity: 0.28;
  transform: rotate(-8deg);
}
.hero-ridge-near {
  right: -35%;
  bottom: -38%;
  width: 120%;
  height: 72%;
  background: var(--color-text);
  opacity: 0.8;
}
.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.32) 40%,
    rgba(0, 0, 0, 0.96) 100%
  );
  pointer-events: none;
}
.hero-identity {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  left: 32rpx;
  display: flex;
  align-items: flex-end;
  gap: 32rpx;
  color: var(--color-on-media);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}
.profile-name {
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 600;
  overflow-wrap: break-word;
}
.profile-copy {
  flex: 1;
  min-width: 0;
}
.profile-title,
.auth-line {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.auth-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--color-media-muted);
}
.auth-dot.verified {
  background: var(--color-status-success);
}
.club-membership-card {
  position: relative;
  box-sizing: border-box;
  display: block;
  width: 100%;
  margin-top: var(--space-6);
  padding: 32rpx 0;
  border: 0;
  border-bottom: 2rpx solid var(--color-border-strong);
  border-radius: 0;
  background: var(--color-bg);
  color: var(--color-text);
  text-align: left;
}
.club-membership-chevron {
  position: absolute;
  top: 50%;
  right: 28rpx;
  flex: 0 0 auto;
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 900;
  transform: translateY(-50%);
}
.club-membership-empty,
.club-membership-single {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.club-membership-avatar {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid var(--color-surface);
  border-radius: 50%;
}
.club-membership-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 24rpx;
  font-weight: 900;
}
.club-membership-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}
.club-membership-name {
  overflow: hidden;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.club-membership-role {
  color: var(--color-muted);
  font-size: 24rpx;
}
.hero-profile-progress {
  margin-top: var(--card-gap);
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.hero-progress-head {
  display: flex;
  justify-content: space-between;
  font-weight: 800;
}
.hero-progress-track {
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: var(--color-raised);
}
.hero-progress-value {
  height: 100%;
  border-radius: 6rpx;
  background: var(--color-brand);
}
.hero-progress-missing {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.profile-progress-action {
  width: 100%;
  min-height: var(--control-height);
  margin-top: 24rpx;
  border: 2rpx solid var(--color-action);
  border-radius: var(--radius-sm);
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 28rpx;
  font-weight: 800;
}
.identity-guide {
  margin-top: var(--card-gap);
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
}
.identity-guide-title {
  font-size: 36rpx;
  font-weight: 900;
}
.identity-guide-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
}
.identity-guide-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}
.menu-list {
  overflow: hidden;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: var(--color-bg);
}
.menu-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 144rpx;
  border-bottom: 2rpx solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text);
  text-align: left;
}
.menu-card:last-child {
  border-bottom: 0;
}
.menu-card--hover {
  background: var(--color-raised);
}
.menu-icon {
  position: relative;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
}
.menu-icon::before,
.menu-icon::after,
.menu-icon view {
  position: absolute;
  border: 2rpx solid var(--color-border-strong);
  content: '';
}
.i-profile::before {
  top: 10rpx;
  left: 20rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}
.i-profile::after {
  right: 10rpx;
  bottom: 8rpx;
  left: 10rpx;
  height: 20rpx;
  border-radius: 20rpx 20rpx 0 0;
}
.i-card::before {
  inset: 12rpx 10rpx;
}
.i-card::after {
  top: 20rpx;
  left: 18rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}
.i-admin::before {
  inset: 14rpx 10rpx 10rpx;
}
.i-admin::after {
  top: 8rpx;
  left: 22rpx;
  width: 14rpx;
  height: 12rpx;
}
.i-settings::before {
  inset: 14rpx;
  border-radius: 50%;
}
.i-settings::after {
  inset: 24rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.menu-copy {
  flex: 1;
  min-width: 0;
}
.menu-title {
  font-size: 28rpx;
  line-height: 44rpx;
}
.chevron {
  color: var(--color-muted);
  font-size: 36rpx;
}
.privacy-note {
  margin-top: 16rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.privacy-note-title {
  margin-bottom: 8rpx;
  color: var(--color-text);
  font-weight: 800;
}
.profile-page .btn {
  border-color: var(--color-action);
  border-radius: 999rpx !important;
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
.profile-page .secondary {
  border-color: var(--color-border);
  border-radius: 999rpx !important;
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
.profile-loading,
.profile-error,
.empty-profile {
  text-align: left;
}
.profile-error .secondary,
.empty-profile .btn {
  width: 100%;
  margin-top: 24rpx;
}
@media (max-width: 340px) {
  .identity-guide-actions {
    grid-template-columns: 1fr;
  }
}
