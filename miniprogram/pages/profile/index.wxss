.profile-page {
  min-height: 100vh;
  padding-top: 0;
  padding-left: 0;
  padding-right: 0;
  background: var(--color-bg);
  color: var(--color-text);
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
}
.a11y-live-region {
  position: absolute;
  left: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
}
.profile-hero {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--color-media-card-bg);
}
.profile-background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.profile-background-image {
  width: 100%;
  height: 100%;
}
.profile-background-swiper {
  display: block;
}
.hero-alpine {
  background: linear-gradient(170deg, var(--color-text) 0%, var(--color-media-card-bg) 100%);
}
.profile-background-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(12, 10, 7, 0.1) 0%,
    rgba(12, 10, 7, 0.05) 42%,
    rgba(12, 10, 7, 0.96) 100%
  );
}
.profile-label {
  position: absolute;
  top: 48rpx;
  left: 48rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-xs);
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 0;
}
.profile-identity {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 56rpx;
  display: flex;
  align-items: flex-end;
  gap: 32rpx;
  color: var(--color-on-media);
}
.avatar-trigger {
  flex: none;
  display: inline-flex;
  width: 152rpx;
  height: 152rpx;
  padding: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: transparent;
  box-shadow: none;
  overflow: hidden;
}
.avatar-trigger .avatar {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
}
.profile-identity-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-bottom: 8rpx;
}
.profile-identity-copy .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.profile-identity-copy .eyebrow::before {
  width: 32rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.profile-name {
  font-family: var(--font-family-editorial);
  font-size: 72rpx;
  line-height: 80rpx;
  font-weight: 600;
  letter-spacing: -2rpx;
  color: var(--color-on-media);
}
.profile-gender {
  font-size: 28rpx;
  line-height: 40rpx;
  color: rgba(255, 255, 255, 0.86);
}
.refresh-note {
  margin: 0 32rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.refresh-note.refresh-error {
  background: var(--color-status-warning-soft);
  color: var(--color-status-warning);
}
.content {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 48rpx var(--page-gutter) 0;
}
.profile-status {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  margin-bottom: 32rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  align-self: flex-start;
  max-width: 100%;
}
.profile-status--warn {
  border-color: var(--color-status-warning);
  color: var(--color-status-warning);
  background: var(--color-status-warning-soft);
  flex-wrap: wrap;
  row-gap: 12rpx;
}
.profile-status--loading {
  color: var(--color-muted);
}
.profile-status-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}
.profile-status-icon--check {
  background: var(--color-status-success);
}
.profile-status-icon--pending {
  background: var(--color-muted);
}
.profile-status-icon--warn {
  background: var(--color-status-warning);
}
.profile-status-action {
  margin: 0;
  padding: 8rpx 20rpx;
  min-height: 56rpx;
  border: 2rpx solid currentColor;
  border-radius: 999rpx;
  background: transparent;
  color: inherit;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
}
.profile-status-action::after {
  display: none;
}
.profile-progress {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}
.profile-progress-head {
  display: flex;
  justify-content: space-between;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.profile-progress-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--color-raised);
  overflow: hidden;
}
.profile-progress-value {
  height: 100%;
  background: var(--color-text);
}
.profile-progress-missing {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.profile-progress-action {
  margin: 4rpx 0 0;
  padding: 12rpx 24rpx;
  min-height: 72rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
  align-self: flex-start;
}
.profile-progress-action::after {
  display: none;
}
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.section-admin {
  gap: 0;
  margin-top: 64rpx;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.chapterhead-title {
  flex: none;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-aside {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 22rpx;
  line-height: 32rpx;
  letter-spacing: 1rpx;
}
.row.rowlink.rowbutton {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 120rpx;
  margin: 0;
  padding: 24rpx 0;
  border: 0;
  border-bottom: 2rpx solid var(--color-border);
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  text-align: left;
  transition: background var(--motion-duration-fast) var(--motion-easing-standard);
}
.row.rowlink.rowbutton::after {
  display: none;
}
.row.rowlink.rowbutton:active:not([disabled]) {
  background: var(--color-raised);
}
.row.rowlink.rowbutton[disabled] {
  opacity: 1;
  background: var(--color-raised) !important;
  color: var(--color-disabled-text) !important;
}
.lead {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 24rpx;
}
.rowicon {
  flex: none;
  position: relative;
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  overflow: hidden;
}
.rowicon.rowicon--avatar {
  padding: 0;
  background: transparent;
}
.rowicon-image {
  width: 100%;
  height: 100%;
}
.rowicon-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 900;
}
.rowtext {
  flex: 1;
  min-width: 0;
}
.rowtext-title {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 900;
  color: var(--color-text);
}
.rowtext-sub {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 34rpx;
}
.chev {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--color-text);
  border-right: 2rpx solid var(--color-text);
  transform: rotate(45deg);
}
.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 24rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.notice--info {
  border-style: solid;
  color: var(--color-text);
}
.card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  color: var(--color-text);
}
.card-title {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 900;
}
.card-copy {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 38rpx;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn--secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.profile-footer {
  margin-top: 72rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
@media (max-width: 350px) {
  .content {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .profile-identity {
    left: 32rpx;
    right: 32rpx;
    bottom: 32rpx;
  }
  .profile-label {
    left: 32rpx;
    top: 32rpx;
  }
  .profile-name {
    font-size: 56rpx;
    line-height: 64rpx;
  }
  .row.rowlink.rowbutton {
    padding: 20rpx;
  }
}
