<view class="page profile-page">
  <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{loading ? '正在读取资料。正在同步最新资料' : (refreshing ? '正在更新资料' : (!error ? '资料已就绪' : ''))}}</view>
  <view class="a11y-live-region" role="alert" aria-live="assertive" aria-atomic="true">{{error}}</view>
  <view class="brand-bar"><view class="cili-mark"><text class="mark-cut"></text></view><view class="brand-word">CILI <text>此里</text></view><view class="profile-code">RIDER / 01</view></view>
  <view class="profile-hero {{hasProfileHeroBackground ? 'with-card-bg' : ''}}">
    <image wx:if="{{hasProfileHeroBackground}}" class="hero-bg" src="{{profileHeroBackground}}" mode="aspectFill" aria-hidden="true" />
    <view class="hero-shade"></view>
    <view class="avatar">
      <image wx:if="{{hasProfileAvatar}}" src="{{profileAvatarUrl}}" mode="aspectFill" aria-hidden="true" />
      <text wx:else>{{profileInitial}}</text>
    </view>
    <view class="profile-copy"><view class="hero-kicker">RIDER PROFILE</view><view class="profile-name">{{profile ? profile.nickname : '欢迎来到此里'}}</view><view class="auth-line"><text class="auth-dot {{authStatus === 'authenticated' ? 'verified' : ''}}"></text>{{authStatus === 'authenticated' ? '微信身份已验证' : '请先完成微信云身份验证'}}</view><view class="card-sync-line" wx:if="{{profileCardStatus}}">名片背景 · STRAVA {{profileCardStatus}}</view></view>
  </view>
  <view class="card auth-card" wx:if="{{authStatus !== 'authenticated'}}"><view class="panel-index">IDENTITY CHECK</view><view class="title">身份引导</view><view class="muted">{{authError || '正在连接身份服务'}}</view><button class="secondary" bindtap="retryAuth">重试身份验证</button></view>
  <view class="section-label"><text>01</text> 我的资料</view>
  <view class="profile-refreshing" wx:if="{{profile && refreshing}}" aria-hidden="true">正在更新资料…</view>
  <view class="profile-refresh-error" wx:if="{{profile && error}}"><text aria-hidden="true">{{error}}</text><button bindtap="retryProfile">重试</button></view>
  <view class="card profile-loading" wx:if="{{loading}}" aria-hidden="true"><view class="panel-index">PROFILE LOADING</view><view class="title">正在读取资料</view><view class="muted">正在同步最新资料。</view></view>
  <view class="card profile-card" wx:elif="{{profile}}"><view class="panel-index">PROFILE COMPLETION</view><view class="row"><view><view class="title">常用资料</view><view class="muted">报名资料仅自己与授权审核员可见</view></view><button class="edit-button" bindtap="edit">编辑</button></view><view class="progress-head"><text>资料完整度</text><text class="progress-number">{{profile.completeness}}%</text></view><view class="progress"><view class="progress-value" style="width: {{profile.completeness}}%"></view></view><view class="corner-cut"></view></view>
  <view class="card profile-error" wx:elif="{{error}}"><view aria-hidden="true"><view class="panel-index">PROFILE ERROR</view><view class="title">资料暂时无法加载</view><view class="muted">{{error}}</view></view><button class="secondary" bindtap="retryProfile">重试加载</button></view>
  <view class="card empty-profile" wx:else><view class="title">资料尚未配置</view><view class="muted">请创建资料后再报名。</view><button class="btn" bindtap="edit">去完善</button></view>
  <view class="section-label"><text>02</text> 骑行服务</view>
  <view class="menu-card capability-entry" bindtap="capabilityCard"><view class="menu-icon capability-icon">C</view><view class="menu-copy"><view class="menu-title">我的骑行名片</view><view class="muted">查看仅自己可见的近 90 天骑行能力</view></view><text class="chevron">›</text></view>
  <view class="menu-card" bindtap="strava"><view class="menu-icon">S</view><view class="menu-copy"><view class="menu-title">Strava 数据</view><view class="muted">查看真实绑定与近 90 天快照</view></view><text class="chevron">›</text></view>
  <view class="menu-card" wx:if="{{authStatus === 'authenticated'}}" bindtap="activities"><view class="menu-icon">M</view><view class="menu-copy"><view class="menu-title">我的活动</view><view class="muted">创建草稿、编辑并发布自己的骑行活动</view></view><text class="chevron">›</text></view>
  <view class="menu-card" wx:if="{{isAdmin}}" bindtap="admin"><view class="menu-icon admin-icon">A</view><view class="menu-copy"><view class="menu-title">报名审批</view><view class="muted">审核活动报名与骑手资料</view></view><text class="chevron">›</text></view>
</view>
