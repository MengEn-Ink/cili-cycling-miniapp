<view class="page profile-page" bindtouchstart="refreshTouchStart" bindtouchmove="refreshTouchMove" bindtouchend="refreshTouchEnd" bindtouchcancel="refreshTouchEnd">
  <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{loading ? '正在同步个人资料' : (refreshTitle || (!error ? '个人资料已就绪' : ''))}}</view>
  <view class="a11y-live-region" role="alert" aria-live="assertive" aria-atomic="true">{{error}}</view>
  <brand-logo compact="{{true}}" meta="一起骑，去更远的地方" />

  <view class="profile-refresh-feedback refresh-{{refreshStage}}" wx:if="{{refreshStage !== 'idle'}}" style="--refresh-progress: {{refreshPullProgress}}" aria-hidden="true">
    <view class="refresh-feedback-icon">
      <text wx:if="{{refreshStage === 'success'}}">✓</text>
      <text wx:elif="{{refreshStage === 'error'}}">!</text>
      <view wx:elif="{{refreshStage === 'refreshing'}}" class="refresh-feedback-spinner"></view>
      <text wx:else class="refresh-feedback-arrow">↓</text>
    </view>
    <view class="refresh-feedback-copy">
      <view class="refresh-feedback-title">{{refreshTitle}}</view>
      <view class="refresh-feedback-detail">{{refreshDetail}}</view>
    </view>
  </view>

  <view class="rider-card">
    <view class="profile-hero has-bg">
      <swiper wx:if="{{heroBackgrounds.length}}" class="hero-swiper" circular="{{heroBackgrounds.length > 1}}" indicator-dots="{{heroBackgrounds.length > 1}}" bindchange="heroSwiperChange">
        <swiper-item wx:for="{{heroBackgrounds}}" wx:key="url">
          <image class="hero-bg-image" src="{{item.url}}" mode="aspectFill" aria-label="查看完整背景照片" data-url="{{item.url}}" data-index="{{index}}" bindtap="previewHeroImage" binderror="heroBackgroundError" />
        </swiper-item>
      </swiper>
      <image wx:elif="{{heroBackgroundAvatarUrl}}" class="hero-bg-image hero-fallback-image" src="{{heroBackgroundAvatarUrl}}" mode="aspectFill" aria-hidden="true" data-url="{{heroBackgroundAvatarUrl}}" binderror="heroAvatarBackgroundError" />
      <image wx:elif="{{heroFallbackImageUrl}}" class="hero-bg-image hero-fallback-image packaged-alpine-image" src="{{heroFallbackImageUrl}}" mode="aspectFill" aria-hidden="true" data-url="{{heroFallbackImageUrl}}" binderror="heroFallbackBackgroundError" />
      <view wx:else class="hero-alpine" aria-hidden="true"><view class="hero-ridge hero-ridge-far"></view><view class="hero-ridge hero-ridge-near"></view></view>
      <view class="hero-shade" aria-hidden="true"></view>
      <view class="hero-identity">
        <view class="avatar">
          <image wx:if="{{heroAvatarUrl}}" class="avatar-image" src="{{heroAvatarUrl}}" mode="aspectFill" data-url="{{heroAvatarUrl}}" bindtap="previewAvatar" binderror="heroAvatarError" aria-label="{{profile && profile.nickname ? profile.nickname : (heroCard ? heroCard.displayName : '骑手')}}的头像" />
          <text wx:else aria-label="默认骑手头像">骑</text>
        </view>
        <view class="profile-copy">
          <view class="profile-name">{{profile && profile.nickname ? profile.nickname : (heroCard ? heroCard.displayName : '欢迎来到此里')}}</view>
          <view class="profile-title" wx:if="{{profile && profile.title}}">{{profile.title}}</view>
          <view class="auth-line"><text class="auth-dot {{authStatus === 'authenticated' ? 'verified' : ''}}"></text>{{authStatus === 'authenticated' ? '微信身份已验证' : ((authStatus === 'loading' || authStatus === 'idle') ? '微信身份同步中' : '微信身份待验证')}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="hero-profile-progress" wx:if="{{profile && profile.completeness < 100}}">
    <view class="hero-progress-head"><text>资料完整度</text><text>{{profile.completeness}}%</text></view>
    <view class="hero-progress-track"><view class="hero-progress-value" style="width: {{profile.completeness}}%"></view></view>
  </view>

  <view class="identity-guide" wx:if="{{authStatus === 'unavailable' || authStatus === 'error'}}">
    <view class="identity-guide-title">让骑友认出你</view>
    <view class="identity-guide-copy">请先设置常用昵称和非默认头像，再完成微信身份验证。</view>
    <view class="identity-guide-copy" wx:if="{{authError || identityHintText}}">{{authError || identityHintText}}</view>
    <view class="identity-guide-actions"><button class="secondary" bindtap="edit">完善昵称与头像</button><button class="btn" bindtap="retryAuth">验证微信身份</button></view>
  </view>

  <view class="profile-refresh-error" wx:if="{{!profile && error}}"><text aria-hidden="true">{{error}}</text><button bindtap="retryProfile">重试</button></view>
  <view class="card profile-loading" wx:if="{{loading}}" aria-hidden="true"><view class="menu-title">正在读取资料</view><view class="muted">正在同步最新资料。</view></view>
  <view class="card profile-error" wx:elif="{{error}}"><view aria-hidden="true"><view class="menu-title">资料暂时无法加载</view><view class="muted">{{error}}</view></view><button class="secondary" bindtap="retryProfile">重试加载</button></view>
  <view class="card empty-profile" wx:elif="{{!profile}}"><view class="menu-title">资料尚未配置</view><view class="muted">完善资料后可快速报名。</view><button class="btn" bindtap="edit">去完善</button></view>

  <view class="section-label">常用服务</view>
  <view class="menu-list">
    <view class="menu-card" wx:if="{{isAdmin}}" bindtap="activities"><view class="menu-icon">管</view><view class="menu-copy"><view class="menu-title">活动管理</view><view class="muted">创建、编辑与发布活动</view></view><text class="chevron">›</text></view>
    <view class="menu-card" bindtap="edit"><view class="menu-icon">资</view><view class="menu-copy"><view class="menu-title">报名资料</view><view class="muted">编辑微信昵称、头像、性别与紧急联系人</view></view><text class="chevron">›</text></view>
    <view class="privacy-note"><view class="privacy-note-title">隐私说明</view><view>联系电话仅用于活动联络；紧急联系人仅在骑行安全需要时使用。资料仅你本人和报名审核员可见。</view></view>
    <view class="menu-card" bindtap="openSettings" role="button" aria-label="打开设置"><view class="menu-icon">设</view><view class="menu-copy"><view class="menu-title">设置</view><view class="muted">查看应用设置与功能升级记录</view></view><text class="chevron" aria-hidden="true">›</text></view>
  </view>
</view>
