<view class="page"><view class="hero"><view>RIDER PROFILE</view><view class="hero-title">{{profile ? profile.nickname : '欢迎来到此里'}}</view><view>{{authStatus === 'authenticated' ? '微信身份已验证' : '请先完成微信云身份验证'}}</view></view><view class="card" wx:if="{{authStatus !== 'authenticated'}}"><view class="title">身份引导</view><view>{{authError || '正在连接身份服务'}}</view><button bindtap="retryAuth">重试身份验证</button></view><view class="card" wx:if="{{profile}}"><view class="row"><view><view class="title">常用资料 · 完整度 {{profile.completeness}}%</view><view>{{profile.realName || '未填写实名'}} · {{profile.phone || '未授权手机号'}}</view></view><button size="mini" bindtap="edit">编辑</button></view></view><view class="card" wx:elif="{{!loading}}"><view class="title">资料尚未配置</view><view class="muted">{{error || '请创建资料后再报名。'}}</view><button bindtap="edit">去完善</button></view><view class="card" bindtap="strava"><view class="row"><view><view class="title">Strava</view><view class="muted">查看真实绑定与近 90 天快照</view></view><text>›</text></view></view><view class="card" wx:if="{{isAdmin}}" bindtap="admin"><view class="row"><view class="title">管理员控制台</view><text>›</text></view></view></view>
