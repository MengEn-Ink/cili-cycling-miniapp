page {
  background: #0b0b0c;
}

.credential-page {
  min-height: 100vh;
  padding-top: 20rpx;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #0b0b0c;
  color: #f7f7f5;
}

.status-hero {
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid #343438;
  border-radius: 14rpx;
  background: linear-gradient(145deg, #242427, #111113);
  color: #f7f7f5;
}

.status-pending {
  background: linear-gradient(145deg, #2a2417, #16120e);
}

.status-approved {
  border-color: #557363;
  background: linear-gradient(145deg, #203128, #111713);
}

.status-checked_in {
  border-color: #557363;
  background: linear-gradient(145deg, #203128, #111713);
}

.status-rejected,
.status-cancelled {
  background: linear-gradient(145deg, #2a1817, #160f0e);
}

.hero-top,
.credential-top,
.credential-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
}

.credential-page .hero-kicker {
  min-width: 0;
  color: var(--color-brand);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  overflow-wrap: anywhere;
}

.status-label {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  min-height: 42rpx;
  padding: 3rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  font-weight: 800;
}

.credential-page .hero-title {
  display: -webkit-box;
  margin: 12rpx 0 5rpx;
  overflow: hidden;
  color: #f7f7f5;
  font-size: 38rpx;
  line-height: 1.25;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.credential-page .hero-subtitle {
  color: #c8c8cc;
  font-size: 23rpx;
}

.credential-card {
  margin-top: 14rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid #557363;
  border-radius: 14rpx;
  background: #1b1b1d;
  color: #f7f7f5;
}

.credential-caption,
.credential-key,
.meet-label {
  color: #a8a8ad;
  font-size: 21rpx;
}

.credential-caption {
  letter-spacing: 3rpx;
}

.serial {
  margin-top: 5rpx;
  color: var(--color-brand);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.approved-mark {
  flex: 0 0 auto;
  color: #9bc2aa;
  font-size: 28rpx;
  font-weight: 900;
}

.credential-row {
  align-items: flex-start;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #343438;
}

.credential-value {
  min-width: 0;
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}

.meet-info {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #151517;
  color: #f7f7f5;
}

.meet-value {
  margin-top: 4rpx;
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.credential-note {
  margin-top: 12rpx;
  color: #a8a8ad;
  font-size: 20rpx;
  line-height: 1.45;
}

.credential-page .card {
  border: 1rpx solid #343438;
  background: #242427;
  color: #f7f7f5;
}

.timeline-card {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
}

.credential-page .timeline-card .title {
  margin-bottom: 6rpx;
  color: #f7f7f5;
  font-size: 28rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 22rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 11rpx 0;
}

.timeline-copy {
  min-width: 0;
  overflow-wrap: anywhere;
}

.timeline-mark {
  width: 16rpx;
  height: 16rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: #6f9b82;
}

.timeline-mark.current {
  background: var(--color-brand);
  box-shadow: 0 0 0 7rpx rgba(213, 91, 31, 0.2);
}

.timeline-status {
  color: #e9a071;
  font-weight: 900;
}

.credential-page .muted {
  color: #a8a8ad;
  font-size: 21rpx;
}

.review-comment {
  margin-top: 8rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #151517;
  color: #a8a8ad;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.action-stack {
  margin-top: 14rpx;
}

.action-stack button {
  width: 100%;
  margin-top: 12rpx;
}

.credential-page .btn {
  border: 0;
  background: var(--color-brand-active);
  color: #f7f7f5;
  font-weight: 900;
}

.credential-page .secondary {
  border: 2rpx solid #3a3a3e;
  background: #151517;
  color: #f7f7f5;
}

.history-note {
  margin-top: 0;
  color: #a8a8ad;
  font-size: 23rpx;
  line-height: 1.5;
}

.error-card {
  padding: 20rpx;
  border-radius: 10rpx;
  background: rgba(200, 32, 24, 0.12);
  color: #ff8f86;
  overflow-wrap: anywhere;
}

@media (max-width: 340px) {
  .credential-page .hero-title {
    font-size: 34rpx;
  }

  .credential-top {
    align-items: flex-start;
    flex-direction: column;
  }

  .credential-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 4rpx;
  }

  .credential-value {
    text-align: left;
  }
}

/* Design reference alignment. */
.page.credential-page {
  padding-right: 40rpx;
  padding-left: 40rpx;
  background: #000;
}

.status-hero,
.credential-card {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.credential-page .card {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.status-label,
.meet-info,
.review-comment {
  border-radius: 16rpx;
  background: #2c2c2e;
}

.review-comment {
  color: #a8a8ad;
}

.serial,
.credential-page .hero-kicker {
  color: var(--color-brand);
}

.timeline-mark.current {
  background: var(--color-brand);
}

.action-stack button {
  min-height: 104rpx;
  border-radius: 24rpx !important;
}

.credential-page .btn {
  background: var(--color-brand);
}

@media (max-width: 320px) {
  .page.credential-page {
    padding-right: 32rpx;
    padding-left: 32rpx;
  }
}

.status-hero {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.credential-card {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.credential-page .card {
  border-color: #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.meet-info {
  border-radius: 16rpx;
  background: #2c2c2e;
}

.serial {
  color: var(--color-brand);
}

/* Keep the shared dark surface while preserving each registration state. */
.status-pending {
  border-color: #d59a3a;
  background: linear-gradient(180deg, rgba(213, 154, 58, 0.12), #1c1c1e 34%);
  box-shadow: inset 0 8rpx 0 #d59a3a;
}

.status-approved {
  border-color: #6f9b82;
  background: linear-gradient(180deg, rgba(111, 155, 130, 0.12), #1c1c1e 34%);
  box-shadow: inset 0 8rpx 0 #6f9b82;
}

.status-checked_in {
  border-color: #6f9b82;
  background: linear-gradient(180deg, rgba(111, 155, 130, 0.12), #1c1c1e 34%);
  box-shadow: inset 0 8rpx 0 #6f9b82;
}

.status-rejected {
  border-color: #d65c57;
  background: linear-gradient(180deg, rgba(214, 92, 87, 0.12), #1c1c1e 34%);
  box-shadow: inset 0 8rpx 0 #d65c57;
}

.status-cancelled {
  border-color: #74747a;
  background: linear-gradient(180deg, rgba(116, 116, 122, 0.12), #1c1c1e 34%);
  box-shadow: inset 0 8rpx 0 #74747a;
}

.meet-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #2c2c2e;
}
.meet-location > view {
  min-width: 0;
  overflow-wrap: anywhere;
}
.meet-location button {
  flex: 0 0 auto;
  margin: 0;
  border: 1rpx solid var(--color-brand);
  border-radius: 24rpx;
  background: #1c1c1e;
  color: var(--color-brand);
}

page,
.page.credential-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.status-hero,
.credential-card,
.credential-page .card {
  border-color: var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
}
.meet-info,
.review-comment,
.meet-location {
  border-radius: var(--radius-md);
  background: var(--color-raised);
  color: var(--color-text);
}
.credential-row {
  border-color: var(--color-border);
}
.credential-caption,
.credential-key,
.meet-label,
.credential-note,
.credential-page .muted,
.review-comment,
.history-note {
  color: var(--color-muted);
}
.action-stack button,
.meet-location button {
  min-height: 88rpx;
  border-radius: var(--radius-display) !important;
}
.credential-page .btn {
  background: var(--color-brand);
  color: var(--color-on-brand);
}
.credential-page .secondary,
.meet-location button {
  border-color: var(--color-border);
  background: var(--color-input-bg);
  color: var(--color-text);
}

.status-label {
  border-color: var(--color-border);
  background: var(--color-raised);
  color: var(--color-text);
}
.status-pending {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
}
.status-approved,
.status-checked_in {
  border-color: var(--color-success);
  background: var(--color-success-soft);
}
.status-rejected {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
}
.status-cancelled {
  border-color: var(--color-border-strong);
  background: var(--color-raised);
}

.status-waiting {
  background: linear-gradient(145deg, #2a2417, #16120e);
}

.team-card {
  margin-top: 14rpx;
}
