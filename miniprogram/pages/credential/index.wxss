.credential-page {
  padding-top: 24rpx;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.status-hero {
  padding: 38rpx 34rpx;
  border-radius: 28rpx;
  background: #0b6b4f;
  color: #fff;
}

.status-pending {
  background: #9a6513;
}

.status-rejected,
.status-cancelled {
  background: #7f4545;
}

.status-label {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 700;
}

.credential-card {
  position: relative;
  margin-top: 20rpx;
  padding: 40rpx 28rpx 28rpx;
  border: 2rpx solid #d8e7df;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
}

.credential-caption {
  color: #718078;
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.serial {
  margin: 20rpx 0 8rpx;
  color: #0b6b4f;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  word-break: break-all;
}

.rider {
  font-size: 30rpx;
  font-weight: 700;
}

.meet-info {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #eef5f1;
}

.credential-note {
  margin-top: 18rpx;
  color: #718078;
  font-size: 21rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 24rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 14rpx 0 24rpx;
}

.timeline-mark {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #18a058;
}

.timeline-mark.current {
  background: #ff6b35;
  box-shadow: 0 0 0 8rpx #fff0ea;
}

.review-comment {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f7f2;
  color: #718078;
}

.error-card {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fceded;
  color: #d94b4b;
}

/* ===== CILI 暗色竞技主题：页面级接入，保持全局浅色基线不变 ===== */
.credential-page {
  min-height: 100vh;
  background: #0b0b0c;
  color: #f7f7f5;
}
.status-hero {
  border: 1rpx solid #343438;
  background: linear-gradient(145deg, #242427, #111113);
  color: #f7f7f5;
}
.status-pending {
  background: linear-gradient(145deg, #2a2417, #16120e);
}
.status-rejected,
.status-cancelled {
  background: linear-gradient(145deg, #2a1817, #160f0e);
}
.credential-card {
  border-color: #343438;
  background: #1b1b1d;
  color: #f7f7f5;
}
.credential-caption {
  color: #8b8b91;
}
.serial {
  color: #d55b1f;
}
.meet-info {
  background: #151517;
  color: #f7f7f5;
}
.credential-note {
  color: #8b8b91;
}
.timeline-mark.current {
  background: #d55b1f;
  box-shadow: 0 0 0 8rpx rgba(213, 91, 31, 0.22);
}
.review-comment {
  background: #151517;
  color: #a8a8ad;
}
.credential-page .card {
  border: 1rpx solid #343438;
  background: #242427;
  color: #f7f7f5;
}
.credential-page .title {
  color: #f7f7f5;
}
.credential-page .muted {
  color: #a8a8ad;
}
.credential-page .secondary {
  border: 2rpx solid #3a3a3e;
  background: #151517;
  color: #f7f7f5;
}
.error-card {
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
}
