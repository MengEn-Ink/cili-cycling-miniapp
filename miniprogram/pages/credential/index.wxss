.credential-page {
  background: var(--color-bg);
}
.compact-rider-card {
  overflow: hidden;
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.compact-rider-media {
  position: relative;
  height: 336rpx;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.visual-swiper,
.visual-photo {
  width: 100%;
  height: 100%;
}
.visual-overlay {
  position: absolute;
  inset: 0;
  background: var(--color-overlay);
  opacity: 0.35;
}
.real-media-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 100%;
  color: var(--color-media-muted);
}
.brand-word {
  color: var(--color-on-media);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.compact-rider-identity {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.compact-rider-avatar {
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border: 4rpx solid var(--color-on-media);
  border-radius: 50%;
}
.avatar-missing {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 36rpx;
  font-weight: 900;
}
.rider-copy {
  display: flex;
  flex-direction: column;
}
.rider-name {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.rider-meta {
  color: var(--color-media-muted);
  font-size: 24rpx;
}
.compact-rider-body {
  padding: 24rpx 32rpx;
}
.compact-rider-body__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.compact-rider-event {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}
.compact-rider-empty {
  color: var(--color-muted);
  font-size: 24rpx;
}
.status-journey {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  gap: 20rpx;
  margin-top: var(--card-gap);
  padding: 24rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.status-journey__marker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 900;
}
.status-journey--success .status-journey__marker {
  background: var(--color-status-success-soft);
  color: var(--color-status-success);
}
.status-journey--warning .status-journey__marker {
  background: var(--color-status-warning-soft);
  color: var(--color-status-warning);
}
.status-journey__copy {
  min-width: 0;
}
.status-journey__title {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 900;
}
.status-journey__hint {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.credential-card {
  overflow: hidden;
  margin-top: var(--card-gap);
  padding: 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
}
.credential-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
}
.ticket-brand {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.ticket-brand__name {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.credential-caption,
.serial,
.credential-date {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.serial {
  font-family: monospace;
  font-variant-numeric: tabular-nums;
  text-align: right;
  white-space: nowrap;
}
.credential-summary {
  padding: 24rpx 32rpx 0;
}
.credential-title {
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}
.credential-date {
  margin-top: 4rpx;
}
.meeting-spotlight {
  margin: 24rpx 32rpx;
}
.meeting-time {
  font-size: 48rpx;
  line-height: 64rpx;
  font-variant-numeric: tabular-nums;
}
.meeting-divider {
  height: 2rpx;
  margin: 16rpx 0;
  background: var(--color-muted);
}
.meeting-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.meeting-location-copy {
  min-width: 0;
}
.meeting-location-title {
  color: var(--color-on-media);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}
.meeting-address {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
}
.meeting-navigation,
.meeting-location button {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.meeting-driver {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.meeting-driver-name {
  color: var(--color-on-media);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.meeting-driver-phone {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.credential-details {
  padding: 0 32rpx 16rpx;
}
.public-card-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 0;
}
.public-card-heading .muted {
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: right;
}
.reject-card {
  margin-top: var(--card-gap);
}
.reject-reason {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 44rpx;
}
.team-card {
  margin-top: var(--card-gap);
}
.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: var(--card-gap);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.action-stack .secondary,
.action-stack .btn {
  width: 100%;
}
.history-note {
  color: var(--color-muted);
}
