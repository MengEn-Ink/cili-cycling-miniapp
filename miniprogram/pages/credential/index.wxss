/* 骑行影像志 · 出发凭证 1:1 实现
 * 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/credential.html：
 *   pageheading → content.tight(ticket voucher ink + ticketbody detailrows + notice × N) → credential-actions
 */

.credential-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

.pageheading {
  padding: 32rpx 0 24rpx;
}
.pageheading .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.pageheading .eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.pageheading-title {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-sub {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}
.content.tight {
  gap: 40rpx;
}

.ticket.voucher {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 2rpx solid var(--color-text);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-text);
}
.ticket.voucher.status-rejected,
.ticket.voucher.status-cancelled,
.ticket.voucher.status-waiting,
.ticket.voucher.status-pending {
  border-color: var(--color-border);
  box-shadow: none;
  background: var(--color-raised);
}

.ink {
  position: relative;
  padding: 36rpx 32rpx 32rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-bottom: 2rpx dashed var(--border-credential-divider);
}
.ticket.voucher.status-rejected .ink,
.ticket.voucher.status-cancelled .ink,
.ticket.voucher.status-waiting .ink,
.ticket.voucher.status-pending .ink {
  background: var(--color-surface);
  color: var(--color-text);
  border-bottom: 2rpx dashed var(--color-border);
}
.voucher-title {
  font-family: var(--font-family-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  opacity: 0.9;
}
.voucher-status.tag {
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface-credential-chip);
  color: var(--color-on-action);
  border: 2rpx solid var(--border-credential-chip);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.ticket.voucher.status-rejected .voucher-status,
.ticket.voucher.status-cancelled .voucher-status,
.ticket.voucher.status-waiting .voucher-status,
.ticket.voucher.status-pending .voucher-status {
  background: var(--color-raised);
  color: var(--color-text);
  border-color: var(--color-border);
}
.voucher-headline {
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 76rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}
.voucher-number {
  font-family: var(--font-family-mono);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
}

.ticketbody {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
  background: var(--color-surface);
}

/* --- person ------------------------------------------------------------- */
.person {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-bg);
}
.person .avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-raised);
  overflow: hidden;
  flex: none;
}
.person .avatar--placeholder {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 900;
}
.person-copy {
  flex: 1;
  min-width: 0;
}
.person-name {
  overflow: hidden;
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.person-meta {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.club-identity {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.club-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-raised);
  overflow: hidden;
  flex: none;
}
.club-avatar--placeholder {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 900;
}

/* --- detailrows --------------------------------------------------------- */
.detailrows {
  display: flex;
  flex-direction: column;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  overflow: hidden;
}
.detailrow {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
}
.detailrow + .detailrow {
  border-top: 2rpx dashed var(--color-border);
}
.detailrow-term {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.detailrow-desc {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
  word-break: normal;
}
.detailrow-desc--nowrap {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow-wrap: normal;
}
.detailrow-desc--split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.meeting-name {
  display: block;
  font-weight: 800;
}
.meeting-address {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

/* --- notice ------------------------------------------------------------- */
.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.notice-copy {
  flex: 1;
  min-width: 0;
}
.notice-title {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 36rpx;
}
.notice-item {
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.notice--info {
  border-style: solid;
}
.notice--warning {
  border-style: solid;
  border-color: var(--color-status-warning);
  color: var(--color-status-warning);
}
.notice--warning .notice-title,
.notice--warning .notice-item {
  color: var(--color-status-warning);
}

/* --- credential-actions ------------------------------------------------- */
.credential-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.credential-links {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.credential-links .btn {
  justify-content: space-between;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
  width: 100%;
  text-align: center;
}
.btn::after {
  display: none;
}
.btn[disabled] {
  opacity: 0.6;
}
.btn.secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.btn.ghost {
  background: transparent;
  color: var(--color-muted);
  border-color: var(--color-border);
}
.btn.tiny {
  width: auto;
  min-height: 56rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.share-note {
  text-align: center;
  color: var(--color-muted);
}
.small {
  font-size: 22rpx;
  line-height: 34rpx;
}
.muted {
  color: var(--color-muted);
}
.chev {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}

@media (max-width: 350px) {
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .voucher-headline {
    font-size: 48rpx;
    line-height: 60rpx;
  }
  .detailrow {
    grid-template-columns: 150rpx minmax(0, 1fr);
  }
}
