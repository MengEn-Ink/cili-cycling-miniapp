page,
.page.credential-page {
  background: var(--color-bg);
  color: var(--color-text);
}

.credential-page {
  min-height: 100vh;
  padding-top: 20rpx;
  padding-right: var(--page-gutter);
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  padding-left: var(--page-gutter);
  overflow-x: hidden;
}

.status-hero,
.credential-card,
.credential-page .card {
  padding: 24rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
}

.credential-card,
.credential-page .card {
  margin-top: 14rpx;
}

.status-pending {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
}

.status-approved,
.status-checked_in {
  border-color: var(--color-success);
  background: var(--color-success-soft);
}

.status-rejected {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
}

.status-cancelled {
  border-color: var(--color-border-strong);
  background: var(--color-raised);
}

.status-waiting {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
}

.hero-top,
.credential-top,
.credential-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
}

.credential-page .hero-kicker {
  min-width: 0;
  color: var(--color-muted);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  overflow-wrap: anywhere;
}

.status-label {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  min-height: 42rpx;
  padding: 3rpx 14rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 800;
}

.credential-page .hero-title {
  display: -webkit-box;
  margin: 12rpx 0 5rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 38rpx;
  line-height: 1.25;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.credential-page .hero-subtitle {
  color: var(--color-muted);
  font-size: 23rpx;
}

.credential-caption,
.credential-key,
.meet-label {
  color: var(--color-muted);
  font-size: 21rpx;
}

.credential-caption {
  letter-spacing: 3rpx;
}

.serial {
  margin-top: 5rpx;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.approved-mark {
  flex: 0 0 auto;
  color: var(--color-success-text);
  font-size: 28rpx;
  font-weight: 900;
}

.credential-row {
  align-items: flex-start;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--color-border);
}

.credential-value {
  min-width: 0;
  color: var(--color-text);
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}

.meet-info,
.review-comment,
.meet-location {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-raised);
  color: var(--color-text);
}

.meet-value {
  margin-top: 4rpx;
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.credential-note,
.credential-page .muted,
.history-note {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.timeline-card {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
}

.credential-page .timeline-card .title {
  margin-bottom: 6rpx;
  color: var(--color-text);
  font-size: 28rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 22rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 11rpx 0;
}

.timeline-copy {
  min-width: 0;
  color: var(--color-text);
  overflow-wrap: anywhere;
}

.timeline-mark {
  width: 16rpx;
  height: 16rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: var(--color-muted);
}

.timeline-mark.current {
  background: var(--color-brand);
  box-shadow: 0 0 0 7rpx rgba(217, 255, 67, 0.3);
}

.timeline-status {
  color: var(--color-text);
  font-weight: 900;
}

.review-comment {
  margin-top: 8rpx;
  padding: 12rpx;
  color: var(--color-muted);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.action-stack {
  margin-top: 14rpx;
}

.action-stack button,
.meet-location button {
  width: 100%;
  min-height: var(--control-height);
  margin-top: 12rpx;
  border-radius: var(--radius-display) !important;
}

.credential-page .btn {
  border: 0;
  background: var(--color-action);
  color: var(--color-on-action);
  font-weight: 900;
}

.credential-page .secondary {
  border: 2rpx solid var(--color-border);
  background: var(--color-input-bg);
  color: var(--color-text);
}

.meet-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 20rpx;
}

.meet-location > view {
  min-width: 0;
  overflow-wrap: anywhere;
}

.meet-location button {
  flex: 0 0 auto;
  width: auto;
  min-height: 72rpx;
  margin: 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-input-bg);
  color: var(--color-text);
}

.error-card {
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
  overflow-wrap: anywhere;
}

.team-card {
  margin-top: 14rpx;
}

@media (max-width: 340px) {
  .credential-page .hero-title {
    font-size: 34rpx;
  }

  .credential-top {
    align-items: flex-start;
    flex-direction: column;
  }

  .credential-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 4rpx;
  }

  .credential-value {
    text-align: left;
  }
}
