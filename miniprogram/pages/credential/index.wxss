/* AI Hero credential: genuine status/serial, on-device private details, distinct perforation. */
.credential-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.voucher .ink {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  color: var(--color-text);
}
.voucher-title {
  font-family: var(--font-family-mono);
  font-size: 24rpx;
  letter-spacing: 0.12em;
  color: var(--color-muted);
}
.voucher-status {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border: 1px solid var(--color-border);
  border-radius: 12rpx;
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 24rpx;
}
.status-approved .voucher-status,
.status-checked_in .voucher-status {
  color: var(--color-status-success);
  background: var(--color-status-success-soft);
}
.status-pending .voucher-status,
.status-waiting .voucher-status {
  color: var(--color-status-warning);
  background: var(--color-status-warning-soft);
}
.ticketbody {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.person {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.person .avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex: none;
  background: var(--color-raised);
}
.person .avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.person-copy {
  flex: 1;
  min-width: 0;
}
.person-name {
  font-family: var(--font-family-body);
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.person-meta {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.7;
}
.club-identity {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}
.club-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex: none;
  background: var(--color-raised);
}
.club-avatar--placeholder {
  color: var(--color-text);
  display: flex;
  align-items: center;
  justify-content: center;
}
.detailrow-desc--split {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: flex-start;
}
.detailrow-desc--split > view {
  flex: 1;
  min-width: 160rpx;
}
.detailrow-desc--pair {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
}
.meeting-name,
.meeting-address {
  display: block;
}
.meeting-address {
  font-size: 24rpx;
  color: var(--color-muted);
}
.meeting-navigation {
  margin: 0;
  padding: 12rpx 16rpx;
}
.credential-actions > .btn,
.credential-links > .btn {
  width: 100%;
  box-sizing: border-box;
}
.share-note {
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-muted);
}
.cancel-button {
  background: transparent;
  color: var(--color-danger-text);
  border: 0;
}
.notice-copy {
  flex: 1;
  min-width: 0;
}
.notice-title {
  font-weight: var(--font-weight-body);
  margin-bottom: 8rpx;
}
.notice-item {
  line-height: 1.7;
}
@import '../../styles/aihero-layout.wxss';
