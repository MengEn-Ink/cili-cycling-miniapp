.credential-page {
  padding-top: 24rpx;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.status-hero {
  padding: 38rpx 34rpx;
  border-radius: 28rpx;
  background: #0b6b4f;
  color: #fff;
}

.status-pending {
  background: #9a6513;
}

.status-rejected,
.status-cancelled {
  background: #7f4545;
}

.status-label {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 700;
}

.credential-card {
  position: relative;
  margin-top: 20rpx;
  padding: 40rpx 28rpx 28rpx;
  border: 2rpx solid #d8e7df;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
}

.credential-caption {
  color: #718078;
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.serial {
  margin: 20rpx 0 8rpx;
  color: #0b6b4f;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  word-break: break-all;
}

.rider {
  font-size: 30rpx;
  font-weight: 700;
}

.meet-info {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #eef5f1;
}

.credential-note {
  margin-top: 18rpx;
  color: #718078;
  font-size: 21rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 24rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 14rpx 0 24rpx;
}

.timeline-mark {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #18a058;
}

.timeline-mark.current {
  background: #ff6b35;
  box-shadow: 0 0 0 8rpx #fff0ea;
}

.review-comment {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f7f2;
  color: #718078;
}

.error-card {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fceded;
  color: #d94b4b;
}
