.credential-page {
  background: var(--color-bg);
}
.compact-rider-card {
  overflow: hidden;
  margin-top: var(--card-gap);
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.compact-rider-media {
  position: relative;
  height: 336rpx;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.visual-swiper,
.visual-photo {
  width: 100%;
  height: 100%;
}
.visual-overlay {
  position: absolute;
  inset: 0;
  background: var(--color-overlay);
  opacity: 0.35;
}
.real-media-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 100%;
  color: var(--color-media-muted);
}
.brand-word {
  color: var(--color-on-media);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.compact-rider-top {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  left: 24rpx;
  display: flex;
  justify-content: space-between;
}
.hero-kicker {
  color: var(--color-media-muted);
  font-size: 24rpx;
}
.status-label {
  border: 2rpx solid var(--color-media-muted);
  background: transparent;
  color: var(--color-on-media);
}
.compact-rider-identity {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.compact-rider-avatar {
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border: 6rpx solid var(--color-on-media);
  border-radius: 50%;
}
.avatar-missing {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 36rpx;
  font-weight: 900;
}
.rider-copy {
  display: flex;
  flex-direction: column;
}
.rider-name {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.rider-meta {
  color: var(--color-media-muted);
  font-size: 24rpx;
}
.compact-rider-body {
  padding: 24rpx 32rpx;
}
.compact-rider-event {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}
.compact-rider-empty {
  color: var(--color-muted);
  font-size: 24rpx;
}
.credential-card {
  overflow: hidden;
  padding: 0;
}
.credential-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
}
.credential-caption,
.serial {
  color: var(--color-muted);
  font-size: 24rpx;
}
.meeting-spotlight {
  margin: 24rpx 32rpx;
}
.meeting-divider {
  height: 2rpx;
  margin: 16rpx 0;
  background: var(--color-subtle);
}
.meeting-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.meeting-location-title {
  color: var(--color-on-media);
  font-size: 36rpx;
  font-weight: 900;
}
.meeting-address {
  color: var(--color-media-muted);
  font-size: 24rpx;
}
.meeting-location button {
  min-height: var(--control-height);
  padding: 0 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 800;
}
.credential-row {
  margin: 0 32rpx;
}
.team-card {
  margin-top: var(--card-gap);
}
.action-stack {
  margin-top: var(--card-gap);
}
.action-stack .secondary,
.action-stack .btn {
  width: 100%;
}
.history-note {
  color: var(--color-muted);
}
