/* ===== CILI 暗色竞技主题：报名凭证页页面级接入 ===== */
page {
  background: #0b0b0c;
}
.credential-page {
  min-height: 100vh;
  padding-top: 24rpx;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  background: #0b0b0c;
  color: #f7f7f5;
}

/* 状态横幅保留语义色，在暗色基底上以低饱和渐变面板呈现 */
.status-hero {
  padding: 38rpx 34rpx;
  border: 1rpx solid #343438;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #242427, #111113);
  color: #f7f7f5;
}
.status-pending {
  background: linear-gradient(145deg, #2a2417, #16120e);
}
.status-rejected,
.status-cancelled {
  background: linear-gradient(145deg, #2a1817, #160f0e);
}
.credential-page .hero-kicker {
  color: #e9753b;
}
.credential-page .hero-title {
  color: #f7f7f5;
}
.credential-page .hero-subtitle {
  color: #c8c8cc;
}
.status-label {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 23rpx;
  font-weight: 700;
}

.credential-card {
  margin-top: 20rpx;
  padding: 40rpx 28rpx 28rpx;
  border: 1rpx solid #343438;
  border-radius: 16rpx;
  background: #1b1b1d;
  color: #f7f7f5;
  text-align: center;
}
.credential-caption {
  color: #8b8b91;
  font-size: 23rpx;
  letter-spacing: 3rpx;
}
.serial {
  margin: 20rpx 0 8rpx;
  color: #d55b1f;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  word-break: break-all;
}
.rider {
  font-size: 30rpx;
  font-weight: 700;
}
.meet-info {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #151517;
  color: #f7f7f5;
}
.credential-note {
  margin-top: 18rpx;
  color: #8b8b91;
  font-size: 21rpx;
}

.credential-page .card {
  border: 1rpx solid #343438;
  background: #242427;
  color: #f7f7f5;
}
.credential-page .timeline-card .title {
  color: #f7f7f5;
}
.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 24rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 14rpx 0 24rpx;
}
.timeline-mark {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #5a5a5e;
}
.timeline-mark.current {
  background: #d55b1f;
  box-shadow: 0 0 0 8rpx rgba(213, 91, 31, 0.22);
}
.credential-page .muted {
  color: #a8a8ad;
}
.review-comment {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #151517;
  color: #a8a8ad;
}

.credential-page .btn {
  border: 0;
  background: #d55b1f;
  color: #0b0b0c;
  font-weight: 900;
}
.credential-page .secondary {
  border: 2rpx solid #3a3a3e;
  background: #151517;
  color: #f7f7f5;
}
.error-card {
  padding: 24rpx;
  border-radius: 14rpx;
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
}
