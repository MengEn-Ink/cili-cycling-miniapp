<view class="page"><state-view wx:if="{{loading}}" type="loading" text="正在加载报名凭证"/><view class="card danger" wx:if="{{error}}">{{error}}</view><view wx:if="{{item && activity}}"><view class="hero"><view>{{item.status==='approved'?'APPROVED':'REGISTRATION'}}</view><view class="hero-title">{{activity.title}}</view><view>状态：{{item.status}}</view></view><view wx:if="{{item.status==='approved'}}" class="card"><view class="title">报名凭证</view><view class="big">{{item.serialNo}}</view><view>{{item.profile.realName}} · {{activity.date}}</view><view wx:if="{{activity.schedule.length}}">{{activity.schedule[0].time}} {{activity.schedule[0].location}}</view><view class="muted">仅供截图留存，不作为现场核销二维码</view></view><view class="card"><view class="title">状态时间线</view><view>● 已提交报名</view><view>│ {{item.updatedAt}}</view><view>● 当前状态：{{item.status}}</view><view wx:if="{{item.reviewComment}}">审批意见：{{item.reviewComment}}</view></view><button wx:if="{{item.status==='pending'||item.status==='approved'}}" class="secondary" bindtap="cancel">取消报名</button><button wx:if="{{item.status==='rejected'||item.status==='cancelled'}}" class="btn" bindtap="retry">修改后重新报名</button></view></view>
