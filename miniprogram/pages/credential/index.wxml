<view class="page credential-page">
  <state-view loading="{{loading}}" error="{{!item || !activity ? error : ''}}" loading-title="正在加载报名凭证" loading-copy="正在核对报名与活动信息">
  <view class="error-card" wx:if="{{error}}" role="alert">{{error}}</view>
  <view wx:if="{{item && activity}}">
    <view class="status-hero status-{{item.status}}">
      <view class="hero-top"><view class="hero-kicker">{{item.status === 'approved' ? 'APPROVED' : 'REGISTRATION'}}</view><view class="status-label">{{statusText}}</view></view>
      <view class="hero-title">{{activity.title}}</view>
      <view class="hero-subtitle">{{activity.date}}</view>
    </view>

    <view wx:if="{{item.status === 'approved'}}" class="credential-card">
      <view class="credential-top"><view><view class="credential-caption">报名凭证</view><view class="serial">{{item.serialNo}}</view></view><view class="approved-mark">已通过</view></view>
      <view class="credential-row"><text class="credential-key">骑手</text><text class="credential-value">{{item.profile.realName}}</text></view>
      <view class="credential-row" wx:if="{{item.gatheringMode}}"><text class="credential-key">集合方式</text><text class="credential-value">{{item.gatheringMode}}</text></view>
      <view wx:if="{{activity.schedule && activity.schedule.length}}" class="meet-info"><view class="meet-label">集合信息</view><view class="meet-value">{{activity.schedule[0].time}} · {{activity.schedule[0].location}}</view></view>
      <view class="credential-note">仅供截图留存，不作为现场核销二维码</view>
    </view>

    <view class="card timeline-card">
      <view class="title">报名进度</view>
      <view class="timeline-item"><view class="timeline-mark done"></view><view class="timeline-copy"><view>报名记录已创建</view><view class="muted">最近更新 {{item.updatedAt}}</view></view></view>
      <view class="timeline-item current-item"><view class="timeline-mark current"></view><view class="timeline-copy"><view>当前状态：<text class="timeline-status">{{statusText}}</text></view><view wx:if="{{item.reviewComment}}" class="review-comment">审批意见：{{item.reviewComment}}</view></view></view>
    </view>

    <view class="action-stack">
      <button wx:if="{{item.status === 'pending' || item.status === 'approved'}}" class="secondary" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">{{cancelling ? '正在取消' : '取消报名'}}</button>
      <button wx:if="{{activityAction.kind === 'resubmit'}}" class="btn" disabled="{{cancelling}}" bindtap="retry">{{activityAction.label}}</button>
      <view wx:elif="{{activityAction.kind === 'view-history'}}" class="card history-note">活动报名已关闭，当前记录仅供历史查看。</view>
    </view>
  </view>
  </state-view>
</view>
