<view class="page credential-page">
  <state-view loading="{{loading}}" error="{{!item || !activity ? error : ''}}" loading-title="正在加载报名凭证" loading-copy="正在核对报名与活动信息">
  <view class="error-card" wx:if="{{error}}" role="alert">{{error}}</view>
  <view wx:if="{{item && activity}}">
    <view class="credential-visual status-hero status-{{item.status}}">
      <swiper wx:if="{{backgroundImages.length}}" class="visual-swiper" circular="{{backgroundImages.length > 1}}" autoplay="{{backgroundImages.length > 1}}" interval="4500" indicator-dots="{{backgroundImages.length > 1}}">
        <swiper-item wx:for="{{backgroundImages}}" wx:key="*this"><image class="visual-photo" src="{{item}}" mode="aspectFill" /></swiper-item>
      </swiper>
      <view wx:else class="visual-fallback"></view>
      <view class="visual-overlay"></view>
      <view class="visual-content">
        <view class="hero-top"><view class="hero-kicker">报名凭证</view><view class="status-label">{{statusText}}</view></view>
        <view class="rider-lockup">
          <image wx:if="{{avatarUrl}}" class="rider-avatar" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="rider-avatar avatar-fallback">{{avatarInitial}}</view>
          <view class="rider-copy"><text class="rider-name">{{riderName}}</text><text class="rider-meta">{{item.gatheringMode || '集合方式待确认'}}</text></view>
        </view>
        <view class="hero-title">{{activity.title}}</view>
        <view class="hero-subtitle">{{activity.displayDateTime}}</view>
      </view>
    </view>

    <view wx:if="{{item.status === 'approved' || item.status === 'checked_in'}}" class="credential-card">
      <view class="credential-top"><view><view class="credential-caption">报名凭证</view><view class="serial">{{item.serialNo}}</view></view><view class="approved-mark">{{item.status === 'checked_in' ? '已签到' : '已通过'}}</view></view>
      <view class="meeting-spotlight">
        <view class="meeting-block"><view class="meet-label">集合时间</view><view class="meeting-time">{{meetingTime}}</view></view>
        <view class="meeting-divider"></view>
        <view class="meeting-block meeting-location"><view class="meeting-location-copy"><view class="meet-label">集合地点</view><view class="meeting-location-title">{{meetingLocation}}</view><view wx:if="{{meetingAddress}}" class="meeting-address">{{meetingAddress}}</view></view><button wx:if="{{canNavigate}}" bindtap="navigateToMeeting">导航</button></view>
      </view>
      <view class="credential-row"><text class="credential-key">骑手</text><text class="credential-value">{{item.profile.realName || riderName}}</text></view>
      <view class="credential-row"><text class="credential-key">性别</text><text class="credential-value">{{item.profile.gender || '未标注'}}</text></view>
      <view class="credential-row" wx:if="{{item.gatheringMode}}"><text class="credential-key">集合方式</text><text class="credential-value">{{item.gatheringMode}}</text></view>
    </view>

    <view wx:if="{{item.teamId}}" class="card team-card"><view class="title">队伍：{{item.teamName}}</view><view class="muted">{{item.isTeamLeader ? '我是队长，可使用右上角分享邀请队员' : '通过队伍邀请加入，仍需独立审核'}}</view></view>

    <view class="action-stack">
      <button wx:if="{{item.status === 'waiting' || item.status === 'pending' || item.status === 'approved'}}" class="secondary" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">{{cancelling ? '正在取消' : '取消报名'}}</button>
      <button wx:if="{{activityAction.kind === 'resubmit'}}" class="btn" disabled="{{cancelling}}" bindtap="retry">{{activityAction.label}}</button>
      <view wx:elif="{{activityAction.kind === 'view-history'}}" class="card history-note">活动报名已关闭，当前记录仅供历史查看。</view>
    </view>
  </view>
  </state-view>
</view>
