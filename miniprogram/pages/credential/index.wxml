<view class="page credential-page">
  <state-view wx:if="{{loading}}" type="loading" text="正在加载报名凭证"/>
  <view class="error-card" wx:if="{{error}}">{{error}}</view>
  <view wx:if="{{item && activity}}">
    <view class="status-hero status-{{item.status}}">
      <view class="hero-kicker">{{item.status==='approved'?'APPROVED':'REGISTRATION'}}</view>
      <view class="status-label">{{statusText}}</view>
      <view class="hero-title">{{activity.title}}</view>
      <view class="hero-subtitle">{{activity.date}}</view>
    </view>
    <view wx:if="{{item.status==='approved'}}" class="credential-card">
      <view class="credential-caption">报名凭证</view><view class="serial">{{item.serialNo}}</view><view class="rider">{{item.profile.realName}}</view>
      <view wx:if="{{activity.schedule.length}}" class="meet-info">{{activity.schedule[0].time}} · {{activity.schedule[0].location}}</view>
      <view class="credential-note">仅供截图留存，不作为现场核销二维码</view>
    </view>
    <view class="card timeline-card"><view class="title">状态时间线</view><view class="timeline-item"><view class="timeline-mark done"></view><view><view>已提交报名</view><view class="muted">{{item.updatedAt}}</view></view></view><view class="timeline-item"><view class="timeline-mark current"></view><view><view>当前状态：{{statusText}}</view><view wx:if="{{item.reviewComment}}" class="review-comment">审批意见：{{item.reviewComment}}</view></view></view></view>
    <button wx:if="{{item.status==='pending'||item.status==='approved'}}" class="secondary" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">取消报名</button>
    <button wx:if="{{item.status==='rejected'||item.status==='cancelled'}}" class="btn" disabled="{{cancelling}}" bindtap="retry">修改后重新报名</button>
  </view>
</view>
