<view class="page credential-page">
  <state-view loading="{{loading}}" error="{{!item || !activity ? error : ''}}" loading-title="正在加载报名凭证" loading-copy="正在核对报名与活动信息">
  <view class="card danger" wx:if="{{error}}" role="alert">{{error}}</view>
  <view wx:if="{{item && activity}}">
    <view class="journal-heading">
      <view class="journal-eyebrow">此里 · 出发凭证</view>
      <view class="journal-title editorial">{{item.status === 'checked_in' ? '已经签到，路上见。' : (item.status === 'approved' ? '出发，路上见。' : statusView.title)}}</view>
      <view class="journal-summary">{{statusView.hint}}</view>
    </view>

    <view class="status-journey status-journey--{{statusView.tone}}" role="status" aria-live="polite">
      <view class="status-journey__marker">{{item.status === 'approved' || item.status === 'checked_in' ? '✓' : '·'}}</view>
      <view class="status-journey__copy"><view class="status-journey__title">{{statusView.title}}</view><view class="status-journey__hint">{{statusView.hint}}</view></view>
    </view>

    <view wx:if="{{item.status === 'approved' || item.status === 'checked_in'}}" class="credential-card">
      <view class="credential-top">
        <view class="ticket-brand"><text class="ticket-brand__name">CILI</text><text class="credential-caption">报名凭证</text></view>
        <view class="serial">{{item.serialNo}}</view>
      </view>
      <view class="credential-summary">
        <view class="club-identity" aria-label="活动归属：{{activity.clubIdentity.name}}"><image wx:if="{{activity.clubIdentity.avatarUrl}}" class="club-avatar" src="{{activity.clubIdentity.avatarUrl}}" mode="aspectFill" /><view wx:else class="club-avatar club-avatar--placeholder">此</view><text>{{activity.clubIdentity.name}}</text></view>
        <view class="status-label">{{statusText}}</view>
        <view class="approved-mark"><text>✓</text><text>{{item.status === 'checked_in' ? '已签到' : '已通过'}}</text></view>
        <view class="credential-title">{{activity.title}}</view>
        <view class="credential-date">{{activity.displayDate}}</view>
      </view>
      <view class="credential-rider">
        <image wx:if="{{avatarUrl}}" class="compact-rider-avatar" src="{{avatarUrl}}" mode="aspectFill" aria-label="{{riderName}}的骑手头像" />
        <view wx:else class="compact-rider-avatar avatar-missing">骑</view>
        <view class="rider-copy"><text class="rider-name">{{item.profile.realName || riderName}}</text><text class="rider-meta">公开昵称 · {{riderName}}</text></view>
      </view>
      <view class="meeting-spotlight">
        <view class="meeting-block"><view class="meet-label">集合时间</view><view class="meeting-time">{{meetingTime}}</view></view>
        <view class="meeting-divider"></view>
        <view class="meeting-block meeting-location"><view class="meeting-location-copy"><view class="meet-label">集合地点</view><view class="meeting-location-title">{{meetingLocation}}</view><view wx:if="{{meetingAddress}}" class="meeting-address">{{meetingAddress}}</view></view><button wx:if="{{canNavigate}}" class="meeting-navigation" bindtap="navigateToMeeting">地图导航</button></view>
        <block wx:if="{{supportVehicleDriver}}">
          <view class="meeting-divider"></view>
          <view class="meeting-block meeting-driver">
            <view class="meet-label">后援车司机</view>
            <view class="meeting-driver-name">{{supportVehicleDriver.nickname || '后援车司机'}}</view>
            <view class="meeting-driver-phone">联系电话 {{supportVehicleDriver.contactPhone || '待公布'}}</view>
          </view>
        </block>
      </view>
      <view class="credential-details">
        <view class="credential-row"><text class="credential-key">骑手</text><text class="credential-value">{{item.profile.realName || riderName}}</text></view>
        <view class="credential-row"><text class="credential-key">性别</text><text class="credential-value">{{item.profile.gender || '未标注'}}</text></view>
        <view class="credential-row"><text class="credential-key">联系电话</text><text class="credential-value">{{item.profile.phone || '未填写'}}</text></view>
        <view class="credential-row"><text class="credential-key">紧急联系人</text><text class="credential-value">{{item.profile.emergencyName || '未填写'}}</text></view>
        <view class="credential-row"><text class="credential-key">紧急联系电话</text><text class="credential-value">{{item.profile.emergencyPhone || '未填写'}}</text></view>
        <view class="credential-row" wx:if="{{item.gatheringMode}}"><text class="credential-key">集合方式</text><text class="credential-value">{{item.gatheringMode}}</text></view>
      </view>
    </view>

    <view wx:if="{{item.status === 'rejected'}}" class="card danger reject-card" role="alert">
      <view class="title">未通过原因</view>
      <view class="reject-reason">{{rejectReason}}</view>
    </view>

    <view wx:if="{{item.teamId}}" class="card team-card"><view class="title">队伍：{{item.teamName}}</view><view class="muted">{{item.isTeamLeader ? '我是队长，可前往活动详情邀请队员' : '通过队伍邀请加入，仍需独立审核'}}</view></view>

    <view class="action-stack">
      <button class="btn share-activity" open-type="share">分享活动</button>
      <view class="share-note">仅分享公开活动详情，不包含本人的凭证、实名或电话。</view>
      <button wx:if="{{canAnalyzeRoute}}" class="btn" bindtap="openRouteAnalysis">查看路线分析</button>
      <button wx:if="{{item.status === 'waiting' || item.status === 'pending' || item.status === 'approved'}}" class="secondary" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">{{cancelling ? '正在取消' : '取消报名'}}</button>
      <button wx:if="{{activityAction.kind === 'resubmit'}}" class="btn" disabled="{{cancelling}}" bindtap="retry">{{activityAction.label}}</button>
      <view wx:elif="{{activityAction.kind === 'view-history'}}" class="card history-note">活动报名已关闭，当前记录仅供历史查看。</view>
    </view>
  </view>
  </state-view>
</view>
