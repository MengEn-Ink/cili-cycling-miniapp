<!--
  骑行影像志 · 出发凭证（1:1 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/credential.html）
  - 骨架：pageheading(宋体标题) → content.tight(ticket voucher ink + ticketbody person + detailrows + notice) → credential-actions(share/btn/btn/dialog)
  - 真实业务保留：
    · 状态驱动（waiting/pending/approved/checked_in/rejected/cancelled）
    · 审核拒绝 rejectReason
    · 可点击集合地点导航 navigateToMeeting
    · 后援车司机 supportVehicleDriver 行
    · 路线分析入口 canAnalyzeRoute → openRouteAnalysis
    · 取消（waiting/pending/approved） cancel + 确认模态
    · activityAction kind=resubmit → retry、view-history 展示历史提示
    · open-type=share 分享活动
    · 队伍信息（teamName、isTeamLeader）
-->
<view class="page credential-page cinema-page cinema-page--dark" data-v1-layout="content">
  <view class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{cancelling ? '正在取消报名' : ''}}</view>
  <state-view loading="{{loading}}" error="{{!item || !activity ? error : ''}}" loading-title="正在加载报名凭证" loading-copy="正在核对报名与活动信息">
    <block wx:if="{{item && activity}}">
      <view class="pageheading">
        <view class="pageheading-title editorial">
          <text class="pageheading-line">{{item.status === 'checked_in' ? '已经签到，' : (item.status === 'approved' ? '出发，' : statusView.title)}}</text>
          <text class="pageheading-line" wx:if="{{item.status === 'checked_in' || item.status === 'approved'}}">路上见。</text>
        </view>
        <view class="pageheading-sub">{{statusView.hint}}</view>
      </view>

      <view class="content tight">
        <view class="ticket voucher status-{{item.status}}">
          <view class="ink">
            <view class="voucher-title">此里 CILI · 骑行凭证</view>
            <text class="tag voucher-status status-{{item.status}}" aria-live="polite">{{statusText}}</text>
            <view class="voucher-headline editorial" aria-label="{{activity.title}}">{{activity.title}}</view>
            <text class="mono voucher-number" wx:if="{{(item.status === 'approved' || item.status === 'checked_in') && item.serialNo}}">{{item.serialNo}}</text>
          </view>

          <view class="ticketbody">
            <view class="person">
              <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" aria-label="{{riderName}}的骑手头像"/>
              <view wx:else class="avatar avatar--placeholder" aria-hidden="true">骑</view>
              <view class="person-copy">
                <view class="person-name">{{item.profile.realName || riderName}}</view>
                <view class="person-meta">公开昵称 {{riderName}}</view>
              </view>
            </view>

            <view class="club-identity" aria-label="活动归属：{{activity.clubIdentity.name}}">
              <image wx:if="{{activity.clubIdentity.avatarUrl}}" class="club-avatar" src="{{activity.clubIdentity.avatarUrl}}" mode="aspectFill" />
              <view wx:else class="club-avatar club-avatar--placeholder">此</view>
              <text>{{activity.clubIdentity.name}}</text>
            </view>

            <view class="detailrows">
              <view class="detailrow"><text class="detailrow-term">集合时间</text><text class="detailrow-desc detailrow-desc--nowrap">{{meetingTime}}</text></view>
              <view class="detailrow"><text class="detailrow-term">集合地点</text>
                <view class="detailrow-desc detailrow-desc--split">
                  <view>
                    <text class="meeting-name">{{meetingLocation}}</text>
                    <text wx:if="{{meetingAddress}}" class="meeting-address">{{meetingAddress}}</text>
                  </view>
                  <button wx:if="{{canNavigate}}" class="btn tiny secondary meeting-navigation" bindtap="navigateToMeeting" aria-label="打开集合地点地图导航">地图导航</button>
                </view>
              </view>
              <view class="detailrow" wx:if="{{item.gatheringMode}}"><text class="detailrow-term">出发方式</text><text class="detailrow-desc detailrow-desc--nowrap">{{item.gatheringMode}}</text></view>
              <view class="detailrow"><text class="detailrow-term">本人电话</text><text class="detailrow-desc detailrow-desc--nowrap">{{item.profile.phone || '未填写'}}</text></view>
              <view class="detailrow"><text class="detailrow-term">紧急联系人</text><view class="detailrow-desc detailrow-desc--pair"><text>{{item.profile.emergencyName || '未填写'}}</text><text class="detailrow-desc--nowrap" wx:if="{{item.profile.emergencyPhone}}">{{item.profile.emergencyPhone}}</text></view></view>
              <view class="detailrow" wx:if="{{supportVehicleDriver}}">
                <text class="detailrow-term">后援车司机</text>
                <view class="detailrow-desc">
                  <text>{{supportVehicleDriver.nickname || '后援车司机'}}</text>
                  <text class="small muted">联系电话 {{supportVehicleDriver.contactPhone || '待公布'}}</text>
                </view>
              </view>
            </view>

            <view class="notice notice--info" role="note">
              <view class="notice-dot" aria-hidden="true"></view>
              <text>本人信息仅在你的凭证和管理员审核中完整展示。</text>
            </view>

            <view wx:if="{{item.status === 'rejected'}}" class="notice notice--warning reject-card" role="alert">
              <view class="notice-dot" aria-hidden="true"></view>
              <view class="notice-copy">
                <view class="notice-title">未通过原因</view>
                <view class="notice-item">{{rejectReason}}</view>
              </view>
            </view>

            <view wx:if="{{item.teamId}}" class="notice notice--info team-card">
              <view class="notice-dot" aria-hidden="true"></view>
              <view class="notice-copy">
                <view class="notice-title">队伍：{{item.teamName}}</view>
                <view class="notice-item">{{item.isTeamLeader ? '我是队长，可前往活动详情邀请队员' : '通过队伍邀请加入，仍需独立审核'}}</view>
              </view>
            </view>
          </view>
        </view>

        <view class="credential-actions">
          <button class="btn share-activity" open-type="share" aria-label="分享活动">分享活动</button>
          <text class="small muted share-note">仅分享公开活动链接，不分享本人的凭证、实名或电话。</text>
          <view class="credential-links">
            <navigator class="btn secondary" url="/pages/activity-detail/index?id={{activity.id}}" aria-label="查看活动与集合安排">
              <text>查看活动与集合安排</text>
              <text class="chev" aria-hidden="true"></text>
            </navigator>
            <button wx:if="{{canAnalyzeRoute}}" class="btn secondary" bindtap="openRouteAnalysis" aria-label="查看完整路线分析">
              <text>查看完整路线分析</text>
              <text class="chev" aria-hidden="true"></text>
            </button>
          </view>
          <button wx:if="{{item.status === 'waiting' || item.status === 'pending' || item.status === 'approved'}}" class="btn ghost cancel-button" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel" aria-label="{{cancelling ? '正在取消报名' : '取消报名'}}">{{cancelling ? '正在取消' : '取消报名'}}</button>
          <button wx:if="{{activityAction.kind === 'resubmit'}}" class="btn" disabled="{{cancelling}}" bindtap="retry" aria-label="{{activityAction.label}}">{{activityAction.label}}</button>
          <view wx:elif="{{activityAction.kind === 'view-history'}}" class="notice notice--info history-note" role="note">
            <view class="notice-dot" aria-hidden="true"></view>
            <text>活动报名已关闭，当前记录仅供历史查看。</text>
          </view>
        </view>
      </view>
    </block>
  </state-view>
</view>
