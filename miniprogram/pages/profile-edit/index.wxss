.profile-form-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.form-card {
  margin-top: var(--card-gap);
}
.step-kicker {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
}
.form-tip,
.field-tip,
.avatar-note {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.avatar-editor {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}
.avatar-preview-shell {
  flex: 0 0 144rpx;
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  border: 6rpx solid var(--color-border-strong);
  border-radius: 50%;
  background: var(--color-raised);
}
.avatar-preview,
.avatar-preview-placeholder {
  width: 100%;
  height: 100%;
}
.avatar-panel {
  flex: 1;
  min-width: 0;
}
.avatar-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 16rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 800;
}
.avatar-status {
  min-height: 36rpx;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.gender-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
}
.gender-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--segment-height);
}
.gender-option + .gender-option {
  border-left: 4rpx solid var(--color-border-strong);
}
.photo-action {
  width: 100%;
  margin-top: 24rpx;
}
.photo-list {
  grid-template-columns: 1fr;
}
.photo-item {
  overflow: hidden;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
}
.photo-preview-button {
  width: 100%;
  height: 320rpx;
  background: var(--color-raised);
}
.photo-thumbnail {
  width: 100%;
  height: 100%;
}
.photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--color-muted);
}
.photo-count {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: right;
}
.form-error {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border: 4rpx solid var(--color-brand);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-brand-active);
}
.save-action {
  width: 100%;
  margin-top: var(--card-gap);
}
@media (max-width: 340px) {
  .avatar-editor {
    align-items: stretch;
    flex-direction: column;
  }
  .avatar-preview-shell {
    align-self: center;
  }
}
