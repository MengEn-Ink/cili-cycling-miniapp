.profile-form-page {
  padding-bottom: 190rpx;
}

.form-card {
  overflow: hidden;
}

.form-tip {
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.avatar-field {
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin: 18rpx 0 30rpx;
}

.avatar-preview {
  overflow: hidden;
  display: flex;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid #d55b1f;
  border-radius: 12rpx;
  background: #171719;
  color: #f7f7f5;
  font-size: 44rpx;
  font-style: italic;
  font-weight: 900;
}

.avatar-preview image {
  width: 100%;
  height: 100%;
}

.avatar-copy {
  flex: 1;
  min-width: 0;
}

.avatar-action {
  margin-top: 16rpx;
  background: #d55b1f !important;
  color: #0b0b0c !important;
}

.form-card .field {
  margin: 0;
}

.form-card .field + .field {
  margin-top: 30rpx;
}

.form-card .label {
  display: block;
  line-height: 34rpx;
  margin-bottom: 12rpx;
}

.form-card .input {
  box-sizing: border-box;
  display: block;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 44rpx;
  padding: 0 24rpx;
}

.field-tip {
  margin-top: 12rpx;
  line-height: 1.5;
}

.photo-action {
  margin-top: 32rpx;
}

.photo-count {
  margin-top: 20rpx;
  color: #718079;
}

.form-error {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  line-height: 1.6;
}

.save-action {
  margin-top: 28rpx;
}
