/* Profile Edit · 骑行影像志 1:1（对齐 docs/designs/2026-10-22-cycling-image-journal/pages/profile-edit.html） */
.profile-edit-page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
  padding: 0 var(--page-gutter) calc(96rpx + env(safe-area-inset-bottom));
}
.pageheading {
  padding: 32rpx 0 24rpx;
  background: var(--color-bg);
  color: var(--color-text);
}
.pageheading .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 36rpx;
  text-transform: uppercase;
}
.pageheading .eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.pageheading-title {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 12rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-line {
  display: block;
}
.pageheading-sub {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}
.content {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}
.content.tight {
  gap: 40rpx;
}
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.profile-details {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  margin: 0;
  padding: 0;
  border: 0;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 0;
}
.chapterhead-title {
  flex: none;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-rule {
  flex: 1;
  min-width: 0;
  height: 2rpx;
  background: var(--color-border);
}
.upload {
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}
.upload-background {
  grid-template-columns: 216rpx minmax(0, 1fr);
}
.upload-media {
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-raised);
  position: relative;
}
.upload-media-avatar {
  width: 144rpx;
  height: 144rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 50%;
  background: var(--color-raised);
}
.upload-media-background {
  width: 100%;
  aspect-ratio: 16 / 9;
}
.avatar {
  width: 100%;
  height: 100%;
}
.avatar-preview,
.avatar-preview-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.background-image {
  width: 100%;
  height: 100%;
}
.background-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 16rpx;
  border: 0;
  background: transparent;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}
.background-placeholder::after {
  display: none;
}
.background-placeholder--loading {
  background: var(--color-raised);
  position: relative;
}
.background-placeholder--loading::before {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  margin-top: -56rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-text);
  border-radius: 50%;
  animation: photo-loading-spin 0.9s linear infinite;
  content: '';
}
@keyframes photo-loading-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.background-placeholder--failed {
  color: var(--color-text);
  text-decoration: underline;
}
.background-placeholder--empty {
  color: var(--color-muted);
}
.upload-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.upload-title {
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 900;
}
.upload-sub {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.upload-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.upload-status {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 32rpx;
  border: 2rpx solid var(--color-action);
  border-radius: var(--radius-sm);
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn--secondary {
  border-color: var(--color-border-strong);
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
.btn--text {
  background: transparent !important;
  border-color: transparent;
  color: var(--color-text) !important;
  text-decoration: underline;
  min-height: 72rpx;
  padding: 0 16rpx;
}
.avatar-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
}
.photo-action,
.photo-remove {
  min-height: 88rpx;
}
.photo-remove {
  background: var(--color-danger-soft) !important;
  color: var(--color-danger-text) !important;
  border-color: var(--color-danger-soft);
  text-decoration: none;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.field-label {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-input-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
}
.field-placeholder {
  color: var(--color-placeholder);
}
.field-help {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.gender-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.gender-option {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  padding: 12rpx 28rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
}
.gender-option.is-selected {
  background: var(--color-action);
  color: var(--color-on-action);
  border-color: var(--color-action);
}
.gender-option radio {
  transform: scale(0.9);
}
.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0 16rpx 20rpx;
  border: 0;
  border-left: 6rpx solid var(--color-border-strong);
  border-radius: 0;
  background: transparent;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.notice--info {
  border-left-color: var(--color-text);
  color: var(--color-text);
}
.notice--danger {
  border-left-color: var(--color-action);
  color: var(--color-danger-text);
  background: var(--color-danger-soft);
}
.notice--danger .notice-dot {
  background: var(--color-danger);
}
.readiness-note {
  border-left-color: var(--color-text);
  color: var(--color-text);
}
.save-action {
  width: 100%;
  min-height: 96rpx;
  margin-top: 8rpx;
}
.profile-edit-footer {
  margin-top: 48rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
@media (max-width: 340px) {
  .upload {
    grid-template-columns: 1fr;
    padding: 20rpx;
  }
  .upload-background {
    grid-template-columns: 1fr;
  }
  .upload-media-avatar {
    width: 144rpx;
    height: 144rpx;
  }
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
}

/* 资料授权确认与权限状态 */
.permission-card {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.permission-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.permission-card-copy {
  min-width: 0;
}
.permission-card-title,
.permission-card-status {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.permission-card-title {
  font-weight: 800;
  line-height: 44rpx;
}
.permission-card-status {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.permission-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-xs);
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
}
.permission-badge--active {
  background: var(--color-status-success-soft);
  color: var(--color-status-success);
}
.permission-card-action,
.permission-reset {
  min-height: 88rpx;
  padding: 0;
  background: transparent;
  color: var(--color-action);
  font-size: 26rpx;
  text-align: left;
}
.permission-card-action::after,
.permission-reset::after {
  border: 0;
}
.permission-details {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 40rpx;
}
.consent-mask {
  position: fixed;
  z-index: 120;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: var(--color-overlay);
}
.consent-sheet {
  width: 100%;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-display) var(--radius-display) 0 0;
  background: var(--color-bg);
  box-shadow: var(--shadow-hard);
}
.consent-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 32rpx;
  border-radius: 999rpx;
  background: var(--color-border-strong);
}
.consent-kicker {
  color: var(--color-action);
  font-family: var(--font-mono);
  font-size: 24rpx;
}
.consent-title {
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 64rpx;
}
.consent-copy {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}
.consent-list {
  margin: 32rpx 0;
  border-top: 1rpx solid var(--color-border);
}
.consent-list > view {
  display: grid;
  grid-template-columns: 136rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 26rpx;
  line-height: 40rpx;
}
.consent-list > view > text:first-child {
  font-weight: 800;
  white-space: nowrap;
}
.consent-list > view > text:last-child {
  color: var(--color-muted);
}
.consent-primary,
.consent-later {
  width: 100%;
}
