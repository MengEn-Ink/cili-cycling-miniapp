/* Profile Edit · 骑行影像志 1:1（对齐 docs/designs/2026-10-22-cycling-image-journal/pages/profile-edit.html） */
.profile-edit-page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
  padding: 0 32rpx calc(96rpx + env(safe-area-inset-bottom));
}
.pageheading {
  padding: 32rpx 0 48rpx;
  background: var(--color-bg);
  color: var(--color-text);
}
.pageheading .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  line-height: 32rpx;
  text-transform: uppercase;
}
.pageheading .eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.pageheading-title {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 72rpx;
  line-height: 88rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-line {
  display: block;
}
.pageheading-sub {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}
.content {
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}
.content.tight {
  gap: 48rpx;
}
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.profile-details {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  margin: 0;
  padding: 0;
  border: 0;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 4rpx;
}
.chapterhead-title {
  flex: none;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-rule {
  flex: 1;
  min-width: 0;
  height: 2rpx;
  background: var(--color-border);
}
.upload {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 24rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}
.upload-background {
  grid-template-columns: 200rpx minmax(0, 1fr);
}
.upload-media {
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-raised);
  position: relative;
}
.upload-media-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
}
.upload-media-background {
  width: 100%;
  aspect-ratio: 16 / 9;
}
.avatar {
  width: 100%;
  height: 100%;
}
.avatar-preview,
.avatar-preview-placeholder {
  width: 100%;
  height: 100%;
}
.background-image {
  width: 100%;
  height: 100%;
}
.background-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 16rpx;
  border: 0;
  background: transparent;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}
.background-placeholder::after {
  display: none;
}
.background-placeholder--loading {
  background: var(--color-raised);
  position: relative;
}
.background-placeholder--loading::before {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  margin-top: -56rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-text);
  border-radius: 50%;
  animation: photo-loading-spin 0.9s linear infinite;
  content: '';
}
@keyframes photo-loading-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.background-placeholder--failed {
  color: var(--color-text);
  text-decoration: underline;
}
.background-placeholder--empty {
  color: var(--color-muted);
}
.upload-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.upload-title {
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 900;
}
.upload-sub {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 34rpx;
}
.upload-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.upload-status {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 999rpx;
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn--secondary {
  background: var(--color-surface);
  color: var(--color-text);
}
.btn--text {
  background: transparent;
  border-color: transparent;
  color: var(--color-text);
  text-decoration: underline;
  min-height: 72rpx;
  padding: 0 16rpx;
}
.avatar-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
}
.photo-action,
.photo-remove {
  min-height: 88rpx;
}
.photo-remove {
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
  border-color: var(--color-danger-soft);
  text-decoration: none;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.field-label {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-input-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
}
.field-placeholder {
  color: var(--color-placeholder);
}
.field-help {
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}
.gender-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.gender-option {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding: 12rpx 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 40rpx;
}
.gender-option.is-selected {
  background: var(--color-action);
  color: var(--color-on-action);
  border-color: var(--color-action);
}
.gender-option radio {
  transform: scale(0.9);
}
.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-text);
}
.notice--info {
  border-style: solid;
  color: var(--color-text);
}
.notice--danger {
  border-style: solid;
  border-color: var(--color-danger);
  color: var(--color-danger-text);
  background: var(--color-danger-soft);
}
.notice--danger .notice-dot {
  background: var(--color-danger);
}
.readiness-note {
  border-style: solid;
  color: var(--color-text);
}
.save-action {
  width: 100%;
  min-height: 96rpx;
  margin-top: 8rpx;
}
.profile-edit-footer {
  margin-top: 72rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
@media (max-width: 350px) {
  .upload {
    grid-template-columns: 128rpx minmax(0, 1fr);
    padding: 20rpx;
  }
  .upload-background {
    grid-template-columns: 160rpx minmax(0, 1fr);
  }
  .upload-media-avatar {
    width: 128rpx;
    height: 128rpx;
  }
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
}
