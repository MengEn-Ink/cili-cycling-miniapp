/* ===== CILI 暗色竞技主题：资料编辑页页面级接入 ===== */
page {
  background: #0b0b0c;
}
.profile-form-page {
  min-height: 100vh;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  background: #0b0b0c;
  color: #f7f7f5;
}

.profile-form-page .form-card {
  overflow: hidden;
  border: 1rpx solid #4a4a4e;
  background: #1a1a1c;
  color: #f7f7f5;
}
.profile-form-page .title {
  color: #f7f7f5;
}

.form-tip {
  line-height: 1.7;
  margin-bottom: 28rpx;
}
.form-card .field {
  margin: 0;
}
.form-card .field + .field {
  margin-top: 30rpx;
}
.profile-form-page .form-card .label {
  display: block;
  line-height: 34rpx;
  margin-bottom: 12rpx;
  color: #a8a8ad;
}
.form-card .input {
  box-sizing: border-box;
  display: block;
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #555559;
  border-radius: 8rpx;
  background: #101012;
  color: #f7f7f5;
}

.avatar-editor {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #3f3f43;
}
.profile-form-page .avatar-preview-shell {
  display: flex;
  flex: 0 0 144rpx;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  border: 4rpx solid #343438;
  border-radius: 50%;
  background: #151517;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.4);
}
.avatar-preview {
  width: 100%;
  height: 100%;
}
.avatar-preview-placeholder {
  color: #f38a50;
  font-size: 52rpx;
  font-weight: 900;
}
.avatar-panel {
  min-width: 0;
  flex: 1;
}
.avatar-note {
  margin-bottom: 18rpx;
  font-size: 23rpx;
  line-height: 1.55;
}
.avatar-actions {
  display: grid;
  gap: 12rpx;
}
.avatar-action {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 22rpx;
  border: 2rpx solid #555559;
  border-radius: 14rpx;
  background: #151517;
  color: #f7f7f5;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: left;
}
.avatar-action::before {
  width: 12rpx;
  height: 12rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #d55b1f;
  content: '';
}
.avatar-action-strava::before {
  background: #fc4c02;
}
.avatar-action[disabled] {
  background: #1d1d20;
  color: #858589;
}
.avatar-action[disabled]::before {
  background: #5a5a5e;
}
.avatar-status {
  min-height: 38rpx;
  margin-top: 16rpx;
  color: #aaaab0;
  font-size: 22rpx;
  line-height: 1.55;
}
.avatar-status-error {
  color: #ff8f86;
  font-weight: 700;
}
.avatar-help-link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #e9753b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
  text-decoration: underline;
}
.avatar-help-link[disabled] {
  color: #6a6a70;
}

.field-tip {
  margin-top: 12rpx;
  line-height: 1.5;
}
.profile-form-page .photo-action {
  min-height: 88rpx;
  margin-top: 32rpx;
  border: 2rpx solid #3a3a3e;
  border-radius: 12rpx;
  background: #151517;
  color: #f7f7f5;
}
.photo-count {
  margin-top: 20rpx;
}
.profile-form-page .muted,
.profile-form-page .field-tip,
.profile-form-page .photo-count {
  color: #aaaab0;
}

.profile-form-page .form-error {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
  line-height: 1.6;
}
.save-action {
  margin-top: 28rpx;
  border: 0;
  background: #d55b1f;
  color: #0b0b0c;
  font-weight: 900;
}
