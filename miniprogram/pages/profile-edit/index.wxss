.profile-form-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}
.journal-heading {
  padding: 28rpx 0 56rpx;
}
.journal-eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}
.journal-eyebrow::before {
  width: 40rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
}
.journal-title {
  max-width: 600rpx;
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}
.journal-summary {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 32rpx;
  line-height: 48rpx;
}
.profile-form-page .card {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: none;
}
.profile-form-page .field .input {
  border-width: 2rpx;
}
.form-card {
  margin-top: 64rpx;
  padding: 40rpx 32rpx;
}
.journal-heading + .form-card {
  margin-top: 0;
}
.journal-section > .title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 900;
}
.step-kicker {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
}
.form-tip,
.field-tip,
.avatar-note {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.avatar-editor {
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr);
  align-items: center;
  gap: 24rpx;
  margin-top: 32rpx;
}
.avatar-preview-shell {
  flex: 0 0 144rpx;
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  border: 4rpx solid var(--color-border);
  border-radius: 50%;
  background: var(--color-raised);
}
.avatar-preview,
.avatar-preview-placeholder {
  width: 100%;
  height: 100%;
}
.avatar-panel {
  display: flex;
  align-self: stretch;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}
.avatar-actions {
  width: 100%;
}
.avatar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 800;
  text-align: center;
}
.photo-action,
.photo-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
}
.avatar-status {
  min-height: 36rpx;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.gender-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
.gender-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--segment-height);
}
.gender-option + .gender-option {
  border-left: 2rpx solid var(--color-border);
}
.gender-option radio {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
}
.gender-option.is-selected {
  background: var(--color-action);
  color: var(--color-on-action);
}
.photo-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8rpx;
  margin-top: 32rpx;
}
.photo-remove {
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
  text-decoration: none;
}
.photo-list {
  grid-template-columns: 1fr;
}
.photo-item {
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
.photo-preview-button {
  width: 100%;
  height: 320rpx;
  overflow: hidden;
  background: var(--color-raised);
}
.photo-thumbnail {
  width: 100%;
  height: 100%;
}
.photo-placeholder {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  margin: 0;
  border: 0;
  border-radius: 0;
  color: var(--color-muted);
  font-size: 24rpx;
}
.photo-placeholder--loading {
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-placeholder--failed {
  background: var(--color-surface);
  color: var(--color-brand-active);
  font-weight: 800;
}
.photo-placeholder--loading::before {
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: photo-loading-spin 0.9s linear infinite;
  content: '';
}
@keyframes photo-loading-spin {
  to {
    transform: rotate(360deg);
  }
}
.photo-count {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: right;
}
.form-error {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border: 4rpx solid var(--color-brand);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-brand-active);
}
.save-action {
  width: 100%;
  min-height: 96rpx;
  margin-top: 24rpx;
}
.readiness-note {
  margin-top: 48rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--color-border);
  border-bottom: 2rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 44rpx;
}
@media (max-width: 340px) {
  .avatar-editor {
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  .avatar-preview-shell {
    align-self: center;
  }
}
