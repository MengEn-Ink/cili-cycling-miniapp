<view class="page profile-form-page">
  <state-view loading="{{loading}}" error="{{!p ? error : ''}}" loading-title="正在读取个人资料" loading-copy="正在加载已保存的个人资料">
  <block wx:if="{{p}}">
    <view class="card form-card avatar-step-card">
      <view class="step-kicker">{{canEditDetails ? '头像' : '第 1 步'}}</view>
      <view class="title">{{canEditDetails ? '更新头像' : '先选择头像'}}</view>
      <view class="muted form-tip" wx:if="{{!canEditDetails}}">选择头像后即可继续完善个人资料。</view>
      <view class="avatar-editor">
        <view class="avatar-preview-shell">
          <image wx:if="{{avatarPreviewUrl}}" class="avatar-preview" src="{{avatarPreviewUrl}}" data-url="{{avatarPreviewUrl}}" mode="aspectFill" aria-label="预览当前头像" bindtap="previewAvatar" binderror="avatarPreviewError" />
          <view wx:else class="avatar-preview-placeholder" aria-hidden="true">骑</view>
        </view>
        <view class="avatar-panel">
          <view class="muted avatar-note">请选择微信头像，选择后立即保存，并用于个人主页和活动报名中的骑手身份展示。</view>
          <view class="avatar-actions">
            <button class="avatar-action avatar-action-wechat" open-type="chooseAvatar" bindchooseavatar="chooseWechatAvatar" disabled="{{avatarBusy || phoneBusy || photoBusy || saving}}" aria-label="选择微信头像">选择微信头像</button>
          </view>
        </view>
      </view>
      <view class="avatar-status" role="status" aria-live="polite" aria-atomic="true">{{avatarBusy ? '正在更新头像' : ''}}</view>
    </view>

    <block wx:if="{{canEditDetails}}">
      <view class="card form-card">
        <view class="title">基础资料</view>
        <view class="muted form-tip">请填写真实、常用的信息，便于活动报名、现场联络与安全保障。</view>
        <view class="privacy-note">敏感信息将安全保存；手机号仅本人和审核管理员可完整查看。</view>
        <view class="field">
          <view class="label">真实姓名</view>
          <input class="input" value="{{p.realName}}" data-k="realName" bindinput="set" placeholder-class="input-placeholder" placeholder="请输入真实姓名" />
        </view>
        <view class="field">
          <view class="label">性别</view>
          <radio-group class="gender-options" bindchange="selectGender">
            <label class="gender-option"><radio value="男" checked="{{p.gender === '男'}}" color="#d55b1f" />男</label>
            <label class="gender-option"><radio value="女" checked="{{p.gender === '女'}}" color="#d55b1f" />女</label>
          </radio-group>
        </view>
        <view class="field">
          <view class="label">本人手机号</view>
          <view class="phone-authorization-row">
            <view class="phone-value {{p.phone ? '' : 'phone-value--empty'}}">{{p.phone || '尚未授权'}}</view>
            <button class="phone-authorization-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{phoneBusy}}" disabled="{{phoneBusy || avatarBusy || photoBusy || saving}}">{{p.phone ? '更新手机号' : '授权手机号'}}</button>
          </view>
          <view class="muted field-tip">用于活动联系与安全通知；授权后将完整显示本人手机号。</view>
        </view>
        <view class="field emergency-field">
          <view class="label">紧急联系人</view>
          <input class="input" value="{{p.emergencyName}}" data-k="emergencyName" bindinput="set" placeholder-class="input-placeholder" placeholder="请输入紧急联系人姓名" />
          <view class="muted field-tip">仅在活动中发生紧急情况时使用。</view>
        </view>
        <view class="field">
          <view class="label">紧急联系电话</view>
          <input class="input" type="number" maxlength="21" value="{{p.emergencyPhone}}" data-k="emergencyPhone" bindinput="set" placeholder-class="input-placeholder" placeholder="请输入紧急联系人手机号" />
        </view>
      </view>

      <view class="card form-card">
        <view class="title">个人背景图</view>
        <view class="muted form-tip">最多 1 张，用于个人中心背景；选择新图片会替换当前背景图，点击可查看大图。</view>
        <button class="photo-action" bindtap="addPhoto" loading="{{photoBusy}}" disabled="{{photoBusy || phoneBusy || saving || avatarBusy}}">{{p.photos.length ? '更换背景图' : '添加背景图'}}</button>
        <view class="photo-list" wx:if="{{photoItems.length}}">
          <view class="photo-item" wx:for="{{photoItems}}" wx:key="id">
            <button class="photo-preview-button" data-url="{{item.previewUrl}}" bindtap="previewPhoto" disabled="{{!item.previewUrl}}" aria-label="预览个人背景图">
              <image wx:if="{{item.previewUrl}}" class="photo-thumbnail" src="{{item.previewUrl}}" mode="aspectFill" />
              <view wx:else class="photo-placeholder">图片准备中</view>
            </button>
          </view>
        </view>
        <view class="photo-count">{{p.photos.length ? '已设置 1 张背景图' : '尚未设置背景图'}}</view>
      </view>

      <view class="danger form-error" wx:if="{{mediaError}}" role="alert" aria-live="assertive" aria-atomic="true">{{mediaError}}</view>
      <view class="danger form-error" wx:if="{{error}}">{{error}}</view>
      <button class="btn save-action" loading="{{saving}}" disabled="{{saving || phoneBusy || photoBusy || avatarBusy}}" bindtap="save">保存资料</button>
    </block>
    <view class="danger form-error" wx:elif="{{mediaError}}" role="alert" aria-live="assertive" aria-atomic="true">{{mediaError}}</view>
  </block>
  </state-view>
</view>
