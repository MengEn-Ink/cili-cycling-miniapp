<view class="page">
  <state-view wx:if="{{loading}}" type="loading" text="正在读取安全资料"/>
  <state-view wx:elif="{{error && !p}}" type="error" text="{{error}}"/>
  <block wx:elif="{{p}}">
    <view class="card"><view class="title">展示身份</view><view class="field"><view class="label">昵称</view><input class="input" value="{{p.nickname}}" data-k="nickname" bindinput="set"/></view><view class="field"><view class="label">称号（管理员颁发）</view><input class="input" value="{{p.title}}" disabled/></view></view>
    <view class="card"><view class="title">实名资料</view><view class="muted">已保存字段仅显示脱敏值；再次填写会覆盖加密值。</view><view class="field"><view class="label">真实姓名</view><input class="input" value="{{p.realName}}" data-k="realName" bindinput="set"/></view><view class="field"><view class="label">证件类型</view><input class="input" value="{{p.idType}}" data-k="idType" bindinput="set"/></view><view class="field"><view class="label">证件号码</view><input class="input" value="{{p.idNumber}}" data-k="idNumber" bindinput="set"/></view><view class="field"><view class="label">性别</view><input class="input" value="{{p.gender}}" data-k="gender" bindinput="set"/></view><view class="field"><view class="label">紧急联系人</view><input class="input" value="{{p.emergencyName}}" data-k="emergencyName" bindinput="set"/></view><view class="field"><view class="label">紧急电话</view><input class="input" value="{{p.emergencyPhone}}" data-k="emergencyPhone" bindinput="set"/></view><button open-type="getPhoneNumber" bindgetphonenumber="phone">微信授权手机号（不接受手填）</button></view>
    <view class="card"><view class="title">个人相册</view><view class="muted">{{uploadHint}}</view><button size="mini" bindtap="addPhoto">选择并上传照片</button><view>{{p.photos.length}} 张待保存</view></view>
    <view class="danger" wx:if="{{error}}">{{error}}</view><button class="btn" loading="{{saving}}" bindtap="save">保存资料</button>
  </block>
</view>
