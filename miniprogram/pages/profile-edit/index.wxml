<!-- 骑行影像志 · 编辑个人资料（1:1 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/profile-edit.html） -->
<view class="page profile-edit-page cinema-page cinema-page--dark" data-v1-layout="form">
  <view wx:if="{{avatarBusy || photoBusy}}" class="a11y-live-region" role="status" aria-live="polite" aria-atomic="true">{{mediaProgress || (avatarBusy ? '正在更新头像…' : '正在处理背景图…')}}</view>
  <state-view loading="{{loading}}" error="{{!p ? error : ''}}" loading-title="正在读取个人资料" loading-copy="正在加载已保存的个人资料">
  <block wx:if="{{p}}">
    <view class="pageheading">
      <view class="pageheading-title editorial">
        <text class="pageheading-line">让同行的人，</text>
        <text class="pageheading-line">认出你。</text>
      </view>
      <view class="pageheading-sub">先选头像，再完善报名与联络资料。</view>
    </view>

    <view class="content tight">
      <view class="permission-card" role="status" aria-label="资料展示权限状态">
        <view class="permission-card-main">
          <view class="permission-card-copy">
            <view class="permission-card-title">资料展示权限</view>
            <view class="permission-card-status">{{p.avatarVisibility === 'public' ? (p.avatarId && (p.backgroundPhoto || p.photos.length) ? '头像与背景已公开' : '部分资料已公开') : '仅自己可见'}}</view>
          </view>
          <view class="permission-badge {{p.avatarVisibility === 'public' ? 'permission-badge--active' : ''}}">{{p.avatarVisibility === 'public' ? '已授权' : '未授权'}}</view>
        </view>
        <button class="permission-card-action" bindtap="togglePermissionDetails" aria-expanded="{{permissionDetailsVisible}}">{{permissionDetailsVisible ? '收起详情' : '查看详情'}}</button>
        <view wx:if="{{permissionDetailsVisible}}" class="permission-details">
          <view>活动页：昵称与已授权头像、背景</view>
          <view>报名审核：实名与联系方式仅审核人员可见</view>
          <button class="btn btn--text permission-reset" bindtap="showConsent">重新查看授权说明</button>
        </view>
      </view>

      <!-- Section：头像与背景 -->
      <view class="section section-media">
        <view class="chapterhead">
          <view class="chapterhead-title">头像与背景</view>
          <view class="chapterhead-rule" aria-hidden="true"></view>
        </view>

        <view class="upload upload-avatar" data-avatar-editor>
          <view class="upload-media upload-media-avatar">
            <image wx:if="{{avatarPreviewUrl}}" class="avatar avatar-preview" src="{{avatarPreviewUrl}}" data-url="{{avatarPreviewUrl}}" mode="aspectFill" fade-in="{{true}}" aria-label="预览当前头像" bindtap="previewAvatar" binderror="avatarPreviewError" />
            <image wx:else class="avatar avatar-preview-placeholder" src="/assets/brand/logo-circle-144.png" mode="aspectFill" aria-label="此里默认头像" />
          </view>
          <view class="upload-copy">
            <view class="upload-title">个人头像</view>
            <view class="upload-sub small muted">通过微信选择头像，选择后立即保存；头像用于个人主页和活动报名中的骑手身份展示。</view>
            <button class="btn btn--secondary avatar-action" open-type="chooseAvatar" bindchooseavatar="chooseWechatAvatar" disabled="{{avatarBusy || photoBusy || saving}}" aria-label="选择微信头像">选择微信头像</button>
            <view class="small muted upload-status">{{avatarBusy ? (mediaProgress || '正在更新头像…') : (p.avatarId ? '头像已保存' : '尚未选择头像')}}</view>
          </view>
        </view>

        <view class="upload upload-background">
          <view class="upload-media upload-media-background">
            <image wx:if="{{photoItems.length && photoItems[0].previewUrl}}" class="background-image" src="{{photoItems[0].previewUrl}}" data-id="{{photoItems[0].id}}" data-url="{{photoItems[0].previewUrl}}" mode="aspectFill" lazy-load="{{true}}" fade-in="{{true}}" bindtap="previewPhoto" bindload="photoPreviewLoad" binderror="photoPreviewError" aria-label="预览个人背景图" />
            <view wx:elif="{{photoItems.length && photoItems[0].previewState === 'loading'}}" class="background-placeholder background-placeholder--loading">背景图加载中…</view>
            <button wx:elif="{{photoItems.length}}" class="background-placeholder background-placeholder--failed" data-id="{{photoItems[0].id}}" bindtap="retryPhotoPreview">图片加载失败，点击重试</button>
            <view wx:else class="background-placeholder background-placeholder--empty" aria-hidden="true">尚未添加背景图</view>
          </view>
          <view class="upload-copy">
            <view class="upload-title">个人中心顶部背景</view>
            <view class="upload-sub small muted">最多 1 张，按 16:9 展示；选择后可移动和缩放画面，建议使用横向照片；上传完成后随资料保存。</view>
            <view class="upload-actions">
              <button class="btn btn--secondary photo-action" bindtap="addPhoto" loading="{{photoBusy}}" disabled="{{photoBusy || saving || avatarBusy}}">{{p.photos.length ? '更换背景' : '添加背景'}}</button>
              <button wx:if="{{p.photos.length}}" class="btn btn--text photo-remove" bindtap="removeBackgroundPhoto" disabled="{{photoBusy || saving || avatarBusy}}">删除背景图</button>
            </view>
            <view class="small muted upload-status">{{photoBusy ? (mediaProgress || '正在处理背景图…') : (p.photos.length ? '当前背景已就绪' : '尚未设置背景图')}}</view>
          </view>
        </view>
      </view>

      <!-- Fieldset：基础资料 + 紧急联系人（只在选择头像后展开，canEditDetails 作为门禁） -->
      <view class="profile-details" data-profile-details wx:if="{{canEditDetails}}">
        <view class="section section-basic">
          <view class="chapterhead">
            <view class="chapterhead-title">基础资料</view>
            <view class="chapterhead-rule" aria-hidden="true"></view>
          </view>
          <view class="field">
            <view class="field-label">公开昵称</view>
            <input class="field-input" type="nickname" value="{{p.nickname}}" data-k="nickname" bindinput="set" bindblur="set" placeholder-class="field-placeholder" placeholder="点击使用微信昵称或自定义" />
            <view class="field-help">其他骑友通过昵称认出你。</view>
          </view>
          <view class="field">
            <view class="field-label">真实姓名</view>
            <input class="field-input" value="{{p.realName}}" data-k="realName" bindinput="set" placeholder-class="field-placeholder" placeholder="请输入真实姓名" />
            <view class="field-help">仅本人和审核管理员完整可见。</view>
          </view>
          <view class="field">
            <view class="field-label">性别</view>
            <radio-group class="gender-options" bindchange="selectGender">
              <label class="gender-option {{p.gender === '男' ? 'is-selected' : ''}}"><radio value="男" checked="{{p.gender === '男'}}" />男</label>
              <label class="gender-option {{p.gender === '女' ? 'is-selected' : ''}}"><radio value="女" checked="{{p.gender === '女'}}" />女</label>
            </radio-group>
          </view>
          <view class="field">
            <view class="field-label">本人手机号码</view>
            <input class="field-input" type="number" maxlength="20" value="{{p.phone}}" data-k="phone" bindinput="set" placeholder-class="field-placeholder" placeholder="请输入本人手机号" />
            <view class="field-help">用于活动联系与安全通知，可直接填写或更换。</view>
          </view>
        </view>

        <view class="section section-emergency">
          <view class="chapterhead">
            <view class="chapterhead-title">紧急联系人</view>
            <view class="chapterhead-rule" aria-hidden="true"></view>
          </view>
          <view class="field">
            <view class="field-label">联系人姓名</view>
            <input class="field-input" value="{{p.emergencyName}}" data-k="emergencyName" bindinput="set" placeholder-class="field-placeholder" placeholder="请输入紧急联系人姓名" />
            <view class="field-help">仅在活动中发生紧急情况时使用。</view>
          </view>
          <view class="field">
            <view class="field-label">联系人电话</view>
            <input class="field-input" type="number" maxlength="21" value="{{p.emergencyPhone}}" data-k="emergencyPhone" bindinput="set" placeholder-class="field-placeholder" placeholder="请输入紧急联系人手机号" />
          </view>
        </view>
      </view>

      <view wx:else class="notice notice--info" role="note">
        <view class="notice-dot" aria-hidden="true"></view>
        <text>先选择头像后，再继续完善报名资料。</text>
      </view>

      <!-- 错误 / 媒体错误 -->
      <view class="notice notice--danger" wx:if="{{mediaError}}" role="alert" aria-live="assertive" aria-atomic="true">
        <view class="notice-dot" aria-hidden="true"></view>
        <text>{{mediaError}}</text>
      </view>
      <view class="notice notice--danger" wx:if="{{error}}" role="alert">
        <view class="notice-dot" aria-hidden="true"></view>
        <text>{{error}}</text>
      </view>

      <!-- Readiness notice -->
      <view class="notice readiness-note" role="note">
        <view class="notice-dot" aria-hidden="true"></view>
        <text>保存前请确认 7 项报名资料完整。头像独立即时保存，背景完成上传后再保存整表。</text>
      </view>

      <button class="btn save-action" loading="{{saving}}" disabled="{{saving || photoBusy || avatarBusy}}" bindtap="save">保存资料</button>
    </view>
  </block>
  </state-view>

  <view class="profile-edit-footer" wx:if="{{p}}">此里 · 骑行影像志</view>

  <view wx:if="{{consentVisible}}" class="consent-mask" bindtap="deferConsent" catchtouchmove="keepConsentSheet">
    <view class="consent-sheet" catchtap="keepConsentSheet" role="dialog" aria-label="资料授权确认">
      <view class="consent-handle" aria-hidden="true"></view>
      <view class="consent-title editorial">这些资料会用在哪里？</view>
      <view class="consent-copy">仅在你确认后使用，之后可在本页随时查看状态或调整。</view>
      <view class="consent-list">
        <view><text>公开身份</text><text>昵称、头像和背景用于活动页骑友展示</text></view>
        <view><text>报名审核</text><text>实名与手机号仅本人和活动管理员可见</text></view>
        <view><text>安全联络</text><text>紧急联系人仅在活动安全场景使用</text></view>
      </view>
      <button class="btn consent-primary" bindtap="acknowledgeConsent">确认并继续填写</button>
      <button class="btn btn--text consent-later" bindtap="deferConsent">稍后再说</button>
    </view>
  </view>
</view>
