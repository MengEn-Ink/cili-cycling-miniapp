<view class="page profile-form-page">
  <state-view loading="{{loading}}" error="{{!p ? error : ''}}" loading-title="正在读取安全资料" loading-copy="正在加载已保存的个人资料">
  <block wx:if="{{p}}">
    <view class="card form-card">
      <view class="title">展示身份</view>
      <view class="field">
        <view class="label">昵称</view>
        <input class="input" value="{{p.nickname}}" data-k="nickname" bindinput="set" />
      </view>
      <view class="field">
        <view class="label">称号（管理员颁发）</view>
        <input class="input" value="{{p.title}}" disabled />
      </view>
      <view class="avatar-editor">
        <view class="avatar-preview-shell">
          <image
            wx:if="{{avatarPreviewUrl}}"
            class="avatar-preview"
            src="{{avatarPreviewUrl}}"
            data-url="{{avatarPreviewUrl}}"
            mode="aspectFill"
            aria-label="当前头像预览"
            binderror="avatarPreviewError"
          />
          <view wx:else class="avatar-preview-placeholder" aria-hidden="true">骑</view>
        </view>
        <view class="avatar-panel">
          <view class="label">更新头像</view>
          <view class="muted avatar-note">头像操作会即时保存；微信入口仅表示从微信选择图片。</view>
          <view class="avatar-actions">
            <button class="avatar-action avatar-action-wechat" open-type="chooseAvatar" bindchooseavatar="chooseWechatAvatar" disabled="{{avatarBusy}}" aria-label="从微信选择头像">从微信选择头像</button>
            <button class="avatar-action avatar-action-custom" bindtap="chooseCustomAvatar" disabled="{{avatarBusy}}" aria-label="选择自定义头像">选择自定义头像</button>
            <button class="avatar-action avatar-action-strava" bindtap="importStravaAvatar" disabled="{{avatarBusy || !stravaAvatarReady}}" aria-label="导入 Strava 头像">导入 Strava 头像</button>
          </view>
          <view class="avatar-status {{stravaAvatarError ? 'avatar-status-error' : ''}}" role="{{stravaAvatarError ? 'alert' : 'status'}}" aria-live="{{stravaAvatarError ? 'assertive' : 'polite'}}" aria-atomic="true">{{avatarBusy ? '正在安全更新头像' : (stravaAvatarError || stravaAvatarHint)}}</view>
          <button wx:if="{{!stravaAvatarReady}}" class="avatar-help-link" bindtap="goToStrava" disabled="{{avatarBusy}}" aria-label="先绑定或同步 Strava">先绑定/同步 Strava</button>
        </view>
      </view>
    </view>

    <view class="card form-card">
      <view class="title">实名资料</view>
      <view class="muted form-tip">已保存字段仅显示脱敏值；再次填写会覆盖加密值。</view>
      <view class="field">
        <view class="label">真实姓名</view>
        <input class="input" value="{{p.realName}}" data-k="realName" bindinput="set" />
      </view>
      <view class="field">
        <view class="label">性别</view>
        <input class="input" value="{{p.gender}}" data-k="gender" bindinput="set" />
      </view>
      <view class="field">
        <view class="label">手机号</view>
        <input
          class="input"
          type="text"
          maxlength="21"
          value="{{p.phone}}"
          data-k="phone"
          bindinput="set"
          placeholder="请输入本人手机号"
        />
        <view class="muted field-tip">当前个人主体版本暂不支持微信手机号快速验证，请手动填写。</view>
      </view>
      <view class="field">
        <view class="label">紧急联系人</view>
        <input class="input" value="{{p.emergencyName}}" data-k="emergencyName" bindinput="set" />
      </view>
      <view class="field">
        <view class="label">紧急电话</view>
        <input class="input" value="{{p.emergencyPhone}}" data-k="emergencyPhone" bindinput="set" />
      </view>
    </view>

    <view class="card form-card">
      <view class="title">个人相册</view>
      <view class="muted form-tip">{{uploadHint}}</view>
      <button class="photo-action" size="mini" bindtap="addPhoto">选择并上传照片</button>
      <view class="photo-count">{{p.photos.length}} 张待保存</view>
    </view>

    <view class="danger form-error" wx:if="{{error}}">{{error}}</view>
    <button class="btn save-action" loading="{{saving}}" bindtap="save">保存资料</button>
  </block>
  </state-view>
</view>
