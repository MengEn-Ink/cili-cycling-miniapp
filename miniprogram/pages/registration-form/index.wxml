<mock-banner/><view class="page" wx:if="{{profile}}"><view class="hero"><view>报名资料</view><view class="hero-title">确认安全信息</view><view>Mock 不调用真实手机号授权</view></view><view class="card"><view class="title">实名与联系</view><view class="field"><view class="label">真实姓名</view><input class="input" value="{{profile.realName}}" disabled/></view><view class="field"><view class="label">手机号</view><input class="input" value="{{profile.phone}}" disabled/></view><view class="field"><view class="label">证件号码</view><input class="input" value="{{profile.idNumber}}" password disabled/></view><view class="field"><view class="label">紧急联系人</view><input class="input" value="{{profile.emergencyName}} {{profile.emergencyPhone}}" disabled/></view></view><view class="card"><view class="title">活动选项</view><view class="field"><view class="label">用车方式</view><radio-group data-key="bikeMode" bindchange="set"><label><radio value="自带车" checked/>自带车</label>　<label><radio value="租车"/>租车</label></radio-group></view><view class="field"><view class="label">骑行经验</view><radio-group data-key="experience" bindchange="set"><label><radio value="新手"/>新手</label>　<label><radio value="有一定经验"/>有经验</label>　<label><radio value="常骑" checked/>常骑</label></radio-group></view><textarea class="textarea" placeholder="租车车型、饮食或其他备注" data-key="remark" bindinput="set"/></view><view class="card"><view class="row"><view><view class="title">Strava 能力证明</view><text class="tag">{{stravaStatus}}</text></view><button size="mini" class="secondary" bindtap="strava">管理</button></view></view><view wx:if="{{errors.length}}" class="card danger"><view wx:for="{{errors}}" wx:key="*this">{{item}}</view></view></view><view class="fixed"><button class="btn" loading="{{submitting}}" bindtap="submit">提交审核</button></view>