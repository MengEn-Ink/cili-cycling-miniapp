<view class="page">
  <state-view wx:if="{{loading}}" type="loading" text="正在检查报名条件"/>
  <block wx:elif="{{profile}}">
    <view class="hero">
      <view>报名资料</view>
      <view class="hero-title">确认安全信息</view>
      <view>敏感字段仅展示云端脱敏值</view>
    </view>
    <view class="card">
      <view class="title">实名与联系</view>
      <view>{{profile.realName || '未填写实名'}} · {{profile.phone || '未授权手机号'}}</view>
      <view>{{profile.idType}} {{profile.idNumber || '未填写证件'}}</view>
      <view>{{profile.emergencyName}} {{profile.emergencyPhone}}</view>
      <button size="mini" bindtap="profile">完善资料</button>
    </view>
    <view class="card">
      <view class="title">活动选项</view>
      <radio-group data-key="bikeMode" bindchange="set">
        <label><radio value="自带车" checked/>自带车</label>
        <label><radio value="租车"/>租车</label>
      </radio-group>
      <radio-group data-key="experience" bindchange="set">
        <label><radio value="新手"/>新手</label>
        <label><radio value="有一定经验"/>有经验</label>
        <label><radio value="常骑" checked/>常骑</label>
      </radio-group>
      <textarea class="textarea" placeholder="租车、饮食或其他备注" data-key="remark" bindinput="set"/>
    </view>
    <view class="card">
      <view class="row">
        <view class="title">Strava</view>
        <button size="mini" bindtap="strava">管理</button>
      </view>
      <view>{{readinessMessage}}</view>
      <view wx:if="{{readiness.state === 'syncing'}}" class="muted">首次授权后会自动准备，无需手动同步。</view>
    </view>
  </block>
  <view wx:if="{{errors.length}}" class="card danger">
    <view wx:for="{{errors}}" wx:key="*this">{{item}}</view>
  </view>
  <view class="fixed">
    <button
      class="btn"
      loading="{{submitting}}"
      disabled="{{loading || submitting || !profile || !readiness.canRegister}}"
      bindtap="submit"
    >提交审核</button>
  </view>
</view>
