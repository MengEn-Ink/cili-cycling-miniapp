<view class="page form-page">
  <state-view wx:if="{{loading}}" type="loading" text="正在检查报名条件"/>
  <block wx:elif="{{profile}}">
    <view class="form-head"><view class="hero-kicker">REGISTRATION</view><view class="form-title">确认报名信息</view><view class="muted">请核对安全信息后提交审核</view></view>

    <view class="section-label">01 · 资料</view>
    <view class="card form-card">
      <view class="row"><view class="title">实名与联系</view><button class="text-button" bindtap="profile" disabled="{{submitting}}">完善资料</button></view>
      <view class="info-row"><text class="info-label">姓名与手机</text><text class="info-value">{{profile.realName || '未填写实名'}} · {{profile.phone || '未授权手机号'}}</text></view>
    </view>

    <view class="section-label">02 · 骑行能力</view>
    <view class="card form-card">
      <view class="field-title">用车方式</view>
      <radio-group class="choice-group" data-key="bikeMode" bindchange="set"><label class="choice"><radio color="#0B6B4F" value="自带车" checked="{{bikeMode === '自带车'}}" disabled="{{submitting}}"/>自带车</label><label class="choice"><radio color="#0B6B4F" value="租车" checked="{{bikeMode === '租车'}}" disabled="{{submitting}}"/>租车</label></radio-group>
      <view class="field-title field-gap">骑行经验</view>
      <radio-group class="choice-group three" data-key="experience" bindchange="set"><label class="choice"><radio color="#0B6B4F" value="新手" checked="{{experience === '新手'}}" disabled="{{submitting}}"/>新手</label><label class="choice"><radio color="#0B6B4F" value="有一定经验" checked="{{experience === '有一定经验'}}" disabled="{{submitting}}"/>有经验</label><label class="choice"><radio color="#0B6B4F" value="常骑" checked="{{experience === '常骑'}}" disabled="{{submitting}}"/>常骑</label></radio-group>
      <textarea class="textarea remark" placeholder="租车、饮食或其他备注" data-key="remark" bindinput="set" disabled="{{submitting}}"/>
      <view class="strava-row"><view><view class="field-title">Strava 骑行数据</view><view class="muted readiness">{{readinessMessage}}</view><view wx:if="{{readiness.state === 'syncing'}}" class="muted readiness">首次授权后会自动准备，无需手动同步。</view></view><button class="text-button" bindtap="strava" disabled="{{submitting}}">管理</button></view>
    </view>

    <view class="section-label">03 · 紧急联系与提交</view>
    <view class="card form-card"><view class="info-row"><text class="info-label">紧急联系人</text><text class="info-value">{{profile.emergencyName}} {{profile.emergencyPhone}}</text></view><view class="privacy-note">信息仅用于活动组织与紧急安全联络，敏感字段仅展示云端脱敏值。</view></view>
  </block>
  <view wx:if="{{errors.length}}" class="error-card"><view class="error-title">请处理以下问题</view><view wx:for="{{errors}}" wx:key="*this">{{item}}</view></view>
  <view class="fixed"><button class="btn" loading="{{submitting}}" disabled="{{loading || submitting || !profile || !readiness.canRegister || !activityCanSubmit}}" bindtap="submit">提交审核</button></view>
</view>
