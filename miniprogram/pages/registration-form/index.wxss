.form-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #0b0b0c;
  color: #f7f7f5;
}

.form-head {
  padding: 12rpx 0 8rpx;
}

.step-line {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-bottom: 20rpx;
  color: #747c77;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.step {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 6rpx;
  white-space: nowrap;
}

.step-number {
  color: #89918b;
  font-variant-numeric: tabular-nums;
}

.step-active,
.step-active .step-number {
  color: #e9753b;
}

.step-rule {
  min-width: 12rpx;
  height: 1rpx;
  flex: 1;
  margin: 0 10rpx;
  background: #3a3a3e;
}

.title-row,
.context-head,
.strava-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.hero-kicker,
.context-kicker {
  color: #d55b1f;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.form-title {
  margin: 4rpx 0 14rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.step-caption {
  flex: 0 0 auto;
  color: #89918b;
  font-size: 19rpx;
  font-weight: 800;
}

.activity-context,
.submit-note {
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid #303735;
  border-left: 6rpx solid #d55b1f;
  border-radius: 8rpx;
  background: #111517;
}

.context-status {
  min-width: 0;
  color: #e9a071;
  font-size: 21rpx;
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}

.context-title {
  display: -webkit-box;
  margin-top: 5rpx;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.context-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 18rpx;
  margin-top: 6rpx;
  color: #a8b0ab;
  font-size: 22rpx;
  line-height: 1.45;
}

.submit-note {
  margin-top: 10rpx;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  border-left-color: #69716c;
  color: #a8b0ab;
  font-size: 21rpx;
  line-height: 1.5;
}

.form-page .section-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 22rpx;
  color: #f4f7f2;
  font-size: 27rpx;
  font-weight: 900;
}

.section-label > text {
  flex: 0 0 auto;
  color: #d55b1f;
  font-size: 20rpx;
  line-height: 1.8;
}

.section-hint {
  margin-top: 1rpx;
  color: #89918b;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
}

.form-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 9rpx;
  padding: 20rpx;
  overflow: hidden;
  border: 1rpx solid #2b3130;
  border-radius: 10rpx;
  background: #171b1d;
  color: #f4f7f2;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.22);
}

.identity-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto;
  align-items: center;
  gap: 14rpx;
}

.identity-main {
  min-width: 0;
}

.identity-label,
.info-label {
  color: #89918b;
  font-size: 20rpx;
}

.identity-value,
.info-value {
  min-width: 0;
  margin-top: 2rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.field-title {
  min-width: 0;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.field-hint {
  margin-top: 5rpx;
  color: #929a95;
  font-size: 21rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.required,
.optional {
  margin-left: 6rpx;
  font-size: 19rpx;
}

.required {
  color: #e9753b;
}

.optional {
  color: #89918b;
  font-weight: 500;
}

.text-button {
  box-sizing: border-box;
  min-width: 94rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid #4a524e;
  background: transparent;
  color: #e9753b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 86rpx;
}

.choice-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.choice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  min-width: 0;
  min-height: 112rpx;
  padding: 14rpx 12rpx;
  border: 2rpx solid #343b39;
  border-radius: 10rpx;
  background: #0d1012;
  color: #cbd1cc;
  font-size: 23rpx;
}

.choice radio {
  flex: 0 0 auto;
  transform: scale(0.82);
  transform-origin: left top;
}

.choice-copy {
  min-width: 0;
}

.choice-title {
  font-weight: 800;
  overflow-wrap: anywhere;
}

.choice-meta,
.choice-remain {
  margin-top: 3rpx;
  color: #929a95;
  font-size: 20rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.choice-remain {
  color: #c7cec9;
}

.choice.selected,
.segment.selected {
  border-color: #d55b1f;
  background: rgba(213, 91, 31, 0.12);
  color: #ffe6d6;
}

.choice.is-disabled {
  border-color: #292e2c;
  background: #0a0c0d;
  color: #68706b;
  opacity: 0.72;
}

.experience-segment {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 12rpx;
  overflow: hidden;
  border: 1rpx solid #3a403e;
  border-radius: 8rpx;
  background: #0d1012;
}

.segment {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 8rpx 6rpx;
  border-right: 1rpx solid #3a403e;
  color: #aeb5b0;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  overflow-wrap: anywhere;
}

.segment:last-child {
  border-right: 0;
}

.segment radio {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.strava-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
  margin-top: 18rpx;
  padding: 16rpx;
  border: 1rpx solid #343b39;
  border-left: 5rpx solid #69716c;
  border-radius: 8rpx;
  background: #0d1012;
}

.strava-copy {
  min-width: 0;
  flex: 1;
}

.readiness-badge {
  flex: 0 0 auto;
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: #292f2c;
  color: #bfc7c1;
  font-size: 19rpx;
  font-weight: 800;
}

.status-ready {
  border-left-color: #6f9b82;
}

.status-ready .readiness-badge {
  background: rgba(111, 155, 130, 0.18);
  color: #a9cbb6;
}

.status-syncing {
  border-left-color: #d59a3a;
}

.status-failed,
.status-disconnected {
  border-left-color: #d55b1f;
}

.remark {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #343b39;
  border-radius: 8rpx;
  background: #0d1012;
  color: #f4f7f2;
}

.safety-box {
  display: grid;
  grid-template-columns: minmax(110rpx, 0.7fr) minmax(0, 1.7fr);
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #303735;
  border-radius: 8rpx;
  background: #0d1012;
}

.info-value {
  margin-top: 0;
  text-align: right;
}

.privacy-note {
  margin-top: 12rpx;
  color: #929a95;
  font-size: 20rpx;
  line-height: 1.5;
}

.error-card {
  margin: 20rpx 0;
  padding: 20rpx;
  border: 1rpx solid #ff5c61;
  border-radius: 8rpx;
  background: #281417;
  color: #ff9a9d;
}

.error-title {
  margin-bottom: 8rpx;
  color: #ffd4d5;
  font-weight: 900;
}

.error-item {
  margin-top: 5rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.form-page .fixed {
  box-sizing: border-box;
  min-height: var(--fixed-action-reserve);
  min-height: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  min-height: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  border-top: 1rpx solid #303735;
  background: rgba(11, 11, 12, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.42);
}

.action-bar {
  display: grid;
  grid-template-columns: minmax(150rpx, 0.7fr) minmax(0, 1.3fr);
  gap: 14rpx;
}

.action-bar button {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
}

.back-button {
  border: 1rpx solid #4a524e;
  background: #111517;
  color: #cbd1cc;
}

.form-page .submit-button {
  background: #a94416;
  color: #f7f7f5;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.form-page button[disabled] {
  opacity: 0.48;
}

.disabled-hint {
  grid-column: 1 / -1;
  color: #9aa39d;
  font-size: 20rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .page.form-page {
    --fixed-action-reserve: var(--fixed-action-reserve-narrow);
  }

  .form-title {
    font-size: 38rpx;
  }

  .title-row {
    align-items: flex-start;
  }

  .step-caption {
    display: none;
  }

  .identity-card,
  .choice-group,
  .action-bar,
  .safety-box {
    grid-template-columns: 1fr;
  }

  .identity-action {
    width: 100%;
  }

  .info-value {
    text-align: left;
  }

  .strava-row {
    align-items: stretch;
    flex-direction: column;
  }

  .strava-row .text-button {
    width: 100%;
  }

  .disabled-hint {
    grid-column: 1;
  }
}
