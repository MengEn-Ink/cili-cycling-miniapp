page {
  background: #0b0b0c;
}

.form-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-top: 12rpx;
  padding-right: var(--page-gutter);
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  padding-left: var(--page-gutter);
  overflow-x: hidden;
  background: #000;
  color: #f7f7f5;
}

.form-head {
  padding: 4rpx 0 18rpx;
}

.step-line,
.title-row,
.context-head,
.strava-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
}

.step-line {
  margin-bottom: 14rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.step {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 6rpx;
  white-space: nowrap;
}

.step-number {
  color: #89918b;
  font-variant-numeric: tabular-nums;
}

.step-active,
.step-active .step-number {
  color: var(--color-brand);
}

.step-rule {
  min-width: 12rpx;
  max-width: 64rpx;
  height: 1rpx;
  flex: 1;
  margin: 0 8rpx;
  background: #3a3a3c;
}

.hero-kicker,
.context-kicker {
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.form-title {
  margin: 3rpx 0 12rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: 0;
  text-align: center;
}

.step-caption {
  flex: 0 0 auto;
  color: #89918b;
  font-size: 20rpx;
  font-weight: 800;
}

.activity-context,
.submit-note {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  background: #1c1c1e;
}

.activity-context {
  padding: 16rpx 20rpx;
  border: 1rpx solid #3a3a3c;
  border-left: 6rpx solid var(--color-brand);
  border-radius: var(--radius-display) var(--radius-display) var(--radius-md) var(--radius-md);
}

.context-status {
  min-width: 0;
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}

.context-title {
  display: -webkit-box;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.context-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 18rpx;
  margin-top: 4rpx;
  color: #a8b0ab;
  font-size: 21rpx;
}

.submit-note {
  margin-top: 2rpx;
  padding: 11rpx 20rpx 13rpx;
  border-radius: 14rpx 14rpx 28rpx 28rpx;
  color: #a8b0ab;
  font-size: 20rpx;
  line-height: 1.45;
}

.form-surface {
  overflow: hidden;
  margin-top: 4rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: var(--radius-display);
  background: #1c1c1e;
}

.form-section {
  padding: 18rpx 20rpx;
  border-top: 1rpx solid #3a3a3c;
}

.form-section.first-section {
  border-top: 0;
}

.form-section.last-section {
  padding-bottom: 22rpx;
}

.form-page .section-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #f4f7f2;
  font-size: 26rpx;
  font-weight: 900;
}

.section-label > text {
  flex: 0 0 auto;
  color: var(--color-brand);
  font-size: 19rpx;
  line-height: 1.8;
}

.section-hint {
  margin-top: 1rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.35;
}

.form-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 9rpx;
  background: #1c1c1e;
  color: #f4f7f2;
}

.identity-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 24rpx;
  background: #111113;
}

.identity-main,
.strava-copy {
  min-width: 0;
}

.identity-label,
.info-label {
  color: #89918b;
  font-size: 19rpx;
}

.identity-value,
.info-value {
  min-width: 0;
  margin-top: 2rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.field-title {
  min-width: 0;
  font-weight: 800;
  overflow-wrap: anywhere;
  text-align: left;
}

.field-hint {
  margin-top: 4rpx;
  color: #929a95;
  font-size: 20rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.required,
.optional {
  margin-left: 6rpx;
  font-size: 20rpx;
}

.required,
.text-button {
  color: var(--color-brand);
}

.optional {
  color: #89918b;
  font-weight: 500;
}

.text-button {
  box-sizing: border-box;
  min-width: 94rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: 20rpx;
  background: #1c1c1e;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 74rpx;
}

.choice-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 11rpx;
}

.choice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  min-width: 0;
  min-height: 104rpx;
  padding: 13rpx 11rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: 24rpx;
  background: #111113;
  color: #cbd1cc;
  font-size: 22rpx;
}

.choice radio {
  flex: 0 0 auto;
  transform: scale(0.82);
  transform-origin: left top;
}

.choice-copy {
  min-width: 0;
}

.choice-title {
  font-weight: 900;
  overflow-wrap: anywhere;
}

.choice-meta,
.choice-remain {
  margin-top: 2rpx;
  color: #929a95;
  font-size: 19rpx;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.choice-remain {
  color: #c7cec9;
}

.choice.selected,
.segment.selected {
  border-color: var(--color-brand);
  background: #2b1812;
  color: #fff;
}

.choice.is-disabled {
  border-color: #29292b;
  background: #0d0d0e;
  color: #68706b;
  opacity: 0.72;
}

.experience-segment {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 10rpx;
  overflow: hidden;
  border: 1rpx solid #3a3a3c;
  border-radius: 24rpx;
  background: #111113;
}

.segment {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 104rpx;
  padding: 6rpx;
  border-right: 1rpx solid #3a3a3c;
  color: #aeb5b0;
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
  overflow-wrap: anywhere;
}

.segment:last-child {
  border-right: 0;
}

.segment radio {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.strava-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
  margin-top: 12rpx;
  padding: 13rpx 14rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: 24rpx;
  background: #111113;
}

.strava-copy {
  flex: 1;
}

.strava-brand {
  display: inline-flex;
  padding: 4rpx 9rpx;
  border-radius: 8rpx;
  background: var(--color-brand);
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.readiness-badge {
  flex: 0 0 auto;
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: #29292b;
  color: #bfc7c1;
  font-size: 20rpx;
  font-weight: 800;
}

.status-ready {
  border-color: #496957;
}

.status-ready .readiness-badge {
  background: #203128;
  color: #a9cbb6;
}

.status-syncing,
.status-authorizing {
  border-color: #8c6529;
}

.status-failed,
.status-disconnected {
  border-color: var(--color-brand);
}

.remark {
  box-sizing: border-box;
  width: 100%;
  min-height: 140rpx;
  margin-top: 10rpx;
  padding: 14rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: 24rpx;
  background: #111113;
  color: #f4f7f2;
}

.safety-box {
  display: grid;
  grid-template-columns: minmax(110rpx, 0.7fr) minmax(0, 1.7fr);
  gap: 14rpx;
  margin-top: 10rpx;
  padding: 13rpx 14rpx;
  border-radius: 20rpx;
  background: #111113;
}

.info-value {
  margin-top: 0;
  text-align: right;
}

.privacy-note {
  margin-top: 9rpx;
  color: #929a95;
  font-size: 19rpx;
  line-height: 1.45;
}

.error-card {
  margin: 16rpx 0;
  padding: 18rpx;
  border: 1rpx solid #ff5c61;
  border-radius: 24rpx;
  background: #281417;
  color: #ff9a9d;
}

.error-title {
  margin-bottom: 6rpx;
  color: #ffd4d5;
  font-weight: 900;
}

.error-item {
  margin-top: 4rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.form-page .fixed {
  box-sizing: border-box;
  min-height: var(--fixed-action-reserve);
  min-height: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  min-height: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  border-top: 1rpx solid #3a3a3c;
  background: rgba(11, 11, 12, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.42);
}

.action-bar {
  display: grid;
  grid-template-columns: minmax(150rpx, 0.7fr) minmax(0, 1.3fr);
  gap: 12rpx;
}

.action-bar button {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  border-radius: 28rpx !important;
}

.back-button {
  border: 1rpx solid #3a3a3c;
  background: #1c1c1e;
  color: #cbd1cc;
}

.form-page .submit-button {
  background: var(--color-brand);
  color: #fff;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.form-page button[disabled] {
  opacity: 0.48;
}

.disabled-hint {
  grid-column: 1 / -1;
  color: #9aa39d;
  font-size: 19rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .page.form-page {
    --fixed-action-reserve: var(--fixed-action-reserve-narrow);
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }

  .form-title {
    font-size: 38rpx;
  }

  .title-row {
    align-items: flex-start;
  }

  .step-caption {
    display: none;
  }

  .identity-card,
  .choice-group,
  .action-bar,
  .safety-box {
    grid-template-columns: 1fr;
  }

  .identity-action,
  .strava-row .text-button {
    width: 100%;
  }

  .info-value {
    text-align: left;
  }

  .strava-row {
    align-items: stretch;
    flex-direction: column;
  }

  .disabled-hint {
    grid-column: 1;
  }
}

@media (max-width: 320px) {
  .experience-segment {
    box-sizing: border-box;
    width: 100%;
  }

  .segment {
    padding-right: 2rpx;
    padding-left: 2rpx;
    font-size: 20rpx;
  }
}

page,
.form-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.activity-context,
.submit-note,
.form-surface,
.form-card {
  border-color: var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}
.activity-context,
.form-surface {
  border-radius: var(--radius-display);
}
.form-section {
  border-color: var(--color-border);
}
.identity-card,
.choice,
.experience-segment,
.strava-row,
.safety-box {
  border-color: var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-raised);
  color: var(--color-text);
}
.segment {
  min-height: 104rpx;
  border-color: var(--color-border);
  color: var(--color-muted);
}
.choice.selected,
.segment.selected {
  border-color: var(--color-brand);
  background: var(--color-brand-soft);
  color: var(--color-text);
}
.field-hint,
.choice-meta,
.privacy-note,
.context-meta,
.submit-note,
.section-hint {
  color: var(--color-muted);
}
.remark {
  border-color: var(--color-border-strong);
  border-radius: var(--radius-md);
  background: var(--color-input-bg);
  color: var(--color-text);
}
.form-page .fixed {
  border-color: var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 28rpx var(--color-shadow);
}
.action-bar button,
.text-button {
  min-height: 88rpx;
  border-radius: var(--radius-display) !important;
}
.back-button,
.text-button {
  border-color: var(--color-border);
  background: var(--color-input-bg);
  color: var(--color-text);
}
.form-page .submit-button {
  background: var(--color-brand);
  color: var(--color-on-brand);
}

.status-ready {
  border-color: var(--color-success);
}
.status-syncing,
.status-authorizing {
  border-color: var(--color-warning);
}
.status-failed,
.status-disconnected {
  border-color: var(--color-danger);
}
