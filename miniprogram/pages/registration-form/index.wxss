page {
  background: var(--color-bg);
}

.form-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-top: 20rpx;
  padding-right: var(--page-gutter);
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  padding-left: var(--page-gutter);
  overflow-x: hidden;
  background: var(--color-bg);
  color: var(--color-text);
}

.form-head {
  padding: 2rpx 0 22rpx;
}

.title-row,
.context-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.step-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  margin-bottom: 22rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.step {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 7rpx;
  min-width: 0;
  white-space: nowrap;
}

.step-number {
  color: var(--color-subtle);
  font-variant-numeric: tabular-nums;
}

.step-active,
.step-active .step-number {
  color: var(--color-brand);
}

.step-rule {
  min-width: 20rpx;
  max-width: 64rpx;
  height: 1rpx;
  flex: 1;
  margin: 0 14rpx;
  background: var(--color-border-strong);
}

.title-row {
  justify-content: flex-start;
  margin-bottom: 16rpx;
}

.form-title {
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 0;
  text-align: center;
}

.activity-context,
.submit-note,
.form-surface,
.form-card {
  box-sizing: border-box;
  width: 100%;
}

.activity-context {
  padding: 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.context-head {
  justify-content: space-between;
  gap: 16rpx;
}

.context-kicker {
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 700;
}

.context-status {
  flex: 0 0 auto;
  max-width: 44%;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand-active);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.context-title {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.context-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 20rpx;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
}

.submit-note {
  margin-top: 12rpx;
  padding: 0 4rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.form-surface {
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.form-section {
  padding: 24rpx 22rpx;
  border-top: 1rpx solid var(--color-border);
  border-color: var(--color-border);
}

.form-section.first-section {
  border-top: 0;
}

.form-section.last-section {
  padding-bottom: 28rpx;
}

.form-page .section-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.section-label > text {
  flex: 0 0 auto;
  color: var(--color-brand);
  font-size: 20rpx;
  line-height: 1.8;
  font-variant-numeric: tabular-nums;
}

.section-hint {
  margin-top: 1rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.45;
}

.form-card {
  margin-top: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
}

.identity-card {
  padding: 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-raised);
}

.identity-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 0.62fr minmax(0, 1.35fr);
  align-items: stretch;
  min-width: 0;
}

.identity-main {
  min-width: 0;
  padding: 0 16rpx;
  border-left: 1rpx solid var(--color-border);
}

.identity-main:first-child {
  padding-left: 0;
  border-left: 0;
}

.identity-main:last-child {
  padding-right: 0;
}

.identity-label,
.info-label {
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.35;
}

.identity-value,
.info-value {
  margin-top: 6rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.identity-phone {
  font-variant-numeric: tabular-nums;
}

.text-button,
.profile-alert-action {
  box-sizing: border-box;
  min-height: 76rpx;
  margin: 0;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-action);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 74rpx;
}

.identity-action {
  width: 100%;
  margin-top: 16rpx;
}

.profile-alert,
.error-card {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--color-danger);
  border-radius: var(--radius-md);
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}

.profile-alert {
  margin-top: 14rpx;
  padding: 18rpx;
}

.profile-alert-title,
.error-title {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.profile-alert-item,
.error-item {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
}

.profile-alert-note {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.profile-alert-action {
  width: 100%;
  margin-top: 14rpx;
  border-color: var(--color-danger);
  color: var(--color-danger-text);
}

.field-title {
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.4;
  text-align: left;
}

.required,
.optional {
  display: inline-flex;
  align-items: center;
  min-height: 32rpx;
  margin-left: 8rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 32rpx;
  vertical-align: 3rpx;
}

.required {
  background: var(--color-brand-soft);
  color: var(--color-brand-active);
}

.optional {
  background: var(--color-raised);
  color: var(--color-muted);
}

.field-hint,
.team-note,
.privacy-note {
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.field-hint {
  margin-top: 5rpx;
}

.choice-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.choice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  min-width: 0;
  min-height: 118rpx;
  padding: 18rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 22rpx;
  transition:
    border-color 120ms ease-out,
    background-color 120ms ease-out;
}

.choice.selected {
  border-color: var(--color-brand);
  background: var(--color-brand-soft);
}

.choice:active {
  background: var(--color-raised);
}

.choice radio {
  flex: 0 0 auto;
  margin-top: 2rpx;
  margin-right: 12rpx;
  transform: scale(0.88);
  transform-origin: top left;
}

.choice-copy {
  min-width: 0;
  flex: 1;
}

.choice-name {
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.choice-meta {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.4;
}

.capacity-line {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 12rpx;
}

.choice.disabled {
  border-color: var(--color-border);
  background: var(--color-raised);
  color: var(--color-disabled-text);
}

.choice.disabled .choice-name,
.choice.disabled .choice-meta {
  color: var(--color-disabled-text);
}

.experience-segment {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  margin-top: 12rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.segment {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 104rpx;
  padding: 10rpx 8rpx;
  border-right: 1rpx solid var(--color-border);
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
  overflow-wrap: anywhere;
}

.segment:last-child {
  border-right: 0;
}

.segment.selected {
  background: var(--color-brand-soft);
  color: var(--color-brand-active);
}

.segment radio {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.safety-box {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-raised);
}

.team-card,
.capability-card,
.gathering-card {
  min-width: 0;
}

.gathering-default {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-color: var(--color-brand-border);
  background: var(--color-brand-soft);
}

.default-choice-copy {
  min-width: 0;
}

.default-choice-copy .field-hint {
  margin-top: 6rpx;
}

.default-choice-badge {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  color: var(--color-brand-dark);
  font-size: 20rpx;
  font-weight: 700;
}

.team-invite {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.team-note {
  margin: 14rpx 0 8rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.switch-row:first-of-type {
  border-top: 0;
}

.switch-row switch {
  flex: 0 0 auto;
  transform: scale(0.88);
  transform-origin: center right;
}

.input,
.capability-card input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 10rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-md);
  background: var(--color-input-bg);
  color: var(--color-text);
  font-size: 23rpx;
  line-height: 1.45;
}

.input,
.capability-card input {
  min-height: 82rpx;
  padding: 0 16rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 16rpx;
}

.input-placeholder {
  color: var(--color-placeholder);
}

.safety-box {
  display: grid;
  grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 16rpx;
}

.safety-box .info-value {
  margin-top: 0;
  text-align: right;
}

.privacy-note {
  margin-top: 12rpx;
}

.error-card {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
}

.action-bar {
  z-index: 20;
  display: grid;
  grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
  gap: 12rpx;
  box-sizing: border-box;
  min-height: var(--fixed-action-reserve);
  min-height: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  min-height: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  padding: 16rpx var(--page-gutter);
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 28rpx var(--color-shadow);
}

.form-page .fixed {
  background: var(--color-fixed-bar);
}

.action-bar button {
  width: 100%;
  min-height: var(--control-height);
  margin: 0;
  border-radius: var(--radius-md);
  font-size: 25rpx;
  font-weight: 900;
  line-height: var(--control-height);
}

.back-button {
  border: 1rpx solid var(--color-border-strong);
  background: var(--color-surface);
  color: var(--color-action);
}

.submit-button {
  border: 0;
  background: var(--color-action);
  color: var(--color-on-action);
}

.form-page .submit-button {
  background: var(--color-action);
  color: var(--color-on-action);
}

.submit-button:active {
  background: var(--color-action-active);
}

.form-page button[disabled],
.form-page .choice.disabled {
  opacity: 1;
}

.form-page button[disabled] {
  border-color: var(--color-border);
  background: var(--color-raised);
  color: var(--color-disabled-text);
}

.disabled-hint {
  grid-column: 1 / -1;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

@media (max-width: 320px) {
  .experience-segment {
    box-sizing: border-box;
    width: 100%;
  }

  .segment {
    padding-right: 4rpx;
    padding-left: 4rpx;
    font-size: 20rpx;
  }
}

@media (max-width: 340px) {
  .page.form-page {
    --fixed-action-reserve: var(--fixed-action-reserve-narrow);
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }

  .form-title {
    font-size: 38rpx;
  }

  .identity-grid,
  .choice-group,
  .action-bar,
  .safety-box {
    grid-template-columns: 1fr;
  }

  .identity-main {
    padding: 12rpx 0;
    border-top: 1rpx solid var(--color-border);
    border-left: 0;
  }

  .identity-main:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .identity-main:last-child {
    padding-bottom: 0;
  }

  .identity-action {
    width: 100%;
  }

  .safety-box .info-value {
    text-align: left;
  }

  .action-bar {
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }
}
