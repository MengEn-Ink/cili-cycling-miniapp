/* 骑行影像志 · 填写报名 1:1 实现
 * 对齐 docs/designs/2026-10-22-cycling-image-journal/pages/registration-form.html：
 *   pageheading → content.tight(timeline + form + section × 4 + check + notice + 底部提交) → fixed actionbar
 */

.form-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

/* --- pageheading --------------------------------------------------------- */
.pageheading {
  padding: 32rpx 0 24rpx;
}

.pageheading-title {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  font-family: var(--font-family-editorial);
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: var(--color-text);
}
.pageheading-sub {
  margin-top: var(--space-3);
  color: var(--color-muted);
  font-size: var(--font-size-body);
  line-height: 44rpx;
}
.pageheading-sub--meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0 var(--space-4);
  margin-top: 4rpx;
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
}

/* --- content wrapper ---------------------------------------------------- */
.content {
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}
.content.tight {
  gap: 40rpx;
}

/* --- timeline ----------------------------------------------------------- */
.timeline {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-2);
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-surface);
}
.timeline > .step {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  padding: 8rpx 0;
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
  font-weight: 800;
}
.timeline > .step.active {
  color: var(--color-text);
}
.timeline .step-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-raised);
  color: var(--color-text);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  font-weight: 900;
}
.timeline > .step.active .step-index {
  background: var(--color-text);
  color: var(--color-on-action);
}

/* --- section + chapterhead ---------------------------------------------- */
.section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.chapterhead {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.chapterhead-title {
  flex: none;
  color: var(--color-text);
  font-family: var(--font-family-editorial);
  font-size: var(--font-size-title);
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.chapterhead-rule {
  flex: 1;
  min-width: 0;
  height: 2rpx;
  background: var(--color-border);
}
.chapterhead-aside {
  flex: none;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
  letter-spacing: 1rpx;
}

/* --- paper -------------------------------------------------------------- */
.paper {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: var(--space-4);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

/* --- detailrows --------------------------------------------------------- */
.detailrows {
  display: flex;
  flex-direction: column;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  overflow: hidden;
}
.detailrow {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--color-surface);
}
.detailrow + .detailrow {
  border-top: 2rpx solid var(--color-border-subtle);
}
.detailrow-term {
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
  letter-spacing: 1rpx;
}
.detailrow-desc {
  color: var(--color-text);
  font-size: var(--font-size-body);
  line-height: 36rpx;
  word-break: break-all;
}

/* --- row link ----------------------------------------------------------- */
.row.rowlink.rowbutton {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 112rpx;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  text-align: left;
}
.row.rowlink.rowbutton::after {
  display: none;
}
.lead {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}
.rowicon {
  flex: none;
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--color-text);
  border-radius: 14rpx;
  background: var(--color-bg);
  position: relative;
}
.rowicon--pen::before {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 24rpx;
  height: 2rpx;
  background: var(--color-text);
  transform: rotate(-45deg);
  transform-origin: top right;
  content: '';
}
.rowicon--pen::after {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  width: 10rpx;
  height: 10rpx;
  background: var(--color-text);
  border-radius: 2rpx 0 0 2rpx;
  content: '';
}
.rowtext {
  flex: 1;
  min-width: 0;
}
.rowtext .em {
  display: block;
  color: var(--color-text);
  font-size: var(--font-size-body);
  line-height: 40rpx;
  font-weight: 900;
}
.rowtext .sub {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 34rpx;
}
.chev {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--color-text);
  border-right: 2rpx solid var(--color-text);
  transform: rotate(45deg);
}

/* --- choice-group (集合方式) --------------------------------------------- */
.choice-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.choice {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
}
.choice.selected {
  border-color: var(--color-text);
  background: var(--color-raised);
}
.choice radio {
  flex: none;
}
.choice-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.choice-title {
  font-size: var(--font-size-body);
  font-weight: 800;
}
.choice-meta {
  display: flex;
  gap: var(--space-3);
  color: var(--color-muted);
  font-size: var(--font-size-label);
}

/* --- field + experience segment ---------------------------------------- */
.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.field-label {
  color: var(--color-text);
  font-size: var(--font-size-body);
  font-weight: 800;
}
.field-flag {
  margin-left: var(--space-2);
  color: var(--color-muted);
  font-size: var(--font-size-label);
  font-weight: 600;
}
.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: var(--font-size-body);
  line-height: 40rpx;
  box-sizing: border-box;
}
.field-placeholder {
  color: var(--color-placeholder);
}
.field-counter {
  text-align: right;
  color: var(--color-muted);
  font-family: var(--font-family-mono);
  font-size: var(--font-size-label);
}

.experience-segment {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-2);
}
.segment-choice {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  padding: 14rpx 12rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: var(--font-size-body);
  font-weight: 800;
}
.segment-choice.selected {
  background: var(--color-text);
  color: var(--color-on-action);
  border-color: var(--color-text);
}
.segment-choice radio {
  display: none;
}

/* --- check -------------------------------------------------------------- */
.check {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 16rpx 20rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  color: var(--color-text);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}

/* --- notice ------------------------------------------------------------ */
.notice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-muted);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}
.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: var(--space-2);
  border-radius: 50%;
  background: var(--color-text);
}
.notice-copy {
  flex: 1;
  min-width: 0;
}
.notice-title {
  color: var(--color-text);
  font-size: var(--font-size-body);
  font-weight: 800;
  line-height: 36rpx;
}
.notice-item {
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: var(--font-size-label);
  line-height: 36rpx;
}
.notice--info {
  border-style: solid;
  color: var(--color-text);
}
.notice--warning {
  border-style: solid;
  border-color: var(--color-status-warning);
  color: var(--color-status-warning);
}
.notice--warning .notice-title,
.notice--warning .notice-item {
  color: var(--color-status-warning);
}

.small {
  font-size: var(--font-size-label);
  line-height: 34rpx;
}
.muted {
  color: var(--color-muted);
}

/* --- actionbar --------------------------------------------------------- */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-border);
}
.actionbar-hint {
  color: var(--color-brand);
  font-size: var(--font-size-label);
  line-height: 32rpx;
  text-align: center;
}
.actionbar-row {
  display: flex;
  gap: var(--space-3);
}
.actionbar-row .btn {
  flex: 1;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--color-text);
  border-radius: var(--radius-full);
  background: var(--color-text);
  color: var(--color-on-action);
  font-size: var(--font-size-body);
  line-height: 40rpx;
  font-weight: 800;
}
.btn::after {
  display: none;
}
.btn[disabled] {
  opacity: 0.6;
}
.btn.secondary {
  background: var(--color-surface);
  color: var(--color-text);
}

@media (max-width: 350px) {
  .pageheading-title {
    font-size: 56rpx;
    line-height: 72rpx;
  }
  .experience-segment {
    gap: var(--space-1);
  }
}

/* 2026-10-28 · Direction A / 暗场标题 + 高对比暗色表单 */
.form-page {
  padding-bottom: calc(248rpx + env(safe-area-inset-bottom));
  background: var(--color-cinema-bg);
  color: var(--color-cinema-text);
}
.form-page .pageheading {
  padding: 40rpx 0 28rpx;
}

.form-page .pageheading-title,
.form-page .chapterhead-title {
  color: var(--color-cinema-text);
}
.form-page .pageheading-sub,
.form-page .chapterhead-aside,
.form-page form > .small.muted {
  color: var(--color-cinema-muted);
}
.form-page .timeline {
  gap: 4rpx;
  padding: 0;
  overflow: hidden;
  border-color: var(--color-cinema-line);
  border-radius: 0;
  background: var(--color-cinema-bg);
}
.form-page .timeline > .step {
  min-height: 72rpx;
  padding: 12rpx 8rpx;
  background: var(--color-cinema-panel-raised);
  color: var(--color-cinema-muted);
}
.form-page .timeline > .step.active {
  background: var(--color-cinema-red);
  color: var(--color-on-action);
}
.form-page .timeline .step-index,
.form-page .timeline > .step.active .step-index {
  background: transparent;
  color: currentColor;
}
.form-page .chapterhead-rule {
  background: var(--color-cinema-line);
}
.form-page .paper {
  border-color: var(--color-border-strong);
  border-radius: 18rpx;
  background: var(--color-paper);
  color: var(--color-ink);
  box-shadow: var(--shadow-floating);
}
.form-page .paper .notice {
  background: var(--color-bg);
}
.form-page form > .check,
.form-page form > .notice {
  border-color: var(--color-cinema-line);
  background: var(--color-cinema-panel);
  color: var(--color-cinema-text);
}
.form-page form > .notice .notice-title,
.form-page form > .notice .notice-item {
  color: var(--color-cinema-text);
}
.form-page form > .notice .notice-dot {
  background: var(--color-cinema-red);
}
.form-page .segment-choice.selected,
.form-page .choice.selected {
  border-color: var(--color-cinema-red);
  background: var(--color-brand-soft);
  color: var(--color-text);
}
.form-page .actionbar {
  border-color: var(--color-cinema-line);
  background: var(--color-fixed-bar);
  box-shadow: var(--shadow-actionbar);
}
.form-page .btn {
  border-color: var(--color-cinema-red);
  border-radius: 10rpx;
  background: var(--color-cinema-red);
  color: var(--color-on-action);
}
.form-page .btn.secondary {
  border-color: var(--color-border-strong);
  background: var(--color-cinema-panel);
  color: var(--color-cinema-text);
}

@media (max-width: 350px) {
  .form-page .timeline > .step {
    flex-direction: column;
    gap: 2rpx;
    font-size: var(--font-size-label);
  }
}
