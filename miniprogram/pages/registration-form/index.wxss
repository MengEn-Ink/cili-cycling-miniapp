.form-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #090b0f;
  color: #f4f7f2;
}

.form-head {
  padding: 28rpx 8rpx 18rpx;
}

.step-line {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 24rpx;
  color: #69716c;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.step-line text {
  padding: 8rpx 12rpx;
  border: 1rpx solid #2b3130;
  border-radius: 6rpx;
}

.step-line .step-active {
  border-color: #d8ff36;
  color: #d8ff36;
}

.hero-kicker,
.context-kicker {
  color: #d8ff36;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.form-title {
  margin: 10rpx 0 18rpx;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.activity-context,
.submit-note {
  padding: 22rpx;
  border: 1rpx solid #303735;
  border-left: 6rpx solid #d8ff36;
  border-radius: 8rpx;
  background: #111517;
}

.context-title {
  margin-top: 8rpx;
  overflow-wrap: anywhere;
  font-size: 30rpx;
  font-weight: 900;
}

.context-meta,
.submit-note,
.form-page .muted {
  color: #9aa39d;
  font-size: 23rpx;
  line-height: 1.6;
}

.context-meta {
  margin-top: 8rpx;
}

.submit-note {
  margin-top: 14rpx;
  border-left-color: #69716c;
}

.form-page .section-label {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 34rpx;
  color: #f4f7f2;
  font-weight: 900;
}

.section-label > text {
  flex: 0 0 auto;
  color: #d8ff36;
  font-size: 22rpx;
}

.section-hint {
  margin-top: 4rpx;
  color: #7f8882;
  font-size: 21rpx;
  font-weight: 500;
}

.form-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  padding: 26rpx;
  overflow: hidden;
  border: 1rpx solid #2b3130;
  border-radius: 8rpx;
  background: #171b1d;
  color: #f4f7f2;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.24);
}

.field-head,
.strava-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.field-head > view,
.strava-copy {
  min-width: 0;
}

.field-title {
  font-weight: 800;
  overflow-wrap: anywhere;
}

.field-hint {
  margin-top: 8rpx;
  color: #89918b;
  font-size: 23rpx;
  line-height: 1.5;
}

.required {
  margin-left: 8rpx;
  color: #d8ff36;
  font-size: 20rpx;
}

.optional {
  margin-left: 8rpx;
  color: #89918b;
  font-size: 20rpx;
  font-weight: 500;
}

.text-button {
  flex: 0 0 auto;
  min-width: 96rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid #4a524e;
  background: transparent;
  color: #d8ff36;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 62rpx;
}

.info-box,
.safety-box {
  display: grid;
  grid-template-columns: minmax(120rpx, 0.8fr) minmax(0, 1.7fr);
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #303735;
  border-radius: 8rpx;
  background: #0d1012;
}

.info-label {
  color: #89918b;
  font-size: 23rpx;
}

.info-value {
  min-width: 0;
  text-align: right;
  overflow-wrap: anywhere;
}

.choice-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.choice-group.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.choice {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 92rpx;
  padding: 16rpx;
  border: 2rpx solid #343b39;
  border-radius: 10rpx;
  background: #0d1012;
  color: #cbd1cc;
  font-size: 24rpx;
}

.choice-detail {
  align-items: flex-start;
  min-height: 126rpx;
}

.choice-copy {
  min-width: 0;
  margin-left: 4rpx;
}

.choice-title {
  font-weight: 800;
  overflow-wrap: anywhere;
}

.choice-meta {
  margin-top: 8rpx;
  color: #89918b;
  font-size: 21rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.choice.selected {
  border-color: #d8ff36;
  background: #171d14;
  color: #f7ffd4;
}

.choice.is-disabled {
  border-color: #292e2c;
  background: #0a0c0d;
  color: #68706b;
  opacity: 0.72;
}

.remark {
  box-sizing: border-box;
  width: 100%;
  min-height: 170rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #343b39;
  border-radius: 8rpx;
  background: #0d1012;
  color: #f4f7f2;
}

.strava-row {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #2b3130;
}

.readiness {
  overflow-wrap: anywhere;
}

.privacy-note {
  margin-top: 16rpx;
  color: #89918b;
  font-size: 22rpx;
  line-height: 1.55;
}

.error-card {
  margin: 24rpx 0;
  padding: 24rpx;
  border: 1rpx solid #ff5c61;
  border-radius: 8rpx;
  background: #281417;
  color: #ff9a9d;
}

.error-title {
  margin-bottom: 10rpx;
  color: #ffd4d5;
  font-weight: 900;
}

.error-item {
  margin-top: 6rpx;
  overflow-wrap: anywhere;
  line-height: 1.5;
}

.form-page .fixed {
  box-sizing: border-box;
  min-height: var(--fixed-action-reserve);
  min-height: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  min-height: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  border-top: 1rpx solid #303735;
  background: rgba(9, 11, 15, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.42);
}

.action-bar {
  display: grid;
  grid-template-columns: minmax(150rpx, 0.7fr) minmax(0, 1.3fr);
  gap: 14rpx;
}

.action-bar button {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
}

.back-button {
  border: 1rpx solid #4a524e;
  background: #111517;
  color: #cbd1cc;
}

.form-page .submit-button {
  background: #d8ff36;
  color: #090b0f;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.form-page button[disabled] {
  opacity: 0.48;
}

.disabled-hint {
  grid-column: 1 / -1;
  color: #89918b;
  font-size: 21rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .page.form-page {
    --fixed-action-reserve: var(--fixed-action-reserve-narrow);
  }

  .form-title {
    font-size: 40rpx;
  }

  .choice-group,
  .choice-group.three,
  .action-bar,
  .info-box,
  .safety-box {
    grid-template-columns: 1fr;
  }

  .info-value {
    text-align: left;
  }

  .field-head,
  .strava-row {
    align-items: stretch;
    flex-direction: column;
  }

  .text-button {
    width: 100%;
  }

  .disabled-hint {
    grid-column: 1;
  }
}
