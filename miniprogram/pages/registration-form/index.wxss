page {
  background: var(--color-bg);
}

/* 字号四级：标题 48rpx、卡片标题 36rpx、正文 28rpx、辅助 24rpx；间距 8 点栅格。 */
.form-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-top: 24rpx;
  padding-right: var(--page-gutter);
  padding-bottom: var(--fixed-action-reserve);
  padding-bottom: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  padding-left: var(--page-gutter);
  overflow-x: hidden;
  background: var(--color-bg);
  color: var(--color-text);
}

.form-head {
  padding-bottom: 8rpx;
}

.title-row,
.context-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 步骤条：三格轻量票据，当前步骤使用主题橙底白字。 */
.step-line {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  min-width: 0;
  margin-bottom: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
}

.step {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  min-height: var(--control-height);
  padding: 8rpx;
  border-left: 2rpx solid var(--color-border);
  white-space: nowrap;
}

.step:first-child {
  border-left: 0;
}

.step-number {
  flex: 0 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size: 20rpx;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.step-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.step-title,
.step-state {
  overflow: hidden;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-state {
  font-size: 20rpx;
  font-weight: 600;
}

.step-active,
.step-active .step-number {
  background: var(--color-brand);
  color: var(--color-on-brand);
}

.title-row {
  justify-content: flex-start;
  margin-bottom: 8rpx;
}

.form-title {
  color: var(--color-text);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: 0;
  text-align: center;
}

.activity-context,
.submit-note,
.form-card {
  box-sizing: border-box;
  width: 100%;
}

.submit-note {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

/* 活动信息：浅色卡片承载核心上下文，左侧主题橙短线强化识别。 */
.activity-context {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx 40rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: none;
}

.activity-context::before {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 8rpx;
  background: var(--color-brand);
  content: '';
}

.context-head {
  justify-content: space-between;
  gap: 16rpx;
}

.form-page .context-kicker {
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.context-status {
  flex: 0 0 auto;
  max-width: 44%;
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--color-brand);
  border-radius: 8rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
}

.context-title {
  display: -webkit-box;
  margin-top: 16rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.4;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.context-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

/* 分区：四张同级卡片，2px 近黑描边，不再嵌套小卡。 */
.form-card {
  margin-top: 24rpx;
  background: var(--color-surface);
  color: var(--color-text);
}

.form-section {
  padding: 32rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-display);
  box-shadow: none;
}

.form-page .section-label {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 0 24rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.4;
  letter-spacing: 0;
}

.section-label > text {
  flex: 0 0 auto;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 2.1;
  font-variant-numeric: tabular-nums;
}

.section-hint {
  margin-top: 0;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

/* 报名资料：“标签—值”行列表，每行 88rpx。 */
.identity-list {
  min-width: 0;
}

.identity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-width: 0;
  min-height: var(--control-height);
  border-bottom: 1rpx solid var(--color-border);
}

.identity-label,
.info-label {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.identity-value,
.info-value {
  min-width: 0;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: right;
  overflow-wrap: anywhere;
}

.identity-phone,
.info-value {
  font-variant-numeric: tabular-nums;
}

.form-page .text-button,
.form-page .profile-alert-action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--control-height);
  margin: 24rpx 0 0;
  border: 4rpx solid var(--color-border-strong);
  border-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.profile-alert,
.error-card {
  box-sizing: border-box;
  width: 100%;
  border: 4rpx solid var(--color-brand);
  border-radius: var(--radius-display);
  background: var(--color-surface);
  color: var(--color-text);
}

.profile-alert {
  margin-top: 24rpx;
  padding: 24rpx;
}

.profile-alert-title,
.error-title {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
}

.profile-alert-item,
.error-item {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.profile-alert-note {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.form-page .profile-alert-action {
  margin-top: 16rpx;
  border-color: var(--color-brand);
  color: var(--color-text);
}

.field-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
  text-align: left;
}

.required,
.optional {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 36rpx;
}

/* 必选：主题橙描边表示待处理；选填：灰底中性。 */
.required {
  border: 2rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
}

.optional {
  border: 2rpx solid var(--color-raised);
  background: var(--color-raised);
  color: var(--color-muted);
}

.field-hint,
.privacy-note,
.remark-count {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.field-hint {
  margin-top: 8rpx;
}

.choice-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.form-page .choice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  min-width: 0;
  min-height: 120rpx;
  padding: 16rpx 24rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
}

.form-page .choice.selected {
  border-color: var(--color-action);
  background: var(--color-action);
  color: var(--color-on-action);
}

.choice radio,
.segment radio {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.choice-copy {
  min-width: 0;
  flex: 1;
}

.choice-title {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
}

.choice-capacity {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
  min-width: 0;
  margin-top: 8rpx;
}

.choice-meta,
.choice-remain {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.choice.selected .choice-meta,
.choice.selected .choice-remain {
  color: var(--color-media-muted);
}

.gathering-default {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: var(--control-height);
}

.default-choice-copy {
  flex: 1;
  min-width: 0;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 1.4;
}

.default-choice-value {
  flex: 0 0 auto;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}

/* “默认”不是用户选择，使用灰底中性标签，不占用主题橙语义。 */
.default-choice-badge {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-raised);
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
}

/* 骑行经验：默认不选；选中态黑底白字。 */
.form-page .experience-segment {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  margin-top: 16rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: 8rpx;
  background: var(--color-surface);
}

.segment {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: var(--control-height);
  padding: 8rpx;
  border-right: 4rpx solid var(--color-border-strong);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
  overflow-wrap: anywhere;
}

.segment:last-child {
  border-right: 0;
}

.segment.selected {
  background: var(--color-action);
  color: var(--color-on-action);
}

.pending-hint {
  position: relative;
  margin-top: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 24rpx 16rpx 32rpx;
  border: 4rpx solid var(--color-brand);
  border-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.5;
}

.pending-hint::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 8rpx;
  border-radius: 4rpx 0 0 4rpx;
  background: var(--color-brand);
  content: '';
}

.team-invite {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.form-page .textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 176rpx;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: 8rpx;
  background: var(--color-input-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.input-placeholder {
  color: var(--color-placeholder);
}

.remark-count {
  margin-top: 8rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.form-page .safety-box {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: var(--control-height);
  margin-top: 16rpx;
  padding: 0;
  border: 0;
  border-top: 1rpx solid var(--color-border);
  border-radius: 0;
  background: var(--color-surface);
}

.privacy-note {
  margin-top: 16rpx;
}

.error-card {
  margin-top: 24rpx;
  padding: 24rpx;
}

/* 底部操作栏：与活动详情 .detail-action--admin 同比例 0.82 / 1.18，按钮 88rpx。 */
.action-bar {
  z-index: 20;
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: 16rpx;
  box-sizing: border-box;
  min-height: var(--fixed-action-reserve);
  min-height: calc(var(--fixed-action-reserve) + constant(safe-area-inset-bottom));
  min-height: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
  padding: 16rpx var(--page-gutter);
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 28rpx var(--color-shadow);
  align-content: end;
}

.form-page .fixed {
  background: var(--color-fixed-bar);
}

.action-bar button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--control-height);
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx !important;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.form-page .back-button {
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}

.submit-button {
  border-color: var(--color-action);
  background: var(--color-action);
  color: var(--color-on-action);
}

.form-page .submit-button {
  background: var(--color-action);
  color: var(--color-on-action);
}

.submit-button:active {
  background: var(--color-brand-active);
}

.form-page button[disabled] {
  opacity: 1;
  border-color: var(--color-border);
  background: var(--color-raised);
  color: var(--color-disabled-text);
}

.disabled-hint {
  position: relative;
  grid-column: 1 / -1;
  padding-left: 24rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.5;
}

.disabled-hint::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  background: var(--color-brand);
  content: '';
}

@media (max-width: 320px) {
  .experience-segment {
    box-sizing: border-box;
    width: 100%;
  }

  .segment {
    padding-right: 4rpx;
    padding-left: 4rpx;
    font-size: 24rpx;
  }
}

@media (max-width: 340px) {
  .page.form-page {
    --fixed-action-reserve: var(--fixed-action-reserve-narrow);
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }

  .form-title {
    font-size: 40rpx;
  }

  .step {
    flex-direction: column;
    gap: 2rpx;
  }

  .step-copy {
    align-items: center;
  }

  .step-title,
  .step-state {
    max-width: 100%;
    font-size: 20rpx;
    line-height: 28rpx;
  }

  .choice-group,
  .action-bar {
    grid-template-columns: 1fr;
  }

  .identity-row,
  .form-page .safety-box {
    flex-wrap: wrap;
    gap: 8rpx;
    padding: 16rpx 0;
  }

  .identity-value,
  .info-value {
    text-align: left;
  }

  .action-bar {
    padding-right: var(--page-gutter-narrow);
    padding-left: var(--page-gutter-narrow);
  }
}
