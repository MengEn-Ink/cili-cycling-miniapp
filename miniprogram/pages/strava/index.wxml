<view class="page strava-page">
  <view class="strava-head"><image class="strava-connect-logo" src="/assets/strava/connect-with-strava.svg" mode="widthFix" aria-label="Connect with Strava" /><view><view class="hero-kicker">STRAVA</view><view class="strava-title">授权读取活动路线</view><view class="muted">仅在创建活动并同步 Strava 路线时使用</view></view></view>
  <state-view loading="{{loading}}" error="{{!readiness ? error : ''}}" loading-title="正在读取绑定状态" loading-copy="正在检查 Strava 授权与数据准备状态" retryable="{{!readiness}}" bind:retry="load">
  <view class="error-card" wx:if="{{error}}">{{error}}</view>
  <view class="manual-auth-card" wx:if="{{manualAuthorization && authorizationUrl}}">
    <view class="manual-auth-title">扫码授权 Strava</view>
    <view class="status-help">Strava 默认仅提供 10 个共享授权名额，扩容需要向官方申请。授权仅用于读取你在创建活动时指定的线路。</view>
    <view class="qr-shell">
      <canvas id="strava-auth-qr" type="2d" class="qr-canvas" aria-label="Strava 授权二维码"></canvas>
    </view>
    <view class="status-help">点「保存二维码到相册」后，用微信或相机扫描保存的二维码，在系统浏览器完成 Strava 授权。完成后返回微信，本页会自动同步。二维码 10 分钟后失效。</view>
    <button class="btn manual-auth-save" loading="{{busyAction === 'save'}}" disabled="{{busyAction || !qrReady}}" bindtap="saveAuthorizationQr">保存二维码到相册</button>
    <button class="secondary manual-auth-copy" loading="{{busyAction === 'refresh'}}" disabled="{{busyAction}}" bindtap="refreshAuthorizationQr">刷新二维码</button>
  </view>
  <view wx:if="{{!loading && readiness}}">
    <view class="status-card status-{{readiness.state}}"><view class="status-icon">{{readiness.state === 'ready' ? '✓' : readiness.state === 'failed' ? '!' : '·'}}</view><view class="status-copy"><view class="status-title">{{readinessMessage}}</view><view wx:if="{{readiness.state === 'authorizing'}}" class="status-help">请在系统浏览器完成 Strava 授权，返回微信后会自动检查并同步。</view><view wx:elif="{{readiness.state === 'syncing'}}" class="status-help">首次授权后会自动准备数据，无需手动同步。</view><view wx:elif="{{readiness.state === 'disconnected'}}" class="status-help">点击后将生成授权二维码，扫码在系统浏览器完成授权。</view><view wx:elif="{{readiness.state === 'failed'}}" class="status-help">{{readiness.error ? readiness.error.message : 'Strava 数据准备失败'}}</view></view></view>
    <view wx:if="{{readiness.state === 'ready'}}" class="card athlete-card"><view class="section-label inner-label">已连接骑手</view><view class="athlete-name">{{readiness.athleteName || 'Strava 骑手'}}</view><view class="grid snapshot" wx:if="{{readiness.snapshot}}"><view class="metric"><view class="big">{{readiness.snapshot.totalKm === null ? '未获取' : readiness.snapshot.totalKm + ' km'}}</view><view>近 90 天里程</view></view><view class="metric"><view class="big">{{readiness.snapshot.rides90d === null ? '未获取' : readiness.snapshot.rides90d}}</view><view>骑行次数</view></view><view class="metric"><view class="big">{{readiness.snapshot.speedKmh === null ? '未获取' : readiness.snapshot.speedKmh + ' km/h'}}</view><view>加权均速</view></view><view class="metric"><view class="big">{{readiness.snapshot.longestKm === null ? '未获取' : readiness.snapshot.longestKm + ' km'}}</view><view>最长骑行</view></view></view><view wx:if="{{readiness.snapshot}}" class="muted"><view>{{snapshotMeta.coverageText}}</view><view>{{snapshotMeta.syncedAtText}}</view></view></view>
    <button wx:if="{{readiness.state === 'disconnected' || (readiness.state === 'failed' && readiness.error && readiness.error.recoveryAction === 'reauthorize') || (reauthorize && readiness.state === 'ready')}}" class="btn" loading="{{busyAction === 'connect'}}" disabled="{{busyAction}}" bindtap="connect">{{reauthorize && readiness.state === 'ready' ? '重新授权路线读取权限' : readiness.state === 'failed' ? '重新授权 Strava' : '生成授权二维码'}}</button>
    <button wx:if="{{readiness.state === 'failed' && readiness.error && readiness.error.recoveryAction === 'retry'}}" class="btn" loading="{{busyAction === 'retry'}}" disabled="{{busyAction}}" bindtap="retry">{{readiness.error.code === 'STRAVA_AUTH_STATUS_TIMEOUT' ? '重新检查授权状态' : '重试数据准备'}}</button>
    <button wx:if="{{readiness.state === 'failed' && readiness.error && readiness.error.recoveryAction === 'contact-support'}}" class="btn" disabled="{{busyAction}}" bindtap="contactSupport">联系支持</button>
    <button wx:if="{{readiness.state === 'ready' || readiness.state === 'syncing' || (readiness.state === 'failed' && readiness.error && readiness.error.recoveryAction === 'disconnect')}}" class="secondary" loading="{{busyAction === 'disconnect'}}" disabled="{{busyAction}}" bindtap="disconnect">本地断开 Strava</button>
    <view wx:if="{{readiness.state === 'ready' || readiness.state === 'syncing'}}" class="muted">本地断开不会撤销 Strava 网站中的外部授权。</view>
  </view>
  </state-view>
</view>
