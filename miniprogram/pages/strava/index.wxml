<view class="page strava-page">
  <view class="strava-head"><view class="strava-mark">S</view><view><view class="hero-kicker">STRAVA</view><view class="strava-title">骑行数据</view><view class="muted">授权与凭证由云函数安全处理</view></view></view>
  <state-view wx:if="{{loading}}" type="loading" text="正在读取绑定状态"/>
  <view class="error-card" wx:if="{{error}}">{{error}}</view>
  <view wx:if="{{!loading && readiness}}">
    <view class="status-card status-{{readiness.state}}"><view class="status-icon">{{readiness.state === 'ready' ? '✓' : readiness.state === 'failed' ? '!' : '·'}}</view><view class="status-copy"><view class="status-title">{{readinessMessage}}</view><view wx:if="{{readiness.state === 'authorizing'}}" class="status-help">请在 Strava 授权页完成操作后返回小程序。</view><view wx:elif="{{readiness.state === 'syncing'}}" class="status-help">首次授权后会自动准备数据，无需手动同步。</view><view wx:elif="{{readiness.state === 'disconnected'}}" class="status-help">连接后可用于活动报名资格核验。</view><view wx:elif="{{readiness.state === 'failed'}}" class="status-help">{{readiness.error ? readiness.error.message : 'Strava 数据准备失败'}}</view></view></view>
    <view wx:if="{{readiness.state === 'ready'}}" class="card athlete-card"><view class="section-label inner-label">已连接骑手</view><view class="athlete-name">{{readiness.athleteName || 'Strava 骑手'}}</view><view class="grid snapshot" wx:if="{{readiness.snapshot}}"><view class="metric"><view class="big">{{readiness.snapshot.totalKm === null ? '未获取' : readiness.snapshot.totalKm + ' km'}}</view><view>近 90 天里程</view></view><view class="metric"><view class="big">{{readiness.snapshot.rides90d === null ? '未获取' : readiness.snapshot.rides90d}}</view><view>骑行次数</view></view><view class="metric"><view class="big">{{readiness.snapshot.speedKmh === null ? '未获取' : readiness.snapshot.speedKmh + ' km/h'}}</view><view>加权均速</view></view><view class="metric"><view class="big">{{readiness.snapshot.longestKm === null ? '未获取' : readiness.snapshot.longestKm + ' km'}}</view><view>最长骑行</view></view></view></view>
    <button wx:if="{{readiness.state === 'disconnected'}}" class="btn" loading="{{busyAction === 'connect'}}" disabled="{{busyAction}}" bindtap="connect">前往 Strava 授权</button>
    <button wx:if="{{readiness.state === 'failed' && readiness.error && readiness.error.retryable}}" class="btn" loading="{{busyAction === 'retry'}}" disabled="{{busyAction}}" bindtap="retry">重试数据准备</button>
    <button wx:if="{{readiness.state === 'ready' || readiness.state === 'syncing' || readiness.state === 'failed'}}" class="secondary" loading="{{busyAction === 'disconnect'}}" disabled="{{busyAction}}" bindtap="disconnect">解绑 Strava</button>
  </view>
</view>
