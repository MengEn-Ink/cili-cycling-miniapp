/* ===== CILI 暗色竞技主题：Strava 页页面级接入 ===== */
page {
  background: #0b0b0c;
}
.strava-page {
  min-height: 100vh;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  background: #0b0b0c;
  color: #f7f7f5;
}

.strava-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 8rpx;
}
.strava-head .hero-kicker {
  color: var(--color-brand);
}
.strava-mark {
  display: flex;
  flex: 0 0 100rpx;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background: var(--color-brand);
  color: #0b0b0c;
  font-size: 42rpx;
  font-weight: 900;
}
.strava-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #f7f7f5;
}
.strava-page .muted {
  color: #a8a8ad;
}

.status-card {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 28rpx;
  border: 1rpx solid #343438;
  border-radius: 16rpx;
  background: #1b1b1d;
  color: #f7f7f5;
}
.status-ready {
  border-color: rgba(24, 160, 88, 0.55);
  background: rgba(24, 160, 88, 0.1);
}
.status-failed,
.status-disconnected {
  border-color: rgba(200, 32, 24, 0.55);
  background: rgba(200, 32, 24, 0.1);
}
.status-syncing,
.status-authorizing {
  border-color: rgba(200, 132, 24, 0.55);
  background: rgba(200, 132, 24, 0.1);
}
.status-icon {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #0b6b4f;
  color: #fff;
  font-weight: 800;
}
.status-failed .status-icon,
.status-disconnected .status-icon {
  background: #c82018;
}
.status-syncing .status-icon,
.status-authorizing .status-icon {
  background: #c88418;
}
.status-copy {
  min-width: 0;
}
.status-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #f7f7f5;
}
.status-help {
  margin-top: 8rpx;
  color: #a8a8ad;
  font-size: 24rpx;
}

.inner-label {
  margin: 0 0 8rpx;
}
.strava-page .section-label {
  color: #a8a8ad;
}
.athlete-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #f7f7f5;
}
.snapshot {
  margin-top: 24rpx;
}
.strava-page .card {
  border: 1rpx solid #343438;
  background: #242427;
  color: #f7f7f5;
}
.strava-page .metric {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #1b1b1d;
  color: #a8a8ad;
}
.strava-page .big {
  color: var(--color-brand);
  font-size: 34rpx;
  font-weight: 900;
}

.strava-page .btn {
  border: 0;
  background: var(--color-brand);
  color: #0b0b0c;
  font-weight: 900;
}
.strava-page .secondary {
  border: 2rpx solid #3a3a3e;
  background: #151517;
  color: #f7f7f5;
}
.error-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
}

page,
.strava-page {
  background: var(--color-bg);
  color: var(--color-text);
}
.strava-title,
.status-title,
.athlete-name {
  color: var(--color-text);
}
.strava-page .muted,
.status-help,
.strava-page .section-label {
  color: var(--color-muted);
}
.status-card,
.strava-page .card {
  border-color: var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
}
.strava-page .metric {
  border-color: var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-muted);
}
.strava-mark,
.strava-page .btn {
  background: var(--color-brand);
  color: var(--color-on-brand);
}
.strava-page .secondary {
  border-color: var(--color-border-strong);
  background: var(--color-input-bg);
  color: var(--color-text);
}

.status-ready {
  border-color: var(--color-success);
  background: var(--color-success-soft);
}
.status-failed,
.status-disconnected {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
}
.status-syncing,
.status-authorizing {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
}
