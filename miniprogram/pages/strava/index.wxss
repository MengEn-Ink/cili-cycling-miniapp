.strava-page {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.strava-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 8rpx;
}

.strava-head .hero-kicker {
  color: #ff6b35;
}

.strava-mark {
  display: flex;
  flex: 0 0 100rpx;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 42rpx;
  font-weight: 900;
}

.strava-title {
  font-size: 40rpx;
  font-weight: 800;
}

.status-card {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 28rpx;
  border: 2rpx solid #dfe7e2;
  border-radius: 22rpx;
  background: #fff;
}

.status-ready {
  border-color: #bce3ce;
  background: #f3fbf6;
}

.status-failed {
  border-color: #efcaca;
  background: #fff8f8;
}

.status-syncing,
.status-authorizing {
  border-color: #efd9aa;
  background: #fffbf3;
}

.status-icon {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #0b6b4f;
  color: #fff;
  font-weight: 800;
}

.status-failed .status-icon {
  background: #d94b4b;
}

.status-syncing .status-icon,
.status-authorizing .status-icon {
  background: #e6a23c;
}

.status-copy {
  min-width: 0;
}

.status-title {
  font-size: 30rpx;
  font-weight: 800;
}

.status-help {
  margin-top: 8rpx;
  color: #718078;
  font-size: 24rpx;
}

.inner-label {
  margin: 0 0 8rpx;
}

.athlete-name {
  font-size: 36rpx;
  font-weight: 800;
}

.snapshot {
  margin-top: 24rpx;
}

.error-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fceded;
  color: #d94b4b;
}

/* ===== CILI 暗色竞技主题：页面级接入，保持全局浅色基线不变 ===== */
.strava-page {
  min-height: 100vh;
  background: #0b0b0c;
  color: #f7f7f5;
}
.strava-head .hero-kicker {
  color: #d55b1f;
}
.strava-mark {
  background: #d55b1f;
  color: #0b0b0c;
}
.status-card {
  border-color: #343438;
  background: #1b1b1d;
  color: #f7f7f5;
}
.status-ready {
  border-color: rgba(24, 160, 88, 0.55);
  background: rgba(24, 160, 88, 0.1);
}
.status-failed {
  border-color: rgba(200, 32, 24, 0.55);
  background: rgba(200, 32, 24, 0.1);
}
.status-syncing,
.status-authorizing {
  border-color: rgba(200, 132, 24, 0.55);
  background: rgba(200, 132, 24, 0.1);
}
.status-help {
  color: #a8a8ad;
}
.strava-page .card {
  border: 1rpx solid #343438;
  background: #242427;
  color: #f7f7f5;
}
.strava-page .section-label {
  color: #a8a8ad;
}
.strava-page .muted {
  color: #a8a8ad;
}
.strava-page .metric {
  background: #1b1b1d;
  color: #a8a8ad;
}
.strava-page .big {
  color: #f38a50;
}
.strava-page .secondary {
  border: 2rpx solid #3a3a3e;
  background: #151517;
  color: #f7f7f5;
}
.error-card {
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
}
