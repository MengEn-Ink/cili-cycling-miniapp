page {
  --cili-black: #0b0b0c;
  --cili-charcoal: #1b1b1d;
  --cili-panel: #242427;
  --cili-border: #3a3a3e;
  --cili-silver: #a8a8ad;
  --cili-white: #f7f7f5;
  --cili-orange: #d55b1f;
  --cili-orange-dark: #a94416;
  --cili-red: #c82018;
  --cili-success: #6f9b82;
  --tab-page-bottom-space: 52rpx;
  --fixed-action-reserve: 210rpx;
  --fixed-action-reserve-narrow: 320rpx;
  min-height: 100%;
  background: #0b0b0c;
  color: #f7f7f5;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.a11y-live-region {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 168rpx;
  padding-bottom: calc(168rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  background-color: #0b0b0c;
  color: #f7f7f5;
}

.page.activities-page,
.page.registrations-page,
.page.profile-page {
  padding-bottom: var(--tab-page-bottom-space);
  padding-bottom: calc(var(--tab-page-bottom-space) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 36rpx;
  border: 1rpx solid #343438;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #242427 0%, #111113 68%);
  color: #f7f7f5;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.36);
}

.hero::after {
  position: absolute;
  right: -54rpx;
  bottom: -76rpx;
  width: 220rpx;
  height: 220rpx;
  border: 30rpx solid rgba(213, 91, 31, 0.12);
  border-radius: 50%;
  content: '';
}

.hero-kicker {
  color: #d55b1f;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  margin: 12rpx 0 10rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  color: #a8a8ad;
  font-size: 25rpx;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #3a3a3e;
  border-radius: 8rpx;
  background: #1b1b1d;
  color: #f7f7f5;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.24);
}

.title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: #a8a8ad;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid #557363;
  border-radius: 999rpx;
  background: #1d2922;
  color: #9bc2aa;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.warn {
  border-color: #7a5c2c;
  background: #2a2115;
  color: #e7b66a;
}

.danger {
  border-color: #7a302c;
  background: #291413;
  color: #ff8f86;
}

.btn,
.secondary {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 20rpx 0 0;
  border-radius: 4rpx !important;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: 1rpx;
  clip-path: polygon(
    22rpx 0,
    100% 0,
    100% calc(100% - 22rpx),
    calc(100% - 22rpx) 100%,
    0 100%,
    0 22rpx
  );
}

.btn {
  background: linear-gradient(115deg, #b44716, #923812) !important;
  color: #f7f7f5 !important;
}

.btn:active {
  background: #a94416 !important;
}

.btn[disabled] {
  background: #3b3b3f !important;
  color: #a8a8ad !important;
}

.secondary {
  border: 1rpx solid #626267;
  background: #151517 !important;
  color: #f7f7f5 !important;
}

button::after {
  border: 0;
}

.field {
  margin: 26rpx 0;
}

.label {
  margin-bottom: 10rpx;
  color: #c7c7ca;
  font-size: 24rpx;
  font-weight: 600;
}

.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #4a4a4f;
  border-radius: 8rpx;
  background: #151517;
  color: #f7f7f5;
}

.textarea {
  min-height: 176rpx;
}

.fixed {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx;
  padding: 16rpx 24rpx calc(16rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #303034;
  background: rgba(11, 11, 12, 0.97);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.34);
}

.fixed .btn,
.fixed .secondary {
  margin: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.metric {
  min-width: 0;
  padding: 22rpx;
  border: 1rpx solid #343438;
  border-radius: 8rpx;
  background: #151517;
  color: #a8a8ad;
  font-size: 23rpx;
}

.big {
  margin-bottom: 4rpx;
  color: #f38a50;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.empty {
  padding: 88rpx 32rpx;
  color: #a8a8ad;
  text-align: center;
}

.section-label {
  margin: 34rpx 4rpx 10rpx;
  color: #a8a8ad;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
