page {
  /* Spacing scale: raw values only. */
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 24rpx;
  --space-5: 32rpx;
  --space-6: 48rpx;
  --border-width-hairline: 2rpx;
  --border-width-strong: 4rpx;
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-card: 28rpx;
  --radius-display: 32rpx;
  --font-size-label: 24rpx;
  --font-size-body: 28rpx;
  --font-size-title: 36rpx;
  --font-size-display: 48rpx;
  --line-height-label: 36rpx;
  --line-height-body: 44rpx;
  --line-height-title: 52rpx;
  --line-height-display: 64rpx;
  --font-weight-body: 600;
  --font-weight-strong: 800;
  --font-weight-display: 900;
  --font-family-body:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --font-family-editorial: 'Songti SC', STSong, serif;
  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  --motion-duration-fast: 120ms;
  --motion-duration-base: 180ms;
  --motion-easing-standard: cubic-bezier(0.2, 0, 0, 1);

  /* Semantic tokens: preserve established names for existing consumers. */
  --color-bg: #fbf5ea;
  --color-surface: #ffffff;
  --color-raised: #f3e6d0;
  --color-text: #211f1c;
  --color-muted: #6f675d;
  --color-placeholder: #6f675d;
  --color-disabled-text: #6f675d;
  --color-border: #ededed;
  --color-border-subtle: var(--color-border);
  --color-border-strong: #9a9186;
  --color-card-border: #ededed;
  --color-input-bg: #ffffff;
  --color-action: #c0321f;
  --color-action-active: #a52a1c;
  /* Legacy editorial aliases: keep older page styles on the current journal palette. */
  --color-paper: var(--color-surface);
  --color-ink: var(--color-text);
  --color-ink-muted: var(--color-muted);
  --color-rule: var(--color-border-strong);
  --color-accent: var(--color-action);
  --color-on-action: #ffffff;
  --color-on-action-muted: #ffffff;
  --color-on-media: #ffffff;
  --color-media-muted: #d4d4d4;
  --color-media-card-bg: #211f1c;
  --color-media-placeholder-bg: #211f1c;
  --color-media-scrim: rgba(12, 10, 7, 0.58);
  --color-scrim-base: #0c0a07;
  --color-scrim-dark: rgba(12, 10, 7, 0.72);
  --color-scrim-mid: rgba(12, 10, 7, 0.42);
  --color-brand: #e13b2b;
  --color-brand-active: #c0321f;
  --color-brand-soft: #fcebea;
  --color-on-brand: #0c0a07;
  --color-status-success: #16633a;
  --color-status-success-soft: #e7f4eb;
  --color-status-warning: #7a5c00;
  --color-status-warning-soft: #fff2c7;
  --color-logo-background: #211f1c;
  --color-logo-foreground: #ffffff;
  --color-logo-accent: #e13b2b;
  --color-fixed-bar: rgba(255, 255, 255, 0.98);
  --color-overlay: rgba(0, 0, 0, 0.72);
  --color-shadow: rgba(33, 31, 28, 0.06);
  --color-danger: var(--color-text);
  --color-danger-text: var(--color-text);
  --color-danger-soft: var(--color-raised);
  --shadow-hard: 0 10rpx 28rpx var(--color-shadow);
  --shadow-card: 0 8rpx 24rpx var(--color-shadow);
  --focus-color: var(--color-brand);
  --focus-ring: 0 0 0 4rpx var(--color-brand-soft);
  --control-height: 96rpx;
  --segment-height: 92rpx;
  --page-gutter: 28rpx;
  --page-gutter-narrow: 24rpx;
  --card-gap: 20rpx;
  --route-preview-canvas-height: 288rpx;
  --group-qr-code-size: 192rpx;
  --tab-page-bottom-space: 32rpx;
  --fixed-action-reserve: 240rpx;
  --fixed-action-reserve-narrow: 292rpx;
  --font-mono: var(--font-family-mono);

  /* Component tokens: shared controls consume these aliases first. */
  --button-bg: var(--color-action);
  --button-bg-active: var(--color-action-active);
  --button-text: var(--color-on-action);
  --button-border: var(--color-action);
  --button-radius: var(--radius-sm);
  --button-padding-inline: var(--space-4);
  --card-bg: var(--color-surface);
  --card-text: var(--color-text);
  --card-border: var(--color-card-border);
  --card-border-width: var(--border-width-hairline);
  --card-radius: var(--radius-card);
  --card-padding: var(--space-4);
  --input-bg: var(--color-input-bg);
  --input-text: var(--color-text);
  --input-border: var(--color-border-strong);
  --input-border-width: var(--border-width-strong);
  --input-radius: var(--radius-sm);
  --input-focus-border: var(--focus-color);
  --input-focus-ring: var(--focus-ring);
  --tag-bg: var(--color-raised);
  --tag-text: var(--color-text);
  --tag-radius: var(--radius-xs);
  --segment-bg: var(--color-surface);
  --segment-text: var(--color-text);
  --segment-border: var(--color-border-strong);
  --segment-border-width: var(--border-width-strong);
  --segment-radius: var(--radius-sm);
  /* PR B value-preserving media and route component tokens. */
  --scrim-activity-cover-clear: rgba(12, 10, 7, 0);
  --scrim-activity-cover-strong: rgba(12, 10, 7, 0.68);
  --surface-media-tag: rgba(12, 10, 7, 0.72);
  --scrim-activity-detail-cover-clear: rgba(12, 10, 7, 0);
  --scrim-activity-detail-cover-strong: rgba(12, 10, 7, 0.72);
  --surface-countdown: rgba(12, 10, 7, 0.6);
  --surface-dialog-backdrop: rgba(12, 10, 7, 0.68);
  --surface-dialog-control: rgba(12, 10, 7, 0.56);
  --scrim-attendee-card-strong: rgba(12, 10, 7, 0.76);
  --scrim-attendee-card-clear: rgba(12, 10, 7, 0);
  --surface-attendee-avatar-glass: rgba(255, 255, 255, 0.18);
  --surface-media-index: rgba(12, 10, 7, 0.78);
  --surface-media-action: rgba(12, 10, 7, 0.82);
  --surface-media-danger: rgba(165, 42, 28, 0.92);
  --shadow-swipe-color: rgba(0, 0, 0, 0.08);
  --surface-photo-count: rgba(12, 10, 7, 0.56);
  --surface-upload-progress-track: rgba(255, 255, 255, 0.3);
  --scrim-club-admin-top: rgba(12, 10, 7, 0.1);
  --scrim-club-admin-mid: rgba(12, 10, 7, 0.05);
  --scrim-club-admin-strong: rgba(12, 10, 7, 0.72);
  --color-club-admin-eyebrow: rgba(255, 255, 255, 0.86);
  --surface-club-fallback-shine: rgba(255, 255, 255, 0.08);
  --surface-club-fallback-clear: rgba(255, 255, 255, 0);
  --surface-club-fallback-glow: rgba(255, 255, 255, 0.12);
  --scrim-club-cover-top: rgba(12, 10, 7, 0.1);
  --scrim-club-cover-mid: rgba(12, 10, 7, 0.05);
  --scrim-club-cover-strong: rgba(12, 10, 7, 0.78);
  --border-club-location: rgba(255, 255, 255, 0.7);
  --surface-club-location: rgba(12, 10, 7, 0.4);
  --surface-club-identity: rgba(12, 10, 7, 0.42);
  --border-club-avatar: rgba(255, 255, 255, 0.85);
  --color-club-intro: rgba(255, 255, 255, 0.84);
  --border-credential-divider: rgba(255, 255, 255, 0.3);
  --surface-credential-chip: rgba(255, 255, 255, 0.12);
  --border-credential-chip: rgba(255, 255, 255, 0.2);
  --scrim-profile-hero-top: rgba(12, 10, 7, 0.08);
  --scrim-profile-hero-soft: rgba(12, 10, 7, 0.04);
  --scrim-profile-hero-mid: rgba(12, 10, 7, 0.42);
  --scrim-profile-hero-strong: rgba(12, 10, 7, 0.94);
  --color-profile-eyebrow: rgba(255, 255, 255, 0.78);
  --color-profile-meta: rgba(255, 255, 255, 0.86);
  --scrim-registration-cover-clear: rgba(0, 0, 0, 0);
  --scrim-registration-cover-strong: rgba(0, 0, 0, 0.35);
  /* UI Revamp V1 component surfaces: only route slices consume these names. */
  --scrim-cover-top: rgba(17, 15, 12, 0.04);
  --scrim-cover-strong: rgba(17, 15, 12, 0.88);
  --scrim-hero: rgba(17, 15, 12, 0.72);
  --surface-glass: rgba(255, 255, 255, 0.88);
  --surface-sheet: var(--color-surface);
  --shadow-sheet: 0 12rpx 32rpx var(--color-shadow);
  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-family-body);
  font-size: 28rpx;
  line-height: 44rpx;
}

.editorial {
  font-family: var(--font-family-editorial);
  font-weight: 600;
}

view,
text,
button,
input,
textarea,
picker,
image {
  box-sizing: border-box;
}
button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  line-height: 44rpx;
}
button::after {
  border: 0;
}
.club-identity {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
}
.club-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}
.club-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
  color: var(--color-on-brand);
}
.a11y-live-region {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.page,
.page-shell,
.detail-page,
.capability-page {
  min-height: 100vh;
  overflow-x: hidden;
  padding: 32rpx var(--page-gutter);
  background: var(--color-bg);
  color: var(--color-text);
}
.page.activities-page,
.page.registrations-page,
.page.profile-page {
  padding-bottom: calc(var(--tab-page-bottom-space) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
}
.custom-nav-title {
  position: absolute;
  left: var(--page-gutter);
  z-index: 2;
  display: flex;
  align-items: center;
  height: 44px;
  font-size: 28rpx;
  line-height: 44px;
  font-weight: 800;
}
.detail-page,
.form-page,
.activity-form-page,
.review-detail-page {
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
}
.page-title,
.hero-title,
.heading-title,
.editor-title {
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  overflow-wrap: break-word;
}
.title,
.card-title,
.section-title,
.menu-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 800;
}
.muted,
.hint,
.field-hint,
.section-hint,
.hero-subtitle {
  color: var(--color-muted);
}

.card,
.form-card,
.review-card,
.decision-panel,
.menu-list,
.activity-context,
.credential-card,
.rider-card,
.official-route-card,
.gpx-route-card,
.detail-decision,
.metric-panel,
.state-card {
  margin-top: var(--card-gap);
  padding: var(--card-padding);
  border: var(--card-border-width) solid var(--card-border);
  border-radius: var(--card-radius);
  background: var(--card-bg);
  color: var(--card-text);
  box-shadow: none;
}
.card .card,
.form-card .card {
  box-shadow: none;
}
.card-head,
.section-head,
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.card-no,
.section-label > text:first-child {
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.section-label {
  margin-top: calc(var(--space-6) + var(--space-5));
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.btn,
.secondary,
.button,
.map-button,
.photo-button,
.photo-action,
.profile-alert-action,
.meeting-location__action,
.route-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 var(--button-padding-inline);
  border: var(--border-width-hairline) solid var(--button-border);
  border-radius: var(--button-radius) !important;
  background: var(--button-bg) !important;
  color: var(--button-text) !important;
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  font-weight: var(--font-weight-strong);
  text-align: center;
}
.btn {
  min-height: var(--control-height);
}
.secondary,
.button--secondary,
.map-button--secondary,
.photo-button,
.photo-action,
.meeting-location__action,
.route-action {
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
.btn:active,
.button--primary:active {
  background: var(--button-bg-active) !important;
  transform: scale(0.985);
}
.rowbutton:active,
.rowlink:active {
  transform: scale(0.985);
}
.btn[disabled],
.secondary[disabled],
.button[disabled],
button[disabled],
input[disabled],
textarea[disabled],
picker[disabled] {
  border-color: var(--color-border) !important;
  background: var(--color-raised) !important;
  color: var(--color-disabled-text) !important;
  opacity: 1;
}
.text-button,
.image-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 8rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 8rpx;
}

.field {
  margin-top: var(--space-6);
}
.label,
.field-label,
.field-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-3);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.input,
.textarea,
.field input,
.field textarea,
.picker-value {
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  border: var(--input-border-width) solid var(--input-border);
  border-radius: var(--input-radius);
  background: var(--input-bg);
  color: var(--input-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 700;
}
.textarea,
.field textarea {
  min-height: 176rpx;
}
.input-placeholder {
  color: var(--color-placeholder);
  font-weight: 400;
}
.input:focus,
.textarea:focus,
.field input:focus,
.field textarea:focus {
  border-color: var(--input-focus-border);
  box-shadow: var(--input-focus-ring);
}
.field-error,
.form-error,
.field-msg.is-error {
  margin-top: 8rpx;
  color: var(--color-brand-active);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
}
.required {
  margin-left: auto;
  padding: 4rpx 12rpx;
  border: 4rpx solid var(--color-brand);
  border-radius: 8rpx;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}

.tag,
.status-tag,
.section-tag,
.context-status,
.default-choice-badge,
.cover-badge,
.image-count,
.approved-mark,
.route-ready-mark,
.status-label {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: var(--tag-radius);
  background: var(--tag-bg);
  color: var(--tag-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
  white-space: nowrap;
}
.tag-solid,
.route-ready-mark {
  background: var(--color-action);
  color: var(--color-on-action);
}
.required {
  border: 4rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
}
.tag-outline {
  border: 2rpx solid var(--color-border-strong);
  background: var(--color-surface);
}
.tag-success,
.approved-mark {
  border: 2rpx solid var(--color-status-success);
  background: var(--color-status-success-soft);
  color: var(--color-status-success);
}
.group-qr-warning {
  border: 2rpx solid var(--color-status-warning);
  background: var(--color-status-warning-soft);
  color: var(--color-status-warning);
}

.info-bar,
.activity-context,
.meeting-spotlight {
  position: relative;
  margin-top: var(--card-gap);
  padding: 32rpx 32rpx 32rpx 40rpx;
  border: 0;
  border-radius: var(--radius-card);
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.info-bar::before,
.activity-context::before,
.meeting-spotlight::before {
  position: absolute;
  top: 32rpx;
  bottom: 32rpx;
  left: 0;
  width: 8rpx;
  background: var(--color-brand);
  content: '';
}
.context-kicker,
.info-kicker,
.meet-label {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.context-title,
.info-title,
.meeting-time {
  margin-top: 8rpx;
  color: var(--color-on-media);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.context-meta,
.info-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 12rpx;
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.identity-row,
.credential-row,
.detail-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: var(--control-height);
  border-bottom: 2rpx solid var(--color-border);
}
.identity-row:last-child,
.credential-row:last-child,
.detail-line:last-child {
  border-bottom: 0;
}
.identity-label,
.credential-key,
.detail-line > text:first-child {
  color: var(--color-muted);
}
.identity-value,
.credential-value,
.detail-line strong {
  min-width: 0;
  color: var(--color-text);
  font-weight: 700;
  text-align: right;
}

.metrics,
.metric-panel,
.route-native-metrics,
.route-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rpx;
  overflow: hidden;
  padding: 0;
  border: 2rpx solid var(--color-border);
  background: var(--color-border);
}
.metric-item,
.detail-metric,
.route-native-metrics > view,
.route-metric-grid > view {
  min-width: 0;
  padding: 16rpx 24rpx;
  background: var(--color-surface);
}
.metric-value,
.metric-number,
.route-native-metrics > view > text:first-child,
.route-metric-grid > view > text:first-child {
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.metric-unit,
.metric-label,
.route-native-metrics > view > text:last-child,
.route-metric-grid > view > text:last-child {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.step-line,
.experience-segment,
.timeline-tabs,
.status-filters,
.filter-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  border: var(--segment-border-width) solid var(--segment-border);
  border-radius: var(--segment-radius);
}
.step,
.segment,
.timeline-tab,
.status-filter,
.filter-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: var(--segment-height);
  padding: 0 8rpx;
  border-right: var(--segment-border-width) solid var(--segment-border);
  background: var(--segment-bg);
  color: var(--segment-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
  text-align: center;
}
.step:last-child,
.segment:last-child,
.timeline-tab:last-child,
.status-filter:last-child {
  border-right: 0;
}
.step-active {
  background: var(--color-brand);
  color: var(--color-on-brand);
}
.segment.selected,
.timeline-tab.is-active,
.status-filter.active,
.filter-tab.is-active {
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
.segment radio {
  position: absolute;
  opacity: 0;
}

.upload-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  border: 4rpx dashed var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.image-grid,
.photo-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}
.image-item {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.image-preview,
.photo-thumbnail {
  width: 100%;
  height: 100%;
}
.image-item > .upload-status {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-overlay);
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}

.neutral-note,
.privacy-note,
.submit-note,
.section-help {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-left: 8rpx solid var(--color-border-strong);
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.pending-hint,
.profile-alert {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-left: 8rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.group-qr-warning {
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
}

.fixed,
.action-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: 16rpx;
  padding: 16rpx var(--page-gutter) calc(16rpx + constant(safe-area-inset-bottom));
  padding: 16rpx var(--page-gutter) calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 24rpx var(--color-shadow);
}
.fixed .disabled-hint,
.action-bar .disabled-hint {
  grid-column: 1 / -1;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.detail-action:not(.detail-action--admin) {
  grid-template-columns: 1fr;
}

.state-view,
.empty,
.state-card {
  text-align: center;
}
.skeleton {
  min-height: 220rpx;
  margin-top: var(--card-gap);
  border: 4rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.refresh-note,
.result-count {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.refresh-error,
.danger {
  color: var(--color-brand-active);
}

@media (max-width: 340px) {
  page {
    --page-gutter: var(--page-gutter-narrow);
  }
  .fixed,
  .action-bar {
    grid-template-columns: 1fr;
  }
  .metrics,
  .metric-panel,
  .route-native-metrics,
  .route-metric-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 375px) {
  button.btn {
    min-height: var(--control-height);
  }
  button,
  button.secondary,
  button.button,
  button.text-button,
  button.image-action,
  button.map-button,
  button.photo-action,
  button.route-action {
    min-height: var(--control-height);
  }
  .timeline-tabs .timeline-tab,
  .status-filters .status-filter,
  .filter-tabs .filter-tab,
  .experience-segment .segment {
    min-height: var(--segment-height);
  }
}

/* UI Revamp V1 · shared content-first and steady single-column language. */
[data-v1-layout] .pageheading {
  padding: var(--space-5) 0 var(--space-4);
}
[data-v1-layout] .pageheading-title {
  max-width: 18em;
  margin-top: var(--space-3);
  font-family: var(--font-family-editorial);
  font-size: 56rpx;
  line-height: 64rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}
[data-v1-layout] .pageheading-sub {
  max-width: 32em;
  margin-top: var(--space-3);
  color: var(--color-muted);
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  font-weight: 400;
}
[data-v1-layout] .chapterhead {
  padding-bottom: var(--space-2);
  border-bottom: var(--border-width-hairline) solid var(--color-border);
}
[data-v1-layout] .chapterhead-title {
  font-family: var(--font-family-editorial);
  font-size: var(--font-size-title);
  line-height: 48rpx;
  font-weight: 600;
}
[data-v1-layout] .chev {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  border: var(--border-width-hairline) solid var(--color-border);
  border-radius: 50%;
  background: var(--color-surface);
}
[data-v1-layout] .rowbutton,
[data-v1-layout] .rowlink,
[data-v1-layout] .filter-tab,
[data-v1-layout] .segment-item,
[data-v1-layout] .choice,
[data-v1-layout] .segment-choice {
  min-height: 88rpx;
}
[data-v1-layout='form'] .section,
[data-v1-layout='admin'] .section,
[data-v1-layout='admin-form'] .section {
  border-radius: 0;
  box-shadow: none;
}
[data-v1-layout='form'] .form-card,
[data-v1-layout='admin-form'] .form-card,
[data-v1-layout='admin-form'] .club-profile-card {
  padding: var(--space-5) 0;
  border-width: 0 0 var(--border-width-hairline);
  border-radius: 0;
  background: transparent;
}
[data-v1-layout] .filters,
[data-v1-layout] .segment {
  border-width: 0 0 var(--border-width-hairline);
  border-radius: 0;
  background: transparent;
}
[data-v1-layout] .filter-tab,
[data-v1-layout] .segment-item {
  border: 0;
  border-bottom: var(--border-width-strong) solid transparent;
  border-radius: 0;
  background: transparent;
  color: var(--color-muted);
}
[data-v1-layout] .filter-tab.is-active,
[data-v1-layout] .segment-item.selected {
  border-bottom-color: var(--color-action);
  background: transparent !important;
  color: var(--color-text) !important;
}
[data-v1-layout] .metric .em,
[data-v1-layout] .metric-value,
[data-v1-layout] .metric-number,
[data-v1-layout] .storyfacts-value,
[data-v1-layout] .trip-stat__value {
  font-family: var(--font-family-mono);
  font-variant-numeric: tabular-nums;
}
.profile-page[data-v1-layout] .profile-permission {
  position: relative;
  z-index: 2;
  margin-top: -32rpx;
  border-radius: var(--radius-display);
  background: var(--surface-sheet);
  box-shadow: var(--shadow-sheet);
}
@media (max-width: 340px) {
  [data-v1-layout] .pageheading-title {
    font-size: 48rpx;
    line-height: 60rpx;
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-v1-layout] view,
  [data-v1-layout] text,
  [data-v1-layout] button,
  [data-v1-layout] input,
  [data-v1-layout] textarea,
  [data-v1-layout] image,
  [data-v1-layout] navigator,
  [data-v1-layout] scroll-view,
  [data-v1-layout] swiper,
  [data-v1-layout] swiper-item,
  [data-v1-layout] picker,
  [data-v1-layout] form,
  [data-v1-layout] label,
  [data-v1-layout] radio,
  [data-v1-layout] checkbox,
  [data-v1-layout] switch,
  [data-v1-layout] slider,
  [data-v1-layout] canvas,
  [data-v1-layout] map,
  [data-v1-layout] video,
  [data-v1-layout] cover-view,
  [data-v1-layout] cover-image,
  [data-v1-layout] rich-text,
  [data-v1-layout] progress,
  [data-v1-layout] icon,
  [data-v1-layout] .avatar,
  [data-v1-layout] .brand-logo,
  [data-v1-layout] .state-view,
  [data-v1-layout] .status-pill,
  [data-v1-layout] .generated-cover,
  [data-v1-layout] .async-status-card,
  [data-v1-layout] .blur-text {
    animation-duration: 1ms !important;
    transition-duration: 1ms !important;
  }
}
