page {
  /* Spacing scale: raw values only. */
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 24rpx;
  --space-5: 32rpx;
  --space-6: 48rpx;
  --border-width-hairline: 2rpx;
  --border-width-strong: 4rpx;
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-card: 28rpx;
  --radius-display: 32rpx;
  --font-size-label: 24rpx;
  --font-size-body: 28rpx;
  --font-size-title: 36rpx;
  --font-size-display: 48rpx;
  --line-height-label: 36rpx;
  --line-height-body: 44rpx;
  --line-height-title: 52rpx;
  --line-height-display: 64rpx;
  --font-weight-body: 600;
  --font-weight-strong: 800;
  --font-weight-display: 900;
  --font-family-body:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --font-family-editorial: 'Songti SC', STSong, serif;
  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  /* Primitive palette: only this layer owns raw theme values. */
  --palette-ink-950: #0b0a0c;
  --palette-ink-900: #121116;
  --palette-ink-800: #1a1820;
  --palette-ink-700: #24212b;
  --palette-red-500: #e54242;
  --palette-red-600: #d93636;
  --palette-red-700: #b72c2c;
  --palette-warm-50: #f7f4f2;
  --palette-white: #ffffff;
  --palette-neutral-300: #b8b3ba;
  --palette-neutral-500: #8c858f;
  --palette-line-500: #4b454f;
  --palette-line-700: #766f7a;

  /* Primitive motion: brief feedback, readable reveal, no continuous loops. */
  --motion-duration-instant: 100ms;
  --motion-duration-fast: 150ms;
  --motion-duration-base: 220ms;
  --motion-duration-reveal: 420ms;
  --motion-duration-emphasis: 560ms;
  --motion-duration-hero: 680ms;
  --motion-delay-none: 0ms;
  --motion-delay-short: 80ms;
  --motion-delay-title: 120ms;
  --motion-delay-story: 180ms;
  --motion-delay-content: 220ms;
  --motion-delay-section: 280ms;
  --motion-delay-title-second: 340ms;
  --motion-delay-caption: 400ms;
  --motion-delay-story-second: 300ms;
  --motion-delay-story-third: 420ms;
  --motion-delay-story-fourth: 540ms;
  --motion-stagger-step: 40ms;
  --motion-distance-press: 2rpx;
  --motion-distance-reveal: 16rpx;
  --motion-easing-standard: cubic-bezier(0.2, 0, 0, 1);
  --motion-easing-out: cubic-bezier(0.25, 1, 0.5, 1);
  --motion-easing-in-out: cubic-bezier(0.65, 0, 0.35, 1);

  /* Global cinematic dark tokens: all 17 routes share one canvas and hierarchy. */
  --color-bg: var(--palette-ink-950);
  --color-surface: var(--palette-ink-900);
  --color-raised: var(--palette-ink-800);
  --color-floating: var(--palette-ink-700);
  --color-text: var(--palette-warm-50);
  --color-muted: var(--palette-neutral-300);
  --color-placeholder: var(--palette-neutral-500);
  --color-disabled-text: var(--palette-neutral-500);
  --color-border: var(--palette-line-500);
  --color-border-subtle: var(--color-border);
  --color-border-strong: var(--palette-line-700);
  --color-card-border: var(--palette-line-700);
  --color-input-bg: var(--palette-ink-800);
  --color-action: var(--palette-red-600);
  --color-action-active: var(--palette-red-700);
  /* Legacy editorial aliases: keep older page styles on the current journal palette. */
  --color-paper: var(--color-surface);
  --color-ink: var(--color-text);
  --color-ink-muted: var(--color-muted);
  --color-rule: var(--color-border-strong);
  --color-accent: var(--color-action);
  --color-on-action: var(--palette-white);
  --color-on-action-muted: var(--palette-white);
  --color-on-media: var(--palette-warm-50);
  --color-media-muted: var(--palette-neutral-300);
  --color-media-card-bg: var(--palette-ink-900);
  --color-media-placeholder-bg: var(--palette-ink-900);
  --color-media-scrim: rgba(11, 10, 12, 0.58);
  --surface-media-action: rgba(11, 10, 12, 0.82);
  --surface-media-danger: rgba(165, 42, 28, 0.92);
  --color-scrim-clear: rgba(11, 10, 12, 0);
  --color-scrim-faint: rgba(11, 10, 12, 0.04);
  --color-scrim-soft: rgba(11, 10, 12, 0.18);
  --color-scrim-base: var(--palette-ink-950);
  --color-scrim-dark: rgba(11, 10, 12, 0.72);
  --color-scrim-mid: rgba(11, 10, 12, 0.42);
  --color-scrim-strong: rgba(11, 10, 12, 0.76);
  --color-scrim-heavy: rgba(11, 10, 12, 0.96);
  --color-control-scrim: rgba(11, 10, 12, 0.56);
  --color-on-media-surface: rgba(255, 255, 255, 0.18);
  --color-on-media-border: rgba(255, 255, 255, 0.2);
  --color-on-media-divider: rgba(255, 255, 255, 0.3);
  --color-brand: var(--palette-red-500);
  --color-brand-fill: var(--palette-red-600);
  --color-brand-active: var(--palette-red-700);
  --color-brand-soft: rgba(229, 66, 66, 0.14);
  --color-brand-glow: rgba(229, 66, 66, 0.28);
  --color-on-brand: var(--palette-white);
  --color-status-success: #7bdba1;
  --color-status-success-soft: #183424;
  --color-status-warning: #f0ce75;
  --color-status-warning-soft: #3a2d12;
  /* Logo asset contract stays independent from the UI theme palette. */
  --color-logo-background: #211f1c;
  --color-logo-foreground: #ffffff;
  --color-logo-accent: #e13b2b;
  --color-fixed-bar: rgba(11, 10, 12, 0.98);
  --color-sticky-surface: rgba(21, 19, 22, 0.96);
  --color-overlay: rgba(0, 0, 0, 0.72);
  --color-shadow: rgba(0, 0, 0, 0.34);
  --color-cinema-bg: var(--color-bg);
  --color-cinema-panel: var(--color-surface);
  --color-cinema-panel-raised: var(--color-raised);
  --color-cinema-line: var(--color-border-strong);
  --color-cinema-text: var(--color-text);
  --color-cinema-muted: var(--color-muted);
  --color-cinema-red: var(--color-action);
  --color-danger: #ffb4a6;
  --color-danger-text: #ffb4a6;
  --color-danger-soft: #431b17;
  --shadow-hard: 0 10rpx 28rpx var(--color-shadow);
  --shadow-card: 0 8rpx 24rpx var(--color-shadow);
  --shadow-floating: 0 16rpx 36rpx var(--color-shadow);
  --shadow-actionbar: 0 -16rpx 32rpx var(--color-shadow);
  --gradient-cover: linear-gradient(
    to bottom,
    var(--color-scrim-clear) 0%,
    var(--color-scrim-clear) 48%,
    var(--color-scrim-dark) 100%
  );
  --gradient-cover-opening: linear-gradient(
    to bottom,
    var(--color-scrim-faint) 10%,
    var(--color-scrim-soft) 42%,
    var(--color-scrim-heavy) 100%
  );
  --gradient-dialog-cover: linear-gradient(
    to top,
    var(--color-scrim-strong),
    var(--color-scrim-clear) 60%
  );
  --gradient-ticket-cover: linear-gradient(
    to bottom,
    var(--color-scrim-clear) 0%,
    var(--color-scrim-mid) 100%
  );
  --focus-color: var(--color-brand);
  --focus-ring: 0 0 0 4rpx rgba(229, 66, 66, 0.36);
  --control-height: 96rpx;
  --segment-height: 92rpx;
  --page-gutter: 28rpx;
  --page-gutter-narrow: 24rpx;
  --card-gap: 20rpx;
  --route-preview-canvas-height: 288rpx;
  --group-qr-code-size: 192rpx;
  --tab-page-bottom-space: 32rpx;
  --fixed-action-reserve: 240rpx;
  --fixed-action-reserve-narrow: 292rpx;
  --action-bar-height: 128rpx;
  --radius-full: 9999rpx;
  --font-mono: var(--font-family-mono);

  /* Component tokens: shared controls consume these aliases first. */
  --button-bg: var(--color-action);
  --button-bg-active: var(--color-action-active);
  --button-text: var(--color-on-action);
  --button-border: var(--color-action);
  --button-radius: var(--radius-sm);
  --button-padding-inline: var(--space-4);
  --card-bg: var(--color-surface);
  --card-text: var(--color-text);
  --card-border: var(--color-card-border);
  --card-border-width: var(--border-width-hairline);
  --card-radius: var(--radius-card);
  --card-padding: var(--space-4);
  --input-bg: var(--color-input-bg);
  --input-text: var(--color-text);
  --input-border: var(--color-border-strong);
  --input-border-width: var(--border-width-strong);
  --input-radius: var(--radius-sm);
  --input-focus-border: var(--focus-color);
  --input-focus-ring: var(--focus-ring);
  --tag-bg: var(--color-raised);
  --tag-text: var(--color-text);
  --tag-radius: var(--radius-xs);
  --segment-bg: var(--color-surface);
  --segment-text: var(--color-text);
  --segment-border: var(--color-border-strong);
  --segment-border-width: var(--border-width-strong);
  --segment-radius: var(--radius-sm);
  --scrim-cover-strong: var(--color-scrim-dark);
  --surface-sheet: var(--color-surface);
  --cinema-title-duration: var(--motion-duration-emphasis);
  --cinema-content-duration: var(--motion-duration-reveal);
  --cinema-hero-duration: var(--motion-duration-hero);
  --cinema-reveal-duration: var(--motion-duration-reveal);
  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-family-body);
  font-size: 28rpx;
  line-height: 44rpx;
}

.editorial {
  font-family: var(--font-family-editorial);
  font-weight: 600;
}

view,
text,
button,
input,
textarea,
picker,
image {
  box-sizing: border-box;
}
button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  line-height: 44rpx;
}
button::after {
  border: 0;
}
.club-identity {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
}
.club-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}
.club-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand-fill);
  color: var(--color-on-brand);
}
.a11y-live-region {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.page,
.page-shell,
.detail-page,
.capability-page {
  min-height: 100vh;
  overflow-x: hidden;
  padding: 32rpx var(--page-gutter);
  background: var(--color-bg);
  color: var(--color-text);
}
.page.activities-page,
.page.registrations-page,
.page.profile-page {
  padding-bottom: calc(var(--tab-page-bottom-space) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
}
.custom-nav-title {
  position: absolute;
  left: var(--page-gutter);
  z-index: 2;
  display: flex;
  align-items: center;
  height: 44px;
  font-size: 28rpx;
  line-height: 44px;
  font-weight: 800;
}
.detail-page,
.form-page,
.activity-form-page,
.review-detail-page {
  padding-bottom: calc(var(--fixed-action-reserve) + env(safe-area-inset-bottom));
}
.page-title,
.hero-title,
.heading-title,
.editor-title {
  font-size: 64rpx;
  line-height: 80rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  overflow-wrap: break-word;
}
.title,
.card-title,
.section-title,
.menu-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 800;
}
.muted,
.hint,
.field-hint,
.section-hint,
.hero-subtitle {
  color: var(--color-muted);
}

.card,
.form-card,
.review-card,
.decision-panel,
.menu-list,
.activity-context,
.credential-card,
.rider-card,
.official-route-card,
.gpx-route-card,
.detail-decision,
.metric-panel,
.state-card {
  margin-top: var(--card-gap);
  padding: var(--card-padding);
  border: var(--card-border-width) solid var(--card-border);
  border-radius: var(--card-radius);
  background: var(--card-bg);
  color: var(--card-text);
  box-shadow: none;
}
.card .card,
.form-card .card {
  box-shadow: none;
}
.card-head,
.section-head,
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.card-no,
.section-label > text:first-child {
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.section-label {
  margin-top: calc(var(--space-6) + var(--space-5));
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.btn,
.secondary,
.button,
.map-button,
.photo-button,
.photo-action,
.profile-alert-action,
.meeting-location__action,
.route-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 var(--button-padding-inline);
  border: var(--border-width-hairline) solid var(--button-border);
  border-radius: var(--button-radius) !important;
  background: var(--button-bg) !important;
  color: var(--button-text) !important;
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  font-weight: var(--font-weight-strong);
  text-align: center;
}
.btn {
  min-height: var(--control-height);
}
.secondary,
.button--secondary,
.map-button--secondary,
.photo-button,
.photo-action,
.meeting-location__action,
.route-action {
  background: var(--color-surface) !important;
  color: var(--color-text) !important;
}
.btn:active,
.button--primary:active {
  background: var(--button-bg-active) !important;
  transform: scale(0.985);
}
.rowbutton:active,
.rowlink:active {
  transform: scale(0.985);
}
.btn[disabled],
.secondary[disabled],
.button[disabled],
button[disabled],
input[disabled],
textarea[disabled],
picker[disabled] {
  border-color: var(--color-border) !important;
  background: var(--color-raised) !important;
  color: var(--color-disabled-text) !important;
  opacity: 1;
}
.text-button,
.image-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 8rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 8rpx;
}

.field {
  margin-top: var(--space-6);
}
.label,
.field-label,
.field-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-3);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
}
.input,
.textarea,
.field input,
.field textarea,
.picker-value {
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 24rpx;
  border: var(--input-border-width) solid var(--input-border);
  border-radius: var(--input-radius);
  background: var(--input-bg);
  color: var(--input-text);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 700;
}
.textarea,
.field textarea {
  min-height: 176rpx;
}
.input-placeholder {
  color: var(--color-placeholder);
  font-weight: 400;
}
.input:focus,
.textarea:focus,
.field input:focus,
.field textarea:focus {
  border-color: var(--input-focus-border);
  box-shadow: var(--input-focus-ring);
}
.field-error,
.form-error,
.field-msg.is-error {
  margin-top: 8rpx;
  color: var(--color-brand-active);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
}
.required {
  margin-left: auto;
  padding: 4rpx 12rpx;
  border: 4rpx solid var(--color-brand);
  border-radius: 8rpx;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}

.tag,
.status-tag,
.section-tag,
.context-status,
.default-choice-badge,
.cover-badge,
.image-count,
.approved-mark,
.route-ready-mark,
.status-label {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: var(--tag-radius);
  background: var(--tag-bg);
  color: var(--tag-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 800;
  white-space: nowrap;
}
.tag-solid,
.route-ready-mark {
  background: var(--color-action);
  color: var(--color-on-action);
}
.required {
  border: 4rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
}
.tag-outline {
  border: 2rpx solid var(--color-border-strong);
  background: var(--color-surface);
}
.tag-success,
.approved-mark {
  border: 2rpx solid var(--color-status-success);
  background: var(--color-status-success-soft);
  color: var(--color-status-success);
}
.group-qr-warning {
  border: 2rpx solid var(--color-status-warning);
  background: var(--color-status-warning-soft);
  color: var(--color-status-warning);
}

.info-bar,
.activity-context,
.meeting-spotlight {
  position: relative;
  margin-top: var(--card-gap);
  padding: 32rpx 32rpx 32rpx 40rpx;
  border: 0;
  border-radius: var(--radius-card);
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.info-bar::before,
.activity-context::before,
.meeting-spotlight::before {
  position: absolute;
  top: 32rpx;
  bottom: 32rpx;
  left: 0;
  width: 8rpx;
  background: var(--color-brand-fill);
  content: '';
}
.context-kicker,
.info-kicker,
.meet-label {
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.context-title,
.info-title,
.meeting-time {
  margin-top: 8rpx;
  color: var(--color-on-media);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.context-meta,
.info-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 12rpx;
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.identity-row,
.credential-row,
.detail-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: var(--control-height);
  border-bottom: 2rpx solid var(--color-border);
}
.identity-row:last-child,
.credential-row:last-child,
.detail-line:last-child {
  border-bottom: 0;
}
.identity-label,
.credential-key,
.detail-line > text:first-child {
  color: var(--color-muted);
}
.identity-value,
.credential-value,
.detail-line strong {
  min-width: 0;
  color: var(--color-text);
  font-weight: 700;
  text-align: right;
}

.metrics,
.metric-panel,
.route-native-metrics,
.route-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rpx;
  overflow: hidden;
  padding: 0;
  border: 2rpx solid var(--color-border);
  background: var(--color-border);
}
.metric-item,
.detail-metric,
.route-native-metrics > view,
.route-metric-grid > view {
  min-width: 0;
  padding: 16rpx 24rpx;
  background: var(--color-surface);
}
.metric-value,
.metric-number,
.route-native-metrics > view > text:first-child,
.route-metric-grid > view > text:first-child {
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.metric-unit,
.metric-label,
.route-native-metrics > view > text:last-child,
.route-metric-grid > view > text:last-child {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.step-line,
.experience-segment,
.timeline-tabs,
.status-filters,
.filter-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  border: var(--segment-border-width) solid var(--segment-border);
  border-radius: var(--segment-radius);
}
.step,
.segment,
.timeline-tab,
.status-filter,
.filter-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: var(--segment-height);
  padding: 0 8rpx;
  border-right: var(--segment-border-width) solid var(--segment-border);
  background: var(--segment-bg);
  color: var(--segment-text);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
  text-align: center;
}
.step:last-child,
.segment:last-child,
.timeline-tab:last-child,
.status-filter:last-child {
  border-right: 0;
}
.step-active {
  background: var(--color-brand-fill);
  color: var(--color-on-brand);
}
.segment.selected,
.timeline-tab.is-active,
.status-filter.active,
.filter-tab.is-active {
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
.segment radio {
  position: absolute;
  opacity: 0;
}

.upload-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  border: 4rpx dashed var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}
.image-grid,
.photo-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}
.image-item {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-raised);
}
.image-preview,
.photo-thumbnail {
  width: 100%;
  height: 100%;
}
.image-item > .upload-status {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-overlay);
  color: var(--color-on-media);
  font-size: 24rpx;
  font-weight: 800;
}

.neutral-note,
.privacy-note,
.submit-note,
.section-help {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-left: 8rpx solid var(--color-border-strong);
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.pending-hint,
.profile-alert {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-left: 8rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.group-qr-warning {
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
}

.fixed,
.action-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: 16rpx;
  padding: 16rpx var(--page-gutter) calc(16rpx + constant(safe-area-inset-bottom));
  padding: 16rpx var(--page-gutter) calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 24rpx var(--color-shadow);
}
.fixed .disabled-hint,
.action-bar .disabled-hint {
  grid-column: 1 / -1;
  color: var(--color-text);
  font-size: 24rpx;
  line-height: 36rpx;
}
.detail-action:not(.detail-action--admin) {
  grid-template-columns: 1fr;
}

.state-view,
.empty,
.state-card {
  text-align: center;
}
.skeleton {
  min-height: 220rpx;
  margin-top: var(--card-gap);
  border: 4rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.refresh-note,
.result-count {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.refresh-error,
.danger {
  color: var(--color-brand-active);
}

/* 17 条正式路由共用的一镜到底入场。只播放一次，不拦截滚动与触控。 */
.cinema-page {
  --cinema-scroll-edge: rgba(11, 10, 12, 0.96);
  position: relative;
  isolation: isolate;
}
.cinema-page::after {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  height: 36rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(15, 13, 10, 0), var(--cinema-scroll-edge));
  content: '';
}
.cinema-page .pageheading .eyebrow,
.cinema-page .profile-hero,
.cinema-page .info-bar {
  animation: cinema-blur-in var(--cinema-title-duration) var(--motion-delay-title)
    var(--motion-easing-out) both;
}
.cinema-page .pageheading-line {
  animation: cinema-blur-in var(--cinema-title-duration) var(--motion-delay-title)
    var(--motion-easing-out) both;
}
.review-detail-page .pageheading-title {
  animation: cinema-blur-in var(--cinema-title-duration) var(--motion-delay-title)
    var(--motion-easing-out) both;
}
.cinema-page .pageheading-line + .pageheading-line {
  animation-delay: var(--motion-delay-title-second);
}
.cinema-page .pageheading-sub,
.cinema-page .pageheading-meta {
  animation: cinema-blur-in var(--motion-duration-reveal) var(--motion-delay-caption)
    var(--motion-easing-out) both;
}
.cinema-page > .content,
.cinema-page > state-view,
.cinema-page .content.tight {
  animation: cinema-rise-in var(--cinema-content-duration) var(--motion-delay-content)
    var(--motion-easing-out) both;
}
.cinema-page .content > .section:first-child > .chapterhead,
.cinema-page .content > .section:nth-child(2) > .chapterhead {
  animation: cinema-blur-in var(--motion-duration-reveal) var(--motion-delay-section)
    var(--motion-easing-out) both;
}
.cinema-page .content > .section:nth-child(2) > .chapterhead {
  animation-delay: var(--motion-delay-title-second);
}
.cinema-page .profile-background-image,
.cinema-page .photo.hero image,
.cinema-page .club-cover-image {
  animation: cinema-hero-in var(--cinema-hero-duration) var(--motion-duration-instant)
    var(--motion-easing-out) both;
}
.cinema-page .story-title,
.cinema-page .hero-title {
  animation: cinema-blur-in var(--cinema-title-duration) var(--motion-delay-story)
    var(--motion-easing-out) both;
}
.activities-page .story-shell:nth-child(2) .story-title {
  animation-delay: var(--motion-delay-story-second);
}
.activities-page .story-shell:nth-child(3) .story-title {
  animation-delay: var(--motion-delay-story-third);
}
.activities-page .story-shell:nth-child(n + 4) .story-title {
  animation-delay: var(--motion-delay-story-fourth);
}
.cinema-page .chev,
.cinema-page .storymeta-link,
.cinema-page .compact-item__arrow {
  position: relative;
  right: 0;
  transition:
    right var(--motion-duration-instant) var(--motion-easing-standard),
    opacity var(--motion-duration-instant) var(--motion-easing-standard);
}
.cinema-page .rowlink:active .chev,
.cinema-page .story:active .storymeta-link,
.cinema-page .compact-item:active .compact-item__arrow {
  right: -4rpx;
  opacity: 0.68;
}
.cinema-page button {
  transition:
    opacity var(--motion-duration-fast) var(--motion-easing-standard),
    transform var(--motion-duration-fast) var(--motion-easing-standard),
    background-color var(--motion-duration-base) var(--motion-easing-standard),
    border-color var(--motion-duration-base) var(--motion-easing-standard);
}
.cinema-page button:active {
  transform: translateY(var(--motion-distance-press));
  opacity: 0.84;
}

/* 全局暗色收口：旧页面类名继续复用，但不再产生暖白票身、表单或管理卡。 */
.cinema-page,
.cinema-page .content,
.cinema-page .pageheading,
.cinema-page .section {
  background-color: var(--color-bg);
  color: var(--color-text);
}
.cinema-page .card,
.cinema-page .paper,
.cinema-page .ticket,
.cinema-page .reviewitem,
.cinema-page .form-card,
.cinema-page .menu-list,
.cinema-page .state-card,
.cinema-page .modal-sheet,
.cinema-page .dialog,
.cinema-page .trip-skeleton__card {
  border-color: var(--color-card-border);
  background-color: var(--color-surface);
  color: var(--color-text);
}
.cinema-page .input,
.cinema-page .textarea,
.cinema-page input,
.cinema-page textarea,
.cinema-page .picker-value,
.cinema-page .field-input,
.cinema-page .field-textarea,
.cinema-page .choice,
.cinema-page .segment-choice {
  border-color: var(--color-border-strong);
  background-color: var(--color-input-bg);
  color: var(--color-text);
}
.cinema-page .fixed,
.cinema-page .fixed-bar,
.cinema-page .action-bar,
.cinema-page .actionbar {
  border-color: var(--color-border-strong);
  background-color: var(--color-fixed-bar);
}
.cinema-page .decision,
.cinema-page .conclusion-panel,
.cinema-page .ink {
  border-color: var(--color-cinema-line) !important;
  background-color: var(--color-media-card-bg) !important;
  color: var(--color-on-media) !important;
}
.cinema-page .tag--dark,
.cinema-page .ticket-tag,
.cinema-page .filter-tab.is-active,
.cinema-page .status-filter.active,
.cinema-page .segment.selected,
.cinema-page .day-chip.is-active {
  border-color: var(--color-action) !important;
  background-color: var(--color-action) !important;
  color: var(--color-on-action) !important;
}
.cinema-page .tag-success,
.cinema-page .tag--connected,
.cinema-page .tag--approved,
.cinema-page .tag--checked_in,
.cinema-page .approved-mark {
  border-color: var(--color-status-success) !important;
  background-color: var(--color-status-success-soft) !important;
  color: var(--color-status-success) !important;
}
.cinema-page .tag-warning,
.cinema-page .tag--pending,
.cinema-page .tag--waiting,
.cinema-page .group-qr-warning {
  border-color: var(--color-status-warning) !important;
  background-color: var(--color-status-warning-soft) !important;
  color: var(--color-status-warning) !important;
}
.cinema-page .tag--rejected,
.cinema-page .tag--cancelled,
.cinema-page .tag--error,
.cinema-page .tag.is-error {
  border-color: var(--color-danger) !important;
  background-color: var(--color-danger-soft) !important;
  color: var(--color-danger-text) !important;
}

@keyframes cinema-blur-in {
  from {
    opacity: 0;
    filter: blur(8rpx);
    transform: translateY(var(--motion-distance-reveal));
  }
  to {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}
@keyframes cinema-rise-in {
  from {
    opacity: 0;
    transform: translateY(var(--motion-distance-reveal));
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes cinema-hero-in {
  from {
    opacity: 0.84;
    transform: scale(1.025);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@media (max-width: 340px) {
  page {
    --page-gutter: var(--page-gutter-narrow);
  }
  .fixed,
  .action-bar {
    grid-template-columns: 1fr;
  }
  .metrics,
  .metric-panel,
  .route-native-metrics,
  .route-metric-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 375px) {
  button.btn {
    min-height: var(--control-height);
  }
  button,
  button.secondary,
  button.button,
  button.text-button,
  button.image-action,
  button.map-button,
  button.photo-action,
  button.route-action {
    min-height: var(--control-height);
  }
  .timeline-tabs .timeline-tab,
  .status-filters .status-filter,
  .filter-tabs .filter-tab,
  .experience-segment .segment {
    min-height: var(--segment-height);
  }
}

/* touch-hit-begin · 触控热区补齐（2026-10-29）
   背景：rpx 随视口宽度缩放，340px 窄屏下 96/92/88rpx 控件高度低于 44 CSS px 命中下限。
   方法：wxml 真实透明子节点 <view class="hit-pad"> 承载命中层（固定 CSS px 扩张，不随 rpx 缩放），
   不绘制背景/边框/字号/字色，不占文档流、不改变视觉布局；命中事件冒泡回宿主控件。
   分段类仅做纵向扩张，避免三列相邻控件横向互抢；无对应 wxml 节点的宿主不产生扩张。
   验证边界：微信原生渲染层 tap 命中仍须真机门禁复核；本仓库无 IDE 授权，
   浏览器证据只覆盖原型 HTML，不得外推为 native 通过；真机矩阵未取得前 native 结论保持 BLOCKED。 */

/* 组件尺度令牌：触控命中下限固定 44 CSS px；视觉基线 --control-height（96rpx）原值不动，
   仅作承载几何引用，不改颜色/字号/字重/背景/边框。 */
page {
  --touch-target-min: 44px;
}

button,
.btn,
.secondary,
.button,
.map-button,
.photo-button,
.photo-action,
.route-action,
.profile-alert-action,
.meeting-location__action,
.text-button,
.image-action,
.row.rowlink.rowbutton {
  position: relative;
}

/* —— 真实节点承载（bearing）：宿主真实元素自身以 --touch-target-min 承载 min-height，
   字形/字号/颜色不变；不使用伪元素。图标型小钮另补 min-width 下限。仅承载几何，不绘制背景/边框。
   沸点契约锁定为 var(--control-height) 的主按钮不在此声明高度，由窄屏 media 兜底补齐。 —— */
.load-more,
.submit-button,
.back-button,
.cancel-button,
.delete-button,
.delete-record-button,
.trip-action,
.club-admin-action,
.club-admin-retry,
.club-manage-btn,
.chapterhead-action,
.consent-primary,
.consent-later,
.permission-card-action,
.permission-reset,
.save-action,
.profile-progress-action,
.profile-status-action,
.profile-permission,
.route-upload-button,
.route-link-plus,
.route-source-conn-link,
.row.rowlink.rowbutton,
.start-navigation-button,
.refresh-error,
.activity-retry,
.club-profile-retry,
.club-media-btn,
.club-cover-remove,
.club-profile-submit,
.strava-cta,
.ticket,
.paper,
.rider,
.story,
.activity-row,
.background-placeholder {
  min-height: var(--touch-target-min);
}

/* 图标型小钮横向最小命中 44px（容器已有相对定位，glyph 居中，不改字形）。 */
.back-button,
.photo-remove,
.club-admin-retry,
.activity-retry,
.club-profile-retry,
.refresh-error,
.swipe-delete {
  min-width: var(--touch-target-min);
  min-height: var(--touch-target-min);
}

button .hit-pad,
.btn .hit-pad,
.secondary .hit-pad,
.button .hit-pad,
.map-button .hit-pad,
.photo-button .hit-pad,
.photo-action .hit-pad,
.route-action .hit-pad,
.profile-alert-action .hit-pad,
.meeting-location__action .hit-pad,
.text-button .hit-pad,
.image-action .hit-pad,
.row.rowlink.rowbutton .hit-pad {
  position: absolute;
  top: -4px;
  bottom: -4px;
  left: 0;
  right: 0;
  pointer-events: auto;
}

.step,
.segment,
.timeline-tab,
.status-filter,
.filter-tab {
  position: relative;
  min-height: var(--touch-target-min);
}

.step .hit-pad,
.segment .hit-pad,
.timeline-tab .hit-pad,
.status-filter .hit-pad,
.filter-tab .hit-pad {
  position: absolute;
  top: -4px;
  bottom: -4px;
  left: 0;
  right: 0;
  pointer-events: auto;
}

/* —— 级联兜底（R-CASCADE-1）：页面 wxss 在 app.wxss 之后加载，同/高特异性
   的页面 min-height（rpx 换算后 <44px）会覆盖上面的单类 bearing；这里只用
   更高特异性引用 --touch-target-min，不改字号/字色/背景/边框/圆角，字形主题不变。 —— */
.filter-tab.filter-tab.filter-tab {
  min-height: var(--touch-target-min);
}

button.row.rowlink.rowbutton.rowlink {
  min-height: var(--touch-target-min);
}

.chapterhead-action.chapterhead-action {
  min-height: var(--touch-target-min);
}

/* 沸点契约锁定 var(--control-height) 的主按钮不在此改写声明高度；
   窄屏 96rpx=43.52px 的不足由其真实 .hit-pad 纵向各扩张 4px（命中盒 51.52px）补齐，
   视觉声明保持 var(--control-height)，不改字号/颜色。 */
/* touch-hit-end */
