page {
  background: #f5f7f2;
  color: #17231e;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(168rpx + env(safe-area-inset-bottom));
}

.hero {
  overflow: hidden;
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  background: #0b6b4f;
  color: #fff;
}

.hero-kicker {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  opacity: 0.76;
}

.hero-title {
  margin: 12rpx 0 10rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-subtitle {
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(11, 107, 79, 0.08);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(23, 35, 30, 0.06);
}

.title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.35;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: #718078;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f3ee;
  color: #0b6b4f;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.warn {
  background: #fff5df;
  color: #9a6513;
}

.danger {
  background: #fceded;
  color: #d94b4b;
}

.btn,
.secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 20rpx 0 0;
  border-radius: 18rpx !important;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.btn {
  background: #0b6b4f !important;
  color: #fff !important;
}

.btn:active {
  background: #085540 !important;
}

.btn[disabled] {
  background: #a9b8b1 !important;
  color: rgba(255, 255, 255, 0.86) !important;
}

.secondary {
  border: 2rpx solid #cfe0d8;
  background: #fff !important;
  color: #0b6b4f !important;
}

button::after {
  border: 0;
}

.field {
  margin: 26rpx 0;
}

.label {
  margin-bottom: 10rpx;
  color: #4f6058;
  font-size: 24rpx;
  font-weight: 600;
}

.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #dfe7e2;
  border-radius: 16rpx;
  background: #f8faf7;
}

.textarea {
  min-height: 176rpx;
}

.fixed {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8ede9;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -8rpx 24rpx rgba(23, 35, 30, 0.08);
}

.fixed .btn,
.fixed .secondary {
  margin: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.metric {
  min-width: 0;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #eef5f1;
  color: #718078;
  font-size: 23rpx;
}

.big {
  margin-bottom: 4rpx;
  color: #0b6b4f;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
  word-break: break-word;
}

.empty {
  padding: 88rpx 32rpx;
  color: #718078;
  text-align: center;
}

.section-label {
  margin: 34rpx 4rpx 10rpx;
  color: #718078;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
