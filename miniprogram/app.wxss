page {
  --color-bg: #ffffff;
  --color-surface: #ffffff;
  --color-raised: #f4f5f0;
  --color-text: #10120f;
  --color-muted: #5b6258;
  --color-subtle: #737a70;
  --color-placeholder: #6b7268;
  --color-disabled-text: #5b6258;
  --color-on-media: #f7f7f5;
  --color-media-muted: #d2d2d6;
  --color-media-placeholder-bg: #101012;
  --color-media-card-bg: #1c1c1e;
  --color-on-media-gender-male: #4fb3a7;
  --color-on-media-gender-female: #ef8072;
  --color-on-media-gender-unknown: #e9743f;
  --color-gender-male: #17665f;
  --color-gender-female: #983c34;
  --color-gender-unknown: #8a401f;
  --color-border: #10120f;
  --color-border-strong: #10120f;
  --color-input-bg: #ffffff;
  --color-fixed-bar: rgba(255, 255, 255, 0.98);
  --color-overlay: rgba(0, 0, 0, 0.72);
  --color-shadow: rgba(16, 18, 15, 0.12);
  --color-brand: #d9ff43;
  --color-brand-active: #c4ec23;
  --color-brand-soft: #f2ffc2;
  --color-on-brand: #10120f;
  --color-action: #10120f;
  --color-action-active: #30342e;
  --color-on-action: #ffffff;
  --color-danger: #b3261e;
  --color-danger-text: #8f1d17;
  --color-danger-soft: #fbe9e7;
  --color-success: #356348;
  --color-success-text: #294f39;
  --color-success-soft: #e5f2e9;
  --color-warning: #8a5b12;
  --color-warning-text: #71490d;
  --color-warning-soft: #fff0d4;
  --color-card-border: #10120f;
  --shadow-hard: 8rpx 8rpx 0 #10120f;
  --shadow-card: var(--shadow-hard);
  --metric-align: left;
  --page-heading-align: left;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-display: 32rpx;
  --radius-card: 32rpx;
  --cili-black: var(--color-bg);
  --cili-charcoal: var(--color-surface);
  --cili-panel: var(--color-raised);
  --cili-border: var(--color-border);
  --cili-silver: var(--color-muted);
  --cili-white: var(--color-text);
  --cili-orange: var(--color-brand);
  --cili-orange-dark: var(--color-brand-active);
  --cili-red: var(--color-danger);
  --cili-success: var(--color-success);
  --tab-bar-height: 112rpx;
  --tab-page-bottom-space: 32rpx;
  --fixed-action-reserve: 224rpx;
  --fixed-action-reserve-narrow: 320rpx;
  --control-height: 96rpx;
  --segment-height: 80rpx;
  --page-gutter: 32rpx;
  --page-gutter-narrow: 24rpx;
  --card-gap: 24rpx;
}

page {
  min-height: 100%;
  height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.a11y-live-region {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 168rpx;
  padding-bottom: calc(168rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  background-color: var(--color-bg);
  color: var(--color-text);
}

.page.activities-page,
.page.registrations-page,
.page.profile-page {
  padding-bottom: var(--tab-page-bottom-space);
  padding-bottom: calc(var(--tab-page-bottom-space) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--tab-page-bottom-space) + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 36rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-display);
  background: linear-gradient(135deg, var(--color-raised) 0%, var(--color-surface) 68%);
  color: var(--color-text);
  box-shadow: 0 18rpx 48rpx var(--color-shadow);
}

.hero::after {
  position: absolute;
  right: -54rpx;
  bottom: -76rpx;
  width: 220rpx;
  height: 220rpx;
  border: 30rpx solid var(--color-brand-soft);
  border-radius: 50%;
  content: '';
}

.hero-kicker {
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  margin: 12rpx 0 10rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  color: var(--color-muted);
  font-size: 25rpx;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: 0 10rpx 30rpx var(--color-shadow);
}

.title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: var(--color-muted);
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--color-success);
  border-radius: 999rpx;
  background: var(--color-success-soft);
  color: var(--color-success-text);
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.warn {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning-text);
}

.danger {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}

.btn,
.secondary {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  margin: 20rpx 0 0;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm) !important;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: 0;
  clip-path: none;
}

.btn {
  background: var(--color-action) !important;
  color: var(--color-on-action) !important;
}

.btn:active {
  background: var(--color-action-active) !important;
}

.btn[disabled],
.secondary[disabled],
button[disabled] {
  border-color: var(--color-border) !important;
  background: var(--color-raised) !important;
  color: var(--color-disabled-text) !important;
  opacity: 1;
}

.secondary {
  border: 1rpx solid var(--color-border-strong);
  background: var(--color-input-bg) !important;
  color: var(--color-text) !important;
}

button::after {
  border: 0;
}

.field {
  margin: 26rpx 0;
}

.label {
  margin-bottom: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.input-placeholder {
  color: var(--color-placeholder);
}

.input,
.textarea {
  width: 100%;
  min-height: var(--control-height);
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  background: var(--color-input-bg);
  color: var(--color-text);
}

.textarea {
  min-height: 176rpx;
}

.fixed {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx;
  padding: 16rpx 24rpx calc(16rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 24rpx var(--color-shadow);
}

.fixed .btn,
.fixed .secondary {
  margin: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.metric {
  min-width: 0;
  padding: 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-input-bg);
  color: var(--color-muted);
  font-size: 23rpx;
}

.big {
  margin-bottom: 4rpx;
  color: var(--color-text);
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.empty {
  padding: 88rpx 32rpx;
  color: var(--color-muted);
  text-align: center;
}

.section-label {
  margin: 34rpx 4rpx 10rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* Semantic theme bridge: page shells and data/admin surfaces inherit either theme. */
.activities-page,
.detail-page,
.capability-page,
.credential-page,
.registrations-page,
.profile-form-page,
.strava-page,
.profile-page,
.form-page,
.activity-form-page,
.activity-list-page,
.review-detail-page,
.review-page {
  background: var(--color-bg);
  color: var(--color-text);
}

.activities-page .muted,
.detail-page .muted,
.credential-page .muted,
.registrations-page .muted,
.profile-form-page .muted,
.strava-page .muted,
.profile-page .muted,
.form-page .muted,
.activity-form-page .muted,
.activity-list-page .muted,
.review-detail-page .muted,
.review-page .muted,
.hint,
.field-hint,
.section-hint,
.status-help {
  color: var(--color-muted);
}

.activity-context,
.form-surface,
.form-card,
.credential-card,
.timeline-card,
.status-card,
.registration-card,
.activity-list-page .card,
.activity-form-page .card,
.snapshot-panel,
.decision-panel,
.activity-picker,
.review-card,
.detail-page .card,
.metric-panel,
.rider-card,
.profile-page .card,
.menu-list {
  border-color: var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: 0 10rpx 30rpx var(--color-shadow);
}

.identity-card,
.choice,
.experience-segment,
.strava-row,
.safety-box,
.meet-info,
.review-comment,
.rider-stats view,
.metric-item,
.menu-card,
.profile-refreshing,
.profile-cache-message {
  border-color: var(--color-border);
  background: var(--color-raised);
  color: var(--color-text);
}

.field input,
.field textarea,
.form-card .input,
.remark,
.review-detail-page .textarea {
  border-color: var(--color-border-strong);
  background: var(--color-input-bg);
  color: var(--color-text);
}

.form-section,
.credential-row,
.card-footer,
.route-location-row,
.climb-row,
.detail-line,
.facts,
.metrics,
.sync-meta,
brand-logo {
  border-color: var(--color-border);
}

.fixed,
.form-page .fixed {
  border-color: var(--color-border);
  background: var(--color-fixed-bar);
  box-shadow: 0 -8rpx 28rpx var(--color-shadow);
}

.hero-kicker,
.context-kicker,
.section-eyebrow,
.panel-index,
.eyebrow,
.picker-label,
.metric-kicker,
.route-arrow,
.schedule-time,
.check,
.date,
.arrow,
.serial,
.accent,
.open-arrow,
.corner-cut {
  color: var(--color-text);
}

.btn,
.submit-button,
.save-action,
.repair-button,
.filter-tab.is-active {
  background-color: var(--color-action) !important;
  color: var(--color-on-action) !important;
}

.secondary,
.back-button,
.text-button,
.route-actions button,
.route-location-row button,
.media-actions button,
.media-add,
.location-button,
.photo-button {
  border-color: var(--color-border-strong);
  background: var(--color-input-bg) !important;
  color: var(--color-text) !important;
}

.status-pending,
.status-approved,
.status-checked_in,
.status-rejected,
.status-cancelled,
.status-ready,
.status-failed,
.status-disconnected,
.status-syncing,
.status-authorizing {
  color: var(--color-text);
}

/* Three-level radius system; circular avatars and pills remain circular. */
.form-card,
.status-card,
.registration-card,
.activity-list-page .card,
.activity-form-page .card,
.snapshot-panel,
.decision-panel,
.activity-picker,
.review-card,
.detail-page .card,
.metric-panel,
.rider-card,
.profile-page .card,
.menu-list,
.form-surface,
.activity-context {
  border-radius: var(--radius-display);
}

.field input,
.field textarea,
.form-card .input,
.remark,
.review-detail-page .textarea,
.metric-item,
.menu-card,
.identity-card,
.choice,
.experience-segment,
.strava-row,
.safety-box,
.meet-info,
.review-comment {
  border-radius: var(--radius-md);
}

button,
.btn,
.secondary,
.text-button,
.route-actions button,
.route-location-row button,
.media-actions button,
.media-add,
.location-button {
  min-height: var(--control-height);
}
