{
  "pages": [
    "pages/activities/index",
    "pages/registration-form/index",
    "pages/registrations/index",
    "pages/credential/index",
    "pages/profile/index",
    "pages/capability-card/index"
  ],
  "subpackages": [
    {
      "root": "pages/settings",
      "pages": ["index"]
    },
    {
      "root": "pages/activity-detail",
      "pages": ["index"]
    },
    {
      "root": "pages/route-analysis",
      "pages": ["index"]
    },
    {
      "root": "pages/profile-edit",
      "pages": ["index"]
    },
    {
      "root": "pages/club",
      "pages": ["center/index"]
    },
    {
      "root": "pages/admin",
      "pages": [
        "activity-list/index",
        "activity-edit/index",
        "reviews/index",
        "review-detail/index",
        "club-applications/index",
        "club-application-detail/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/activity-detail/index": {
      "network": "all",
      "packages": ["pages/route-analysis"]
    }
  },
  "requiredPrivateInfos": ["chooseLocation"],
  "window": {
    "navigationBarTitleText": "此里",
    "navigationBarBackgroundColor": "#0b0a0c",
    "navigationBarTextStyle": "white",
    "enablePullDownRefresh": false,
    "backgroundColor": "#0b0a0c",
    "backgroundColorTop": "#0b0a0c",
    "backgroundColorBottom": "#0b0a0c",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "backgroundColor": "#0b0a0c",
    "borderStyle": "black",
    "color": "#b8b3ba",
    "selectedColor": "#e54242",
    "list": [
      {
        "pagePath": "pages/activities/index",
        "text": "活动",
        "iconPath": "assets/tabbar/activities-light.png",
        "selectedIconPath": "assets/tabbar/activities-active.png"
      },
      {
        "pagePath": "pages/registrations/index",
        "text": "行程",
        "iconPath": "assets/tabbar/registrations-light.png",
        "selectedIconPath": "assets/tabbar/registrations-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "assets/tabbar/profile-light.png",
        "selectedIconPath": "assets/tabbar/profile-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json"
