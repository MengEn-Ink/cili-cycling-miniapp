  letter-spacing: -0.025em;
  color: var(--color-on-media);
}
.club-center-page.aihero-page .activity-row {
  padding: 28rpx 0;
  border: 0;
  border-bottom: 1px solid var(--color-border);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.club-center-page.aihero-page .story-title {
  font-size: 38rpx;
}

/* Admin: grouped metrics, flat list actions, numbered single-column form. */
.activity-list-page.aihero-page .ticket,
.activity-list-page.aihero-page .paper {
  border: 1px solid var(--color-border);
  border-radius: 22rpx;
  background: var(--color-surface);
  box-shadow: none;
}
.activity-list-page.aihero-page .ticket-title,
.activity-list-page.aihero-page .paper-title {
  font-family: var(--font-family-body);
  font-size: 40rpx;
  line-height: 1.25;
  letter-spacing: -0.025em;
}
.activity-list-page.aihero-page .management-metrics {
  margin: 28rpx 0;
}
.activity-list-page.aihero-page .page-actions {
  margin-top: 32rpx;
}
.activity-editor.aihero-page .fieldgrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0;
}
.activity-editor.aihero-page .form-card {
  padding: 40rpx 0 0;
  border-radius: 0;
  background: transparent;
}
.activity-editor.aihero-page .image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}
.activity-editor.aihero-page .image-item,
.activity-editor.aihero-page .upload-tile {
  border-radius: 18rpx;
}
.activity-editor.aihero-page .choicegrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16rpx;
}
.activity-editor.aihero-page .choice {
  border: 1px solid var(--color-border-strong);
  border-radius: 18rpx;
  background: var(--color-surface);
  padding: 28rpx;
  text-align: left;
}
.activity-editor.aihero-page .choice.is-active {
  border-color: var(--color-action);
  background: var(--color-brand-soft);
}
.activity-editor.aihero-page .route-preview-card .metrics {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.review-page.aihero-page .info-bar {
  padding: 28rpx;
  border: 1px solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-surface);
}
.review-page.aihero-page .reviewitem {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1px solid var(--color-border);
  border-radius: 22rpx;
  background: var(--color-surface);
  box-shadow: none;
}
.review-page.aihero-page .reviewitem-title {
  font-size: 34rpx;
  letter-spacing: -0.02em;
}
.review-page.aihero-page .reviewitem .meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  padding: 20rpx 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}
.review-detail-page.aihero-page .person {
  padding: 28rpx;
  border: 1px solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-surface);
}
.review-detail-page.aihero-page .section-body {
  padding: 28rpx;
  border: 1px solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-surface);
  line-height: 1.75;
}
.club-profile-page.aihero-page .club-cover-editor {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border: 0;
  border-bottom: 1px solid var(--color-border);
  border-radius: 0;
  padding: 0 0 28rpx;
}
.club-profile-page.aihero-page .club-cover-preview {
  width: 100%;
  height: 0;
  padding-top: 56.25%;
  border-radius: 18rpx;
}
.club-profile-page.aihero-page .club-cover-preview > .upload-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.club-profile-page.aihero-page .club-avatar-editor {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  border: 0;
  padding: 28rpx 0;
  border-radius: 0;
}
.club-profile-page.aihero-page .upload-copy {
  flex: 1;
  min-width: 0;
}
.capability-page.aihero-page {
  padding: 40rpx var(--page-gutter);
  min-height: 100vh;
}
.capability-page.aihero-page .redirect-heading {
  padding: 40rpx 0;
  border-bottom: 1px solid var(--color-border);
}

/* Tabs are navigation, not filled CTAs; status retains its semantic colour. */
.aihero-page.aihero-page .filter-tab,
.activities-page.aihero-page .segment-item {
  border: 0;
  border-bottom: 1px solid transparent;
  border-radius: 0;
  background: transparent;
  color: var(--color-muted);
}
.aihero-page.aihero-page .filter-tab.is-active,
.activities-page.aihero-page .segment-item.selected {
  border-bottom-color: var(--color-action);
  background: transparent;
  color: var(--color-text);
}
.review-page.aihero-page .info-tag.is-pending {
  border: 1px solid var(--color-status-warning);
  background: transparent;
  color: var(--color-status-warning);
}
.review-page.aihero-page .tag--approved,
.review-page.aihero-page .tag--checked_in {
  border: 1px solid var(--color-status-success);
  background: transparent;
  color: var(--color-status-success);
}
