.pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid #55555b;
  border-radius: 4rpx;
  background: #29292d;
  color: #b8b8bc;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.pill--success {
  border-color: #557363;
  background: rgba(111, 155, 130, 0.14);
  color: #9bc2aa;
}

.pill--warning {
  border-color: #c88418;
  background: rgba(200, 132, 24, 0.12);
  color: #e7a84b;
}

.pill--danger {
  border-color: #c82018;
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
}

.pill {
  border-color: var(--color-border-strong);
  background: var(--color-raised);
  color: var(--color-muted);
}
.pill--success {
  border-color: var(--color-success);
  background: var(--color-success-soft);
  color: var(--color-success-text);
}
.pill--warning {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning-text);
}
.pill--danger {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
  color: var(--color-danger-text);
}
