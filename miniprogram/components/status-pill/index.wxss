.pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid #55555b;
  border-radius: 4rpx;
  background: #29292d;
  color: #b8b8bc;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.pill--success {
  border-color: #d55b1f;
  background: rgba(213, 91, 31, 0.14);
  color: #f38a50;
}

.pill--warning {
  border-color: #c88418;
  background: rgba(200, 132, 24, 0.12);
  color: #e7a84b;
}

.pill--danger {
  border-color: #c82018;
  background: rgba(200, 32, 24, 0.12);
  color: #ff7068;
}
