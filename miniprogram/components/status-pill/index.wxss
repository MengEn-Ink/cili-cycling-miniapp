.pill {
  display: inline-flex;
  max-width: 100%;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  vertical-align: middle;
  white-space: nowrap;
}
.pill-icon,
.pill-label {
  display: inline-flex;
  align-items: center;
  line-height: 1;
}
.pill-icon {
  font-size: 24rpx;
}
.pill--solid {
  background: var(--color-action);
  color: var(--color-on-action);
}
.pill--pending {
  border: 4rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-text);
}
.pill--success {
  border: 2rpx solid var(--color-status-success);
  background: var(--color-status-success-soft);
  color: var(--color-status-success);
}
.pill--warning {
  border: 2rpx solid var(--color-status-warning);
  background: var(--color-status-warning-soft);
  color: var(--color-status-warning);
}
.pill--danger {
  border: 2rpx solid var(--color-brand);
  background: var(--color-surface);
  color: var(--color-brand-active);
}
.pill--ticket.pill--danger {
  border-color: transparent;
  background: var(--color-raised);
  color: var(--color-muted);
}
