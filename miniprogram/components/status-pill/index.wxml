<text class="pill {{status === '已通过' ? 'pill--success' : ''}} {{status === '即将满员' || status === '名额紧张' ? 'pill--warning' : ''}} {{status === '待审核' ? 'pill--pending' : ''}} {{status === '已驳回' || status === '已取消' ? 'pill--danger' : ''}} {{status === '报名中' || status === '已上线' ? 'pill--solid' : ''}}">{{status === '已通过' ? '✓ ' : (status === '即将满员' || status === '名额紧张' ? '⚠ ' : '')}}{{status}}</text>