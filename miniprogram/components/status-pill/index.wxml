<text class="pill {{ticket ? 'pill--ticket' : ''}} {{status === '已通过' ? 'pill--success' : ''}} {{status === '即将满员' || status === '名额紧张' ? 'pill--warning' : ''}} {{status === '待审核' ? 'pill--pending' : ''}} {{status === '已驳回' || status === '已取消' ? 'pill--danger' : ''}} {{status === '报名中' || status === '已上线' ? 'pill--solid' : ''}}"><text wx:if="{{status === '已通过'}}" class="pill-icon" aria-hidden="true">✓</text><text wx:elif="{{status === '即将满员' || status === '名额紧张'}}" class="pill-icon" aria-hidden="true">⚠</text><text class="pill-label">{{status}}</text></text>
