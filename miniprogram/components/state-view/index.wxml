<view wx:if="{{loading}}" class="state-shell"><view class="state-mark" aria-hidden="true"></view><view class="state-title">正在加载</view><view class="state-copy">正在同步骑行数据…</view></view>
<view wx:elif="{{error}}" class="state-shell state-shell--error"><view class="state-code" aria-hidden="true">!</view><view class="state-title">加载失败</view><view class="state-copy">{{error}}</view><button class="state-retry" size="mini" bindtap="retry">重新加载</button></view>
<view wx:elif="{{empty}}" class="state-shell"><view class="state-code" aria-hidden="true">C</view><view class="state-title">{{emptyTitle}}</view><view class="state-copy">{{emptyCopy}}</view></view>
<slot wx:else />
