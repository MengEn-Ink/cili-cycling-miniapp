.a11y-live-region {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.state-shell {
  margin-top: 48rpx;
  padding: 64rpx 32rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-muted);
  text-align: center;
}
.state-mark {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  animation: state-pulse 1.2s ease-in-out infinite;
}
@keyframes state-pulse {
  50% {
    opacity: 0.55;
  }
}
@media (prefers-reduced-motion: reduce) {
  .state-mark {
    animation: none;
  }
}
.state-code {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-raised);
  color: var(--color-text);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 900;
}
.state-shell--error .state-code {
  background: var(--color-brand);
  color: var(--color-on-brand);
}
.state-title {
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
}
.state-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.state-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--control-height);
  margin-top: 24rpx;
  border: 4rpx solid var(--color-action);
  border-radius: var(--radius-sm);
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 28rpx;
  font-weight: 800;
}
