.a11y-live-region {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.state-shell {
  margin-top: 24rpx;
  padding: 80rpx 32rpx;
  border: 1rpx dashed #414146;
  border-radius: 8rpx;
  background: #151517;
  color: #85858a;
  text-align: center;
}

.state-mark {
  width: 36rpx;
  height: 36rpx;
  margin: 0 auto 20rpx;
  border: 5rpx solid #3f3f44;
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: state-spin 0.8s linear infinite;
}

@keyframes state-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .state-mark {
    animation: none;
  }
}

.state-code {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto 18rpx;
  border: 4rpx solid var(--color-brand);
  border-radius: 50%;
  color: #f7f7f5;
  font-size: 28rpx;
  font-weight: 900;
}

.state-shell--error .state-code {
  border-color: #c82018;
  color: #ff7068;
}

.state-title {
  color: #f7f7f5;
  font-size: 28rpx;
  font-weight: 800;
}

.state-copy {
  margin-top: 8rpx;
  font-size: 23rpx;
}

.state-retry {
  margin-top: 24rpx;
  border: 1rpx solid var(--color-brand);
  border-radius: 4rpx;
  background: transparent;
  color: var(--color-brand);
  font-weight: 700;
}

.state-shell {
  border-color: var(--color-border-strong);
  border-radius: var(--radius-md);
  background: var(--color-input-bg);
  color: var(--color-muted);
}
.state-mark {
  border-color: var(--color-border);
  border-top-color: var(--color-brand);
}
.state-code {
  border-color: var(--color-brand);
  color: var(--color-text);
}
.state-title {
  color: var(--color-text);
}
.state-shell--error .state-code {
  border-color: var(--color-danger);
  color: var(--color-danger-text);
}
.state-retry {
  min-height: 88rpx;
  border-color: var(--color-brand);
  border-radius: var(--radius-sm);
  color: var(--color-brand);
}
