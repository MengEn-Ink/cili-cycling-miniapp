:host {
  display: inline-flex;
  flex: 0 0 auto;
  vertical-align: middle;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: 50%;
  background: var(--color-action);
}
.avatar--sm {
  width: 64rpx;
  height: 64rpx;
}
.avatar--md {
  width: 88rpx;
  height: 88rpx;
}
.avatar--lg {
  width: 128rpx;
  height: 128rpx;
}
.avatar--on-media {
  border: 6rpx solid var(--color-on-media);
}
.avatar__image {
  display: block;
  width: 100%;
  height: 100%;
}
.avatar__fallback {
  background: var(--color-logo-background);
}
