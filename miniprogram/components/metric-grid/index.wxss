:host {
  display: block;
}
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-border);
}
.metric-grid--3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.metric-grid--4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.metric-grid__item {
  min-width: 0;
  padding: 16rpx 24rpx;
  background: var(--color-surface);
}
.metric-grid__reading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  min-width: 0;
  align-items: end;
  gap: 8rpx;
}
.metric-grid__value {
  min-width: 0;
  overflow-wrap: normal;
  white-space: nowrap;
  color: var(--color-text);
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}
.metric-grid--4 .metric-grid__item {
  padding-right: 16rpx;
  padding-left: 16rpx;
}
.metric-grid--4 .metric-grid__value {
  font-size: 36rpx;
  line-height: 48rpx;
}
.metric-grid__unit,
.metric-grid__label {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.metric-grid__unit {
  align-self: end;
  flex: 0 0 auto;
  padding-bottom: 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}
.metric-grid__label {
  display: block;
  overflow-wrap: anywhere;
}
@media (max-width: 340px) {
  .metric-grid--narrow-1 {
    grid-template-columns: 1fr;
  }
  .metric-grid--narrow-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .metric-grid__item {
    padding: 16rpx;
  }
}
