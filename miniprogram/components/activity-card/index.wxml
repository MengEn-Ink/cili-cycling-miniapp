<view class="activity-card" bindtap="open" hover-class="activity-card--pressed" role="button" aria-label="查看活动：{{item.title}}">
  <view class="card-media">
    <image wx:if="{{item.coverImage && !coverFailed}}" class="card-cover" src="{{item.coverImage}}" mode="aspectFill" lazy-load="{{!eager}}" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
    <generated-activity-cover wx:else item="{{item}}" variant="card" />
    <view class="media-status"><status-pill status="{{item.displayStatus}}" /></view>
    <view class="card-caption">
      <view class="card-meta"><text>{{item.displayDateLabel}}</text><text>{{item.displayTimeLabel}}</text></view>
      <view class="activity-title">{{item.title}}</view>
      <view class="club-name">{{item.clubIdentity.name}}</view>
    </view>
  </view>
  <view class="card-facts">
    <view class="metrics">
      <view class="metric-item"><text class="metric-value">{{item.route.distanceKm > 0 ? item.route.distanceKm : '—'}}{{item.route.distanceKm > 0 ? ' km' : ''}}</text><text class="metric-unit">里程</text></view>
      <view class="metric-item"><text class="metric-value">{{item.route.elevationM > 0 ? item.route.elevationM : '—'}}{{item.route.elevationM > 0 ? ' m' : ''}}</text><text class="metric-unit">爬升</text></view>
      <view class="metric-item"><text class="metric-value">{{item.estimatedRideTime || '—'}}</text><text class="metric-unit">预计骑行</text></view>
    </view>
    <view class="route-line"><text class="location-label">集合</text><text>{{item.route.start || '集合地点待公布'}}</text><text class="card-arrow">查看活动 →</text></view>
  </view>
</view>
