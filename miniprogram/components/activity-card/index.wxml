<view class="activity-card {{item.coverImage && !coverFailed ? 'activity-card--media' : 'activity-card--plain'}}" bindtap="open" hover-class="activity-card--pressed" hover-stay-time="90" role="button" aria-label="查看活动：{{item.title}}">
  <view class="card-media">
    <image wx:if="{{item.coverImage && !coverFailed}}" class="card-cover" src="{{item.coverImage}}" mode="aspectFill" lazy-load="{{true}}" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
    <view wx:else class="card-placeholder" aria-label="暂无活动封面">
      <view class="placeholder-mark">骑有此里</view>
      <view class="placeholder-copy">暂无活动封面</view>
    </view>
  </view>
  <view class="card-info">
    <view class="card-date">
      <view><text class="date-label">集合时间</text><text class="date-value">{{item.displayDate}}</text></view>
      <status-pill status="{{item.displayStatus}}" />
    </view>
    <view class="publisher" wx:if="{{item.publisher}}">
      <image wx:if="{{item.publisher.avatarUrl}}" class="publisher-avatar" src="{{item.publisher.avatarUrl}}" mode="aspectFill" aria-label="{{item.publisher.nickname}}的头像" />
      <view wx:else class="publisher-avatar publisher-avatar--empty" aria-hidden="true"></view>
      <text class="publisher-name">{{item.publisher.nickname}} 发布</text>
    </view>
    <view class="activity-title">{{item.title}}</view>
    <view class="route-line" wx:if="{{item.registrationUnlimited}}">{{item.route.start || '集合地点待公布'}}</view>
    <view class="route-line" wx:else>{{item.route.start || '起点待公布'}} <text class="route-arrow">→</text> {{item.route.end || '终点待公布'}}</view>
    <view class="metrics">
      <view class="metric-item"><view><text class="metric-value">{{item.route.distanceKm > 0 ? item.route.distanceKm : '—'}}</text><text wx:if="{{item.route.distanceKm > 0}}" class="metric-suffix"> km</text></view><text class="metric-unit">里程</text></view>
      <view class="metric-item"><view><text class="metric-value">{{item.route.elevationM > 0 ? item.route.elevationM : '—'}}</text><text wx:if="{{item.route.elevationM > 0}}" class="metric-suffix"> m</text></view><text class="metric-unit">爬升</text></view>
      <view class="metric-item"><text class="metric-value">{{item.registrationUnlimited ? '不限' : (item.capacity > 0 ? item.remaining : '确认中')}}</text><text class="metric-unit">报名人数</text></view>
    </view>
    <view class="card-foot">
      <view class="card-meta">
        <text wx:if="{{item.route.level}}" class="level">{{item.route.level}}</text>
        <text class="occupancy">{{item.registrationUnlimited ? (item.occupied + ' 人已报名') : (item.capacity > 0 ? (item.occupied + ' / ' + item.capacity + ' 人已报名') : '名额确认中')}}</text>
      </view>
      <view class="card-cta" aria-hidden="true">查看详情 <text>→</text></view>
    </view>
  </view>
</view>
