<view class="activity-card {{item.coverImage && !coverFailed ? 'activity-card--media' : 'activity-card--plain'}}" bindtap="open" hover-class="activity-card--pressed" hover-stay-time="90" role="button" aria-label="查看活动：{{item.title}}">
  <view class="card-media">
    <image wx:if="{{item.coverImage && !coverFailed}}" class="card-cover" src="{{item.coverImage}}" mode="aspectFill" lazy-load="{{true}}" binderror="coverImageError" aria-label="{{item.title}}活动封面" />
    <view wx:else class="card-placeholder" aria-label="暂无活动封面"><brand-logo compact="{{true}}" /><view class="placeholder-copy">路线风景即将更新</view></view>
    <view class="date-plate" aria-label="集合时间：{{item.displayTimeLabel}}"><text class="time-value">{{item.displayTimeLabel}}</text></view>
    <view class="media-status"><status-pill status="{{item.displayStatus}}" /></view>
  </view>
  <view class="card-info">
    <view class="publisher" wx:if="{{item.publisher}}"><image wx:if="{{item.publisher.avatarUrl}}" class="publisher-avatar" src="{{item.publisher.avatarUrl}}" mode="aspectFill" aria-label="{{item.publisher.nickname}}的头像" /><view wx:else class="publisher-avatar publisher-avatar--empty" aria-hidden="true"></view><text class="publisher-name">{{item.publisher.nickname}} 发起</text></view>
    <view class="activity-title">{{item.title}}</view>
    <view class="route-line"><text class="location-label">集合</text><text>{{item.route.start || '集合地点待公布'}}</text></view>
    <view class="metrics">
      <view class="metric-item"><view><text class="metric-value">{{item.route.distanceKm > 0 ? item.route.distanceKm : '—'}}</text><text wx:if="{{item.route.distanceKm > 0}}" class="metric-suffix"> km</text></view><text class="metric-unit">里程</text></view>
      <view class="metric-item"><view><text class="metric-value">{{item.route.elevationM > 0 ? item.route.elevationM : '—'}}</text><text wx:if="{{item.route.elevationM > 0}}" class="metric-suffix"> m</text></view><text class="metric-unit">爬升</text></view>
      <view class="metric-item"><text class="metric-value">{{item.registrationUnlimited ? item.occupied : (item.capacity > 0 ? (item.occupied + ' / ' + item.capacity) : '待确认')}}</text><text class="metric-unit">{{!item.registrationUnlimited && item.capacity <= 0 ? '名额' : '报名'}}</text></view>
    </view>
    <view class="card-foot" wx:if="{{item.route.level}}"><text class="level">{{item.route.level}}</text></view>
  </view>
</view>
