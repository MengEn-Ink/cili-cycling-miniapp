.activity-card {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  border: 4rpx solid var(--color-card-border);
  border-color: var(--color-card-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-card);
  transition:
    transform 120ms ease,
    opacity 120ms ease;
}

.activity-card--pressed {
  opacity: 0.9;
  transform: scale(0.985);
}

.card-media {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border-bottom: 4rpx solid var(--color-card-border);
  background: var(--color-raised);
}

.card-cover {
  width: 100%;
  height: 100%;
}

.card-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--color-raised);
  color: var(--color-text);
  text-align: center;
}

.placeholder-mark {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.placeholder-copy {
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.card-info {
  padding: 24rpx;
}

.card-date {
  display: flex;
  min-height: 48rpx;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-date > view:first-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 2rpx;
}

.date-label {
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.date-value {
  overflow: hidden;
  color: var(--color-text);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.publisher {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 14rpx;
}

.publisher-avatar {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 50%;
  background: var(--color-border);
}

.publisher-avatar--empty {
  border: 2rpx solid var(--color-border);
  background:
    radial-gradient(circle at 50% 38%, var(--color-muted) 0 6rpx, transparent 7rpx),
    linear-gradient(180deg, transparent 24rpx, var(--color-border) 25rpx 100%);
}

.publisher-name {
  margin-left: 12rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

status-pill {
  flex: none;
}

.activity-title {
  display: -webkit-box;
  min-height: 84rpx;
  margin-top: 18rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.24;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.route-line {
  display: -webkit-box;
  min-height: 62rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.3;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.route-arrow {
  margin: 0 4rpx;
  color: var(--color-text);
  font-weight: 900;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 18rpx;
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-border);
  gap: 2rpx;
}

.metric-item {
  min-width: 0;
  min-height: 110rpx;
  padding: 16rpx 6rpx 14rpx;
  background: var(--color-raised);
  text-align: center;
}

.metric-value {
  overflow: hidden;
  color: var(--color-text);
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-suffix {
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 800;
}

.metric-unit {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card-foot {
  display: flex;
  min-height: var(--control-height);
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border);
}

.card-meta {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.4;
}

.level,
.occupancy {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level {
  color: var(--color-text);
  font-weight: 700;
}

.card-cta {
  display: flex;
  width: 192rpx;
  height: var(--control-height);
  min-width: 192rpx;
  min-height: var(--control-height);
  padding: 0 18rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: var(--color-action);
  color: var(--color-on-action);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.card-cta text {
  margin-left: 4rpx;
}

@media (max-width: 350px) {
  .card-media {
    height: 320rpx;
  }

  .card-info {
    padding: 20rpx;
  }

  .activity-title {
    min-height: 78rpx;
    font-size: 31rpx;
  }

  .route-line {
    min-height: 58rpx;
    font-size: 22rpx;
  }

  .metric-value {
    font-size: 27rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .activity-card {
    transition: none;
  }

  .activity-card--pressed {
    transform: none;
  }
}
