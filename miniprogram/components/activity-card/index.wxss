.activity-card {
  --card-accent: var(--color-brand);
  overflow: hidden;
  border: 4rpx solid var(--color-card-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}
.activity-card--pressed {
  transform: scale(0.99);
  background: var(--color-raised);
}
.card-media {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  background: var(--color-media-placeholder-bg);
}
.card-cover {
  width: 100%;
  height: 100%;
}
.card-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 100%;
  color: var(--color-media-muted);
  font-size: 24rpx;
}
.media-status {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}
.card-info {
  padding: 24rpx 32rpx 32rpx;
}
.card-meta {
  display: flex;
  justify-content: space-between;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.activity-title {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.route-line {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.location-label {
  margin-right: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rpx;
  overflow: hidden;
  margin-top: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-border);
}
.metric-item {
  min-width: 0;
  padding: 16rpx 8rpx;
  background: var(--color-surface);
  text-align: center;
}
.metric-value {
  display: block;
  overflow: hidden;
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.metric-unit {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
.card-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}
.card-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: var(--control-height);
  margin: 0;
  padding: 0 16rpx;
  border: 4rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}
.card-action::after {
  border: 0;
}
.card-action--detail {
  background: var(--color-surface);
  color: var(--color-text);
}
.card-action--primary {
  background: var(--color-action);
  color: var(--color-on-action);
}
@media (prefers-reduced-motion: reduce) {
  .activity-card--pressed {
    transform: none;
  }
}
