.activity-card {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  padding: 30rpx 28rpx 26rpx;
  border: 1rpx solid #39393d;
  border-radius: 8rpx;
  background: linear-gradient(145deg, #252528 0%, #18181a 75%);
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.3);
  transition:
    transform 120ms ease,
    border-color 120ms ease;
}

.card-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 112rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #c82018, #d55b1f);
}

.activity-card::after {
  position: absolute;
  right: -1rpx;
  bottom: -1rpx;
  width: 38rpx;
  height: 38rpx;
  background: #d55b1f;
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
  content: '';
}

.activity-card--pressed {
  border-color: #d55b1f;
  transform: scale(0.985);
}

.card-top,
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.date-block {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.date-label {
  color: #74747a;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.date-value {
  color: #d55b1f;
  font-size: 25rpx;
  font-weight: 800;
}

.activity-title {
  margin-top: 20rpx;
  color: #f7f7f5;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
}

.route-line {
  overflow: hidden;
  margin-top: 8rpx;
  color: #a8a8ad;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-arrow,
.arrow {
  color: #d55b1f;
  font-weight: 900;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rpx;
  margin-top: 26rpx;
  border: 1rpx solid #37373b;
  background: #37373b;
}

.metric-item {
  min-width: 0;
  padding: 18rpx 8rpx;
  background: #141416;
  text-align: center;
}

.metric-value,
.metric-unit {
  display: block;
}

.metric-value {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
}

.metric-unit {
  margin-top: 2rpx;
  color: #a8a8ad;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.card-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #37373b;
  color: #8b8b91;
  font-size: 22rpx;
}

.level {
  color: #c5c5c8;
  font-weight: 700;
}
