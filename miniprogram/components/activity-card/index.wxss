.activity-card {
  position: relative;
  overflow: hidden;
  margin-top: 14rpx;
  border: 1rpx solid #38383a;
  border-radius: 32rpx;
  background: #1c1c1e;
  box-shadow: none;
  transition:
    transform 120ms ease,
    border-color 120ms ease,
    opacity 120ms ease;
}

.activity-card--pressed {
  border-color: #ff5722;
  opacity: 0.92;
  transform: scale(0.985);
}

.card-media {
  position: relative;
  height: 254rpx;
  overflow: hidden;
  background: #111113;
}

.card-cover {
  width: 100%;
  height: 100%;
}

.card-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 87, 34, 0.08), transparent 42%),
    linear-gradient(160deg, #252527 0%, #111113 72%);
}

.card-placeholder::before,
.card-placeholder::after {
  position: absolute;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.08);
  content: '';
  transform: rotate(-14deg);
}

.card-placeholder::before {
  right: -60rpx;
  bottom: 76rpx;
  width: 430rpx;
}

.card-placeholder::after {
  right: 24rpx;
  bottom: 48rpx;
  width: 260rpx;
}

.placeholder-orbit {
  position: absolute;
  top: -54rpx;
  right: -20rpx;
  width: 210rpx;
  height: 210rpx;
  border: 24rpx solid rgba(255, 87, 34, 0.12);
  border-radius: 50%;
}

.placeholder-mark {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  color: rgba(247, 247, 245, 0.48);
  font-size: 27rpx;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.placeholder-mark text {
  color: rgba(247, 247, 245, 0.24);
  font-size: 17rpx;
  font-style: normal;
  letter-spacing: 2rpx;
}

.card-media-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 20%, rgba(0, 0, 0, 0.82) 100%);
}

.card-date {
  position: absolute;
  right: 22rpx;
  bottom: 18rpx;
  left: 22rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.date-label {
  color: #b1b1b6;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.date-value {
  overflow: hidden;
  color: #fff;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-content {
  padding: 18rpx 22rpx 20rpx;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.activity-title {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  color: #f7f7f5;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.22;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

status-pill {
  flex: none;
}

.route-line {
  overflow: hidden;
  margin-top: 5rpx;
  color: #a8a8ad;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-arrow {
  margin: 0 4rpx;
  color: #ff5722;
  font-weight: 900;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rpx;
  margin-top: 14rpx;
  border: 1rpx solid #3a3a3c;
  border-radius: 16rpx;
  overflow: hidden;
  background: #3a3a3c;
}

.metric-item {
  min-width: 0;
  padding: 11rpx 5rpx 10rpx;
  background: #2c2c2e;
  text-align: center;
}

.metric-value {
  overflow: hidden;
  color: #f7f7f5;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-suffix {
  color: #d0d0d2;
  font-size: 18rpx;
  font-weight: 800;
}

.metric-unit {
  display: block;
  margin-top: 2rpx;
  color: #a8a8ad;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 13rpx;
  border-top: 1rpx solid #38383a;
}

.card-meta {
  display: flex;
  min-width: 0;
  flex-direction: column;
  color: #8e8e93;
  font-size: 19rpx;
  line-height: 1.35;
}

.level,
.occupancy {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level {
  color: #c5c5c8;
  font-weight: 700;
}

.card-cta {
  flex: none;
  min-width: 150rpx;
  padding: 13rpx 18rpx;
  border-radius: 999rpx;
  background: #ff5722;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.card-cta text {
  margin-left: 4rpx;
}

@media (max-width: 350px) {
  .card-media {
    height: 230rpx;
  }

  .activity-title {
    font-size: 31rpx;
  }

  .metric-value {
    font-size: 27rpx;
  }

  .card-cta {
    min-width: 134rpx;
    padding-right: 14rpx;
    padding-left: 14rpx;
  }
}
