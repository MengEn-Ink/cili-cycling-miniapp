.activity-card {
  --card-accent: var(--color-brand);
  overflow: hidden;
  border-bottom: 2rpx solid var(--color-border-strong);
  background: transparent;
}
.activity-card--pressed {
  transform: scale(0.99);
  background: var(--color-raised);
}
.card-media {
  position: relative;
  height: 560rpx;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-media-placeholder-bg);
}
.card-cover {
  width: 100%;
  height: 100%;
}
.media-status {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}
.card-caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 32rpx;
  background: var(--color-media-card-bg);
  color: var(--color-on-media);
}
.club-name {
  display: block;
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--color-media-muted);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-meta {
  display: flex;
  justify-content: space-between;
  color: var(--color-media-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}
.activity-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--color-on-media);
  font-family: var(--font-family-editorial);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 600;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.card-facts {
  padding: 0 0 20rpx;
}
.route-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.location-label {
  color: var(--color-muted);
  font-size: 24rpx;
}
.route-line > text:nth-child(2) {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}
.card-arrow {
  flex: 0 0 auto;
  color: var(--color-action);
  font-size: 24rpx;
  font-weight: 800;
}
.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rpx;
  overflow: hidden;
  border-bottom: 2rpx solid var(--color-border-strong);
  background: transparent;
}
.metric-item {
  min-width: 0;
  padding: 24rpx 8rpx;
  background: transparent;
  text-align: left;
}
.metric-item + .metric-item {
  padding-left: 20rpx;
  border-left: 2rpx solid var(--color-border-strong);
}
.metric-value {
  display: block;
  overflow: hidden;
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.metric-unit {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}
@media (prefers-reduced-motion: reduce) {
  .activity-card--pressed {
    transform: none;
  }
}
