:host {
  display: block;
}

.brand-logo {
  display: flex;
  min-height: 60rpx;
  align-items: center;
  color: var(--color-text);
}

.brand-logo__wordmark {
  position: relative;
  display: inline-flex;
  align-items: center;
  padding-right: 26rpx;
  color: inherit;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.brand-logo__character {
  position: relative;
  z-index: 1;
}

.brand-logo__character--li {
  margin-left: -2rpx;
}

.brand-logo__route {
  position: absolute;
  right: 0;
  bottom: 3rpx;
  width: 34rpx;
  height: 12rpx;
  border-bottom: 4rpx solid currentColor;
}

.brand-logo__route::after {
  position: absolute;
  right: 0;
  bottom: -7rpx;
  width: 10rpx;
  height: 10rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  content: '';
}

.brand-logo__meta {
  margin-left: auto;
  color: inherit;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  opacity: 0.62;
  text-align: right;
}

.brand-logo--compact {
  min-height: 48rpx;
}

.brand-logo--compact .brand-logo__wordmark {
  padding-right: 22rpx;
  font-size: 38rpx;
}

.brand-logo--compact .brand-logo__route {
  width: 29rpx;
}
