:host {
  display: block;
}

.brand-logo {
  display: flex;
  box-sizing: border-box;
  min-height: 60rpx;
  align-items: center;
  gap: 18rpx;
  background: transparent;
  color: var(--color-text);
}

.brand-logo__wordmark {
  position: relative;
  display: inline-flex;
  box-sizing: border-box;
  min-height: 60rpx;
  padding: 14rpx 44rpx 14rpx 18rpx;
  align-items: center;
  border-radius: var(--radius-sm);
  background: var(--color-logo-background);
  color: var(--color-logo-foreground);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.brand-logo__character {
  position: relative;
  z-index: 1;
}

.brand-logo__character--li {
  margin-left: -2rpx;
}

.brand-logo__route {
  position: absolute;
  right: 0;
  bottom: 3rpx;
  width: 34rpx;
  height: 12rpx;
  border-bottom: 4rpx solid currentColor;
}

.brand-logo__route::after {
  position: absolute;
  right: 0;
  bottom: -7rpx;
  width: 10rpx;
  height: 10rpx;
  border: 4rpx solid var(--color-logo-accent);
  border-radius: 50%;
  content: '';
}

.brand-logo__meta {
  margin-left: 0;
  color: var(--color-text);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.45;
  opacity: 0.72;
  text-align: left;
}

.brand-logo--compact {
  min-height: 48rpx;
}

.brand-logo--compact .brand-logo__wordmark {
  min-height: 48rpx;
  padding: 10rpx 36rpx 10rpx 14rpx;
  font-size: 38rpx;
}

.brand-logo--compact .brand-logo__route {
  width: 29rpx;
}
