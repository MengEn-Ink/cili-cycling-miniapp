:host {
  display: block;
}

.brand-logo {
  display: flex;
  box-sizing: border-box;
  min-height: 60rpx;
  align-items: center;
  gap: 18rpx;
  background: transparent;
  color: var(--color-text);
}

.brand-logo__wordmark {
  position: relative;
  display: inline-flex;
  box-sizing: border-box;
  min-height: 60rpx;
  padding: 14rpx 18rpx;
  align-items: center;
  background: var(--color-logo-background);
  color: var(--color-logo-foreground);
  font-family: var(--font-family-body);
  font-size: 40rpx;
  font-stretch: condensed;
  font-weight: 900;
  letter-spacing: -2rpx;
  line-height: 1;
}

.brand-logo__letters {
  position: relative;
  z-index: 1;
}

.brand-logo__cut {
  position: absolute;
  left: 31rpx;
  bottom: 13rpx;
  z-index: 2;
  width: 12rpx;
  height: 5rpx;
  background: var(--color-logo-accent);
  transform: skewX(-28deg);
}

.brand-logo__meta {
  margin-left: 0;
  color: var(--color-text);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.45;
  opacity: 0.72;
  text-align: left;
}

.brand-logo--compact {
  min-height: 48rpx;
}

.brand-logo--compact .brand-logo__wordmark {
  min-height: 48rpx;
  padding: 10rpx 14rpx;
  font-size: 34rpx;
}

.brand-logo--compact .brand-logo__cut {
  left: 25rpx;
  bottom: 9rpx;
  width: 10rpx;
  height: 4rpx;
}
