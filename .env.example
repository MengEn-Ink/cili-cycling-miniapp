# 此文件仅列出本地开发、验证和手动上传可用的变量名。
# 不要把真实值写回本文件，也不要依赖复制后的 .env 自动生效；仓库脚本不会
# 自动加载 .env。请仅在需要对应操作时，通过受控终端或 Secret 管理器注入变量。

# GitHub / CloudBase 自动化（仅在需要对应远端操作时配置）
GITHUB_TOKEN=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=

# 生产写入 smoke 的本地防误跑双重门禁；默认留空即拒绝执行
CILI_ALLOW_PRODUCTION_SMOKE=
CILI_SMOKE_ENV_ID=

# 微信开发者工具 E2E（可选）
WECHAT_DEVTOOLS_CLI=
CILI_E2E_OUTPUT=

# 微信开发版手动上传（可选）
MINIPROGRAM_CI_PRIVATE_KEY_PATH=
MINIPROGRAM_VERSION=
MINIPROGRAM_DESCRIPTION=
MINIPROGRAM_CI_ROBOT=1

# CloudBase 云函数运行时变量键名。
# 真实值应配置在 CloudBase 控制台，而不是本地 .env。
PII_ENCRYPTION_KEY=
PROFILE_MEDIA_PATH_SECRET=
OAUTH_RETIREMENT_PURGE_ENABLED=0
REVIEW_APPROVED_TEMPLATE_ID=
REVIEW_REJECTED_TEMPLATE_ID=
WAITLIST_ENTERED_TEMPLATE_ID=
WAITLIST_PROMOTED_TEMPLATE_ID=
ACTIVITY_REMINDER_TEMPLATE_ID=
WECHAT_CALLBACK_TOKEN=
WECHAT_CALLBACK_AES_KEY=
WECHAT_APP_ID=
