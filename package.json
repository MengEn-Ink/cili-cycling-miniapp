{
  "name": "cili-cycling-miniapp",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "node scripts/harness.mjs",
    "harness:preflight": "node scripts/harness.mjs preflight verify",
    "harness:verify": "node scripts/harness.mjs run verify",
    "harness:release": "node scripts/harness.mjs run release",
    "test:devtools:e2e": "node scripts/wechat-devtools-e2e.cjs",
    "cloud:prepare": "node scripts/prepare-cloudfunctions.mjs",
    "cloud:install": "npm run cloud:prepare && node scripts/run-cloud-packages.mjs install",
    "tool:install": "npx --yes npm@11 ci --ignore-scripts --prefix tools/miniprogram-ci --registry=https://registry.npmjs.org",
    "test:cloud": "node scripts/run-cloud-packages.mjs test",
    "test:bootstrap": "node --test scripts/bootstrap-cloudbase.node-test.mjs scripts/cloudbase-deploy-decision.node-test.mjs scripts/cloudbase-function-env.node-test.mjs scripts/cloudbase-storage-rules.node-test.mjs scripts/cloudbase-club-application-smoke.node-test.mjs scripts/cloudbase-activity-flow-smoke.node-test.mjs scripts/cloudbase-historical-activity-purge.node-test.mjs scripts/cloudbase-prelaunch-media-purge.node-test.mjs scripts/activity-home-timeline-planner-probe.node-test.mjs",
    "test:journey-evidence": "node --test tests/verify-journey-evidence.node-test.mjs scripts/p0-journey-driver.node-test.mjs scripts/wechat-devtools-e2e.node-test.mjs scripts/e2e-report.node-test.mjs",
    "check:journey-preflight": "node scripts/p0-journey-driver.mjs preflight",
    "issue:journey-run": "node scripts/issue-journey-run.mjs",
    "verify:journey-evidence": "node scripts/verify-journey-evidence.mjs",
    "cloudbase:plan": "node scripts/bootstrap-cloudbase.mjs",
    "cloudbase:apply": "node scripts/bootstrap-cloudbase.mjs --apply",
    "cloudbase:verify": "node scripts/bootstrap-cloudbase.mjs --verify",
    "cloudbase:storage:reconcile": "node scripts/cloudbase-storage-rules.mjs",
    "cloudbase:smoke:club-application": "node scripts/cloudbase-club-application-smoke.mjs",
    "cloudbase:smoke:activity-flow": "node scripts/cloudbase-activity-flow-smoke.mjs",
    "cloudbase:purge:prelaunch-media": "node scripts/cloudbase-prelaunch-media-purge.mjs",
    "cloudbase:purge:historical-activities": "node scripts/cloudbase-historical-activity-purge.mjs",
    "verify:cloud-packages": "node scripts/verify-cloud-packages.mjs",
    "coverage": "vitest run --coverage && node --experimental-test-coverage --test scripts/bootstrap-cloudbase.node-test.mjs && node scripts/check-cloud-coverage.mjs",
    "test:deploy": "node --test scripts/miniprogram-upload-decision.node-test.mjs scripts/upload-miniprogram-ci.node-test.mjs scripts/miniprogram-experience-release.node-test.mjs scripts/audit-miniprogram-ci.node-test.mjs scripts/media-upload-governance.node-test.mjs",
    "check:experience-releases": "node scripts/miniprogram-experience-release.mjs verify-repository --directory docs/releases/experience --base \"${RELEASE_NOTES_BASE:-}\"",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:main-package": "node scripts/check-main-package-size.mjs",
    "test:release-notes": "node --test scripts/check-release-notes.node-test.mjs",
    "test:ui-sync": "node --test scripts/ui-sync-policy.node-test.mjs scripts/check-ui-sync.node-test.mjs",
    "deploy:miniprogram": "node scripts/upload-miniprogram-ci.mjs",
    "check:ui-sync": "node scripts/check-ui-sync.mjs",
    "check:pr-description": "node scripts/check-pr-description.mjs",
    "test:affected": "node scripts/affected-ci.mjs run",
    "test:affected:plan": "node scripts/affected-ci.mjs plan",
    "test:affected:self": "node --test scripts/affected-ci.node-test.mjs",
    "test:ci-contract": "node --test scripts/affected-ci.node-test.mjs scripts/run-cloud-packages.node-test.mjs scripts/ci-workflow-contract.node-test.mjs",
    "check:governance": "node scripts/check-project-governance.mjs",
    "devtools:port": "node scripts/ensure-devtools-port.mjs",
    "ui:digest": "node scripts/pages-visual-acceptance/sync-ui-digests.mjs",
    "pr:preflight": "node scripts/pr-preflight.mjs",
    "pr:body": "node scripts/pr-body.mjs",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/validate.mjs",
    "validate": "npm run tool:install && npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:phase3-visual && npm run test:ci-contract && npm run test:journey-evidence && npm run test:bootstrap && npm run test:deploy && npm run check:experience-releases && npm run test:release-notes && npm run test:ui-sync && npm run check:release-notes && npm run check:main-package && npm run check:ui-sync && npm run check:governance && npm run test:cloud && npm run verify:cloud-packages && npm run build",
    "audit:all": "npm audit --audit-level=high && node scripts/audit-miniprogram-ci.mjs && npm --prefix cloudfunctions/shared audit --audit-level=high && npm --prefix cloudfunctions/auth audit --audit-level=high && npm --prefix cloudfunctions/activity-read audit --audit-level=high && npm --prefix cloudfunctions/activity-admin audit --audit-level=high && npm --prefix cloudfunctions/strava-bridge audit --audit-level=high && npm --prefix cloudfunctions/strava-callback audit --audit-level=high && npm --prefix cloudfunctions/registration audit --audit-level=high && npm --prefix cloudfunctions/admin-review audit --audit-level=high && npm --prefix cloudfunctions/club-application audit --audit-level=high && npm --prefix cloudfunctions/notification-send audit --audit-level=high && npm --prefix cloudfunctions/profile audit --audit-level=high && npm --prefix cloudfunctions/profile-media-cleanup audit --audit-level=high && npm --prefix cloudfunctions/route-maintenance audit --audit-level=high",
    "test:phase3-visual": "playwright install chromium && node scripts/run-phase3-three-width.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
