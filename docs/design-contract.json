{
  "schemaVersion": 1,
  "layers": {
    "primitive": "原始色板、尺寸、排版与动效数值",
    "semantic": "跨场景颜色与布局职责，保留既有名称兼容消费",
    "component": "按钮、卡片、输入、标签、分段与焦点控件别名"
  },
  "tokens": {
