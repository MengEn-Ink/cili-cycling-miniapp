    "--card-radius": "var(--radius-card)",
    "--card-padding": "var(--space-5)",
    "--input-bg": "var(--color-input-bg)",
    "--input-text": "var(--color-text)",
    "--input-border": "var(--color-border-strong)",
    "--input-border-width": "var(--border-width-strong)",
    "--input-radius": "var(--radius-sm)",
    "--input-focus-border": "var(--focus-color)",
    "--input-focus-ring": "var(--focus-ring)",
    "--tag-bg": "var(--color-raised)",
    "--tag-text": "var(--color-text)",
    "--tag-radius": "var(--radius-xs)",
    "--segment-bg": "var(--color-surface)",
    "--segment-text": "var(--color-text)",
    "--segment-border": "var(--color-border-strong)",
    "--segment-border-width": "var(--border-width-strong)",
    "--segment-radius": "var(--radius-sm)"
