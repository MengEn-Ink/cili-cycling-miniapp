{
  "slug": "admin-activity-edit",
  "pagePath": "pages/admin/activity-edit/index",
  "title": "编辑活动",
  "wxml": "miniprogram/pages/admin/activity-edit/index.wxml",
  "wxss": "miniprogram/pages/admin/activity-edit/index.wxss",
  "ts": "miniprogram/pages/admin/activity-edit/index.ts",
  "designIntent": "骑行影像志 1:1：pageheading(宋体双行标题：出发之前，把细节讲清楚) → content.tight → section 影像与标题（upload 3×封面 + 活动名称 field） → section 何时在哪里（date+time fieldgrid + 集合地点 field） → section 报名方式（公开 / 审核 choicegrid + 报名截止 / 容量 detailrows） → section 路线与说明（Strava 链接 + 解析 + 公开/GPX routePreview paper + metrics + 画布 + GPX 兜底 + description） → section 活动群（二维码 upload）→ 固定 action-bar actions buttonpair（保存草稿 secondary + 发布活动 primary）。",
  "containers": [
    { "class": "page-shell activity-editor activity-form-page", "role": "page-root", "order": 1 },
    { "class": "editor-hero pageheading", "role": "page-heading", "order": 2, "note": "宋体双行标题 + 活动摘要副标题" },
    { "class": "content tight", "role": "content", "order": 3 },
    { "class": "section form-card card", "role": "form-section", "order": 4, "note": "多节表单：影像/时间地点/报名/路线/活动群均使用相同容器" },
    { "class": "chapterhead", "role": "section-head", "order": 5, "note": "小标题 + 右侧辅助说明" },
    { "class": "upload cover-upload", "role": "cover-upload", "order": 6, "note": "最多 3 张封面：第一张置顶" },
    { "class": "fieldgrid", "role": "date-time-grid", "order": 7, "note": "日期 + 时间两列" },
    { "class": "fieldset registration-mode-field", "role": "registration-mode", "order": 8, "note": "公开 / 审核 choicegrid + 规则说明" },
    { "class": "detailrows", "role": "registration-detail", "order": 9, "note": "报名截止与容量只读说明" },
    { "class": "action-bar actions buttonpair", "role": "primary-actions", "order": 10, "note": "固定底部双按钮：保存草稿 secondary + 发布活动 primary" }
  ],
  "interactions": [
    { "trigger": "field", "dataAttr": "data-name", "note": "基础字段输入" },
    { "trigger": "dateTimePicker", "dataAttr": "data-target", "note": "日期 / 时间 picker 变更" },
    { "trigger": "registrationModeChange", "dataAttr": "data-mode", "note": "切换公开 / 审核报名模式" },
    { "trigger": "chooseImages", "note": "选取活动封面图" },
    { "trigger": "removeImage", "dataAttr": "data-index", "note": "移除封面图" },
    { "trigger": "setCover", "dataAttr": "data-index", "note": "设置封面" },
    { "trigger": "retryImage", "dataAttr": "data-id", "note": "重试上传封面图" },
    { "trigger": "removePendingImage", "dataAttr": "data-id", "note": "移除失败的待上传图" },
    { "trigger": "chooseRouteLocation", "note": "地图选点集合地点" },
    { "trigger": "openStravaSettings", "note": "跳转设置页完成 Strava 同步" },
    { "trigger": "addOfficialRoute", "note": "解析并导入 Strava 线路" },
    { "trigger": "openRouteBoostSheet", "note": "打开补充本地路线弹层" },
    { "trigger": "closeRouteBoostSheet", "note": "关闭补充本地路线弹层" },
    { "trigger": "chooseRouteGpx", "note": "上传本地 GPX" },
    { "trigger": "retryRouteGpx", "note": "重试解析本地 GPX" },
    { "trigger": "removeRouteDetails", "note": "移除当前线路预览" },
    { "trigger": "useRouteAsCover", "note": "将路线渲染图设为封面背景" },
    { "trigger": "chooseGroupQrCode", "note": "上传活动群二维码" },
    { "trigger": "removeGroupQrCode", "note": "删除活动群二维码" },
    { "trigger": "storedMediaPreviewError", "note": "已上传媒体预览加载失败兜底" },
    { "trigger": "retryStoredMediaPreview", "dataAttr": "data-file-id", "note": "重试已上传媒体预览" },
    { "trigger": "save", "dataAttr": "data-status", "note": "保存草稿 / 发布活动" },
    { "trigger": "retryLoad", "note": "身份加载失败重试" }
  ],
  "copy": [
    "出发之前，",
    "把细节讲清楚。",
    "影像与标题",
    "何时，在哪里",
    "报名方式",
    "公开报名",
    "审核报名",
    "报名截止",
    "活动容量",
    "路线与说明",
    "活动群",
    "活动群二维码",
    "保存草稿",
    "集合地点",
    "活动日期",
    "集合时间",
    "活动说明"
  ],
  "assets": [
    { "class": "route-outline-canvas", "note": "线路轮廓 canvas" },
    { "class": "route-elevation-canvas", "note": "海拔曲线 canvas" }
  ],
  "forbids": [
    { "class": "journal-heading", "reason": "过渡 heading 已退役，统一使用 pageheading" },
    { "class": "form-section", "reason": "旧 form-section 已被 section.form-card 替代" },
    { "class": "activity-editor-actions", "reason": "底部主次按钮统一走 action-bar.actions.buttonpair" }
  ],
  "designSource": "docs/designs/2026-10-22-cycling-image-journal/pages/admin-activity-edit.html"
}
