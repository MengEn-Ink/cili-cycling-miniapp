{
  "slug": "activity-detail",
  "pagePath": "pages/activity-detail/index",
  "title": "活动详情",
  "wxml": "miniprogram/pages/activity-detail/index.wxml",
  "wxss": "miniprogram/pages/activity-detail/index.wxss",
  "ts": "miniprogram/pages/activity-detail/index.ts",
  "designIntent": "设计稿 pages/activity-detail.html 一比一映射：photo.hero.detail(首屏画面) → ink(metrics + 集合概要行) → content(section × N) → decision(报名状态卡) → fixed actionbar。真实业务保留 画面轮播降级 / viewerStatus 权限视图 / Strava 复制 / GPX 下载 + MD5 / 路线分析入口 / 骑手公开名片 modal / 群二维码 / admin 两键底栏。",
  "containers": [
    { "class": "page detail-page", "role": "page-root", "order": 1 },
    { "class": "photo hero detail", "role": "hero", "order": 2, "note": "首屏画面；swiper/image/generated-activity-cover 三选一；caption 承载日期 + 标题 + 俱乐部名" },
    { "class": "ink", "role": "metrics", "order": 3, "note": "metrics 两列 × 四项 + ink-row 集合时间" },
    { "class": "content", "role": "content", "order": 4, "note": "section × N 容器" },
    { "class": "section section-intro", "role": "section", "order": 5, "note": "这次一起骑 + 俱乐部 row + 可选 route-difficulty" },
    { "class": "section section-meeting", "role": "section", "order": 6, "note": "集合与出发 detailrows + 导航 CTA" },
    { "class": "section section-route", "role": "section", "order": 7, "optional": true, "note": "山路有迹可循：路线详情 paper + GPX 下载 + Strava 复制 + 路线分析入口" },
    { "class": "section section-attendees", "role": "section", "order": 8, "optional": true, "note": "一起出发的骑友：riderlist scroll + 公开名片 modal 触发点" },
    { "class": "section section-notes", "role": "section", "order": 9, "optional": true, "note": "行前约定：装备 / 注意事项 chip-list" },
    { "class": "section section-schedule", "role": "section", "order": 10, "optional": true, "note": "时间安排 schedule-list" },
    { "class": "section section-end", "role": "section", "order": 11, "optional": true, "note": "终点导航 detailrows + 导航 CTA" },
    { "class": "section section-fee", "role": "section", "order": 12, "optional": true, "note": "费用说明" },
    { "class": "section section-group", "role": "section", "order": 13, "note": "活动群：群二维码 paper 或锁定 notice" },
    { "class": "decision", "role": "status-banner", "order": 14, "note": "报名状态卡：decision-head + decision-hint + 可选 decision-capacity" },
    { "class": "actionbar", "role": "fixed-cta", "order": 15, "note": "固定底栏；admin 时为 actionbar--admin 两键，普通用户为单主 CTA" }
  ],
  "interactions": [
    { "trigger": "retryLoad", "note": "state-view bind:retry + 刷新失败重试" },
    { "trigger": "galleryChange", "note": "swiper 切换记录 currentGalleryIndex" },
    { "trigger": "galleryImageError", "dataAttr": "data-index", "note": "画面加载失败降级" },
    { "trigger": "coverImageError", "note": "单图封面失败降级" },
    { "trigger": "navigate", "dataAttr": "data-target", "note": "集合 / 终点导航" },
    { "trigger": "openRouteAnalysis", "note": "进入完整路线分析页" },
    { "trigger": "downloadGpx", "note": "GPX 下载 + MD5 校验" },
    { "trigger": "copyOfficialRoute", "note": "复制 Strava 官方路线链接" },
    { "trigger": "openAttendeeCard", "dataAttr": "data-index", "note": "打开骑手公开名片 modal" },
    { "trigger": "closeAttendeeCard", "note": "关闭名片 modal" },
    { "trigger": "previewGroupQr", "note": "放大查看活动群二维码" },
    { "trigger": "editActivity", "note": "管理员：进入活动编辑" },
    { "trigger": "adminRegistration", "note": "管理员：进入活动报名审核" },
    { "trigger": "go", "note": "普通用户：主 CTA（报名 / 查看凭证 / 重新报名 等）" }
  ],
  "copy": [
    "报名状态",
    "集合时间",
    "集合地点",
    "查看完整路线分析",
    "活动群",
    "活动简介",
    "集合信息",
    "活动路线",
    "一起出发的骑友"
  ],
  "assets": [
    { "class": "photo hero detail", "note": "首屏画面容器；swiper / image / 生成封面三选一" }
  ],
  "forbids": [
    { "class": "detail-unified-card", "reason": "旧 Oil UI 外壳已退役。" },
    { "class": "detail-hero", "reason": "旧 hero class 已退役，由 photo.hero.detail 取代。" },
    { "class": "info-bar", "reason": "旧 info-bar 已退役，由 caption + ink 分摊承载。" },
    { "class": "info-head", "reason": "旧 info-head 已退役。" },
    { "class": "info-title", "reason": "旧 info-title 已退役，由 hero-title.editorial 取代。" },
    { "class": "detail-metric-panel", "reason": "旧 metric 外壳已退役，由 ink > metrics 取代。" },
    { "class": "detail-decision", "reason": "旧 decision 外壳已退役，由 .decision 取代。" },
    { "class": "time-card", "reason": "旧集合卡已退役，由 section-meeting + paper + detailrows 取代。" },
    { "class": "fixed detail-action", "reason": "旧 fixed detail-action 已退役，由 .actionbar 取代。" }
  ],
  "designSource": "docs/designs/2026-10-22-cycling-image-journal/pages/activity-detail.html"
}
