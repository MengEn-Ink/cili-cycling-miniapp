  "containers": [
    { "class": "page credential-page", "role": "page-root", "order": 1 },
    { "class": "journal-heading", "role": "page-heading", "order": 2, "note": "journal-eyebrow + journal-title editorial + journal-summary；文案由 statusView 驱动。" },
    { "class": "status-journey", "role": "status", "order": 3, "note": "status-journey__marker + status-journey__copy；tone 用于视觉态。" },
