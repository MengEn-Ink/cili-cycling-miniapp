    { "class": "meeting-spotlight", "role": "meeting", "order": 5, "optional": true, "note": "credential-card 内部：集合时间 / 集合地点 / 可选后援车司机。" },
    { "class": "action-stack", "role": "actions", "order": 6, "note": "分享活动 / 查看路线分析 / 取消报名 / 重新报名 等按钮集合；分享按钮必须使用 open-type=share。" }
  ],
  "interactions": [
    { "trigger": "share", "openType": "share", "note": "分享活动，open-type=share，不含本人隐私。" },
    { "trigger": "openRouteAnalysis", "note": "进入完整路线分析。" },
    { "trigger": "navigateToMeeting", "note": "打开集合地点地图导航。" },
    { "trigger": "cancel", "note": "取消报名；禁用由 cancelling 控制。" },
    { "trigger": "retry", "note": "重新报名（当活动可再报名时）。" }
  ],
