{
  "envId": "cloudbase-d0gizacy77a1ab017",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "auth",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 5,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "activity-read",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "activity-admin",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "registration",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "admin-review",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "notification-send",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "triggers": [
        {
          "name": "notification-outbox-worker",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ]
    },
    {
      "name": "profile",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "profile-media-cleanup",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": true,
      "triggers": [
        {
          "name": "profile-media-cleanup-worker",
          "type": "timer",
          "config": "0 */10 * * * * *"
        }
      ]
    },
    {
      "name": "strava-auth",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "strava-callback",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "memorySize": 256,
      "installDependency": true
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/strava/callback",
        "target": "function:strava-callback",
        "enableAuth": false,
        "enablePathTransmission": true,
        "domain": "*"
      },
      {
        "path": "/strava/success",
        "target": "function:strava-callback",
        "enableAuth": false,
        "enablePathTransmission": true,
        "domain": "*"
      },
      {
        "path": "/strava/failure",
        "target": "function:strava-callback",
        "enableAuth": false,
        "enablePathTransmission": true,
        "domain": "*"
      }
    ]
  }
}
